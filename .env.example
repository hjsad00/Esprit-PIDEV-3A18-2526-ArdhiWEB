# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=your_app_secret_here
APP_LAN_IP=127.0.0.1
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://username:password@smtp.example.com:587
MAIL_FROM=no-reply@example.com
###< symfony/mailer ###

GOOGLE_CALENDAR_ID=your_calendar_id_here
###> google/apiclient ###
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_AUTH_CONFIG=%kernel.project_dir%/path/to/file.json
###< google/apiclient ###

OPENWEATHER_API_KEY=your_openweather_api_key_here

###> Parcelles Cultures - APIs IA ###
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
###< Parcelles Cultures - APIs IA ###

###> knplabs/knp-snappy-bundle ###
WKHTMLTOPDF_PATH="C:\Program Files\wkhtmltopdf\bin\wkhtmltopdf.exe"
WKHTMLTOIMAGE_PATH="C:\Program Files\wkhtmltopdf\bin\wkhtmltoimage.exe"
###< knplabs/knp-snappy-bundle ###

MAILER_FROM=support@example.com
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

###> karser/karser-recaptcha3-bundle ###
RECAPTCHA3_KEY=your_recaptcha_key_here
RECAPTCHA3_SECRET=your_recaptcha_secret_here
###< karser/karser-recaptcha3-bundle ###

###> Marketplace AI ###
MARKETPLACE_GROQ_API_KEY=your_marketplace_groq_api_key_here
MARKETPLACE_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
###< Marketplace AI ###

###> Twilio WhatsApp ###
MARKETPLACE_TWILIO_SID=your_twilio_sid_here
MARKETPLACE_TWILIO_TOKEN=your_twilio_token_here
MARKETPLACE_TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
###< Twilio WhatsApp ###

###> Marketplace Stripe ###
MARKETPLACE_STRIPE_SECRET_KEY=your_stripe_secret_key_here
###< Marketplace Stripe ###

###> karser/karser-recaptcha3-bundle ###
MARKETPLACE_RECAPTCHA3_ENABLED=1
MARKETPLACE_RECAPTCHA3_KEY=your_marketplace_recaptcha_key_here
MARKETPLACE_RECAPTCHA3_SECRET=your_marketplace_recaptcha_secret_here
###< karser/karser-recaptcha3-bundle ###

APP_URL=https://your-domain.ngrok-free.dev
TRUSTED_PROXIES=127.0.0.1

###> twilio/sdk ###
MATERIEL_TWILIO_SID=your_materiel_twilio_sid_here
MATERIEL_TWILIO_AUTH_TOKEN=your_materiel_twilio_auth_token_here
MATERIEL_TWILIO_FROM=whatsapp:+14155238886
###< twilio/sdk ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> Twilio HR Urgent ###
TWILIO_SID=your_hr_twilio_sid_here
TWILIO_TOKEN=your_hr_twilio_token_here
TWILIO_FROM="your_hr_twilio_from_here"
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
###< Twilio HR Urgent ###

###> Global APIs ###
STRIPE_SECRET_KEY=your_stripe_secret_key_here
IMGBB_API_KEY=your_imgbb_api_key_here
UNSPLASH_API_KEY=your_unsplash_api_key_here
###< Global APIs ###
