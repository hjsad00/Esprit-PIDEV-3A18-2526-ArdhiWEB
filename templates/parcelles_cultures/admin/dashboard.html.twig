{% extends 'base.html.twig' %}

{% block title %}Administration - Agriculture{% endblock %}

{% block stylesheets %}
    <style>
        .agriculture-hero {
            position: relative;
            height: 600px;
            display: flex;
            align-items: center;
            color: white;
            overflow: hidden;
            background: linear-gradient(135deg, #c41e3a 0%, #e94b3c 100%);
        }

        .hero-bg {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            opacity: 0.3;
            z-index: 0;
        }

        .hero-bg img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .agriculture-hero .container {
            position: relative;
            z-index: 1;
        }

        .hero-inner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .hero-left h1 {
            font-size: 3.5rem;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 1.5rem;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .hero-left p {
            font-size: 1.2rem;
            margin-bottom: 2rem;
            opacity: 0.95;
            line-height: 1.6;
        }

        .hero-label {
            display: inline-block;
            background: rgba(255, 255, 255, 0.2);
            color: white;
            padding: 0.5rem 1.5rem;
            border-radius: 25px;
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 1px;
            margin-bottom: 1.5rem;
            backdrop-filter: blur(10px);
        }

        .hero-btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: white;
            color: #c41e3a;
            padding: 1rem 2rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .hero-btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
            color: #c41e3a;
            text-decoration: none;
        }

        .categories-glass-panel {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        }

        .categories-panel-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: white;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
        }

        .category-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            margin-bottom: 0.5rem;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.1);
            color: white;
            text-decoration: none;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .category-item:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateX(10px);
            border-color: rgba(255, 255, 255, 0.3);
            color: white;
        }

        .category-icon {
            font-size: 2rem;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            flex-shrink: 0;
        }

        .category-text h4 {
            margin: 0;
            font-weight: 600;
            margin-bottom: 0.3rem;
        }

        .category-text span {
            font-size: 0.85rem;
            opacity: 0.9;
            display: block;
        }

        @media (max-width: 768px) {
            .hero-inner {
                grid-template-columns: 1fr;
            }

            .hero-left h1 {
                font-size: 2.5rem;
            }
        }
    </style>
{% endblock %}

{% block body %}

    {# ============================
       HERO SECTION
       ============================ #}
    <section class="agriculture-hero">
        <div class="hero-bg">
            <img src="{{ asset('assets/img/hero_1.jpg') }}" alt="Agriculture Admin">
        </div>

        <div class="container">
            <div class="hero-inner">

                {# --- Left Content --- #}
                <div class="hero-left">
                    <div class="hero-label">ADMINISTRATION AGRICOLE</div>
                    <h1>Administrez les<br>parcelles et<br>cultures.</h1>
                    <p>
                        Suivi global, statistiques, gestion des parcelles et cultures de tous les agriculteurs.
                    </p>
                    <a href="{{ path('admin_parcelle_index') }}" class="hero-btn-primary">
                        <i class="fas fa-arrow-right"></i> Accéder
                    </a>
                </div>

                {# --- Right: Navigation Panel --- #}
                <div>
                    <div class="categories-glass-panel">
                        <div class="categories-panel-title">Gestion Admin</div>

                        <a href="{{ path('admin_parcelle_index') }}" class="category-item">
                            <div class="category-icon"><i class="fas fa-map"></i></div>
                            <div class="category-text">
                                <h4>Parcelles</h4>
                                <span>Toutes les parcelles</span>
                            </div>
                        </a>

                        <a href="{{ path('admin_culture_index') }}" class="category-item">
                            <div class="category-icon"><i class="fas fa-leaf"></i></div>
                            <div class="category-text">
                                <h4>Cultures</h4>
                                <span>Toutes les cultures</span>
                            </div>
                        </a>

                        <a href="{{ path('admin_stats_index') }}" class="category-item">
                            <div class="category-icon"><i class="fas fa-chart-bar"></i></div>
                            <div class="category-text">
                                <h4>Statistiques</h4>
                                <span>Tableau de bord</span>
                            </div>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>

{% endblock %}
