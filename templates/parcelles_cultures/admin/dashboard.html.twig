{% extends 'parcelles_cultures/admin/admin_base.html.twig' %}

{% block title %}Administration - Parcelles & Cultures{% endblock %}
{% block page_title %}Gestion des Parcelles & Cultures{% endblock %}

{% block body %}
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 30px;">
  <!-- Card: Parcelles -->
  <div style="background: white; border-radius: 12px; padding: 25px; border-left: 4px solid #116530; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px;">
      <div style="font-size: 2.5rem; color: #116530;">
        <i class="bi bi-map-fill"></i>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 2rem; font-weight: 700; color: #116530;">{% if stats.parcellesCount %}{{ stats.parcellesCount }}{% else %}0{% endif %}</div>
        <div style="font-size: 0.85rem; color: #6c757d;">Parcelles</div>
      </div>
    </div>
    <a href="{{ path('admin_parcelle_index') }}" class="btn btn-admin btn-sm w-100">
      <i class="bi bi-arrow-right me-1"></i> Voir toutes
    </a>
  </div>

  <!-- Card: Cultures -->
  <div style="background: white; border-radius: 12px; padding: 25px; border-left: 4px solid #116530; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px;">
      <div style="font-size: 2.5rem; color: #116530;">
        <i class="bi bi-flower1"></i>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 2rem; font-weight: 700; color: #116530;">{% if stats.culturesCount %}{{ stats.culturesCount }}{% else %}0{% endif %}</div>
        <div style="font-size: 0.85rem; color: #6c757d;">Cultures</div>
      </div>
    </div>
    <a href="{{ path('admin_culture_index') }}" class="btn btn-admin btn-sm w-100">
      <i class="bi bi-arrow-right me-1"></i> Voir toutes
    </a>
  </div>

  <!-- Card: Surface Totale -->
  <div style="background: white; border-radius: 12px; padding: 25px; border-left: 4px solid #116530; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px;">
      <div style="font-size: 2.5rem; color: #116530;">
        <i class="bi bi-rulers"></i>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 2rem; font-weight: 700; color: #116530;">{% if stats.surfaceTotale %}{{ stats.surfaceTotale|round(1) }}{% else %}0{% endif %}</div>
        <div style="font-size: 0.85rem; color: #6c757d;">ha</div>
      </div>
    </div>
  </div>

  <!-- Card: Statut Actif -->
  <div style="background: white; border-radius: 12px; padding: 25px; border-left: 4px solid #28a745; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px;">
      <div style="font-size: 2.5rem; color: #28a745;">
        <i class="bi bi-check-circle-fill"></i>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 2rem; font-weight: 700; color: #28a745;">{% if stats.parcellesActives %}{{ stats.parcellesActives }}{% else %}0{% endif %}</div>
        <div style="font-size: 0.85rem; color: #6c757d;">Parcelles Actives</div>
      </div>
    </div>
  </div>

  <!-- Card: Statut Inactif -->
  <div style="background: white; border-radius: 12px; padding: 25px; border-left: 4px solid #6c757d; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px;">
      <div style="font-size: 2.5rem; color: #6c757d;">
        <i class="bi bi-x-circle-fill"></i>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 2rem; font-weight: 700; color: #6c757d;">{% if stats.parcellesInactives %}{{ stats.parcellesInactives }}{% else %}0{% endif %}</div>
        <div style="font-size: 0.85rem; color: #6c757d;">Parcelles Inactives</div>
      </div>
    </div>
  </div>

  <!-- Card: Production Estimée -->
  <div style="background: white; border-radius: 12px; padding: 25px; border-left: 4px solid #ffc107; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px;">
      <div style="font-size: 2.5rem; color: #ffc107;">
        <i class="bi bi-graph-up"></i>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 1.5rem; font-weight: 700; color: #ffc107;">{% if stats.productionTotale %}{{ (stats.productionTotale / 1000)|round(1) }}{% else %}0{% endif %}</div>
        <div style="font-size: 0.85rem; color: #6c757d;">k tonnes</div>
      </div>
    </div>
  </div>
</div>

<!-- Charts Section -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(500px, 1fr)); gap: 20px; margin-bottom: 30px;">
  <!-- Chart 1: Distribution des Types de Sol -->
  <div class="admin-table-card">
    <div class="admin-table-header">
      <h2><i class="bi bi-pie-chart me-2"></i>Distribution des Types de Sol</h2>
    </div>
    <div style="padding: 20px;">
      {% if soilTypeLabels|length > 0 %}
        <canvas id="soilTypeChart" style="max-height: 300px;"></canvas>
      {% else %}
        <div class="alert alert-info">Pas de données disponibles</div>
      {% endif %}
    </div>
  </div>

  <!-- Chart 2: Distribution des Types de Culture -->
  <div class="admin-table-card">
    <div class="admin-table-header">
      <h2><i class="bi bi-bar-chart me-2"></i>Distribution des Types de Culture</h2>
    </div>
    <div style="padding: 20px;">
      {% if cultureTypeLabels|length > 0 %}
        <canvas id="cultureTypeChart" style="max-height: 300px;"></canvas>
      {% else %}
        <div class="alert alert-info">Pas de données disponibles</div>
      {% endif %}
    </div>
  </div>
</div>

<div class="admin-table-card">
  <div class="admin-table-header">
    <h2><i class="bi bi-map-fill me-2"></i>Dernières Parcelles</h2>
    <a href="{{ path('admin_parcelle_index') }}" class="text-decoration-none" style="color: #116530; font-size: 0.9rem;">Voir toutes →</a>
  </div>
  
  {% if recentParcelles|length > 0 %}
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Agriculteur</th>
            <th>Surface</th>
            <th>Localisation</th>
            <th>Type Sol</th>
            <th>Statut</th>
          </tr>
        </thead>
        <tbody>
          {% for parcelle in recentParcelles %}
            <tr>
              <td class="fw-bold">P-{{ parcelle.id }}</td>
              <td>{{ parcelle.agriculteur.email }}</td>
              <td>{{ parcelle.surface }} ha</td>
              <td>{{ parcelle.localisation }}</td>
              <td><span class="badge badge-admin" style="background: #e8f5e9; color: #116530;">{{ parcelle.typeSol }}</span></td>
              <td>
                {% if parcelle.statut == 'actif' %}
                  <span class="badge bg-success badge-admin">Actif</span>
                {% else %}
                  <span class="badge bg-secondary badge-admin">Inactif</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="empty-state">
      <i class="bi bi-inbox"></i>
      <p>Aucune parcelle pour le moment.</p>
    </div>
  {% endif %}
</div>

<div class="admin-table-card mt-4">
  <div class="admin-table-header">
    <h2><i class="bi bi-flower1 me-2"></i>Dernières Cultures</h2>
    <a href="{{ path('admin_culture_index') }}" class="text-decoration-none" style="color: #116530; font-size: 0.9rem;">Voir toutes →</a>
  </div>

  {% if recentCultures|length > 0 %}
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Type</th>
            <th>Parcelle</th>
            <th>Surface</th>
            <th>Rendement</th>
            <th>État</th>
          </tr>
        </thead>
        <tbody>
          {% for culture in recentCultures %}
            <tr>
              <td class="fw-bold">C-{{ culture.id }}</td>
              <td><span class="badge badge-admin" style="background: #e8f5e9; color: #116530;">{{ culture.typeCulture }}</span></td>
              <td>P-{{ culture.parcelle.id }}</td>
              <td>{{ culture.surfaceUtilisee }} ha</td>
              <td>{{ culture.rendementEstime }} kg/ha</td>
              <td>
                {% if culture.etatCulture == 'active' or culture.etatCulture == 'actif' %}
                  <span class="badge bg-success badge-admin">Actif</span>
                {% else %}
                  <span class="badge bg-secondary badge-admin">{{ culture.etatCulture }}</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="empty-state">
      <i class="bi bi-inbox"></i>
      <p>Aucune culture pour le moment.</p>
    </div>
  {% endif %}
</div>

<!-- Include Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Soil Type Chart
    const soilTypeCtx = document.getElementById('soilTypeChart');
    if (soilTypeCtx && {{ soilTypeData|json_encode|raw }}.length > 0) {
      new Chart(soilTypeCtx.getContext('2d'), {
        type: 'doughnut',
        data: {
          labels: {{ soilTypeLabels|json_encode|raw }},
          datasets: [{
            label: 'Types de Sol',
            data: {{ soilTypeData|json_encode|raw }},
            backgroundColor: [
              '#116530',
              '#28a745',
              '#ffc107',
              '#17a2b8',
              '#e83e8c',
              '#6c757d'
            ],
            borderColor: 'white',
            borderWidth: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                usePointStyle: true,
                padding: 15,
                font: {
                  size: 12
                }
              }
            }
          }
        }
      });
    }

    // Culture Type Chart
    const cultureTypeCtx = document.getElementById('cultureTypeChart');
    if (cultureTypeCtx && {{ cultureTypeData|json_encode|raw }}.length > 0) {
      new Chart(cultureTypeCtx.getContext('2d'), {
        type: 'bar',
        data: {
          labels: {{ cultureTypeLabels|json_encode|raw }},
          datasets: [{
            label: 'Nombre de Cultures',
            data: {{ cultureTypeData|json_encode|raw }},
            backgroundColor: '#116530',
            borderColor: '#0d4620',
            borderWidth: 1,
            borderRadius: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          indexAxis: 'y',
          plugins: {
            legend: {
              display: true,
              position: 'bottom'
            }
          },
          scales: {
            x: {
              beginAtZero: true,
              ticks: {
                stepSize: 1
              }
            }
          }
        }
      });
    }
  });
</script>
{% endblock %}
