{% extends 'base.html.twig' %}

{% block title %}Cultures Globales - Administration Ardhi{% endblock %}

{% block stylesheets %}
<style>
    .page-header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #eee; }
    .page-title { font-family: 'Marcellus', serif; color: #116530; font-size: 2.5rem; margin: 0; }
    .admin-badge { background: rgba(17,101,48,0.1); color: #116530; font-size: 0.7rem; font-weight: 700; padding: 4px 12px; border-radius: 50px; text-transform: uppercase; letter-spacing: 1px; vertical-align: middle; margin-left: 10px; }
    .premium-table-container { background: white; border-radius: 24px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 10px 30px rgba(0,0,0,0.04); overflow: hidden; }
    .premium-table { width: 100%; border-collapse: separate; border-spacing: 0; margin-bottom: 0; }
    .premium-table thead th { background: #f8faf7; color: #116530; font-weight: 700; text-transform: uppercase; font-size: 0.72rem; letter-spacing: 1px; padding: 18px 20px; border: none; }
    .premium-table tbody td { padding: 16px 20px; vertical-align: middle; border-top: 1px solid #f0f0f0; font-size: 0.9rem; color: #4a4a4a; }
    .premium-table tbody tr:hover { background-color: #fcfdfe; }
    .type-badge { font-weight: 700; font-size: 0.72rem; padding: 4px 12px; border-radius: 8px; background: #e8f5e9; color: #116530; text-transform: capitalize; }
    .status-badge { font-weight: 600; font-size: 0.72rem; padding: 5px 12px; border-radius: 50px; text-transform: uppercase; }
    .action-btn { width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s; text-decoration: none; }
    .btn-view { background: #e8f5e9; color: #116530; }
    .btn-view:hover { background: #116530; color: white; }
    .avatar { width: 32px; height: 32px; border-radius: 50%; background: #e8f5e9; display: flex; align-items: center; justify-content: center; color: #116530; font-weight: 700; font-size: .75rem; flex-shrink: 0; }
</style>
{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid py-5 px-lg-5">
    <div class="row">
        <div class="col-md-3 col-xl-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>

        <div class="col-md-9 col-xl-10">
            <div class="page-header" data-aos="fade-down">
                <h1 class="page-title">
                    Cultures Globales
                    <span class="admin-badge">Administration</span>
                </h1>
                <p class="text-muted lead mt-2">Vue d'ensemble de toutes les cultures actives sur la plateforme.</p>
            </div>

            {% if cultures.getTotalItemCount > 0 %}
                <div class="premium-table-container" data-aos="fade-up">
                    <table class="premium-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Type</th>
                                <th>Parcelle</th>
                                <th>Agriculteur</th>
                                <th>Surface</th>
                                <th>Rendement</th>
                                <th>Production Est.</th>
                                <th>État</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for culture in cultures %}
                                <tr>
                                    <td class="fw-bold text-success">C-{{ culture.id }}</td>
                                    <td><span class="type-badge">{{ culture.typeCulture }}</span></td>
                                    <td>
                                        <span class="text-muted small">P-{{ culture.parcelle.id }}</span>
                                        <span class="ms-1 text-dark">{{ culture.parcelle.localisation }}</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar">{{ culture.parcelle.agriculteur.email|slice(0,1)|upper }}</div>
                                            <span>{{ culture.parcelle.agriculteur.email }}</span>
                                        </div>
                                    </td>
                                    <td class="fw-semibold">{{ culture.surfaceUtilisee }} ha</td>
                                    <td>{{ culture.rendementEstime }} kg/ha</td>
                                    <td class="fw-bold text-success">{{ culture.productionEstimee|round(0)|number_format(0, '.', ' ') }} kg</td>
                                    <td>
                                        <span class="status-badge {{ culture.etatCulture == 'active' or culture.etatCulture == 'actif' ? 'bg-success text-white' : 'bg-secondary text-white' }}">
                                            {{ culture.etatCulture }}
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path('admin_culture_show', {id: culture.id}) }}" class="action-btn btn-view" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="mt-4" data-aos="fade-up">
                    {{ knp_pagination_render(cultures) }}
                </div>
            {% else %}
                <div class="premium-table-container text-center py-5" data-aos="zoom-in">
                    <i class="bi bi-flower1" style="font-size: 3rem; color: #cce8d8;"></i>
                    <h4 class="mt-3 text-muted">Aucune culture enregistrée</h4>
                    <p class="text-muted">Aucun agriculteur n'a encore créé de culture sur la plateforme.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
