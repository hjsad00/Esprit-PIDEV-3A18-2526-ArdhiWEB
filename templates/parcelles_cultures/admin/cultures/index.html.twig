{% extends 'parcelles_cultures/admin/admin_base.html.twig' %}

{% block title %}Cultures Globales - Administration Ardhi{% endblock %}
{% block page_title %}Cultures Globales{% endblock %}

{% block body %}
<div class="admin-table-card">
  <div class="admin-table-header">
    <h2><i class="bi bi-flower1 me-2"></i>Cultures Globales</h2>
  </div>

  {# === Search & Filter Section === #}
  <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
    <form id="filterForm" action="{{ path('admin_culture_index') }}" method="GET" class="row g-3 align-items-end">
      <div class="col-md-4">
        <label class="form-label">Rechercher</label>
        <input type="text" name="q" class="form-control" placeholder="ID, Type, Saison, Parcelle..." value="{{ filters.q|default('') }}">
      </div>
      <div class="col-md-2">
        <label class="form-label">Type</label>
        <select name="typeCulture" class="form-select">
          <option value="">Tous les types</option>
          <option value="Blé" {{ filters.typeCulture|default('') == 'Blé' ? 'selected' : '' }}>Blé</option>
          <option value="Orge" {{ filters.typeCulture|default('') == 'Orge' ? 'selected' : '' }}>Orge</option>
          <option value="Maïs" {{ filters.typeCulture|default('') == 'Maïs' ? 'selected' : '' }}>Maïs</option>
          <option value="Olive" {{ filters.typeCulture|default('') == 'Olive' ? 'selected' : '' }}>Olive</option>
          <option value="Tomate" {{ filters.typeCulture|default('') == 'Tomate' ? 'selected' : '' }}>Tomate</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label">Saison</label>
        <select name="saison" class="form-select">
          <option value="">Toutes les saisons</option>
          <option value="Printemps" {{ filters.saison|default('') == 'Printemps' ? 'selected' : '' }}>Printemps</option>
          <option value="Été" {{ filters.saison|default('') == 'Été' ? 'selected' : '' }}>Été</option>
          <option value="Automne" {{ filters.saison|default('') == 'Automne' ? 'selected' : '' }}>Automne</option>
          <option value="Hiver" {{ filters.saison|default('') == 'Hiver' ? 'selected' : '' }}>Hiver</option>
        </select>
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-admin w-100">
          <i class="bi bi-filter me-1"></i> Filtrer
        </button>
      </div>
      {% if filters.q|default('') or filters.typeCulture|default('') or filters.saison|default('') %}
        <div class="col-12">
          <a href="{{ path('admin_culture_index') }}" class="btn btn-admin-outline">
            <i class="bi bi-x-lg me-1"></i> Réinitialiser les filtres
          </a>
        </div>
      {% endif %}
    </form>
  </div>

  {% if cultures.getTotalItemCount > 0 %}
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Type</th>
            <th>Parcelle</th>
            <th>Agriculteur</th>
            <th>Surface</th>
            <th>Rendement</th>
            <th>Production Est.</th>
            <th>État</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for culture in cultures %}
            <tr>
              <td class="fw-bold">C-{{ culture.id }}</td>
              <td>
                <span class="badge badge-admin" style="background: #e8f5e9; color: #116530;">{{ culture.typeCulture }}</span>
              </td>
              <td>P-{{ culture.parcelle.id }}</td>
              <td>{{ culture.parcelle.agriculteur.email }}</td>
              <td>{{ culture.surfaceUtilisee }} ha</td>
              <td>{{ culture.rendementEstime }} kg/ha</td>
              <td class="fw-bold">{{ culture.productionEstimee|round(0)|number_format(0, '.', ' ') }} kg</td>
              <td>
                {% if culture.etatCulture == 'active' or culture.etatCulture == 'actif' %}
                  <span class="badge bg-success badge-admin">Actif</span>
                {% else %}
                  <span class="badge bg-secondary badge-admin">{{ culture.etatCulture }}</span>
                {% endif %}
              </td>
              <td>
                <div class="action-btns">
                  <a href="{{ path('admin_culture_show', {id: culture.id}) }}" class="btn btn-outline-primary btn-sm" title="Voir">
                    <i class="bi bi-eye"></i>
                  </a>
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="mt-4">
      {{ knp_pagination_render(cultures) }}
    </div>
  {% else %}
    <div class="empty-state">
      <i class="bi bi-flower1"></i>
      <p>Aucune culture trouvée.</p>
    </div>
  {% endif %}
</div>
{% endblock %}
