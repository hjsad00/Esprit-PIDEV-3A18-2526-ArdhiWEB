{% extends 'base.html.twig' %}

{% block title %}Cultures - Administration{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>
        <div class="col-md-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1><i class="fas fa-leaf"></i> Liste de toutes les Cultures</h1>
            </div>

            {% if cultures.getTotalItemCount > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nom</th>
                                <th>Parcelle</th>
                                <th>Agriculteur</th>
                                <th>Type</th>
                                <th>Surface (ha)</th>
                                <th>Rendement</th>
                                <th>Production</th>
                                <th>État</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for culture in cultures %}
                                <tr>
                                    <td>#{{ culture.id }}</td>
                                    <td>{{ culture.nom_culture }}</td>
                                    <td>#{{ culture.parcelle.id }}</td>
                                    <td>{{ culture.parcelle.agriculteur.email }}</td>
                                    <td><span class="badge bg-success">{{ culture.type_culture }}</span></td>
                                    <td>{{ culture.surface_utilisee }} ha</td>
                                    <td>{{ culture.rendement_estime }}</td>
                                    <td>{{ culture.production_estimee|round(2) }}</td>
                                    <td>
                                        <span class="badge bg-info">{{ culture.etat_culture }}</span>
                                    </td>
                                    <td>
                                        <a href="{{ path('admin_culture_show', {id: culture.id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Pagination #}
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        {% if cultures.hasPreviousPage %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('admin_culture_index', {'page': cultures.previousPage}) }}">Précédent</a>
                            </li>
                        {% endif %}

                        {% for page in cultures.paginationData.pages %}
                            {% if page == cultures.currentPage %}
                                <li class="page-item active"><span class="page-link">{{ page }}</span></li>
                            {% else %}
                                <li class="page-item"><a class="page-link" href="{{ path('admin_culture_index', {'page': page}) }}">{{ page }}</a></li>
                            {% endif %}
                        {% endfor %}

                        {% if cultures.hasNextPage %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('admin_culture_index', {'page': cultures.nextPage}) }}">Suivant</a>
                            </li>
                        {% endif %}
                    </ul>
                </nav>
            {% else %}
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i> Aucune culture enregistrée.
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
