{% extends 'base.html.twig' %}

{% block title %}Parcelles - Administration{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>
        <div class="col-md-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1><i class="fas fa-th-large"></i> Liste de toutes les Parcelles</h1>
            </div>

            {% if parcelles.getTotalItemCount > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Agriculteur</th>
                                <th>Surface (ha)</th>
                                <th>Localisation</th>
                                <th>Type de Sol</th>
                                <th>Système Irrigation</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for parcelle in parcelles %}
                                <tr>
                                    <td>#{{ parcelle.id }}</td>
                                    <td>{{ parcelle.agriculteur.email }}</td>
                                    <td>{{ parcelle.surface }} ha</td>
                                    <td>{{ parcelle.localisation }}</td>
                                    <td><span class="badge bg-info">{{ parcelle.typeSol }}</span></td>
                                    <td>{{ parcelle.systemeIrrigation }}</td>
                                    <td>
                                        {% if parcelle.statut == 'actif' %}
                                            <span class="badge bg-success">Actif</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Inactif</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('admin_parcelle_show', {id: parcelle.id}) }}" class="btn btn-sm btn-info" title="Voir">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Pagination #}
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        {% if parcelles.paginationData.previous is defined %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('admin_parcelle_index', {'page': parcelles.paginationData.previous}) }}">Précédent</a>
                            </li>
                        {% endif %}

                        {% for page in parcelles.paginationData.pagesInRange %}
                            {% if page == parcelles.currentPageNumber %}
                                <li class="page-item active"><span class="page-link">{{ page }}</span></li>
                            {% else %}
                                <li class="page-item"><a class="page-link" href="{{ path('admin_parcelle_index', {'page': page}) }}">{{ page }}</a></li>
                            {% endif %}
                        {% endfor %}

                        {% if parcelles.paginationData.next is defined %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('admin_parcelle_index', {'page': parcelles.paginationData.next}) }}">Suivant</a>
                            </li>
                        {% endif %}
                    </ul>
                </nav>
            {% else %}
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i> Aucune parcelle enregistrée.
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
