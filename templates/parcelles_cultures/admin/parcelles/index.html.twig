{% extends 'base.html.twig' %}

{% block title %}Parcelles Globales - Administration Ardhi{% endblock %}

{% block stylesheets %}
<style>
    .page-header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #eee; }
    .page-title { font-family: 'Marcellus', serif; color: #116530; font-size: 2.5rem; margin: 0; }
    .admin-badge { background: rgba(17,101,48,0.1); color: #116530; font-size: 0.7rem; font-weight: 700; padding: 4px 12px; border-radius: 50px; text-transform: uppercase; letter-spacing: 1px; vertical-align: middle; margin-left: 10px; }
    .premium-table-container { background: white; border-radius: 24px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 10px 30px rgba(0,0,0,0.04); overflow: hidden; }
    .premium-table { width: 100%; border-collapse: separate; border-spacing: 0; margin-bottom: 0; }
    .premium-table thead th { background: #f8faf7; color: #116530; font-weight: 700; text-transform: uppercase; font-size: 0.72rem; letter-spacing: 1px; padding: 18px 20px; border: none; }
    .premium-table tbody td { padding: 16px 20px; vertical-align: middle; border-top: 1px solid #f0f0f0; font-size: 0.9rem; color: #4a4a4a; }
    .premium-table tbody tr:hover { background-color: #fcfdfe; }
    .status-badge { font-weight: 600; font-size: 0.72rem; padding: 5px 12px; border-radius: 50px; text-transform: uppercase; letter-spacing: 0.5px; }
    .type-badge { font-weight: 600; font-size: 0.72rem; padding: 4px 10px; border-radius: 8px; background: #e8f5e9; color: #116530; }
    .action-btn { width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s; text-decoration: none; }
    .btn-view { background: #e8f5e9; color: #116530; }
    .btn-view:hover { background: #116530; color: white; }
    .premium-card { background: white; border-radius: 24px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 10px 30px rgba(0,0,0,0.04); padding: 25px; margin-bottom: 25px; }
    .btn-premium-add { background: #116530; color: white; border-radius: 12px; padding: 10px 24px; font-weight: 700; border: none; transition: all 0.3s; box-shadow: 0 5px 15px rgba(17,101,48,0.15); font-size: 0.9rem; display: inline-flex; align-items: center; }
    .btn-premium-add:hover { background: #1e8341; color: white; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(17,101,48,0.25); }
    .btn-premium-outline { background: white; color: #116530; border: 2px solid #116530; border-radius: 12px; padding: 8px 22px; font-weight: 700; transition: all 0.3s; font-size: 0.9rem; display: inline-flex; align-items: center; }
    .btn-premium-outline:hover { background: #f0f7ee; color: #116530; border-color: #116530; transform: translateY(-2px); }
    .info-label { font-size: 11px; font-weight: 700; color: #b2bec3; text-transform: uppercase; letter-spacing: 0.5px; }
</style>
{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid py-5 px-lg-5">
    <div class="row mb-4">
        <div class="col-12">
            <a href="{{ path('admin_dashboard') }}" class="d-inline-flex align-items-center gap-2 text-decoration-none px-4 py-2 rounded-pill shadow-sm" style="border: 2px solid #116530; color: #116530; font-weight: 600; transition: all 0.3s;" onmouseover="this.style.background='#116530'; this.style.color='#fff'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(17,101,48,0.3)';" onmouseout="this.style.background='transparent'; this.style.color='#116530'; this.style.transform='translateY(0)'; this.style.boxShadow='0 .125rem .25rem rgba(0,0,0,.075)';">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 col-xl-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>

        <div class="col-md-9 col-xl-10">
            <div class="page-header" data-aos="fade-down">
                <h1 class="page-title">
                    Parcelles Globales
                    <span class="admin-badge">Administration</span>
                </h1>
                <p class="text-muted lead mt-2">Vue d'ensemble de toutes les parcelles enregistrées sur la plateforme.</p>
            </div>

            {# === Search & Filter Section === #}
            <div class="premium-card" data-aos="fade-up">
                <form id="filterForm" action="{{ path('admin_parcelle_index') }}" method="GET" class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="info-label mb-2">Rechercher</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                            <input type="text" name="q" class="form-control bg-light border-0" placeholder="ID, Localisation, Agriculteur..." value="{{ filters.q|default('') }}">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="info-label mb-2">Type de sol</label>
                        <select name="typeSol" class="form-select bg-light border-0">
                            <option value="">Tous les types</option>
                            <option value="Argileux" {{ filters.typeSol|default('') == 'Argileux' ? 'selected' : '' }}>Argileux</option>
                            <option value="Limoneux" {{ filters.typeSol|default('') == 'Limoneux' ? 'selected' : '' }}>Limoneux</option>
                            <option value="Sableux" {{ filters.typeSol|default('') == 'Sableux' ? 'selected' : '' }}>Sableux</option>
                            <option value="Humifère" {{ filters.typeSol|default('') == 'Humifère' ? 'selected' : '' }}>Humifère</option>
                        </select>
                    </div>
                    <div class="col-md-4 d-flex gap-2">
                        <button type="submit" class="btn btn-premium-add flex-grow-1">
                            <i class="bi bi-filter me-2"></i> Filtrer
                        </button>
                        {% if filters.q|default('') or filters.typeSol|default('') %}
                            <a href="{{ path('admin_parcelle_index') }}" class="btn btn-premium-outline">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>

            {% if parcelles.getTotalItemCount > 0 %}
                <div class="premium-table-container" data-aos="fade-up">
                    <table class="premium-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Agriculteur</th>
                                <th>Surface</th>
                                <th>Localisation</th>
                                <th>Type de Sol</th>
                                <th>Irrigation</th>
                                <th>Statut</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for parcelle in parcelles %}
                                <tr>
                                    <td class="fw-bold text-success">P-{{ parcelle.id }}</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div style="width:32px; height:32px; border-radius:50%; background:#e8f5e9; display:flex; align-items:center; justify-content:center; color:#116530; font-weight:700; font-size:.75rem; flex-shrink:0;">
                                                {{ parcelle.agriculteur.email|slice(0,1)|upper }}
                                            </div>
                                            <span>{{ parcelle.agriculteur.email }}</span>
                                        </div>
                                    </td>
                                    <td class="fw-semibold">{{ parcelle.surface }} ha</td>
                                    <td>{{ parcelle.localisation }}</td>
                                    <td><span class="type-badge">{{ parcelle.typeSol }}</span></td>
                                    <td class="text-muted">{{ parcelle.systemeIrrigation }}</td>
                                    <td>
                                        <span class="status-badge {{ parcelle.statut == 'actif' ? 'bg-success text-white' : 'bg-secondary text-white' }}">
                                            {{ parcelle.statut == 'actif' ? 'Actif' : 'Inactif' }}
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path('admin_parcelle_show', {id: parcelle.id}) }}" class="action-btn btn-view" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="mt-4" data-aos="fade-up">
                    {{ knp_pagination_render(parcelles) }}
                </div>
            {% else %}
                <div class="premium-table-container text-center py-5" data-aos="zoom-in">
                    <i class="bi bi-map" style="font-size: 3rem; color: #cce8d8;"></i>
                    <h4 class="mt-3 text-muted">Aucune parcelle enregistrée</h4>
                    <p class="text-muted">Aucun agriculteur n'a encore créé de parcelle sur la plateforme.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const filterForm = document.getElementById('filterForm');
        if (!filterForm) return;

        const inputs = filterForm.querySelectorAll('input, select');
        let timeout = null;

        inputs.forEach(input => {
            const eventType = input.tagName === 'SELECT' ? 'change' : 'input';
            
            input.addEventListener(eventType, function() {
                clearTimeout(timeout);
                const delay = input.tagName === 'SELECT' ? 0 : 600;
                
                timeout = setTimeout(() => {
                    const searchIcon = filterForm.querySelector('.bi-search');
                    if (searchIcon) {
                        searchIcon.classList.remove('bi-search');
                        searchIcon.classList.add('spinner-border', 'spinner-border-sm', 'text-success');
                    }
                    filterForm.submit();
                }, delay);
            });
        });

        const qInput = filterForm.querySelector('input[name="q"]');
        if (qInput && qInput.value) {
            qInput.focus();
            const val = qInput.value;
            qInput.value = '';
            qInput.value = val;
        }
    });
</script>
{% endblock %}
