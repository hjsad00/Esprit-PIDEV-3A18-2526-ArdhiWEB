{% extends 'base.html.twig' %}

{% block title %}Parcelles Globales - Administration Ardhi{% endblock %}

{% block stylesheets %}
<style>
    .page-header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #eee; }
    .page-title { font-family: 'Marcellus', serif; color: #116530; font-size: 2.5rem; margin: 0; }
    .admin-badge { background: rgba(17,101,48,0.1); color: #116530; font-size: 0.7rem; font-weight: 700; padding: 4px 12px; border-radius: 50px; text-transform: uppercase; letter-spacing: 1px; vertical-align: middle; margin-left: 10px; }
    .premium-table-container { background: white; border-radius: 24px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 10px 30px rgba(0,0,0,0.04); overflow: hidden; }
    .premium-table { width: 100%; border-collapse: separate; border-spacing: 0; margin-bottom: 0; }
    .premium-table thead th { background: #f8faf7; color: #116530; font-weight: 700; text-transform: uppercase; font-size: 0.72rem; letter-spacing: 1px; padding: 18px 20px; border: none; }
    .premium-table tbody td { padding: 16px 20px; vertical-align: middle; border-top: 1px solid #f0f0f0; font-size: 0.9rem; color: #4a4a4a; }
    .premium-table tbody tr:hover { background-color: #fcfdfe; }
    .status-badge { font-weight: 600; font-size: 0.72rem; padding: 5px 12px; border-radius: 50px; text-transform: uppercase; letter-spacing: 0.5px; }
    .type-badge { font-weight: 600; font-size: 0.72rem; padding: 4px 10px; border-radius: 8px; background: #e8f5e9; color: #116530; }
    .action-btn { width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s; text-decoration: none; }
    .btn-view { background: #e8f5e9; color: #116530; }
    .btn-view:hover { background: #116530; color: white; }
</style>
{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid py-5 px-lg-5">
    <div class="row">
        <div class="col-md-3 col-xl-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>

        <div class="col-md-9 col-xl-10">
            <div class="page-header" data-aos="fade-down">
                <h1 class="page-title">
                    Parcelles Globales
                    <span class="admin-badge">Administration</span>
                </h1>
                <p class="text-muted lead mt-2">Vue d'ensemble de toutes les parcelles enregistrées sur la plateforme.</p>
            </div>

            {% if parcelles.getTotalItemCount > 0 %}
                <div class="premium-table-container" data-aos="fade-up">
                    <table class="premium-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Agriculteur</th>
                                <th>Surface</th>
                                <th>Localisation</th>
                                <th>Type de Sol</th>
                                <th>Irrigation</th>
                                <th>Statut</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for parcelle in parcelles %}
                                <tr>
                                    <td class="fw-bold text-success">P-{{ parcelle.id }}</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div style="width:32px; height:32px; border-radius:50%; background:#e8f5e9; display:flex; align-items:center; justify-content:center; color:#116530; font-weight:700; font-size:.75rem; flex-shrink:0;">
                                                {{ parcelle.agriculteur.email|slice(0,1)|upper }}
                                            </div>
                                            <span>{{ parcelle.agriculteur.email }}</span>
                                        </div>
                                    </td>
                                    <td class="fw-semibold">{{ parcelle.surface }} ha</td>
                                    <td>{{ parcelle.localisation }}</td>
                                    <td><span class="type-badge">{{ parcelle.typeSol }}</span></td>
                                    <td class="text-muted">{{ parcelle.systemeIrrigation }}</td>
                                    <td>
                                        <span class="status-badge {{ parcelle.statut == 'actif' ? 'bg-success text-white' : 'bg-secondary text-white' }}">
                                            {{ parcelle.statut == 'actif' ? 'Actif' : 'Inactif' }}
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path('admin_parcelle_show', {id: parcelle.id}) }}" class="action-btn btn-view" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="mt-4" data-aos="fade-up">
                    {{ knp_pagination_render(parcelles) }}
                </div>
            {% else %}
                <div class="premium-table-container text-center py-5" data-aos="zoom-in">
                    <i class="bi bi-map" style="font-size: 3rem; color: #cce8d8;"></i>
                    <h4 class="mt-3 text-muted">Aucune parcelle enregistrée</h4>
                    <p class="text-muted">Aucun agriculteur n'a encore créé de parcelle sur la plateforme.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
