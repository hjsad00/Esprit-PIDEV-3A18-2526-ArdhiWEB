{% extends 'parcelles_cultures/admin/admin_base.html.twig' %}

{% block title %}Parcelles Globales - Administration Ardhi{% endblock %}
{% block page_title %}Parcelles Globales{% endblock %}

{% block body %}
<div class="admin-table-card">
  <div class="admin-table-header">
    <h2><i class="bi bi-map-fill me-2"></i>Parcelles Globales</h2>
  </div>

  {# === Search & Filter Section === #}
  <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
    <form id="filterForm" action="{{ path('admin_parcelle_index') }}" method="GET" class="row g-3 align-items-end">
    <div class="col-md-5">
                        <label class="form-label">Rechercher</label>
                        <input type="text" name="q" class="form-control" placeholder="ID, Localisation, Agriculteur..." value="{{ filters.q|default('') }}">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Type de sol</label>
                        <select name="typeSol" class="form-select">
                            <option value="">Tous les types</option>
                            <option value="Argileux" {{ filters.typeSol|default('') == 'Argileux' ? 'selected' : '' }}>Argileux</option>
                            <option value="Limoneux" {{ filters.typeSol|default('') == 'Limoneux' ? 'selected' : '' }}>Limoneux</option>
                            <option value="Sableux" {{ filters.typeSol|default('') == 'Sableux' ? 'selected' : '' }}>Sableux</option>
                            <option value="Humifère" {{ filters.typeSol|default('') == 'Humifère' ? 'selected' : '' }}>Humifère</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-admin w-100">
                            <i class="bi bi-filter me-1"></i> Filtrer
                        </button>
                    </div>
                    {% if filters.q|default('') or filters.typeSol|default('') %}
                        <div class="col-12">
                            <a href="{{ path('admin_parcelle_index') }}" class="btn btn-admin-outline">
                                <i class="bi bi-x-lg me-1"></i> Réinitialiser les filtres
                            </a>
                        </div>
                    {% endif %}
                </form>
            </div>

            {% if parcelles.getTotalItemCount > 0 %}
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Agriculteur</th>
                                <th>Surface</th>
                                <th>Localisation</th>
                                <th>Type de Sol</th>
                                <th>Irrigation</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for parcelle in parcelles %}
                                <tr>
                                    <td class="fw-bold">P-{{ parcelle.id }}</td>
                                    <td>{{ parcelle.agriculteur.email }}</td>
                                    <td>{{ parcelle.surface }} ha</td>
                                    <td>{{ parcelle.localisation }}</td>
                                    <td>
                                        <span class="badge badge-admin" style="background: #e8f5e9; color: #116530;">{{ parcelle.typeSol }}</span>
                                    </td>
                                    <td>{{ parcelle.systemeIrrigation }}</td>
                                    <td>
                                        {% if parcelle.statut == 'actif' %}
                                            <span class="badge bg-success badge-admin">Actif</span>
                                        {% else %}
                                            <span class="badge bg-secondary badge-admin">Inactif</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="action-btns">
                                            <a href="{{ path('admin_parcelle_show', {id: parcelle.id}) }}" class="btn btn-outline-primary btn-sm" title="Voir">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="mt-4">
                    {{ knp_pagination_render(parcelles) }}
                </div>
            {% else %}
                <div class="empty-state">
                    <i class="bi bi-map"></i>
                    <p>Aucune parcelle trouvée.</p>
                </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
{% endblock %}
