{% extends 'parcelles_cultures/admin/admin_base.html.twig' %}

{% block title %}Parcelle #{{ parcelle.id }} - Détails{% endblock %}
{% block page_title %}Parcelle #{{ parcelle.id }} - Détails{% endblock %}

{% block body %}
<div class="admin-table-card">
  <div class="admin-table-header">
    <h2><i class="bi bi-map-fill me-2"></i>Parcelle #{{ parcelle.id }}</h2>
    <a href="{{ path('admin_parcelle_index') }}" class="btn btn-admin-outline">
      <i class="bi bi-arrow-left me-1"></i>Retour
    </a>
  </div>

  <div class="row mt-4">
    <div class="col-md-6">
      <div style="background: #f8f9fa; padding: 20px; border-radius: 8px;">
        <h5 class="mb-3"><i class="bi bi-info-circle me-2"></i>Informations Générales</h5>
        <table class="table table-sm table-borderless">
          <tr>
            <th style="width: 30%;">Agriculteur:</th>
            <td>{{ parcelle.agriculteur.email }}</td>
          </tr>
          <tr>
            <th>Surface:</th>
            <td>{{ parcelle.surface }} ha</td>
          </tr>
          <tr>
            <th>Localisation:</th>
            <td>{{ parcelle.localisation }}</td>
          </tr>
          <tr>
            <th>Type de Sol:</th>
            <td><span class="badge badge-admin" style="background: #e8f5e9; color: #116530;">{{ parcelle.typeSol }}</span></td>
          </tr>
          <tr>
            <th>Système Irrigation:</th>
            <td>{{ parcelle.systemeIrrigation }}</td>
          </tr>
          <tr>
            <th>Statut:</th>
            <td>
              {% if parcelle.statut == 'actif' %}
                <span class="badge bg-success badge-admin">Actif</span>
              {% else %}
                <span class="badge bg-secondary badge-admin">Inactif</span>
              {% endif %}
            </td>
          </tr>
        </table>
      </div>
    </div>

    <div class="col-md-6">
      <div style="background: #f8f9fa; padding: 20px; border-radius: 8px;">
        <h5 class="mb-3"><i class="bi bi-geo-alt me-2"></i>Localisation GPS</h5>
        <table class="table table-sm table-borderless">
          <tr>
            <th style="width: 30%;">Latitude:</th>
            <td>{{ parcelle.latitude }}</td>
          </tr>
          <tr>
            <th>Longitude:</th>
            <td>{{ parcelle.longitude }}</td>
          </tr>
          <tr>
            <th>Créé le:</th>
            <td>{{ parcelle.createdAt|date('d/m/Y H:i') }}</td>
          </tr>
          <tr>
            <th>Modifié le:</th>
            <td>{{ parcelle.updatedAt|date('d/m/Y H:i') }}</td>
          </tr>
        </table>
      </div>
    </div>
  </div>

  <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin-top: 20px;">
    <h5 class="mb-3"><i class="bi bi-flower1 me-2"></i>Cultures associées</h5>
    {% if parcelle.cultures|length > 0 %}
      <div class="table-responsive">
        <table class="table table-hover table-sm">
          <thead style="background: #e8f5e9;">
            <tr>
              <th>ID</th>
              <th>Type</th>
              <th>Surface</th>
              <th>Rendement</th>
              <th>État</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for culture in parcelle.cultures %}
              <tr>
                <td class="fw-bold">C-{{ culture.id }}</td>
                <td><span class="badge badge-admin" style="background: #e8f5e9; color: #116530;">{{ culture.typeCulture }}</span></td>
                <td>{{ culture.surfaceUtilisee }} ha</td>
                <td>{{ culture.rendementEstime }} kg/ha</td>
                <td>
                  {% if culture.etatCulture == 'active' or culture.etatCulture == 'actif' %}
                    <span class="badge bg-success badge-admin">Actif</span>
                  {% else %}
                    <span class="badge bg-secondary badge-admin">{{ culture.etatCulture }}</span>
                  {% endif %}
                </td>
                <td>
                  <a href="{{ path('admin_culture_show', {id: culture.id}) }}" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-eye"></i>
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <div class="alert alert-info mb-0">
        <i class="bi bi-info-circle me-2"></i>Aucune culture associée
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}
