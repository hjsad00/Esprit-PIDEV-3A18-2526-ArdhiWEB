{% extends 'base.html.twig' %}

{% block title %}Parcelle #{{ parcelle.id }} - Détails{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>
        <div class="col-md-10">
            <div class="mb-4">
                <a href="{{ path('admin_parcelle_index') }}" class="btn btn-secondary mb-3">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
            </div>

            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0"><i class="fas fa-th-large"></i> Détails de la Parcelle #{{ parcelle.id }}</h3>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h5>Informations Générales</h5>
                            <table class="table table-sm">
                                <tr>
                                    <th>Agriculteur:</th>
                                    <td>{{ parcelle.agriculteur.email }}</td>
                                </tr>
                                <tr>
                                    <th>Surface:</th>
                                    <td>{{ parcelle.surface }} ha</td>
                                </tr>
                                <tr>
                                    <th>Localisation:</th>
                                    <td>{{ parcelle.localisation }}</td>
                                </tr>
                                <tr>
                                    <th>Type de Sol:</th>
                                    <td>{{ parcelle.type_sol }}</td>
                                </tr>
                                <tr>
                                    <th>Système Irrigation:</th>
                                    <td>{{ parcelle.systeme_irrigation }}</td>
                                </tr>
                                <tr>
                                    <th>Statut:</th>
                                    <td>
                                        {% if parcelle.statut == 'actif' %}
                                            <span class="badge bg-success">Actif</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Inactif</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h5>Localisation GPS</h5>
                            <table class="table table-sm">
                                <tr>
                                    <th>Latitude:</th>
                                    <td>{{ parcelle.latitude }}</td>
                                </tr>
                                <tr>
                                    <th>Longitude:</th>
                                    <td>{{ parcelle.longitude }}</td>
                                </tr>
                                <tr>
                                    <th>Créé le:</th>
                                    <td>{{ parcelle.created_at|date('d/m/Y H:i') }}</td>
                                </tr>
                                <tr>
                                    <th>Modifié le:</th>
                                    <td>{{ parcelle.updated_at|date('d/m/Y H:i') }}</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <hr>

                    <h5>Cultures associées</h5>
                    {% if parcelle.cultures|length > 0 %}
                        <div class="list-group">
                            {% for culture in parcelle.cultures %}
                                <a href="{{ path('admin_culture_show', {id: culture.id}) }}" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">{{ culture.nom_culture }}</h6>
                                        <small>{{ culture.type_culture }}</small>
                                    </div>
                                    <p class="mb-1">
                                        <strong>Surface:</strong> {{ culture.surface_utilisee }} ha | 
                                        <strong>Rendement:</strong> {{ culture.rendement_estime }} | 
                                        <strong>État:</strong> {{ culture.etat_culture }}
                                    </p>
                                    <small>
                                        Plantation: {{ culture.date_plantation|date('d/m/Y') }} - 
                                        Récolte: {{ culture.date_recolte_prevue|date('d/m/Y') }}
                                    </small>
                                </a>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">Aucune culture associée</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
