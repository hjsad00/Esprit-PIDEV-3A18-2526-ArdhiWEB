{% extends 'base.html.twig' %}

{% block title %}Calculateur ROI - Ardhi{% endblock %}

{% block stylesheets %}
    <style>
        .page-header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #eee; }
        .page-title { font-family: 'Marcellus', serif; color: #116530; font-size: 2.5rem; margin: 0; }
        .premium-card { background: white; border-radius: 24px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 10px 30px rgba(0,0,0,0.04); padding: 30px; margin-bottom: 25px; }
        .form-label { font-weight: 600; color: #2d3436; margin-bottom: 8px; font-size: 0.9rem; }
        .form-input { border-radius: 12px; padding: 12px 15px; border: 1px solid #eee; transition: all 0.3s; width: 100%; }
        .form-input:focus { border-color: #116530; box-shadow: 0 0 0 4px rgba(17, 101, 48, 0.05); outline: none; }
        .btn-calculate { background: #116530; color: white; border-radius: 50px; padding: 12px 35px; border: none; cursor: pointer; font-weight: 700; }
        .btn-calculate:hover { background: #1e8341; }
        
        .result-section { background: linear-gradient(135deg, #e8f5e9, #f0f5ed); border-radius: 12px; padding: 25px; margin-top: 25px; }
        .roi-score { font-size: 3rem; font-weight: 700; color: #116530; text-align: center; }
        .roi-label { text-align: center; color: #636e72; font-weight: 600; margin-bottom: 20px; }
        
        .metric-box { background: white; border-radius: 12px; padding: 20px; margin: 15px 0; border-left: 4px solid #116530; }
        .metric-label { font-weight: 600; color: #2d3436; font-size: 0.9rem; }
        .metric-value { font-size: 2rem; font-weight: 700; color: #116530; margin-top: 8px; }
        
        .slider-container { margin: 20px 0; }
        .slider { width: 100%; height: 8px; border-radius: 5px; background: #ddd; outline: none; -webkit-appearance: none; }
        .slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 25px; height: 25px; border-radius: 50%; background: #116530; cursor: pointer; }
        .slider::-moz-range-thumb { width: 25px; height: 25px; border-radius: 50%; background: #116530; cursor: pointer; border: none; }
        
        .cost-input-group { margin: 12px 0; display: flex; align-items: center; }
        .cost-input-group label { flex: 1; font-weight: 600; color: #2d3436; }
        .cost-input-group input { flex: 2; padding: 8px 12px; border-radius: 8px; border: 1px solid #eee; font-size: 0.9rem; }
        
        .hidden { display: none; }
        .loader { display: inline-block; width: 20px; height: 20px; border: 3px solid rgba(17, 101, 48, .3); border-radius: 50%; border-top-color: #116530; animation: spin 1s ease-in-out infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid py-5 px-lg-5">
    <div class="row">
        <div class="col-md-3 col-xl-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>

        <div class="col-md-9 col-xl-10">
            <div class="page-header">
                <h1 class="page-title">💰 Calculateur ROI & Rentabilité</h1>
                <p class="text-muted lead mt-2">Analysez la rentabilité de vos cultures avec les données climatiques.</p>
            </div>

            <div class="premium-card">
                <h3 class="mb-4"><i class="bi bi-bar-chart-fill"></i> Sélectionnez une culture</h3>
                <div class="row g-3">
                    <div class="col-md-12">
                        <label for="culture-select" class="form-label">Culture</label>
                        <select id="culture-select" class="form-input" style="padding: 10px; border: 1px solid #eee; border-radius: 12px;">
                            <option value="">-- Choisir une culture --</option>
                            {% for culture in cultures %}
                                <option value="{{ culture.id }}">
                                    {{ culture.nomCulture }} ({{ culture.surfaceUtilisee }} ha)
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>

            <!-- Costs Section -->
            <div class="premium-card">
                <h3 class="mb-4"><i class="bi bi-coin"></i> Estimation des Coûts</h3>
                
                <div class="cost-input-group">
                    <label>Semences & Plantations</label>
                    <input type="number" class="cost-input" data-cost="seeds" value="0" placeholder="€">
                </div>

                <div class="cost-input-group">
                    <label>Engrais & Amendements</label>
                    <input type="number" class="cost-input" data-cost="fertilizer" value="0" placeholder="€">
                </div>

                <div class="cost-input-group">
                    <label>Main-d'œuvre</label>
                    <input type="number" class="cost-input" data-cost="labor" value="0" placeholder="€">
                </div>

                <div class="cost-input-group">
                    <label>Irrigation</label>
                    <input type="number" class="cost-input" data-cost="irrigation" value="0" placeholder="€">
                </div>

                <div class="cost-input-group">
                    <label>Autres charges</label>
                    <input type="number" class="cost-input" data-cost="other" value="0" placeholder="€">
                </div>

                <hr style="margin: 20px 0;">

                <div class="cost-input-group" style="font-weight: 700; font-size: 1.1rem;">
                    <label>Coût Total Estimé:</label>
                    <span id="total-cost" style="font-size: 1.5rem; color: #116530;">€0.00</span>
                </div>
            </div>

            <!-- Price Section -->
            <div class="premium-card">
                <h3 class="mb-4"><i class="bi bi-tag-fill"></i> Prix de Vente</h3>
                
                <label class="form-label">Prix unitaire (€/t)</label>
                <div class="slider-container">
                    <input type="range" id="price-slider" class="slider" min="0" max="1000" value="500" step="10">
                </div>

                <div style="display: flex; justify-content: space-between; font-weight: 600; color: #636e72;">
                    <span>0 €</span>
                    <span id="price-display">500 €/t</span>
                    <span>1000 €</span>
                </div>
            </div>

            <!-- Calculate Button -->
            <div style="text-align: center; margin: 25px 0;">
                <button id="calculate-roi-btn" class="btn-calculate btn-lg">
                    <i class="bi bi-calculator-fill"></i> Calculer le ROI
                </button>
            </div>

            <!-- Loading -->
            <div id="loading" class="hidden" style="text-align: center; padding: 40px;">
                <div class="loader" style="margin: 0 auto margin-bottom: 15px;"></div>
                <p style="color: #116530; font-weight: 600;">Calcul en cours...</p>
            </div>

            <!-- Results -->
            <div id="results" class="hidden">
                <div class="result-section">
                    <div class="roi-label">Score ROI</div>
                    <div class="roi-score" id="roi-percentage">0%</div>
                    <div style="text-align: center; color: #636e72; margin-top: 10px;">
                        Le retour sur investissement vous indique la rentabilité relative de vos coûts.
                    </div>
                </div>

                <div class="metric-box">
                    <div class="metric-label">Production Estimée (ajustée climat)</div>
                    <div class="metric-value" id="production">0 t</div>
                </div>

                <div class="metric-box">
                    <div class="metric-label">Revenu Brut</div>
                    <div class="metric-value" id="revenue" style="color: #28a745;">€ 0.00</div>
                </div>

                <div class="metric-box">
                    <div class="metric-label">Coûts Totaux</div>
                    <div class="metric-value" id="total-costs-result" style="color: #dc3545;">€ 0.00</div>
                </div>

                <div class="metric-box" style="border-left-color: #116530; background: #e8f5e9;">
                    <div class="metric-label">Marge Nette</div>
                    <div class="metric-value" id="profit" style="font-size: 2.5rem;">€ 0.00</div>
                </div>

                <!-- Credit Capacity -->
                <div class="premium-card mt-4">
                    <h4 class="mb-3"><i class="bi bi-bank"></i> Capacité de Financement Bancaire</h4>
                    <div class="metric-box">
                        <div class="metric-label">Capacité de Remboursement (60% marge)</div>
                        <div class="metric-value" id="repayment-capacity">€ 0.00</div>
                    </div>
                    <div class="metric-box">
                        <div class="metric-label">Montant Prêt Maximum (5 ans)</div>
                        <div class="metric-value" style="color: #116530;">€ <span id="max-loan">0.00</span></div>
                    </div>
                </div>
            </div>

            <!-- Error -->
            <div id="error-message" class="hidden alert alert-danger mt-4"></div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const priceSlider = document.getElementById('price-slider');
    const priceDisplay = document.getElementById('price-display');
    const costInputs = document.querySelectorAll('.cost-input');
    const totalCostDisplay = document.getElementById('total-cost');
    const calculateBtn = document.getElementById('calculate-roi-btn');
    const cultureSelect = document.getElementById('culture-select');
    const loading = document.getElementById('loading');
    const results = document.getElementById('results');
    const errorDiv = document.getElementById('error-message');

    // Update price display
    priceSlider.addEventListener('input', function() {
        priceDisplay.textContent = this.value + ' €/t';
    });

    // Update total cost
    function updateTotalCost() {
        let total = 0;
        costInputs.forEach(input => {
            total += parseFloat(input.value) || 0;
        });
        totalCostDisplay.textContent = '€' + total.toFixed(2);
        return total;
    }

    costInputs.forEach(input => {
        input.addEventListener('change', updateTotalCost);
        input.addEventListener('input', updateTotalCost);
    });

    // Calculate ROI
    calculateBtn.addEventListener('click', function(e) {
        e.preventDefault();

        if (!cultureSelect.value) {
            alert('Veuillez sélectionner une culture');
            return;
        }

        const costs = {
            seeds: parseFloat(document.querySelector('[data-cost="seeds"]').value) || 0,
            fertilizer: parseFloat(document.querySelector('[data-cost="fertilizer"]').value) || 0,
            labor: parseFloat(document.querySelector('[data-cost="labor"]').value) || 0,
            irrigation: parseFloat(document.querySelector('[data-cost="irrigation"]').value) || 0,
            other: parseFloat(document.querySelector('[data-cost="other"]').value) || 0,
        };

        loading.classList.remove('hidden');
        results.classList.add('hidden');
        errorDiv.classList.add('hidden');

        fetch('/farmer/recommendations/api/roi', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                cultureId: parseInt(cultureSelect.value),
                costs: costs,
                salePrice: parseFloat(priceSlider.value)
            })
        })
        .then(response => response.json())
        .then(data => {
            loading.classList.add('hidden');

            if (data.error) {
                errorDiv.textContent = 'Erreur: ' + data.error;
                errorDiv.classList.remove('hidden');
                return;
            }

            displayResults(data);
        })
        .catch(err => {
            loading.classList.add('hidden');
            errorDiv.textContent = 'Erreur réseau: ' + err.message;
            errorDiv.classList.remove('hidden');
        });
    });

    function displayResults(data) {
        document.getElementById('production').textContent = (data.production || 0).toFixed(2) + ' t';
        document.getElementById('revenue').textContent = '€ ' + (data.revenue || 0).toFixed(2);
        document.getElementById('total-costs-result').textContent = '€ ' + (data.total_costs || 0).toFixed(2);
        document.getElementById('profit').textContent = '€ ' + (data.profit || 0).toFixed(2);
        document.getElementById('roi-percentage').textContent = (data.roi_percentage || 0).toFixed(1) + '%';
        document.getElementById('repayment-capacity').textContent = '€ ' + (data.repayment_capacity || 0).toFixed(2);
        document.getElementById('max-loan').textContent = (data.max_loan || 0).toFixed(2);

        results.classList.remove('hidden');
    }
});
</script>
{% endblock %}
