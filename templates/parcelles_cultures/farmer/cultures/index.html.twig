{% extends 'base.html.twig' %}

{% block title %}Mes Cultures - Ardhi{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #eee;
        }
        .page-title {
            font-family: 'Marcellus', serif;
            color: #116530;
            font-size: 2.2rem;
            margin: 0;
        }
        .btn-add {
            background: #116530;
            color: white;
            border-radius: 50px;
            padding: 10px 25px;
            font-weight: 600;
            border: none;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(17, 101, 48, 0.2);
        }
        .btn-add:hover {
            background: #1e8341;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(17, 101, 48, 0.3);
        }
        .culture-card {
            background: white;
            border-radius: 20px;
            border: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 5px 15px rgba(0,0,0,0.03);
            transition: all 0.3s ease;
            overflow: hidden;
            height: 100%;
        }
        .culture-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
            border-color: rgba(17, 101, 48, 0.1);
        }
        .culture-header {
            padding: 20px;
            background: #f8faf7;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .culture-name {
            font-weight: 800;
            color: #116530;
            font-size: 1.1rem;
            margin: 0;
        }
        .culture-body {
            padding: 25px;
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }
        .info-item {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        .info-label {
            font-size: 11px;
            font-weight: 700;
            color: #b2bec3;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .info-value {
            font-size: 14px;
            font-weight: 600;
            color: #2d3436;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .info-value i {
            color: #116530;
            font-size: 1.1rem;
        }
        .culture-footer {
            padding: 20px;
            background: #fff;
            border-top: 1px solid #f8faf7;
            display: flex;
            gap: 10px;
        }
        .btn-action {
            flex: 1;
            padding: 8px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            text-align: center;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .btn-view { background: #f0f7ee; color: #116530; }
        .btn-view:hover { background: #116530; color: white; }
        .btn-edit { background: #fffcf0; color: #d4a017; }
        .btn-edit:hover { background: #d4a017; color: white; }
        .btn-delete { background: #fff5f5; color: #e74c3c; border: none; }
        .btn-delete:hover { background: #e74c3c; color: white; }
        
        .status-badge {
            font-size: 10px;
            padding: 4px 10px;
            text-transform: uppercase;
            font-weight: 700;
        }
    </style>
{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid py-5 px-lg-5">
    <div class="row">
        <div class="col-md-3 col-xl-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>
        
        <div class="col-md-9 col-xl-10">
            <div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" data-aos="fade-down">
                <div>
                    <h1 class="page-title">Mes Cultures</h1>
                    <p class="text-muted mb-0">Suivez l'évolution et les rendements de vos plantations.</p>
                </div>
                <a href="{{ path('farmer_culture_new') }}" class="btn btn-add">
                    <i class="bi bi-plus-lg me-2"></i> Nouvelle Culture
                </a>
            </div>

            {% if cultures.getTotalItemCount > 0 %}
                <div class="row g-4">
                    {% for culture in cultures %}
                        <div class="col-md-6 col-lg-6 col-xl-4" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 100 }}">
                            <div class="culture-card">
                                <div class="culture-header">
                                    <h3 class="culture-name">{{ culture.typeCulture|replace({'_': ' '})|capitalize }}</h3>
                                    <span class="badge rounded-pill status-badge 
                                        {{ culture.etatCulture == 'active' ? 'bg-success' : 'bg-warning' }}">
                                        {{ culture.etatCulture }}
                                    </span>
                                </div>
                                <div class="culture-body">
                                    <div class="mb-3 p-2 bg-light rounded-3 d-flex align-items-center gap-2">
                                        <i class="bi bi-geo-alt text-success"></i>
                                        <span class="small fw-bold">Parcelle : </span>
                                        <a href="{{ path('farmer_parcelle_show', {id: culture.parcelle.id}) }}" class="small link-success text-decoration-none">
                                            #{{ culture.parcelle.id }} - {{ culture.parcelle.localisation }}
                                        </a>
                                    </div>
                                    <div class="info-grid">
                                        <div class="info-item">
                                            <span class="info-label">Saison</span>
                                            <span class="info-value"><i class="bi bi-calendar3"></i> {{ culture.saison|capitalize }}</span>
                                        </div>
                                        <div class="info-item">
                                            <span class="info-label">Surface</span>
                                            <span class="info-value"><i class="bi bi-aspect-ratio"></i> {{ culture.surfaceUtilisee }} ha</span>
                                        </div>
                                        <div class="info-item">
                                            <span class="info-label">Rendement</span>
                                            <span class="info-value"><i class="bi bi-speedometer2"></i> {{ culture.rendementEstime }} u/ha</span>
                                        </div>
                                        <div class="info-item col-span-2">
                                            <span class="info-label">Production Estimée</span>
                                            <span class="info-value text-success fs-5">
                                                <i class="bi bi-bar-chart-fill"></i> {{ culture.productionEstimee|round(2) }} t
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="culture-footer">
                                    <a href="{{ path('farmer_culture_show', {id: culture.id}) }}" class="btn-action btn-view">
                                        <i class="bi bi-eye"></i> Voir
                                    </a>
                                    <a href="{{ path('farmer_culture_edit', {id: culture.id}) }}" class="btn-action btn-edit">
                                        <i class="bi bi-pencil"></i> Modif.
                                    </a>
                                    <form method="POST" action="{{ path('farmer_culture_delete', {id: culture.id}) }}" class="flex-grow-1" 
                                          onsubmit="return confirm('Confirmer la suppression ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ culture.id) }}">
                                        <button type="submit" class="btn-action btn-delete w-100">
                                            <i class="bi bi-trash"></i> Suppr.
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {# Pagination #}
                <div class="mt-5 d-flex justify-content-center" data-aos="fade-up">
                    {{ knp_pagination_render(cultures) }}
                </div>
            {% else %}
                <div class="text-center py-5 bg-white rounded-4 shadow-sm" data-aos="zoom-in">
                    <i class="bi bi-flower1 text-muted" style="font-size: 4rem; opacity: 0.3;"></i>
                    <h3 class="mt-3">Aucune culture trouvée</h3>
                    <p class="text-muted">Commencez par planifier votre première culture sur l'une de vos parcelles.</p>
                    <a href="{{ path('farmer_culture_new') }}" class="btn btn-add mt-2">Planifier une culture</a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
