{% extends 'base.html.twig' %}

{% block title %}Mes Cultures{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>
        <div class="col-md-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1><i class="fas fa-leaf"></i> Mes Cultures</h1>
                <a href="{{ path('farmer_culture_new') }}" class="btn btn-success">
                    <i class="fas fa-plus"></i> Nouvelle Culture
                </a>
            </div>

            {% if cultures.getTotalItemCount > 0 %}
                <div class="row">
                    {% for culture in cultures %}
                        <div class="col-md-6 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-header bg-success text-white">
                                    <h5 class="card-title mb-0">{{ culture.nom_culture }}</h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-2">
                                        <strong>Parcelle:</strong> 
                                        <a href="{{ path('farmer_parcelle_show', {id: culture.parcelle.id}) }}">
                                            #{{ culture.parcelle.id }}
                                        </a>
                                    </div>
                                    <table class="table table-sm">
                                        <tr>
                                            <th>Type:</th>
                                            <td>{{ culture.type_culture }}</td>
                                        </tr>
                                        <tr>
                                            <th>Saison:</th>
                                            <td>{{ culture.saison }}</td>
                                        </tr>
                                        <tr>
                                            <th>Surface:</th>
                                            <td>{{ culture.surface_utilisee }} ha</td>
                                        </tr>
                                        <tr>
                                            <th>Rendement:</th>
                                            <td>{{ culture.rendement_estime }}</td>
                                        </tr>
                                        <tr>
                                            <th>Production Est.:</th>
                                            <td class="fw-bold text-success">{{ culture.production_estimee|round(2) }}</td>
                                        </tr>
                                        <tr>
                                            <th>État:</th>
                                            <td><span class="badge bg-info">{{ culture.etat_culture }}</span></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="card-footer bg-light">
                                    <a href="{{ path('farmer_culture_show', {id: culture.id}) }}" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i> Voir
                                    </a>
                                    <a href="{{ path('farmer_culture_edit', {id: culture.id}) }}" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i> Modifier
                                    </a>
                                    <form method="POST" action="{{ path('farmer_culture_delete', {id: culture.id}) }}" style="display:inline;" 
                                          onsubmit="return confirm('Confirmer la suppression?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ culture.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i> Supprimer
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {# Pagination #}
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        {% if cultures.hasPreviousPage %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('farmer_culture_index', {'page': cultures.previousPage}) }}">Précédent</a>
                            </li>
                        {% endif %}

                        {% for page in cultures.paginationData.pages %}
                            {% if page == cultures.currentPage %}
                                <li class="page-item active"><span class="page-link">{{ page }}</span></li>
                            {% else %}
                                <li class="page-item"><a class="page-link" href="{{ path('farmer_culture_index', {'page': page}) }}">{{ page }}</a></li>
                            {% endif %}
                        {% endfor %}

                        {% if cultures.hasNextPage %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('farmer_culture_index', {'page': cultures.nextPage}) }}">Suivant</a>
                            </li>
                        {% endif %}
                    </ul>
                </nav>
            {% else %}
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i> Vous n'avez pas encore créé de culture. 
                    <a href="{{ path('farmer_culture_new') }}">Commencez par créer une parcelle, puis une culture</a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
