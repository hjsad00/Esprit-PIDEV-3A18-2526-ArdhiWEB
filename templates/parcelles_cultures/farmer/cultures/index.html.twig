{% extends 'base.html.twig' %}

{% block title %}Mes Cultures - Ardhi{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #eee;
        }
        .page-title {
            font-family: 'Marcellus', serif;
            color: #116530;
            font-size: 2.2rem;
            margin: 0;
        }
        .btn-premium-add {
            background: #116530;
            color: white;
            border-radius: 12px;
            padding: 10px 24px;
            font-weight: 700;
            border: none;
            transition: all 0.3s;
            box-shadow: 0 5px 15px rgba(17,101,48,0.15);
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
        }
        .btn-premium-add:hover {
            background: #1e8341;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(17,101,48,0.25);
        }
        .btn-premium-outline {
            background: white;
            color: #116530;
            border: 2px solid #116530;
            border-radius: 12px;
            padding: 8px 22px;
            font-weight: 700;
            transition: all 0.3s;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
        }
        .btn-premium-outline:hover {
            background: #f0f7ee;
            color: #116530;
            border-color: #116530;
            transform: translateY(-2px);
        }
        .premium-card {
            background: white;
            border-radius: 24px;
            border: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 10px 30px rgba(0,0,0,0.04);
            padding: 25px;
        }
        .culture-card {
            background: white;
            border-radius: 20px;
            border: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 5px 15px rgba(0,0,0,0.03);
            transition: all 0.3s ease;
            overflow: hidden;
            height: 100%;
        }
        .culture-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
            border-color: rgba(17, 101, 48, 0.1);
        }
        .culture-header {
            padding: 20px;
            background: #f8faf7;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .culture-name {
            font-weight: 800;
            color: #116530;
            font-size: 1.1rem;
            margin: 0;
        }
        .culture-body {
            padding: 25px;
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }
        .info-item {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        .info-label {
            font-size: 11px;
            font-weight: 700;
            color: #b2bec3;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .info-value {
            font-size: 14px;
            font-weight: 600;
            color: #2d3436;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .info-value i {
            color: #116530;
            font-size: 1.1rem;
        }
        .culture-footer {
            padding: 20px;
            background: #fff;
            border-top: 1px solid #f8faf7;
            display: flex;
            gap: 10px;
        }
        .btn-action {
            flex: 1;
            padding: 8px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            text-align: center;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .btn-view { background: #f0f7ee; color: #116530; }
        .btn-view:hover { background: #116530; color: white; }
        .btn-edit { background: #fffcf0; color: #d4a017; }
        .btn-edit:hover { background: #d4a017; color: white; }
        .btn-delete { background: #fff5f5; color: #e74c3c; border: none; }
        .btn-delete:hover { background: #e74c3c; color: white; }
        
        .status-badge {
            font-size: 10px;
            padding: 4px 10px;
            text-transform: uppercase;
            font-weight: 700;
        }
    </style>
{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid py-5 px-lg-5">
    <div class="row">
        <div class="col-md-3 col-xl-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>
        
        <div class="col-md-9 col-xl-10">
            <div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" data-aos="fade-down">
                <div>
                    <h1 class="page-title">Mes Cultures</h1>
                    <p class="text-muted mb-0">Suivez l'évolution et les rendements de vos plantations.</p>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <a href="{{ path('farmer_stats_index') }}" class="btn btn-premium-outline">
                        <i class="bi bi-graph-up me-2"></i> Statistiques
                    </a>
                    <a href="{{ path('farmer_culture_new') }}" class="btn btn-premium-add">
                        <i class="bi bi-plus-lg me-2"></i> Nouvelle Culture
                    </a>
                </div>
            </div>

            {# === Search & Filter Section === #}
            <div class="premium-card mb-4" data-aos="fade-up">
                <form id="filterForm" action="{{ path('farmer_culture_index') }}" method="GET" class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="info-label mb-2">Rechercher</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                            <input type="text" name="q" class="form-control bg-light border-0" placeholder="ID, Type, Saison, Parcelle..." value="{{ filters.q|default('') }}">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="info-label mb-2">Type</label>
                        <select name="typeCulture" class="form-select bg-light border-0">
                            <option value="">Tous</option>
                            <option value="Blé" {{ filters.typeCulture|default('') == 'Blé' ? 'selected' : '' }}>Blé</option>
                            <option value="Orge" {{ filters.typeCulture|default('') == 'Orge' ? 'selected' : '' }}>Orge</option>
                            <option value="Maïs" {{ filters.typeCulture|default('') == 'Maïs' ? 'selected' : '' }}>Maïs</option>
                            <option value="Olive" {{ filters.typeCulture|default('') == 'Olive' ? 'selected' : '' }}>Olive</option>
                            <option value="Tomate" {{ filters.typeCulture|default('') == 'Tomate' ? 'selected' : '' }}>Tomate</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="info-label mb-2">Saison</label>
                        <select name="saison" class="form-select bg-light border-0">
                            <option value="">Toutes</option>
                            <option value="Printemps" {{ filters.saison|default('') == 'Printemps' ? 'selected' : '' }}>Printemps</option>
                            <option value="Été" {{ filters.saison|default('') == 'Été' ? 'selected' : '' }}>Été</option>
                            <option value="Automne" {{ filters.saison|default('') == 'Automne' ? 'selected' : '' }}>Automne</option>
                            <option value="Hiver" {{ filters.saison|default('') == 'Hiver' ? 'selected' : '' }}>Hiver</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        {% if filters.q|default('') or filters.typeCulture|default('') or filters.saison|default('') %}
                            <a href="{{ path('farmer_culture_index') }}" class="btn btn-premium-outline w-100" title="Réinitialiser">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>

            {# === Summary Stats Section === #}
            <div class="row g-4 mb-5" data-aos="fade-up">
                <div class="col-6 col-md-4">
                    <div class="culture-card p-4 text-center border-0" style="background: linear-gradient(135deg, #f8faf7, #ffffff);">
                        <div class="text-success fs-2 mb-1 fw-black">{{ summary.count|default(0) }}</div>
                        <div class="text-muted text-uppercase small fw-bold">Cultures Total</div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="culture-card p-4 text-center border-0" style="background: linear-gradient(135deg, #f8faf7, #ffffff);">
                        <div class="text-success fs-2 mb-1 fw-black">{{ summary.surface|default(0)|round(1) }} ha</div>
                        <div class="text-muted text-uppercase small fw-bold">Surface Occupée</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="culture-card p-4 text-center border-0" style="background: linear-gradient(135deg, #116530, #1e8341); color: white;">
                        <div class="fs-2 mb-1 fw-black">{{ summary.production|default(0)|round(0)|number_format(0, '.', ' ') }} kg</div>
                        <div class="opacity-75 text-uppercase small fw-bold">Production Totale Est.</div>
                    </div>
                </div>
            </div>

            <div id="cultureListContainer">
                {% include 'parcelles_cultures/farmer/cultures/_list.html.twig' %}
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const filterForm = document.getElementById('filterForm');
        const container = document.getElementById('cultureListContainer');
        if (!filterForm || !container) return;

        const inputs = filterForm.querySelectorAll('input, select');
        let timeout = null;

        const updateList = () => {
            const formData = new FormData(filterForm);
            const params = new URLSearchParams(formData);
            const url = `${filterForm.action}?${params.toString()}`;

            container.style.opacity = '0.5';
            container.style.pointerEvents = 'none';

            fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.text())
            .then(html => {
                container.innerHTML = html;
                container.style.opacity = '1';
                container.style.pointerEvents = 'auto';
                
                if (typeof AOS !== 'undefined') {
                    AOS.refresh();
                }

                window.history.pushState({}, '', url);
            });
        };

        inputs.forEach(input => {
            const eventType = input.tagName === 'SELECT' ? 'change' : 'input';
            
            input.addEventListener(eventType, function() {
                clearTimeout(timeout);
                timeout = setTimeout(updateList, 500);
            });
        });

        filterForm.addEventListener('submit', function(e) {
            e.preventDefault();
            updateList();
        });
    });
</script>
{% endblock %}
