{% extends 'base.html.twig' %}

{% block title %}Mes Parcelles - Ardhi{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #eee;
        }
        .page-title {
            font-family: 'Marcellus', serif;
            color: #116530;
            font-size: 2.2rem;
            margin: 0;
        }
        .btn-premium-add {
            background: #116530;
            color: white;
            border-radius: 12px;
            padding: 10px 24px;
            font-weight: 700;
            border: none;
            transition: all 0.3s;
            box-shadow: 0 5px 15px rgba(17,101,48,0.15);
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
        }
        .btn-premium-add:hover {
            background: #1e8341;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(17,101,48,0.25);
        }
        .btn-premium-outline {
            background: white;
            color: #116530;
            border: 2px solid #116530;
            border-radius: 12px;
            padding: 8px 22px;
            font-weight: 700;
            transition: all 0.3s;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
        }
        .btn-premium-outline:hover {
            background: #f0f7ee;
            color: #116530;
            border-color: #116530;
            transform: translateY(-2px);
        }
        .premium-card {
            background: white;
            border-radius: 24px;
            border: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 10px 30px rgba(0,0,0,0.04);
            padding: 25px;
        }
        .parcel-card {
            background: white;
            border-radius: 20px;
            border: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 5px 15px rgba(0,0,0,0.03);
            transition: all 0.3s ease;
            overflow: hidden;
            height: 100%;
        }
        .parcel-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
            border-color: rgba(17, 101, 48, 0.1);
        }
        .parcel-header {
            padding: 20px;
            background: #f8faf7;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .parcel-id {
            font-weight: 800;
            color: #116530;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .parcel-body {
            padding: 25px;
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }
        .info-item {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        .info-label {
            font-size: 11px;
            font-weight: 700;
            color: #b2bec3;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .info-value {
            font-size: 14px;
            font-weight: 600;
            color: #2d3436;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .info-value i {
            color: #116530;
            font-size: 1.1rem;
        }
        .parcel-footer {
            padding: 20px;
            background: #fff;
            border-top: 1px solid #f8faf7;
            display: flex;
            gap: 10px;
        }
        .btn-action {
            flex: 1;
            padding: 8px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            text-align: center;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .btn-view { background: #f0f7ee; color: #116530; }
        .btn-view:hover { background: #116530; color: white; }
        .btn-edit { background: #fffcf0; color: #d4a017; }
        .btn-edit:hover { background: #d4a017; color: white; }
        .btn-delete { background: #fff5f5; color: #e74c3c; border: none; }
        .btn-delete:hover { background: #e74c3c; color: white; }
    </style>
{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid py-5 px-lg-5">
    <div class="row">
        <div class="col-md-3 col-xl-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>
        
        <div class="col-md-9 col-xl-10">
            <div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" data-aos="fade-down">
                <div>
                    <h1 class="page-title">Mes Parcelles</h1>
                    <p class="text-muted mb-0">Visualisez et gérez l'ensemble de vos terrains agricoles.</p>
                </div>
                <a href="{{ path('farmer_parcelle_new') }}" class="btn btn-premium-add">
                    <i class="bi bi-plus-lg me-2"></i> Nouvelle Parcelle
                </a>
            </div>

            {# === Search & Filter Section === #}
            <div class="premium-card mb-4" data-aos="fade-up">
                <form id="filterForm" action="{{ path('farmer_parcelle_index') }}" method="GET" class="row g-3 align-items-end">
                    <div class="col-md-7">
                        <label class="info-label mb-2">Rechercher</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                            <input type="text" name="q" class="form-control bg-light border-0" placeholder="ID, Localisation, Type..." value="{{ filters.q|default('') }}">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="info-label mb-2">Type de sol</label>
                        <select name="typeSol" class="form-select bg-light border-0">
                            <option value="">Tous les types</option>
                            <option value="Argileux" {{ filters.typeSol|default('') == 'Argileux' ? 'selected' : '' }}>Argileux</option>
                            <option value="Limoneux" {{ filters.typeSol|default('') == 'Limoneux' ? 'selected' : '' }}>Limoneux</option>
                            <option value="Sableux" {{ filters.typeSol|default('') == 'Sableux' ? 'selected' : '' }}>Sableux</option>
                            <option value="Humifère" {{ filters.typeSol|default('') == 'Humifère' ? 'selected' : '' }}>Humifère</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        {% if filters.q|default('') or filters.typeSol|default('') %}
                            <a href="{{ path('farmer_parcelle_index') }}" class="btn btn-premium-outline w-100" title="Réinitialiser">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>

            <div id="parcelListContainer">
                {% include 'parcelles_cultures/farmer/parcelles/_list.html.twig' %}
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const filterForm = document.getElementById('filterForm');
        const container = document.getElementById('parcelListContainer');
        if (!filterForm || !container) return;

        const inputs = filterForm.querySelectorAll('input, select');
        let timeout = null;

        const updateList = () => {
            const formData = new FormData(filterForm);
            const params = new URLSearchParams(formData);
            const url = `${filterForm.action}?${params.toString()}`;

            // Add visual feedback
            container.style.opacity = '0.5';
            container.style.pointerEvents = 'none';

            fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.text())
            .then(html => {
                container.innerHTML = html;
                container.style.opacity = '1';
                container.style.pointerEvents = 'auto';
                
                // Re-init AOS if used for the new content
                if (typeof AOS !== 'undefined') {
                    AOS.refresh();
                }

                // Update URL in browser without reload
                window.history.pushState({}, '', url);
            });
        };

        inputs.forEach(input => {
            const eventType = input.tagName === 'SELECT' ? 'change' : 'input';
            
            input.addEventListener(eventType, function() {
                clearTimeout(timeout);
                timeout = setTimeout(updateList, 500);
            });
        });

        filterForm.addEventListener('submit', function(e) {
            e.preventDefault();
            updateList();
        });
    });
</script>
{% endblock %}
