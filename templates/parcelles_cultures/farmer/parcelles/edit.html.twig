{% extends 'base.html.twig' %}

{% block title %}Modifier Parcelle #{{ parcelle.id }} - Ardhi{% endblock %}

{% block stylesheets %}
    <style>
        .page-header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #eee; }
        .page-title { font-family: 'Marcellus', serif; color: #116530; font-size: 2.5rem; margin: 0; }
        .premium-card { background: white; border-radius: 24px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 10px 30px rgba(0,0,0,0.04); padding: 30px; margin-bottom: 25px; }
        .card-label { font-size: 12px; font-weight: 700; color: #116530; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 25px; display: flex; align-items: center; gap: 10px; }
        .form-control { border-radius: 12px; padding: 12px 15px; border: 1px solid #eee; transition: all 0.3s; }
        .form-control:focus { border-color: #116530; box-shadow: 0 0 0 4px rgba(17, 101, 48, 0.05); }
        .form-label { font-weight: 600; color: #2d3436; margin-bottom: 8px; font-size: 0.9rem; }
        .btn-save { background: #116530; color: white; border-radius: 50px; padding: 12px 35px; font-weight: 700; border: none; transition: all 0.3s ease; box-shadow: 0 8px 20px rgba(17, 101, 48, 0.2); display: inline-flex; align-items: center; gap: 10px; }
        .btn-save:hover { background: #1e8341; color: white; transform: translateY(-2px); }
        .btn-cancel-link { color: #636e72; background: #f0f0f0; border-radius: 50px; padding: 12px 25px; font-weight: 600; text-decoration: none; transition: all 0.3s; }
        .btn-cancel-link:hover { background: #dfe6e9; color: #2d3436; }
        .btn-premium-back { color: #116530; background: #e8f5e9; border-radius: 50px; padding: 10px 20px; font-weight: 600; text-decoration: none; transition: all 0.3s; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 20px; }
        .btn-premium-back:hover { background: #116530; color: white; }
    </style>
{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid py-5 px-lg-5">
    <div class="row">
        <div class="col-md-3 col-xl-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>

        <div class="col-md-9 col-xl-10">
            <div data-aos="fade-right">
                <a href="{{ path('farmer_parcelle_show', {id: parcelle.id}) }}" class="btn-premium-back">
                    <i class="bi bi-arrow-left"></i> Retour aux détails
                </a>
            </div>

            <div class="page-header" data-aos="fade-down">
                <h1 class="page-title">Modifier Parcelle #{{ parcelle.id }}</h1>
                <p class="text-muted lead mt-2">Mettez à jour les informations de votre terrain.</p>
            </div>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'data-aos': 'fade-up'}}) }}

            <div class="premium-card">
                <span class="card-label"><i class="bi bi-geo-alt-fill"></i> Identification & Localisation</span>
                <div class="row g-4">
                    <div class="col-md-6">
                        {{ form_label(form.surface) }}
                        {{ form_widget(form.surface, {'attr': {'class': 'form-control'}}) }}
                        {% if form.surface.vars.errors|length > 0 %}<div class="invalid-feedback d-block">{{ form_errors(form.surface) }}</div>{% endif %}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.localisation) }}
                        {{ form_widget(form.localisation, {'attr': {'class': 'form-control'}}) }}
                        {% if form.localisation.vars.errors|length > 0 %}<div class="invalid-feedback d-block">{{ form_errors(form.localisation) }}</div>{% endif %}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.type_sol) }}
                        {{ form_widget(form.type_sol, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.systeme_irrigation) }}
                        {{ form_widget(form.systeme_irrigation, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            </div>

            <div class="premium-card">
                <span class="card-label"><i class="bi bi-pin-map-fill"></i> Coordonnées GPS</span>
                <div class="row g-4">
                    <div class="col-md-6">
                        {{ form_label(form.latitude) }}
                        {{ form_widget(form.latitude, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.longitude) }}
                        {{ form_widget(form.longitude, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-3 mt-4">
                <a href="{{ path('farmer_parcelle_show', {id: parcelle.id}) }}" class="btn-cancel-link">Annuler</a>
                <button type="submit" class="btn-save">
                    <i class="bi bi-check-circle-fill"></i> Mettre à jour
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
