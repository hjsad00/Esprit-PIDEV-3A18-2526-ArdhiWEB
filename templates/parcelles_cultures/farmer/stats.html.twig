{# Farmer: Stats #}
{% extends 'parcelles_cultures/base.html.twig' %}

{% block title %}Mes Statistiques{% endblock %}

{% block content %}
<h1>Mes Statistiques</h1>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card text-bg-primary">
            <div class="card-body">
                <h5 class="card-title">Mes Parcelles</h5>
                <p class="card-text display-6">{{ total_parcelles }}</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-success">
            <div class="card-body">
                <h5 class="card-title">Mes Cultures</h5>
                <p class="card-text display-6">{{ total_cultures }}</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-info">
            <div class="card-body">
                <h5 class="card-title">Surface Parcelles (ha)</h5>
                <p class="card-text display-6">{{ total_surface|number_format(2) }}</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-warning">
            <div class="card-body">
                <h5 class="card-title">Surface Cultures (ha)</h5>
                <p class="card-text display-6">{{ total_surface_cultures|number_format(2) }}</p>
            </div>
        </div>
    </div>
</div>

<h2 class="mt-5">Cultures prêtes à récolter</h2>
<div class="table-responsive">
    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Nom culture</th>
                <th>Parcelle</th>
                <th>Date récolte</th>
                <th>Surface</th>
            </tr>
        </thead>
        <tbody>
            {% for culture in cultures_prets_recolter %}
                <tr class="table-warning">
                    <td>{{ culture.nomCulture }}</td>
                    <td>{{ culture.parcelle.localisation }}</td>
                    <td>{{ culture.dateRecolteProvue|date('d/m/Y') }}</td>
                    <td>{{ culture.surfaceUtilisee }} ha</td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="text-center text-muted">Aucune culture prête</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
