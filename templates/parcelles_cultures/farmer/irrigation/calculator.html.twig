{% extends 'base.html.twig' %}

{% block title %}Calculateur d'Irrigation - Ardhi{% endblock %}

{% block stylesheets %}
<style>
    .page-header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #eee; }
    .page-title { font-family: 'Marcellus', serif; color: #116530; font-size: 2.5rem; margin: 0; }
    .premium-card { background: white; border-radius: 24px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 10px 30px rgba(0,0,0,0.04); padding: 30px; height: 100%; }
    .card-label { font-size: 12px; font-weight: 700; color: #116530; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 25px; display: flex; align-items: center; gap: 10px; }
    .form-control { border-radius: 12px; padding: 12px 15px; border: 1px solid #eee; transition: all 0.3s; }
    .form-control:focus { border-color: #116530; box-shadow: 0 0 0 4px rgba(17, 101, 48, 0.05); }
    .form-label { font-weight: 600; color: #2d3436; margin-bottom: 8px; font-size: 0.9rem; }
    .btn-calculate { background: #116530; color: white; border-radius: 50px; padding: 14px; font-weight: 700; border: none; width: 100%; transition: all 0.3s; box-shadow: 0 8px 20px rgba(17,101,48,0.2); display: flex; align-items: center; justify-content: center; gap: 10px; }
    .btn-calculate:hover { background: #1e8341; transform: translateY(-2px); box-shadow: 0 12px 30px rgba(17,101,48,0.3); }
    .btn-premium-back { color: #116530; background: #e8f5e9; border-radius: 50px; padding: 10px 20px; font-weight: 600; text-decoration: none; transition: all 0.3s; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 20px; }
    .btn-premium-back:hover { background: #116530; color: white; }
    .result-metric { background: #f8faf7; border-radius: 16px; padding: 20px; margin-bottom: 15px; display: flex; flex-direction: column; gap: 5px; border-left: 4px solid #116530; }
    .result-metric.highlight { background: #e8f5e9; border-left-color: #116530; }
    .result-label { font-size: 0.75rem; font-weight: 700; color: #888; text-transform: uppercase; letter-spacing: 1px; }
    .result-value { font-size: 1.8rem; font-weight: 800; color: #116530; }
    .result-sub { font-size: 0.8rem; color: #aaa; }
    .conditions-box { background: #f0f9ff; border-radius: 12px; padding: 15px; font-size: 0.85rem; color: #555; border-left: 4px solid #4299e1; }
</style>
{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid py-5 px-lg-5">
    <div class="row">
        <div class="col-md-3 col-xl-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>

        <div class="col-md-9 col-xl-10">
            <div data-aos="fade-right">
                <a href="{{ path('farmer_irrigation_index') }}" class="btn-premium-back">
                    <i class="bi bi-arrow-left"></i> Retour à l'irrigation
                </a>
            </div>

            <div class="page-header" data-aos="fade-down">
                <h1 class="page-title">Calculateur d'Irrigation</h1>
                <p class="text-muted lead mt-2">Estimez les besoins en eau de votre parcelle selon les conditions climatiques du jour.</p>
            </div>

            <div class="row g-4">
                <div class="col-lg-5" data-aos="fade-right" data-aos-delay="100">
                    <div class="premium-card">
                        <span class="card-label"><i class="bi bi-droplet-fill"></i> Paramètres du Calcul</span>

                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                        <div class="mb-4">
                            {{ form_label(form.date) }}
                            {{ form_widget(form.date, {'attr': {'class': 'form-control', 'type': 'date'}}) }}
                            {% if form.date.vars.errors|length > 0 %}<div class="invalid-feedback d-block">{{ form_errors(form.date) }}</div>{% endif %}
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Températures (°C)</label>
                            <div class="row g-3">
                                <div class="col-6">
                                    {{ form_label(form.temperature_min) }}
                                    {{ form_widget(form.temperature_min, {'attr': {'class': 'form-control', 'placeholder': 'Min'}}) }}
                                    {% if form.temperature_min.vars.errors|length > 0 %}<div class="invalid-feedback d-block">{{ form_errors(form.temperature_min) }}</div>{% endif %}
                                </div>
                                <div class="col-6">
                                    {{ form_label(form.temperature_max) }}
                                    {{ form_widget(form.temperature_max, {'attr': {'class': 'form-control', 'placeholder': 'Max'}}) }}
                                    {% if form.temperature_max.vars.errors|length > 0 %}<div class="invalid-feedback d-block">{{ form_errors(form.temperature_max) }}</div>{% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.precipitations) }}
                            {{ form_widget(form.precipitations, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 5'}}) }}
                            {% if form.precipitations.vars.errors|length > 0 %}<div class="invalid-feedback d-block">{{ form_errors(form.precipitations) }}</div>{% endif %}
                            <small class="text-muted">En millimètres (mm)</small>
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.humidite) }}
                            {{ form_widget(form.humidite, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 60'}}) }}
                            {% if form.humidite.vars.errors|length > 0 %}<div class="invalid-feedback d-block">{{ form_errors(form.humidite) }}</div>{% endif %}
                            <small class="text-muted">Humidité du sol (0-100%)</small>
                        </div>

                        <div class="mb-5">
                            {{ form_label(form.kc) }}
                            {{ form_widget(form.kc, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 0.75'}}) }}
                            {% if form.kc.vars.errors|length > 0 %}<div class="invalid-feedback d-block">{{ form_errors(form.kc) }}</div>{% endif %}
                            <small class="text-muted">Coefficient cultural (ex: 0.3-1.2)</small>
                        </div>

                        <button type="submit" class="btn-calculate">
                            <i class="bi bi-droplet-half"></i> Lancer le calcul
                        </button>

                        {{ form_end(form) }}
                    </div>
                </div>

                {% if calculation_result %}
                <div class="col-lg-7" data-aos="fade-left" data-aos-delay="150">
                    <div class="premium-card">
                        <span class="card-label"><i class="bi bi-bar-chart-line-fill"></i> Résultats du Calcul</span>

                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <div class="result-metric">
                                    <span class="result-label">Température Moyenne</span>
                                    <span class="result-value">{{ calculation_result.temp|round(1) }} <small style="font-size:1rem">°C</small></span>
                                    <span class="result-sub">(Min + Max) / 2</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="result-metric">
                                    <span class="result-label">ET0 – Évapotranspiration</span>
                                    <span class="result-value">{{ calculation_result.et0|round(3) }} <small style="font-size:1rem">mm/j</small></span>
                                    <span class="result-sub">Évaporation estimée du terrain</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="result-metric">
                                    <span class="result-label">Besoin Brut</span>
                                    <span class="result-value">{{ calculation_result.besoin_brut|round(3) }} <small style="font-size:1rem">mm/j</small></span>
                                    <span class="result-sub">Kc × ET0</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="result-metric">
                                    <span class="result-label">Besoin Net</span>
                                    <span class="result-value" style="color:#e67e22;">{{ calculation_result.besoin_net|round(3) }} <small style="font-size:1rem">mm/j</small></span>
                                    <span class="result-sub">Après soustraction des pluies</span>
                                </div>
                            </div>
                        </div>

                        <div class="result-metric highlight" style="border-left-width: 6px;">
                            <span class="result-label"><i class="bi bi-droplet-fill me-1"></i> Volume d'Irrigation Recommandé</span>
                            <span class="result-value" style="font-size: 2.5rem;">
                                {{ (calculation_result.volume_litres)|round(0)|number_format(0, '.', ' ') }}
                                <small style="font-size:1.2rem; font-weight:500; color:#555">L</small>
                            </span>
                            <span class="result-sub">= {{ (calculation_result.volume_m3)|round(2) }} m³</span>
                        </div>

                        <div class="conditions-box mt-4">
                            <strong><i class="bi bi-thermometer-half me-2"></i>Conditions d'Entrée :</strong><br>
                            Température moy: <strong>{{ calculation_result.temp }}°C</strong> &nbsp;|&nbsp;
                            Précipitations: <strong>{{ calculation_result.precip }} mm</strong> &nbsp;|&nbsp;
                            Humidité: <strong>{{ calculation_result.humidite }}%</strong>
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="col-lg-7 d-flex align-items-center justify-content-center" data-aos="fade-left">
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-cloud-drizzle" style="font-size: 4rem; color: #cce8d8;"></i>
                        <h4 class="mt-3" style="color: #bbb;">Résultats ici</h4>
                        <p>Remplissez le formulaire et lancez le calcul pour voir vos besoins en irrigation.</p>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
