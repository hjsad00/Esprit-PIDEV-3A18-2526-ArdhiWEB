{% extends 'base.html.twig' %}

{% block title %}Calculateur d'Irrigation{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>
        <div class="col-md-10">
            <a href="{{ path('farmer_irrigation_index') }}" class="btn btn-secondary mb-3">
                <i class="fas fa-arrow-left"></i> Retour
            </a>

            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <h3 class="card-title mb-0"><i class="fas fa-calculator"></i> Calcul d'Irrigation</h3>
                        </div>
                        <div class="card-body">
                            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                            <div class="mb-3">
                                {{ form_label(form.date) }}
                                {{ form_widget(form.date, {'attr': {'class': 'form-control', 'type': 'date'}}) }}
                                {% if form.date.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        {{ form_errors(form.date) }}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Températures (°C)</label>
                                <div class="row">
                                    <div class="col-md-6">
                                        {{ form_label(form.temperature_min) }}
                                        {{ form_widget(form.temperature_min, {'attr': {'class': 'form-control'}}) }}
                                        {% if form.temperature_min.vars.errors|length > 0 %}
                                            <div class="invalid-feedback d-block">
                                                {{ form_errors(form.temperature_min) }}
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="col-md-6">
                                        {{ form_label(form.temperature_max) }}
                                        {{ form_widget(form.temperature_max, {'attr': {'class': 'form-control'}}) }}
                                        {% if form.temperature_max.vars.errors|length > 0 %}
                                            <div class="invalid-feedback d-block">
                                                {{ form_errors(form.temperature_max) }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.precipitations) }}
                                {{ form_widget(form.precipitations, {'attr': {'class': 'form-control'}}) }}
                                {% if form.precipitations.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">{{ form_errors(form.precipitations) }}</div>
                                {% endif %}
                                <small class="text-muted">En mm</small>
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.humidite) }}
                                {{ form_widget(form.humidite, {'attr': {'class': 'form-control'}}) }}
                                {% if form.humidite.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">{{ form_errors(form.humidite) }}</div>
                                {% endif %}
                                <small class="text-muted">Humidité du sol (0-100%)</small>
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.kc) }}
                                {{ form_widget(form.kc, {'attr': {'class': 'form-control'}}) }}
                                {% if form.kc.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">{{ form_errors(form.kc) }}</div>
                                {% endif %}
                                <small class="text-muted">Coefficient cultural (ex: 0.3-1.2)</small>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-calculator"></i> Calculer
                            </button>

                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>

                {% if calculation_result %}
                    <div class="col-md-6">
                        <div class="card border-success">
                            <div class="card-header bg-success text-white">
                                <h5 class="card-title mb-0">Résultats du Calcul</h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3 p-3 bg-light rounded">
                                    <h6>Température Moyenne Calculée</h6>
                                    <h4 class="text-info">{{ calculation_result.temp|round(2) }} °C</h4>
                                    <small class="text-muted">(Min + Max) / 2</small>
                                </div>

                                <div class="mb-3 p-3 bg-light rounded">
                                    <h6>ET0 (Evapotranspiration)</h6>
                                    <h4 class="text-primary">{{ calculation_result.et0|round(3) }} mm/jour</h4>
                                    <small class="text-muted">Évaporation estimée du terrain</small>
                                </div>

                                <div class="mb-3 p-3 bg-light rounded">
                                    <h6>Besoin Brut</h6>
                                    <h4 class="text-info">{{ calculation_result.besoin_brut|round(3) }} mm/jour</h4>
                                    <small class="text-muted">Kc × ET0</small>
                                </div>

                                <div class="mb-3 p-3 bg-light rounded">
                                    <h6>Besoin Net</h6>
                                    <h4 class="text-warning">{{ calculation_result.besoin_net|round(3) }} mm/jour</h4>
                                    <small class="text-muted">Besoin après soustraction des précipitations</small>
                                </div>

                                <div class="p-3 bg-success bg-opacity-10 rounded">
                                    <h6>Volume d'Irrigation</h6>
                                    <h4 class="text-success">{{ (calculation_result.volume_litres)|round(0)|number_format(0, '.', ' ') }} L</h4>
                                    <small>= {{ (calculation_result.volume_m3)|round(2) }} m³</small>
                                </div>

                                <div class="mt-3 p-2 bg-info bg-opacity-10 rounded">
                                    <small>
                                        <strong>Conditions:</strong><br>
                                        Température moy: {{ calculation_result.temp }}°C<br>
                                        Précipitations: {{ calculation_result.precip }} mm<br>
                                        Humidité: {{ calculation_result.humidite }}%
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
