{% extends 'base.html.twig' %}

{% block title %}Dossier de Crédit #{{ dossier.id }} - Ardhi{% endblock %}

{% block stylesheets %}
<style>
    .page-header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #eee; }
    .page-title { font-family: 'Marcellus', serif; color: #116530; font-size: 2.5rem; margin: 0; }
    .premium-card { background: white; border-radius: 24px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 10px 30px rgba(0,0,0,0.04); padding: 30px; margin-bottom: 25px; }
    .card-label { font-size: 12px; font-weight: 700; color: #116530; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 25px; display: flex; align-items: center; gap: 10px; }
    .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 25px; }
    .info-item { display: flex; flex-direction: column; gap: 5px; }
    .info-label { font-size: 0.75rem; color: #888; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .info-value { font-size: 1.05rem; font-weight: 700; color: #2d3436; display: flex; align-items: center; gap: 8px; }
    .info-value i { color: #116530; }

    .score-card { background: linear-gradient(135deg, #116530, #1e8341); border-radius: 20px; padding: 25px; text-align: center; color: white; }
    .score-num { font-size: 3rem; font-weight: 900; line-height: 1; }
    .score-label { font-size: 0.8rem; opacity: 0.8; margin-top: 6px; }

    .score-metric { background: #f8faf7; border-radius: 16px; padding: 20px; text-align: center; }
    .score-metric .ms-label { font-size: 0.75rem; color: #888; font-weight: 600; text-transform: uppercase; }
    .score-metric .ms-value { font-size: 1.6rem; font-weight: 900; }
    .score-metric.rentabilite .ms-value { color: #116530; }
    .score-metric.climat .ms-value { color: #4299e1; }
    .score-metric.diversification .ms-value { color: #f59e0b; }
    .score-metric.historique .ms-value { color: #9f7aea; }

    .risk-band { border-radius: 14px; padding: 20px; text-align: center; }
    .risk-faible { background: #e8f5e9; color: #116530; }
    .risk-modere { background: #fff8e1; color: #f59e0b; }
    .risk-eleve { background: #fff0f0; color: #e53e3e; }

    .recommendation-line { padding: 10px 15px; border-radius: 10px; background: #f8faf7; border-left: 4px solid #116530; margin-bottom: 8px; font-size: 0.9rem; color: #4a4a4a; }

    .btn-pdf { background: #e53e3e; color: white; border-radius: 50px; padding: 12px 30px; font-weight: 700; text-decoration: none; transition: all 0.3s; display: inline-flex; align-items: center; gap: 10px; box-shadow: 0 6px 15px rgba(229,62,62,0.2); }
    .btn-pdf:hover { background: #c53030; color: white; transform: translateY(-2px); }
    .btn-premium-back { color: #116530; background: #e8f5e9; border-radius: 50px; padding: 10px 20px; font-weight: 600; text-decoration: none; transition: all 0.3s; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 20px; }
    .btn-premium-back:hover { background: #116530; color: white; }
    .status-badge { font-weight: 600; font-size: 0.7rem; padding: 5px 14px; border-radius: 50px; text-transform: capitalize; }
</style>
{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid py-5 px-lg-5">
    <div class="row">
        <div class="col-md-3 col-xl-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>

        <div class="col-md-9 col-xl-10">
            <div data-aos="fade-right">
                <a href="{{ path('farmer_credit_index') }}" class="btn-premium-back">
                    <i class="bi bi-arrow-left"></i> Retour aux dossiers
                </a>
            </div>

            <div class="page-header d-flex justify-content-between align-items-center" data-aos="fade-down">
                <div>
                    <h1 class="page-title">Dossier de Crédit <span style="color:#aaa;">#{{ dossier.id }}</span></h1>
                    <p class="text-muted lead mt-2">Créé le {{ dossier.createdAt|date('d/m/Y à H:i') }}</p>
                </div>
                <button type="button" class="btn-pdf" onclick="openLanguageModal({{ dossier.id }})">
                    <i class="bi bi-file-pdf"></i> Télécharger PDF
                </button>
            </div>

            {# === Informations Générales + Risque === #}
            <div class="row g-4 mb-4" data-aos="fade-up">
                <div class="col-lg-8">
                    <div class="premium-card">
                        <span class="card-label"><i class="bi bi-info-circle-fill"></i> Informations Générales</span>
                        <div class="info-grid">
                            <div class="info-item">
                                <span class="info-label">Parcelle associée</span>
                                <span class="info-value">
                                    <i class="bi bi-geo-alt"></i>
                                    <a href="{{ path('farmer_parcelle_show', {id: dossier.parcelle.id}) }}" class="link-success text-decoration-none">
                                        {{ dossier.parcelle.localisation }}
                                    </a>
                                </span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Montant Demandé</span>
                                <span class="info-value"><i class="bi bi-cash-stack"></i> {{ dossier.montantPretMax|number_format(2, '.', ' ') }} DT</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Durée du Crédit</span>
                                <span class="info-value"><i class="bi bi-clock-history"></i> {{ dossier.dureeAnnees }} ans</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Capacité de Remboursement</span>
                                <span class="info-value"><i class="bi bi-arrow-repeat"></i> {{ dossier.capaciteRemboursement|round(2)|number_format(2, '.', ' ') }} DT/an</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Statut</span>
                                <span>
                                    <span class="status-badge bg-info-light text-info">{{ dossier.statut|replace({'draft': 'Brouillon', 'pending': 'En attente'}) }}</span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="score-card h-100 d-flex flex-column justify-content-center">
                        <div class="score-label">Score de Risque</div>
                        <div class="score-num">{{ dossier.scoreRisque|round(1) }}<span style="font-size:1.5rem; opacity:.6">/10</span></div>
                        <div class="mt-3">
                            {% if dossier.niveauRisque == 'faible' %}
                                <span class="badge bg-white text-success fw-bold fs-6">✅ Risque Faible</span>
                            {% elseif dossier.niveauRisque == 'modere' %}
                                <span class="badge bg-white text-warning fw-bold fs-6">⚠️ Risque Modéré</span>
                            {% else %}
                                <span class="badge bg-white text-danger fw-bold fs-6">🚨 Risque Élevé</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            {# === Score Details === #}
            <div class="premium-card" data-aos="fade-up" data-aos-delay="100">
                <span class="card-label"><i class="bi bi-bar-chart-fill"></i> Détails des Scores Qualitatifs</span>
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="score-metric rentabilite">
                            <div class="ms-label">Rentabilité</div>
                            <div class="ms-value">{{ dossier.scoreRentabilite|round(1) }}<small style="font-size:.9rem; font-weight:500; color:#aaa">/10</small></div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="score-metric climat">
                            <div class="ms-label">Climat</div>
                            <div class="ms-value">{{ dossier.scoreStabiliteClimat|round(1) }}<small style="font-size:.9rem; font-weight:500; color:#aaa">/10</small></div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="score-metric diversification">
                            <div class="ms-label">Diversification</div>
                            <div class="ms-value">{{ dossier.scoreDiversification|round(1) }}<small style="font-size:.9rem; font-weight:500; color:#aaa">/10</small></div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="score-metric historique">
                            <div class="ms-label">Historique</div>
                            <div class="ms-value">{{ dossier.scoreHistorique|round(1) }}<small style="font-size:.9rem; font-weight:500; color:#aaa">/10</small></div>
                        </div>
                    </div>
                </div>
            </div>

            {# === Recommendations === #}
            <div class="premium-card" data-aos="fade-up" data-aos-delay="200">
                <span class="card-label"><i class="bi bi-lightbulb-fill"></i> Recommandations</span>
                {% for line in dossier.recommandations|split('\n') %}
                    {% if line %}
                        <div class="recommendation-line">{{ line|trans }}</div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<!-- Modal de sélection de langue pour PDF -->
<div class="modal fade" id="languageModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: #116530; border: none;">
                <h5 class="modal-title text-white">Sélectionner la langue du PDF</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-outline-success btn-lg" onclick="downloadPDF('fr')">
                        <i class="bi bi-globe"></i> Français
                    </button>
                    <button type="button" class="btn btn-outline-success btn-lg" onclick="downloadPDF('en')">
                        <i class="bi bi-globe"></i> English
                    </button>
                    <button type="button" class="btn btn-outline-success btn-lg" onclick="downloadPDF('ar')">
                        <i class="bi bi-globe"></i> العربية
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let currentDossierId = null;

function openLanguageModal(dossierId) {
    currentDossierId = dossierId;
    const modal = new bootstrap.Modal(document.getElementById('languageModal'));
    modal.show();
}

function downloadPDF(locale) {
    if (currentDossierId) {
        window.location.href = `{{ path('farmer_credit_export_pdf', {id: '__ID__'}) }}?locale=${locale}`.replace('__ID__', currentDossierId);
        const modal = bootstrap.Modal.getInstance(document.getElementById('languageModal'));
        modal.hide();
    }
}
</script>
{% endblock %}
