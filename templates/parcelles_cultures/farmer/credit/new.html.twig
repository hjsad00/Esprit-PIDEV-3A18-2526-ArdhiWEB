{% extends 'base.html.twig' %}

{% block title %}Nouveau Crédit - Sélection Parcelle - Ardhi{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 2.5rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid #eee;
        }
        .page-title {
            font-family: 'Marcellus', serif;
            color: #116530;
            font-size: 2.5rem;
            margin: 0;
        }
        .premium-card {
            background: white;
            border-radius: 24px;
            border: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 10px 30px rgba(0,0,0,0.04);
            padding: 30px;
            height: 100%;
            transition: all 0.3s ease;
            position: relative;
        }
        .premium-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 45px rgba(0,0,0,0.08);
            border-color: #116530;
        }
        .card-label {
            font-size: 12px;
            font-weight: 700;
            color: #116530;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .parcelle-id {
            position: absolute;
            top: 25px;
            right: 30px;
            font-family: 'Marcellus', serif;
            font-size: 1.5rem;
            color: #f0f0f0;
            z-index: 1;
        }
        .btn-select {
            background: #116530;
            color: white;
            border-radius: 50px;
            padding: 12px 25px;
            font-weight: 700;
            width: 100%;
            border: none;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
        }
        .btn-select:hover {
            background: #1e8341;
            color: white;
            box-shadow: 0 10px 20px rgba(17, 101, 48, 0.2);
        }
        .info-preview {
            display: flex;
            flex-direction: column;
            gap: 10px;
            color: #666;
            font-size: 0.95rem;
        }
    </style>
{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid py-5 px-lg-5">
    <div class="row">
        <div class="col-md-3 col-xl-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>
        
        <div class="col-md-9 col-xl-10">
            <div class="page-header" data-aos="fade-down">
                <h1 class="page-title">Nouvelle Demande de Crédit</h1>
                <p class="text-muted lead mt-2">Étape 1 : Sélectionnez la parcelle à financer.</p>
            </div>

            {% if parcelles|length > 0 %}
                <div class="row g-4" data-aos="fade-up">
                    {% for parcelle in parcelles %}
                        <div class="col-md-6 col-xl-4">
                            <div class="premium-card">
                                <div class="parcelle-id">#{{ parcelle.id }}</div>
                                <span class="card-label"><i class="bi bi-geo-alt-fill"></i> Localisation</span>
                                <h3 class="h5 fw-bold mb-3 text-dark">{{ parcelle.localisation }}</h3>
                                
                                <div class="info-preview">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-aspect-ratio text-success"></i>
                                        <span>Surface : <strong>{{ parcelle.surface }} ha</strong></span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-layers text-success"></i>
                                        <span>Type : {{ parcelle.typeSol }}</span>
                                    </div>
                                </div>

                                <a href="{{ path('farmer_credit_generate', {id: parcelle.id}) }}" class="btn-select">
                                    Choisir cette parcelle <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="premium-card text-center py-5" data-aos="zoom-in">
                    <i class="bi bi-exclamation-triangle text-warning" style="font-size: 3rem;"></i>
                    <h3 class="mt-4">Aucune parcelle disponible</h3>
                    <p class="text-muted">Vous devez enregistrer une parcelle avant de pouvoir demander un crédit.</p>
                    <a href="{{ path('farmer_parcelle_new') }}" class="btn btn-success rounded-pill px-4 mt-3">
                        Créer ma première parcelle
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
