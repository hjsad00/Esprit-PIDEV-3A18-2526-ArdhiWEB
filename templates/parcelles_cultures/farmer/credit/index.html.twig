{% extends 'base.html.twig' %}

{% block title %}Dossiers de Crédit{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>
        <div class="col-md-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1><i class="fas fa-file-contract"></i> Mes Dossiers de Crédit</h1>
                <a href="{{ path('farmer_credit_index') }}#new" class="btn btn-success">
                    <i class="fas fa-plus"></i> Nouveau Dossier
                </a>
            </div>

            {% if dossiers.getTotalItemCount > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Parcelle</th>
                                <th>Montant (DT)</th>
                                <th>Durée (ans)</th>
                                <th>Score Risque</th>
                                <th>Niveau Risque</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for dossier in dossiers %}
                                <tr>
                                    <td>#{{ dossier.id }}</td>
                                    <td><a href="{{ path('farmer_parcelle_show', {id: dossier.parcelle.id}) }}">#{{ dossier.parcelle.id }}</a></td>
                                    <td>{{ dossier.montant_pret_max|round(2) }} DT</td>
                                    <td>{{ dossier.duree_annees }}</td>
                                    <td>
                                        <strong>{{ dossier.score_risque|round(2) }}/10</strong>
                                    </td>
                                    <td>
                                        {% if dossier.niveau_risque == 'faible' %}
                                            <span class="badge bg-success">Faible</span>
                                        {% elseif dossier.niveau_risque == 'modere' %}
                                            <span class="badge bg-warning">Modéré</span>
                                        {% else %}
                                            <span class="badge bg-danger">Élevé</span>
                                        {% endif %}
                                    </td>
                                    <td><span class="badge bg-info">{{ dossier.statut }}</span></td>
                                    <td>
                                        <a href="{{ path('farmer_credit_show', {id: dossier.id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('farmer_credit_export_pdf', {id: dossier.id}) }}" class="btn btn-sm btn-danger" title="Télécharger PDF">
                                            <i class="fas fa-file-pdf"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Pagination #}
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        {% if dossiers.hasPreviousPage %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('farmer_credit_index', {'page': dossiers.previousPage}) }}">Précédent</a>
                            </li>
                        {% endif %}

                        {% for page in dossiers.paginationData.pages %}
                            {% if page == dossiers.currentPage %}
                                <li class="page-item active"><span class="page-link">{{ page }}</span></li>
                            {% else %}
                                <li class="page-item"><a class="page-link" href="{{ path('farmer_credit_index', {'page': page}) }}">{{ page }}</a></li>
                            {% endif %}
                        {% endfor %}

                        {% if dossiers.hasNextPage %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('farmer_credit_index', {'page': dossiers.nextPage}) }}">Suivant</a>
                            </li>
                        {% endif %}
                    </ul>
                </nav>
            {% else %}
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i> Vous n'avez pas encore créé de dossier de crédit.
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
