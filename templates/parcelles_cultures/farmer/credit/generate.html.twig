{% extends 'base.html.twig' %}

{% block title %}Générer un dossier de crédit - Parcelle #{{ parcelle.id }}{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>
        <div class="col-md-10">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('farmer_credit_index') }}">Mes Dossiers</a></li>
                    <li class="breadcrumb-item active">Nouveau Dossier</li>
                </ol>
            </nav>

            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="card-title mb-0"><i class="fas fa-calculator"></i> Simulation de Crédit Agricole</h4>
                    <p class="mb-0 small">Analyse pour la Parcelle #{{ parcelle.id }} ({{ parcelle.surface }} ha)</p>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            {{ form_row(form.duree_annees) }}
                        </div>
                    </div>

                    <h5 class="mt-4 border-bottom pb-2 text-primary"><i class="fas fa-coins"></i> Dépenses et Revenus Prévisionnels</h5>
                    <div class="row">
                        <div class="col-md-4">
                            {{ form_row(form.prixVente) }}
                            {{ form_row(form.coutSemences) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.coutEngrais) }}
                            {{ form_row(form.coutMainOeuvre) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.coutIrrigation) }}
                            {{ form_row(form.coutAutres) }}
                        </div>
                    </div>

                    <h5 class="mt-4 border-bottom pb-2 text-info"><i class="fas fa-chart-line"></i> Évaluation Qualitative (Auto-évaluation)</h5>
                    <p class="text-muted small mb-3">Veuillez noter ces critères sur une échelle de 1 à 10 pour une analyse précise du risque.</p>

                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.score_rentabilite) }}
                            {{ form_row(form.score_stabilite_climat) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.score_diversification) }}
                            {{ form_row(form.score_historique) }}
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-check-circle"></i> Générer l'Analyse de Crédit
                        </button>
                        <a href="{{ path('farmer_parcelle_show', {id: parcelle.id}) }}" class="btn btn-outline-secondary btn-lg">
                            Annuler
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
