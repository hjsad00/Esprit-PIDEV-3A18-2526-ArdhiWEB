{% extends 'base.html.twig' %}

{% block title %}Agriculture - Gestion Parcelles & Cultures{% endblock %}

{% block body_class %}marketplace-page{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/marketplace/marketplace.css') }}" rel="stylesheet">
    <style>
        /* Specific tweaks if needed for Agriculture context */
        .agriculture-hero {
            background: #0f140f; /* Fallback */
        }
        .category-item h4 {
            margin-bottom: 0px !important;
        }
    </style>
{% endblock %}

{% block body %}

    {# ============================
       HERO SECTION — AGRI DASHBOARD
       ============================ #}
    <section class="marketplace-hero agriculture-hero">
      <div class="hero-bg">
        <img src="{{ asset('assets/img/hero_1.jpg') }}" alt="Gestion Agricole Ardhi">
      </div>

      <div class="container">
        <div class="hero-inner">

          {# --- Left Content --- #}
          <div class="hero-left" data-aos="fade-up">
            <div class="hero-label">GESTION AGRICOLE</div>
            <h1 class="hero-headline">Gérez vos<br>parcelles et<br>cultures.</h1>
            <p class="hero-description">
              Suivi complet de vos parcelles, calcul d'irrigation, analyse financière 
              et gestion du crédit agricole pour une productivité maximale.
            </p>
            <a href="{{ path('farmer_parcelle_index') }}" class="hero-btn-primary">
              Commencer
            </a>
          </div>

          {# --- Right: Agri Services Panel --- #}
          <div class="hero-right" data-aos="fade-left">
            <div class="categories-glass-panel">
              <div class="categories-panel-title">Services Agricoles</div>

              <a href="{{ path('farmer_parcelle_index') }}" class="category-item">
                <div class="category-icon"><i class="bi bi-geo-alt-fill"></i></div>
                <div class="category-text">
                  <h4>Mes Parcelles</h4>
                  <span>Gestion des parcelles</span>
                </div>
              </a>

              <a href="{{ path('farmer_culture_index') }}" class="category-item">
                <div class="category-icon"><i class="bi bi-flower1"></i></div>
                <div class="category-text">
                  <h4>Mes Cultures</h4>
                  <span>Suivi des cultures</span>
                </div>
              </a>

              <a href="{{ path('farmer_irrigation_index') }}" class="category-item">
                <div class="category-icon"><i class="bi bi-droplet-fill"></i></div>
                <div class="category-text">
                  <h4>Irrigation</h4>
                  <span>Calcul d'irrigation</span>
                </div>
              </a>

              <a href="{{ path('farmer_roi_index') }}" class="category-item">
                <div class="category-icon"><i class="bi bi-graph-up-arrow"></i></div>
                <div class="category-text">
                  <h4>ROI & Finances</h4>
                  <span>Analyse financière</span>
                </div>
              </a>

              <a href="{{ path('farmer_credit_index') }}" class="category-item">
                <div class="category-icon"><i class="bi bi-file-earmark-diff-fill"></i></div>
                <div class="category-text">
                  <h4>Crédit Agricole</h4>
                  <span>Dossiers de crédit</span>
                </div>
              </a>

            </div>
          </div>

        </div>
      </div>
    </section>

{% endblock %}
