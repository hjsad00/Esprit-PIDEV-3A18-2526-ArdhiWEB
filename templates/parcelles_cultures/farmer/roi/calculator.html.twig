{% extends 'base.html.twig' %}

{% block title %}Calculateur ROI/Finances{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>
        <div class="col-md-10">
            <a href="{{ path('farmer_roi_index') }}" class="btn btn-secondary mb-3">
                <i class="fas fa-arrow-left"></i> Retour
            </a>

            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h3 class="card-title mb-0"><i class="fas fa-calculator"></i> Analyse Financière</h3>
                        </div>
                        <div class="card-body">
                            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                            <div class="mb-4">
                                {{ form_label(form.parcelle) }}
                                {{ form_widget(form.parcelle) }}
                                {% if form.parcelle.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">{{ form_errors(form.parcelle) }}</div>
                                {% endif %}
                                <small class="text-muted">La surface sera pré-remplie si possible.</small>
                            </div>

                            <h6 class="mb-3 text-info">Production</h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.surface_ha) }}
                                        {{ form_widget(form.surface_ha, {'attr': {'class': 'form-control', 'placeholder': '5'}}) }}
                                        {% if form.surface_ha.vars.errors|length > 0 %}
                                            <div class="invalid-feedback d-block">{{ form_errors(form.surface_ha) }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.rendement) }}
                                        {{ form_widget(form.rendement, {'attr': {'class': 'form-control', 'placeholder': '50'}}) }}
                                        {% if form.rendement.vars.errors|length > 0 %}
                                            <div class="invalid-feedback d-block">{{ form_errors(form.rendement) }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <h6 class="mb-3 text-info">Conditions Climatiques</h6>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        {{ form_label(form.jours_canicule) }}
                                        {{ form_widget(form.jours_canicule, {'attr': {'class': 'form-control', 'placeholder': '0'}}) }}
                                        {% if form.jours_canicule.vars.errors|length > 0 %}
                                            <div class="invalid-feedback d-block">{{ form_errors(form.jours_canicule) }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        {{ form_label(form.jours_excespluie) }}
                                        {{ form_widget(form.jours_excespluie, {'attr': {'class': 'form-control', 'placeholder': '0'}}) }}
                                        {% if form.jours_excespluie.vars.errors|length > 0 %}
                                            <div class="invalid-feedback d-block">{{ form_errors(form.jours_excespluie) }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        {{ form_label(form.jours_gel) }}
                                        {{ form_widget(form.jours_gel, {'attr': {'class': 'form-control', 'placeholder': '0'}}) }}
                                        {% if form.jours_gel.vars.errors|length > 0 %}
                                            <div class="invalid-feedback d-block">{{ form_errors(form.jours_gel) }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <h6 class="mb-3 text-info">Coûts de Production</h6>
                            <div class="mb-3">
                                {{ form_label(form.cout_semences) }}
                                {{ form_widget(form.cout_semences, {'attr': {'class': 'form-control', 'placeholder': '1000'}}) }}
                                {% if form.cout_semences.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">{{ form_errors(form.cout_semences) }}</div>
                                {% endif %}
                                <small class="text-muted">En DT</small>
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.cout_engrais) }}
                                {{ form_widget(form.cout_engrais, {'attr': {'class': 'form-control', 'placeholder': '2000'}}) }}
                                {% if form.cout_engrais.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">{{ form_errors(form.cout_engrais) }}</div>
                                {% endif %}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.cout_main_oeuvre) }}
                                {{ form_widget(form.cout_main_oeuvre, {'attr': {'class': 'form-control', 'placeholder': '1500'}}) }}
                                {% if form.cout_main_oeuvre.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">{{ form_errors(form.cout_main_oeuvre) }}</div>
                                {% endif %}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.cout_irrigation) }}
                                {{ form_widget(form.cout_irrigation, {'attr': {'class': 'form-control', 'placeholder': '500'}}) }}
                                {% if form.cout_irrigation.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">{{ form_errors(form.cout_irrigation) }}</div>
                                {% endif %}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.cout_autres) }}
                                {{ form_widget(form.cout_autres, {'attr': {'class': 'form-control', 'placeholder': '300'}}) }}
                                {% if form.cout_autres.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">{{ form_errors(form.cout_autres) }}</div>
                                {% endif %}
                            </div>

                            <h6 class="mb-3 text-info">Vente</h6>
                            <div class="mb-3">
                                {{ form_label(form.prix_vente) }}
                                {{ form_widget(form.prix_vente, {'attr': {'class': 'form-control', 'placeholder': '5'}}) }}
                                {% if form.prix_vente.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">{{ form_errors(form.prix_vente) }}</div>
                                {% endif %}
                                <small class="text-muted">Prix par unité de production (DT)</small>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-calculator"></i> Analyser
                            </button>

                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>

                {% if roi_result %}
                    <div class="col-md-6">
                        <div class="card border-success">
                            <div class="card-header bg-success text-white">
                                <h5 class="card-title mb-0">Résultats de l'Analyse</h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3 p-3 bg-light rounded text-center">
                                    <h6 class="text-primary mb-0">Score ROI</h6>
                                    <h3 class="fw-bold">{{ roi_result.score_roi|round(1) }}%</h3>
                                </div>

                                <hr>
                                <h6 class="text-success"><i class="fas fa-hand-holding-usd"></i> Capacité de Financement</h6>
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <div class="p-2 border rounded">
                                            <small class="text-muted">Capacité Remb.</small><br>
                                            <strong>{{ roi_result.capacite_remboursement|round(2) }} DT</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 border rounded">
                                            <small class="text-muted">Prêt Max ({{ form.vars.value.duree_pret }} ans)</small><br>
                                            <strong>{{ roi_result.montant_pret_max|round(2) }} DT</strong>
                                        </div>
                                    </div>
                                </div>

                                <hr>
                                <h6 class="text-danger"><i class="fas fa-exclamation-triangle"></i> Évaluation du Risque</h6>
                                <div class="p-3 border rounded text-center {% if roi_result.risque_niveau == 'Faible' %}bg-success{% elseif roi_result.risque_niveau == 'Modéré' %}bg-warning{% else %}bg-danger{% endif %} text-white">
                                    <h4 class="mb-1 fw-bold">{{ roi_result.risque_score|round(2) }} / 10</h4>
                                    <span class="badge bg-white text-dark">
                                        Risque {{ roi_result.risque_niveau }}
                                    </span>
                                </div>
                                <hr>

                                <div class="mb-2 p-2 bg-light rounded shadow-sm">
                                    <small class="text-muted">Facteur Climatique</small><br>
                                    <strong class="text-dark">{{ roi_result.facteur_climatique|round(3) }}</strong>
                                </div>

                                <div class="mb-3 p-3 bg-info bg-opacity-10 rounded shadow-sm">
                                    <h6 class="text-info">Production Réelle</h6>
                                    <h4 class="text-dark fw-bold">{{ roi_result.production_reelle|round(2) }} unités</h4>
                                </div>

                                <div class="mb-3 p-3 bg-warning bg-opacity-10 rounded shadow-sm">
                                    <h6 class="text-warning">Coût Total</h6>
                                    <h4 class="text-dark fw-bold">{{ roi_result.cout_total|round(2) }} DT</h4>
                                </div>

                                <div class="mb-3 p-3 bg-primary bg-opacity-10 rounded shadow-sm">
                                    <h6 class="text-primary">Revenu Brut</h6>
                                    <h4 class="text-dark fw-bold">{{ roi_result.revenu_brut|round(2) }} DT</h4>
                                <h5 class="card-title mb-0"><i class="fas fa-magic"></i> Simulateur Dynamique</h5>
                            </div>
                            <div class="card-body bg-light border-bottom">
                                <label class="form-label fw-bold"><i class="fas fa-sliders-h"></i> Ajustement des Revenus (Simulation)</label>
                                <input type="range" class="form-range" id="simulationSlider" min="50" max="200" value="100" step="1">
                                <div class="d-flex justify-content-between">
                                    <small class="text-danger">-50%</small>
                                    <span id="sliderValue" class="badge bg-primary">Normal (100%)</span>
                                    <small class="text-success">+100%</small>
                                </div>
                                <p class="small text-muted mt-2 mb-0">
                                    Glissez pour voir comment l'ROI change selon l'évolution du marché.
                                </p>
                            </div>
                            <div class="card-body" id="dynamicResults">
                                <div class="mb-3 p-3 bg-success text-white rounded shadow text-center">
                                    <h6>Score ROI Global (Simulé)</h6>
                                    <h2 class="fw-bold" id="simScore">{{ roi_result.score_roi|round(2) }}%</h2>
                                    <small id="simStatus">
                                        {% if roi_result.score_roi > 100 %}Très rentable!{% elseif roi_result.score_roi > 0 %}Rentable{% else %}Non rentable{% endif %}
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const parcelleSelect = document.getElementById('{{ form.parcelle.vars.id }}');
        const surfaceInput = document.getElementById('{{ form.surface_ha.vars.id }}');

        if (parcelleSelect && surfaceInput) {
            parcelleSelect.addEventListener('change', function() {
                const selectedOption = this.options[this.selectedIndex];
                const surface = selectedOption.getAttribute('data-surface');
                if (surface) surfaceInput.value = surface;
            });
        }

        // --- Simulateur Dynamique ---
        const slider = document.getElementById('simulationSlider');
        if (slider) {
            const baseRevenu = {{ roi_result.revenu_brut|default(0) }};
            const baseCout = {{ roi_result.cout_total|default(0) }};
            const dureePret = {{ form.vars.value.duree_pret|default(5) }};
            const simScore = document.getElementById('simScore');
            const simStatus = document.getElementById('simStatus');
            const sliderLabel = document.getElementById('sliderValue');

            slider.addEventListener('input', function() {
                const ratio = this.value / 100;
                const newRevenu = baseRevenu * ratio;
                const newMarge = newRevenu - baseCout;
                const newScore = (baseCout > 0) ? (newMarge / baseCout) * 100 : 0;
                
                // Update Badge
                sliderLabel.textContent = (ratio === 1) ? 'Normal (100%)' : (this.value + '%');
                sliderLabel.className = 'badge ' + (ratio < 1 ? 'bg-danger' : (ratio > 1 ? 'bg-success' : 'bg-primary'));

                // Update Results
                simScore.textContent = newScore.toFixed(2) + '%';
                
                // Status & Color
                const container = simScore.closest('.bg-success, .bg-danger');
                if (newScore > 0) {
                    container.classList.replace('bg-danger', 'bg-success');
                    simStatus.textContent = newScore > 100 ? 'Très rentable!' : 'Rentable';
                } else {
                    container.classList.replace('bg-success', 'bg-danger');
                    simStatus.textContent = 'Non rentable';
                }
            });
        }
    });
</script>
{% endblock %}
