{% extends 'base.html.twig' %}

{% block title %}Analyse Financière ROI - Ardhi{% endblock %}

{% block stylesheets %}
<style>
    .page-header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #eee; }
    .page-title { font-family: 'Marcellus', serif; color: #116530; font-size: 2.5rem; margin: 0; }
    .premium-card { background: white; border-radius: 24px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 10px 30px rgba(0,0,0,0.04); padding: 30px; height: 100%; }
    .card-label { font-size: 12px; font-weight: 700; color: #116530; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 25px; display: flex; align-items: center; gap: 10px; }
    .form-section { font-size: 0.8rem; font-weight: 700; color: #116530; text-transform: uppercase; letter-spacing: 1px; margin: 20px 0 12px; display: flex; align-items: center; gap: 8px; }
    .form-control, .form-select { border-radius: 12px; padding: 10px 15px; border: 1px solid #eee; transition: all 0.3s; font-size: 0.9rem; }
    .form-control:focus, .form-select:focus { border-color: #116530; box-shadow: 0 0 0 4px rgba(17,101,48,0.05); }
    .form-label { font-weight: 600; color: #2d3436; margin-bottom: 6px; font-size: 0.85rem; }
    .btn-calculate { background: #116530; color: white; border-radius: 50px; padding: 14px; font-weight: 700; border: none; width: 100%; transition: all 0.3s; box-shadow: 0 8px 20px rgba(17,101,48,0.2); display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 20px; }
    .btn-calculate:hover { background: #1e8341; transform: translateY(-2px); }
    .btn-premium-back { color: #116530; background: #e8f5e9; border-radius: 50px; padding: 10px 20px; font-weight: 600; text-decoration: none; transition: all 0.3s; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 20px; }
    .btn-premium-back:hover { background: #116530; color: white; }

    /* Result side */
    .roi-score-box { background: linear-gradient(135deg, #116530, #1e8341); border-radius: 20px; padding: 30px; text-align: center; color: white; margin-bottom: 20px; }
    .roi-score-box .score-num { font-size: 3.5rem; font-weight: 900; line-height: 1; }
    .roi-score-box .score-label { font-size: 0.85rem; opacity: 0.8; margin-top: 5px; }
    .result-metric { background: #f8faf7; border-radius: 14px; padding: 18px; border-left: 4px solid #116530; }
    .result-label { font-size: 0.72rem; font-weight: 700; color: #888; text-transform: uppercase; letter-spacing: 1px; }
    .result-value { font-size: 1.4rem; font-weight: 800; color: #2d3436; }
    .risk-band { border-radius: 14px; padding: 20px; text-align: center; }
    .risk-band.faible { background: #e8f5e9; color: #116530; }
    .risk-band.modere { background: #fff8e1; color: #f59e0b; }
    .risk-band.eleve { background: #fff0f0; color: #e53e3e; }
    .sim-box { background: #f8faf7; border-radius: 16px; padding: 20px; margin-top: 20px; }
    .sim-result { background: #116530; color: white; border-radius: 14px; padding: 20px; text-align: center; }
    .sim-result.loss { background: #e53e3e; }

    /* Weather Container Styling */
    .weather-info-card { background: #f8faf7; border-radius: 18px; padding: 20px; border: 1px solid rgba(17,101,48,0.08); margin-bottom: 25px; transition: all 0.3s; }
    .weather-info-card:hover { border-color: rgba(17,101,48,0.2); background: #f0f7f2; }

    /* Weather Block Styling */
    .weather-block-wrapper { background: #f0f7f2; border-radius: 16px; padding: 15px; border: 1px solid rgba(17,101,48,0.1); margin-top: 10px; }
    .weather-block-header { font-weight: 800; color: #116530; margin-bottom: 15px; display: flex; align-items: center; gap: 10px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; }
    .weather-data-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .weather-item { background: white; padding: 15px 10px; border-radius: 14px; text-align: center; border: 1px solid rgba(17,101,48,0.05); transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); animation: weatherItemIn 0.5s ease-out both; }
    .weather-item:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(17,101,48,0.08); border-color: #116530; }
    .weather-item i { font-size: 1.4rem; color: #116530; margin-bottom: 4px; display: block; filter: drop-shadow(0 2px 4px rgba(17,101,48,0.1)); }
    .weather-item .val { font-weight: 800; font-size: 1.1rem; color: #2d3436; margin-bottom: 2px; }
    .weather-item .val small { font-size: 0.7rem; color: #999; font-weight: 600; }
    .weather-item .lbl { font-size: 0.6rem; color: #116530; text-transform: uppercase; font-weight: 800; letter-spacing: 0.8px; opacity: 0.7; }

    @keyframes weatherItemIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}

{% block body %}
{% include 'parcelles_cultures/components/navigation_menu.html.twig' %}

<div class="container-fluid py-5 px-lg-5">
    <div class="row">
        <div class="col-md-3 col-xl-2">
            {% include 'parcelles_cultures/components/sidebar.html.twig' %}
        </div>

        <div class="col-md-9 col-xl-10">
            <div data-aos="fade-right">
                <a href="{{ path('farmer_roi_index') }}" class="btn-premium-back">
                    <i class="bi bi-arrow-left"></i> Retour au ROI
                </a>
            </div>

            <div class="page-header" data-aos="fade-down">
                <h1 class="page-title">Analyse Financière</h1>
                <p class="text-muted lead mt-2">Calculez votre ROI et évaluez la rentabilité réelle de votre exploitation.</p>
            </div>

            <div class="row g-4">
                {# ===== FORM COLUMN ===== #}
                <div class="col-xl-5" data-aos="fade-right" data-aos-delay="100">
                    <div class="premium-card">
                        <span class="card-label"><i class="bi bi-graph-up-arrow"></i> Paramètres d'Analyse</span>

                        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'roi_form'}}) }}

                        <div class="mb-3">
                            {{ form_label(form.parcelle) }}
                            {{ form_widget(form.parcelle, {'attr': {'class': 'form-select', 'id': 'roi_form_parcelle'}}) }}
                            {% if form.parcelle.vars.errors|length > 0 %}<div class="invalid-feedback d-block">{{ form_errors(form.parcelle) }}</div>{% endif %}
                            <small class="text-muted">La surface sera pré-remplie si possible.</small>
                        </div>

                        <div class="form-section"><i class="bi bi-layers"></i> Production</div>
                        <div class="row g-3 mb-2">
                            <div class="col-6">
                                {{ form_label(form.surface_ha) }}
                                {{ form_widget(form.surface_ha, {'attr': {'class': 'form-control', 'placeholder': '5'}}) }}
                                {% if form.surface_ha.vars.errors|length > 0 %}<div class="invalid-feedback d-block">{{ form_errors(form.surface_ha) }}</div>{% endif %}
                            </div>
                            <div class="col-6">
                                {{ form_label(form.rendement) }}
                                {{ form_widget(form.rendement, {'attr': {'class': 'form-control', 'placeholder': '50'}}) }}
                                {% if form.rendement.vars.errors|length > 0 %}<div class="invalid-feedback d-block">{{ form_errors(form.rendement) }}</div>{% endif %}
                            </div>
                        </div>

                        <div class="form-section"><i class="bi bi-cloud-sun"></i> Conditions Climatiques (Auto)</div>
                        <div class="weather-info-card">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-info-circle-fill text-success"></i> 
                                <strong style="font-size: 0.85rem; color: #116530;">Météo en temps réel</strong>
                            </div>
                            <span id="weather-status" style="display: block; font-size: 0.8rem; opacity: 0.8; color: #666;">
                                <i class="bi bi-geo-alt"></i> Sélectionnez une parcelle pour charger la météo locale
                            </span>
                            
                            <!-- Bloc météo détaillé (sera rempli par JS) -->
                            <div id="weather-block" class="weather-block-wrapper" style="display: none;">
                                <!-- Injecté par RoiAnalyzer -->
                            </div>
                        </div>

                        <!-- Champs cachés pour envoyer au Python -->
                        {{ form_widget(form.jours_canicule, {'attr': {'class': 'form-control', 'style': 'display: none;'}}) }}
                        {{ form_widget(form.jours_excespluie, {'attr': {'class': 'form-control', 'style': 'display: none;'}}) }}
                        {{ form_widget(form.jours_gel, {'attr': {'class': 'form-control', 'style': 'display: none;'}}) }}

                        <div class="form-section"><i class="bi bi-cash-stack"></i> Coûts de Production (DT)</div>
                        <div class="row g-3 mb-2">
                            <div class="col-6">
                                {{ form_label(form.cout_semences) }}
                                {{ form_widget(form.cout_semences, {'attr': {'class': 'form-control', 'placeholder': '1000'}}) }}
                            </div>
                            <div class="col-6">
                                {{ form_label(form.cout_engrais) }}
                                {{ form_widget(form.cout_engrais, {'attr': {'class': 'form-control', 'placeholder': '2000'}}) }}
                            </div>
                            <div class="col-6">
                                {{ form_label(form.cout_main_oeuvre) }}
                                {{ form_widget(form.cout_main_oeuvre, {'attr': {'class': 'form-control', 'placeholder': '1500'}}) }}
                            </div>
                            <div class="col-6">
                                {{ form_label(form.cout_irrigation) }}
                                {{ form_widget(form.cout_irrigation, {'attr': {'class': 'form-control', 'placeholder': '500'}}) }}
                            </div>
                            <div class="col-12">
                                {{ form_label(form.cout_autres) }}
                                {{ form_widget(form.cout_autres, {'attr': {'class': 'form-control', 'placeholder': '300'}}) }}
                            </div>
                        </div>

                        <div class="form-section"><i class="bi bi-tag"></i> Prix de Vente</div>
                        <div class="mb-4">
                            {{ form_label(form.prix_vente) }}
                            {{ form_widget(form.prix_vente, {'attr': {'class': 'form-control', 'placeholder': '5'}}) }}
                            {% if form.prix_vente.vars.errors|length > 0 %}<div class="invalid-feedback d-block">{{ form_errors(form.prix_vente) }}</div>{% endif %}
                            <small class="text-muted">Prix par unité de production (DT)</small>
                        </div>

                        <div class="form-section"><i class="bi bi-bank"></i> Financement</div>
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                {{ form_label(form.duree_pret) }}
                                <span class="badge bg-success" id="duree-val">5 ans</span>
                            </div>
                            {{ form_widget(form.duree_pret) }}
                            <small class="text-muted">Durée utilisée pour calculer votre capacité d'emprunt maximale.</small>
                        </div>

                        <button type="submit" class="btn-calculate">
                            <i class="bi bi-bar-chart-line-fill"></i> Analyser la Rentabilité
                        </button>

                        {{ form_end(form) }}
                    </div>
                </div>

                {# ===== RESULTS COLUMN ===== #}
                <div class="col-xl-7" id="roi-results-container" data-aos="fade-left">
                {% if roi_result %}
                    <div class="premium-card">
                        <span class="card-label"><i class="bi bi-trophy-fill"></i> Résultats de l'Analyse</span>

                        <div class="roi-score-box">
                            <div class="score-label">Score ROI Global</div>
                            <div class="score-num">{{ roi_result.score_roi|round(1) }}%</div>
                            <div class="mt-2">
                                {% if roi_result.score_roi > 100 %}
                                    <span class="badge bg-white text-success fw-bold">🚀 Très Rentable</span>
                                {% elseif roi_result.score_roi > 0 %}
                                    <span class="badge bg-white text-warning fw-bold">✅ Rentable</span>
                                {% else %}
                                    <span class="badge bg-white text-danger fw-bold">⚠️ Non Rentable</span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <div class="result-metric">
                                    <div class="result-label">Production Réelle</div>
                                    <div class="result-value">{{ roi_result.production_reelle|round(0) }} <small style="font-size:.9rem; color:#888">un.</small></div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="result-metric">
                                    <div class="result-label">Revenu Brut</div>
                                    <div class="result-value">{{ roi_result.revenu_brut|round(0)|number_format(0,'.', ' ') }} <small style="font-size:.9rem; color:#888">DT</small></div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="result-metric">
                                    <div class="result-label">Coût Total</div>
                                    <div class="result-value" style="color:#e67e22;">{{ roi_result.cout_total|round(0)|number_format(0,'.', ' ') }} <small style="font-size:.9rem; color:#888">DT</small></div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="result-metric">
                                    <div class="result-label">Facteur Climatique</div>
                                    <div class="result-value">{{ roi_result.facteur_climatique|round(3) }}</div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="result-metric">
                                    <div class="result-label">Capacité Remboursement</div>
                                    <div class="result-value">{{ roi_result.capacite_remboursement|round(0)|number_format(0,'.', ' ') }} <small style="font-size:.9rem; color:#888">DT</small></div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="result-metric">
                                    <div class="result-label">Prêt Max ({{ form.vars.value.duree_pret }} ans)</div>
                                    <div class="result-value">{{ roi_result.montant_pret_max|round(0)|number_format(0,'.', ' ') }} <small style="font-size:.9rem; color:#888">DT</small></div>
                                </div>
                            </div>
                        </div>

                        <div class="risk-band {{ roi_result.risque_niveau == 'Faible' ? 'faible' : (roi_result.risque_niveau == 'Modéré' ? 'modere' : 'eleve') }} mb-4">
                            <div style="font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:1px; opacity:.7;">Évaluation du Risque</div>
                            <div style="font-size:2rem; font-weight:900;">{{ roi_result.risque_score|round(1) }} / 10</div>
                            <div class="fw-bold">Risque {{ roi_result.risque_niveau }}</div>
                        </div>

                        <div class="sim-box">
                            <div class="card-label mb-3" style="font-size: 10px;"><i class="bi bi-sliders"></i> Simulateur de prix (Variation)</div>
                            <input type="range" class="form-range" min="50" max="150" value="100" id="simulationSlider">
                            <div class="d-flex justify-content-between mt-2">
                                <span class="text-muted small">-50%</span>
                                <span class="badge bg-success" id="sliderValue">Normal (100%)</span>
                                <span class="text-muted small">+50%</span>
                            </div>

                            <div class="sim-result mt-3" id="simContainer">
                                <div style="font-size:.75rem; opacity:.7; text-transform:uppercase; letter-spacing:1px;">Score ROI Simulé</div>
                                <div style="font-size:2.5rem; font-weight:900;" id="simScore">{{ roi_result.score_roi|round(2) }}%</div>
                                <small id="simStatus">{% if roi_result.score_roi > 100 %}Très rentable!{% elseif roi_result.score_roi > 0 %}Rentable{% else %}Non rentable{% endif %}</small>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="d-flex align-items-center justify-content-center" style="min-height: 400px;">
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-bar-chart" style="font-size: 4rem; color: #cce8d8;"></i>
                            <h4 class="mt-3" style="color: #bbb;">Résultats ici</h4>
                            <p>Remplissez le formulaire et lancez l'analyse pour voir vos résultats financiers.</p>
                        </div>
                    </div>
                {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/roi-analyzer.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const ANALYZE_URL = "{{ path('farmer_roi_analyze') }}";

    // Trouver le formulaire
    const form = document.getElementById('roi_form');
    console.log('📋 Form found:', form);
    
    if (form) {
        // Créer une instance et la stocker globalement
        window.roiAnalyzer = new RoiAnalyzer(ANALYZE_URL);
        console.log('✅ RoiAnalyzer initialized with URL:', ANALYZE_URL);
    } else {
        console.error('❌ Form not found!');
    }

    // Gestion du slider de durée de prêt
    const dureeSlider = document.getElementById('{{ form.duree_pret.vars.id }}');
    const dureeValue = document.getElementById('duree-val');
    if (dureeSlider && dureeValue) {
        dureeSlider.addEventListener('input', function() {
            dureeValue.textContent = this.value + ' ans';
        });
    }

    // Gestion de la surface (déjà géré par RoiAnalyzer mais on garde un backup local si besoin)
    const parcelleSelect = document.getElementById('roi_form_parcelle');
    const surfaceInput = document.getElementById('{{ form.surface_ha.vars.id }}');
    if (parcelleSelect && surfaceInput) {
        parcelleSelect.addEventListener('change', function() {
            const surface = this.options[this.selectedIndex].getAttribute('data-surface');
            if (surface) surfaceInput.value = surface;
        });
    }

    const slider = document.getElementById('simulationSlider');
    if (slider) {
        const baseRevenu = {{ roi_result.revenu_brut|default(0) }};
        const baseCout = {{ roi_result.cout_total|default(0) }};
        const simScore = document.getElementById('simScore');
        const simStatus = document.getElementById('simStatus');
        const simContainer = document.getElementById('simContainer');
        const sliderLabel = document.getElementById('sliderValue');

        slider.addEventListener('input', function() {
            const ratio = this.value / 100;
            const newMarge = (baseRevenu * ratio) - baseCout;
            const newScore = baseCout > 0 ? (newMarge / baseCout) * 100 : 0;

            sliderLabel.textContent = ratio === 1 ? 'Normal (100%)' : (this.value + '%');
            sliderLabel.className = 'badge ' + (ratio < 1 ? 'bg-danger' : ratio > 1 ? 'bg-success' : 'bg-success');
            simScore.textContent = newScore.toFixed(1) + '%';

            if (newScore > 0) {
                simContainer.classList.remove('loss');
                simStatus.textContent = newScore > 100 ? 'Très rentable!' : 'Rentable';
            } else {
                simContainer.classList.add('loss');
                simStatus.textContent = 'Non rentable';
            }
        });
    }
});
</script>
{% endblock %}
