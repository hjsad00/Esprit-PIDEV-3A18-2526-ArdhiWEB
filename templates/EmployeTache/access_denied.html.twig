{% extends 'base.html.twig' %}
{% block title %}Accès refusé — Ardhi{% endblock %}

{% block stylesheets %}
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');

.denied-page {
    padding: 120px 0 60px;
    background: linear-gradient(135deg, #f0f7f2 0%, #e8f5e9 50%, #f1f8e9 100%);
    min-height: 100vh;
    font-family: 'Inter', sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
}
.denied-card {
    background: white;
    border-radius: 24px;
    padding: 50px 40px;
    max-width: 520px;
    width: 100%;
    text-align: center;
    box-shadow: 0 8px 40px rgba(0,0,0,.08);
    border: 1px solid rgba(0,0,0,.04);
}
.denied-icon {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e74c3c, #c0392b);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    font-size: 2.5rem;
    box-shadow: 0 6px 24px rgba(231,76,60,.25);
}
.denied-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #1B5E20;
    margin-bottom: 12px;
}
.denied-text {
    font-size: 1rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 28px;
}
.denied-text strong {
    color: #2E7D32;
}
.denied-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 12px;
    font-weight: 700;
    font-size: .92rem;
    text-decoration: none;
    transition: all .2s;
    background: linear-gradient(135deg, #1B5E20, #2E7D32);
    color: white;
    box-shadow: 0 4px 16px rgba(27,94,32,.25);
}
.denied-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(27,94,32,.3);
    color: white;
}
</style>
{% endblock %}

{% block body %}
<div class="denied-page">
    <div class="denied-card">
        <div class="denied-icon">🚫</div>
        <h1 class="denied-title">Accès Refusé</h1>
        <p class="denied-text">
            Ce service est dédié uniquement aux <strong>administrateurs</strong>
            et aux <strong>agriculteurs</strong>.<br><br>
            Votre rôle actuel ne vous permet pas d'accéder à la gestion
            des employés et des tâches.
        </p>
        <a href="{{ path('app_home') }}" class="denied-btn">
            <i class="bi bi-house-door-fill"></i> Retour à l'accueil
        </a>
    </div>
</div>
{% endblock %}
