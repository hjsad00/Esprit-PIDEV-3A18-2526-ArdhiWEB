<style>
.meteo-glass-panel {
    background: rgba(15, 23, 42, 0.7); /* dark slate blue translucent */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    padding: 1rem 1.5rem;
    color: white;
    width: 100%;
    margin-bottom: 2rem;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
}

.meteo-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.meteo-header {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.meteo-icon {
    font-size: 2.5rem;
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.3));
    display: flex;
    align-items: center;
    justify-content: center;
}

.meteo-info h2 {
    margin: 0;
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.1;
    font-family: inherit;
}

.meteo-info p {
    margin: 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.8);
    text-transform: capitalize;
}

.meteo-stats {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}

.meteo-stat-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.9);
}

.meteo-stat-item i {
    color: #3b82f6;
    font-size: 1rem;
}

.meteo-alerts-container {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.meteo-alert-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

/* Alert Items Style */
.meteo-alert {
    padding: 0.6rem 0.8rem;
    border-radius: 6px;
    font-size: 0.85rem;
    border-left: 3px solid;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.meteo-alert p {
    margin: 0;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.9);
}

.alert-positive {
    background: rgba(34, 197, 94, 0.15);
    border-left-color: #22c55e;
}

.alert-warning {
    background: rgba(245, 158, 11, 0.15);
    border-left-color: #f59e0b;
}

.alert-danger {
    background: rgba(239, 68, 68, 0.15);
    border-left-color: #ef4444;
}

.alert-info {
    background: rgba(59, 130, 246, 0.15);
    border-left-color: #3b82f6;
}
</style>

<div class="meteo-glass-panel">
    {% if not weather.available %}
        <div class="meteo-top-row">
            <div class="meteo-header">
                <div class="meteo-icon">⚠️</div>
                <div class="meteo-info">
                    <h2>N/A</h2>
                    <p>{{ 'meteo.widget_title'|trans }}</p>
                    <small style="color: rgba(255,255,255,0.6);">{{ weather.description }}</small>
                </div>
            </div>
        </div>
    {% else %}
        <div class="meteo-top-row">
            <div class="meteo-header">
                <div class="meteo-icon">
                    <img src="https://openweathermap.org/img/wn/{{ weather.iconCode }}@2x.png" alt="Météo" width="60" height="60" style="object-fit: contain;">
                </div>
                <div class="meteo-info">
                    <h2>{{ weather.temperature|round }}°C</h2>
                    <p>{{ weather.description }}</p>
                </div>
            </div>

            <div class="meteo-stats">
                <div class="meteo-stat-item">
                    <i class="bi bi-droplet-fill"></i>
                    {{ weather.humidity }}% <span style="font-size: 0.8em; opacity: 0.8;">{{ 'meteo.humidity'|trans }}</span>
                </div>
                <div class="meteo-stat-item">
                    <i class="bi bi-wind" style="color: #cbd5e1;"></i>
                    {{ weather.windSpeed|round }} km/h <span style="font-size: 0.8em; opacity: 0.8;">{{ 'meteo.wind'|trans }}</span>
                </div>
                <div class="meteo-stat-item">
                    <i class="bi bi-thermometer-half" style="color: #f59e0b;"></i>
                    <span style="font-size: 0.8em; opacity: 0.8;">{{ 'meteo.temp'|trans }}</span> {{ weather.feelsLike|round }}°C
                </div>
            </div>
        </div>
        
        <div class="meteo-alerts-container">
            <div class="meteo-alert-list">
                {% if recommandations|length > 0 %}
                    {% for reco in recommandations %}
                        {% set alertClass = 'alert-info' %}
                        {% if reco.niveau == 'POSITIVE' %}
                            {% set alertClass = 'alert-positive' %}
                        {% elseif reco.niveau == 'WARNING' %}
                            {% set alertClass = 'alert-warning' %}
                        {% elseif reco.niveau == 'DANGER' %}
                            {% set alertClass = 'alert-danger' %}
                        {% endif %}

                        <div class="meteo-alert {{ alertClass }}">
                            <p>{{ reco.message }}</p>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="meteo-alert alert-info" style="border-left-color: #94a3b8; background: rgba(148, 163, 184, 0.1);">
                        <p>{{ 'notification.empty'|trans }}</p>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>
