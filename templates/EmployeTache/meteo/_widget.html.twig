<style>
.meteo-glass-panel {
    background: rgba(15, 23, 42, 0.7); /* dark slate blue translucent */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    padding: 1.5rem;
    color: white;
    width: 100%;
    margin-bottom: 2rem;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
}

.meteo-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.meteo-icon {
    font-size: 3rem;
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.3));
}

.meteo-info h2 {
    margin: 0;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.1;
    font-family: inherit;
}

.meteo-info p {
    margin: 0;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    text-transform: capitalize;
}

.meteo-stats {
    display: flex;
    gap: 2rem;
    margin-bottom: 1.5rem;
}

.meteo-stat-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.9);
}

.meteo-stat-item i {
    color: #3b82f6;
    font-size: 1.1rem;
}

.meteo-alerts-title {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 1rem;
    font-weight: 600;
}

.meteo-alert-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

/* Alert Items Style */
.meteo-alert {
    padding: 0.8rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    border-left: 4px solid;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
}

.meteo-alert p {
    margin: 0;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.9);
}

.alert-positive {
    background: rgba(34, 197, 94, 0.15);
    border-left-color: #22c55e;
}

.alert-warning {
    background: rgba(245, 158, 11, 0.15);
    border-left-color: #f59e0b;
}

.alert-danger {
    background: rgba(239, 68, 68, 0.15);
    border-left-color: #ef4444;
}

.alert-info {
    background: rgba(59, 130, 246, 0.15);
    border-left-color: #3b82f6;
}
</style>

<div class="meteo-glass-panel">
    {% if not weather.available %}
        <div class="meteo-header">
            <div class="meteo-icon">⚠️</div>
            <div class="meteo-info">
                <h2>N/A</h2>
                <p>Météo indisponible</p>
                <small>{{ weather.description }}</small>
            </div>
        </div>
    {% else %}
        <div class="meteo-header">
            <div class="meteo-icon">
                <img src="https://openweathermap.org/img/wn/{{ weather.iconCode }}@2x.png" alt="Météo" width="80" height="80">
            </div>
            <div class="meteo-info">
                <h2>{{ weather.temperature|round }}°C</h2>
                <p>{{ weather.description }}</p>
            </div>
        </div>

        <div class="meteo-stats">
            <div class="meteo-stat-item">
                <i class="bi bi-droplet-fill"></i>
                {{ weather.humidity }}% Humidité
            </div>
            <div class="meteo-stat-item">
                <i class="bi bi-wind" style="color: #cbd5e1;"></i>
                {{ weather.windSpeed|round }} km/h
            </div>
            <div class="meteo-stat-item">
                <i class="bi bi-thermometer-half" style="color: #f59e0b;"></i>
                Ressenti {{ weather.feelsLike|round }}°C
            </div>
        </div>
        
        <div class="meteo-alerts-title">Alertes Météo Agricoles</div>
        <div class="meteo-alert-list">
            {% if recommandations|length > 0 %}
                {% for reco in recommandations %}
                    {% set alertClass = 'alert-info' %}
                    {% if reco.niveau == 'POSITIVE' %}
                        {% set alertClass = 'alert-positive' %}
                    {% elseif reco.niveau == 'WARNING' %}
                        {% set alertClass = 'alert-warning' %}
                    {% elseif reco.niveau == 'DANGER' %}
                        {% set alertClass = 'alert-danger' %}
                    {% endif %}

                    <div class="meteo-alert {{ alertClass }}">
                        <p>{{ reco.message }}</p>
                    </div>
                {% endfor %}
            {% else %}
                <div class="meteo-alert alert-info" style="border-left-color: #94a3b8; background: rgba(148, 163, 184, 0.1);">
                    <p>Aucune recommandation critique pour les tâches d'aujourd'hui.</p>
                </div>
            {% endif %}
        </div>
    {% endif %}
</div>
