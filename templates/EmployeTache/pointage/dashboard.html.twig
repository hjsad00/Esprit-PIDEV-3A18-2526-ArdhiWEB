{% extends 'base.html.twig' %}
{% block title %}Pointage GPS — Ardhi{% endblock %}
{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600&family=Cormorant+Garamond:wght@600&display=swap" rel="stylesheet">
<style>
:root{--g900:#0a1a0f;--g800:#0f2218;--g700:#163821;--g600:#1e4d2e;--g500:#2a6b3f;--g400:#3d8f56;--g300:#5dae74;--g200:#8ecfa0;--g100:#c2e8cb;--gold:#c9a84c;--red:#e05454;--text1:#f0f7f1;--text2:#8ab598;--text3:#4a6b52;--border:rgba(93,174,116,.12);--border2:rgba(93,174,116,.22);--card:#0f2218}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--g900);color:var(--text1);font-family:'Plus Jakarta Sans',sans-serif}
.pt{min-height:100vh;padding-bottom:80px}
.pt-hd{background:var(--g800);border-bottom:1px solid var(--border);padding:2rem 2.5rem 1.75rem;position:relative;overflow:hidden}
.pt-hd::after{content:'';position:absolute;top:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,rgba(93,174,116,.05),transparent 65%);pointer-events:none}
.pt-bc{font-size:11px;color:var(--text3);text-transform:uppercase;letter-spacing:.07em;margin-bottom:.75rem}
.pt-bc a{color:var(--g300);text-decoration:none}
.pt-h1{font-family:'Cormorant Garamond',serif;font-size:clamp(28px,3.5vw,40px);font-weight:600;color:var(--text1)}
.pt-h1 em{color:var(--g300);font-style:normal}
.pt-desc{font-size:13px;color:var(--text2);margin-top:.4rem}

/* KPIs */
.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border-bottom:1px solid var(--border)}
@media(max-width:700px){.kpi-row{grid-template-columns:repeat(2,1fr)}}
.kc{background:var(--g800);padding:1.25rem 1.5rem;opacity:0;transform:translateY(8px);animation:up .4s ease forwards}
.kc:nth-child(1){animation-delay:.05s}.kc:nth-child(2){animation-delay:.10s}.kc:nth-child(3){animation-delay:.15s}.kc:nth-child(4){animation-delay:.20s}
.kc-l{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.07em;margin-bottom:.35rem}
.kc-n{font-size:22px;font-weight:600}
.kc-n.g{color:var(--g300)}.kc-n.r{color:var(--red)}.kc-n.gold{color:var(--gold)}
.kc-u{font-size:10px;color:var(--text3);margin-top:2px}

/* BODY */
.pt-body{max-width:1400px;margin:0 auto;padding:2rem 2.5rem}
.pt-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:1.5rem;margin-bottom:1.5rem}
@media(max-width:1000px){.pt-grid{grid-template-columns:1fr}}

/* CARD */
.card{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;opacity:0;transform:translateY(12px);animation:up .5s ease forwards}
.card:nth-child(1){animation-delay:.3s}.card:nth-child(2){animation-delay:.4s}
.chd{display:flex;align-items:center;justify-content:space-between;padding:1.1rem 1.5rem;border-bottom:1px solid var(--border)}
.chd-t{font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.07em}
.badge{font-size:10px;font-weight:600;padding:3px 10px;border-radius:20px}
.bg{background:rgba(61,143,86,.18);color:var(--g300);border:1px solid rgba(61,143,86,.25)}
.br{background:rgba(224,84,84,.1);color:var(--red)}

/* PRÉSENCE */
.pres-item{display:flex;align-items:center;gap:12px;padding:.9rem 1.5rem;border-bottom:1px solid var(--border)}
.pres-item:last-child{border-bottom:none}
.pres-av{width:38px;height:38px;border-radius:50%;object-fit:cover;border:2px solid rgba(93,174,116,.3);flex-shrink:0}
.pres-av-i{width:38px;height:38px;border-radius:50%;background:rgba(61,143,86,.15);border:2px solid rgba(93,174,116,.3);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600;color:var(--g300);flex-shrink:0}
.pres-nm{font-size:13px;font-weight:500;color:var(--text1)}
.pres-ps{font-size:11px;color:var(--text3)}
.pres-times{margin-left:auto;text-align:right}
.pres-hr{font-size:12px;font-weight:500;color:var(--g300)}
.pres-dist{font-size:10px;color:var(--text3)}
.abs-item{display:flex;align-items:center;gap:10px;padding:.75rem 1.5rem;border-bottom:1px solid var(--border)}
.abs-item:last-child{border-bottom:none}
.abs-dot{width:7px;height:7px;border-radius:50%;background:var(--red);flex-shrink:0}
.abs-nm{font-size:13px;color:var(--text2);flex:1}
.abs-ps{font-size:11px;color:var(--text3)}
.btn-qr{font-size:11px;padding:4px 10px;border:1px solid rgba(93,174,116,.25);border-radius:8px;background:transparent;color:var(--g300);cursor:pointer;transition:all .2s;text-decoration:none;display:inline-block}
.btn-qr:hover{background:rgba(93,174,116,.1)}

/* CONFIG FERME */
.config-form{padding:1.25rem 1.5rem}
.config-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.lbl{font-size:11px;color:var(--text3);margin-bottom:4px}
input[type=number],input[type=text]{background:var(--g700);border:1px solid var(--border);color:var(--text1);border-radius:8px;padding:8px 10px;font-size:13px;width:100%;font-family:inherit}
input:focus{outline:none;border-color:var(--g400)}
.btn-save{background:var(--g500);color:#fff;border:none;border-radius:10px;padding:10px 24px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:all .2s;margin-top:.5rem}
.btn-save:hover{background:var(--g400)}
.btn-locate{background:transparent;border:1px solid var(--border2);color:var(--g300);border-radius:10px;padding:10px 16px;font-size:12px;cursor:pointer;font-family:inherit;transition:all .2s;margin-right:8px}
.btn-locate:hover{background:rgba(93,174,116,.08)}

/* STATS 7J */
.stats-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;padding:1.25rem 1.5rem}
.stat-day{text-align:center}
.stat-bar-wrap{height:60px;display:flex;flex-direction:column;justify-content:flex-end;margin-bottom:4px}
.stat-bar{border-radius:3px 3px 0 0;background:var(--g500);min-height:3px;transition:height 1s ease}
.stat-lbl{font-size:10px;color:var(--text3)}
.stat-n{font-size:11px;font-weight:600;color:var(--g300)}

/* ANIMS */
@keyframes up{to{opacity:1;transform:translateY(0)}}
</style>
{% endblock %}

{% block body %}
<div class="pt">
{# HEADER #}
<div class="pt-hd">
  <div style="max-width:1400px;margin:0 auto">
    <div class="pt-bc"><a href="{{ path('employe_index') }}">Employés</a> › <a href="{{ path('finance_rh_dashboard') }}">Finance RH</a> › Pointage GPS</div>
    <div class="pt-h1">Pointage <em>GPS</em></div>
    <div class="pt-desc">Présence en temps réel · Validation Haversine · Aucune API externe</div>
  </div>
</div>

{# KPIs #}
<div class="kpi-row">
  <div class="kc"><div class="kc-l">Présents aujourd'hui</div><div class="kc-n g">{{ nbPresents }}</div><div class="kc-u">employés sur site</div></div>
  <div class="kc"><div class="kc-l">Absents</div><div class="kc-n r">{{ nbAbsents }}</div><div class="kc-u">sur {{ totalEmployes }} actifs</div></div>
  <div class="kc"><div class="kc-l">Taux de présence</div><div class="kc-n gold">{{ tauxPresence }}%</div><div class="kc-u">aujourd'hui</div></div>
  <div class="kc"><div class="kc-l">Rayon validation</div><div class="kc-n">{{ rayonValidation }}</div><div class="kc-u">mètres</div></div>
</div>

{# BODY #}
<div class="pt-body">
<div class="pt-grid">

{# PRÉSENTS #}
<div class="card">
  <div class="chd">
    <div class="chd-t">Présents aujourd'hui</div>
    <div class="badge bg">{{ nbPresents }} sur site</div>
  </div>
  {% if presents is empty %}
    <div style="text-align:center;padding:2.5rem;color:var(--text3);font-size:13px">Aucun pointage enregistré aujourd'hui</div>
  {% endif %}
  {% for p in presents %}
  <div class="pres-item">
    {% if p.employe.photoPath %}
      <img src="{{ p.employe.photoPath }}" class="pres-av" alt="">
    {% else %}
      <div class="pres-av-i">{{ p.employe.prenom|first }}{{ p.employe.nom|first }}</div>
    {% endif %}
    <div>
      <div class="pres-nm">{{ p.employe.prenom }} {{ p.employe.nom }}</div>
      <div class="pres-ps">{{ p.employe.poste }}</div>
    </div>
    <div class="pres-times">
      <div class="pres-hr">
        → {{ p.arrivee.dateHeure|date('H:i') }}
        {% if p.depart %}← {{ p.depart.dateHeure|date('H:i') }}{% endif %}
      </div>
      <div class="pres-dist">{{ p.arrivee.distanceFerme|round(0) }} m de la ferme</div>
    </div>
  </div>
  {% endfor %}

  {# ABSENTS #}
  {% if absents is not empty %}
  <div class="chd" style="border-top:1px solid var(--border)">
    <div class="chd-t">Non pointés</div>
    <div class="badge br">{{ nbAbsents }}</div>
  </div>
  {% for emp in absents %}
  <div class="abs-item">
    <div class="abs-dot"></div>
    <div>
      <div class="abs-nm">{{ emp.prenom }} {{ emp.nom }}</div>
      <div class="abs-ps">{{ emp.poste }}</div>
    </div>
    <a href="{{ path('pointage_mobile', {idEmploye: emp.id}) }}"
       class="btn-qr" target="_blank">
      Pointer
    </a>
  </div>
  {% endfor %}
  {% endif %}
</div>

{# CONFIG + STATS #}
<div>
  {# CONFIG FERME #}
  <div class="card" style="margin-bottom:1.5rem">
    <div class="chd">
      <div class="chd-t">Configuration de la ferme</div>
    </div>
    <div class="config-form">
      <div class="config-row">
        <div><div class="lbl">Latitude</div>
          <input type="number" id="cfgLat" step="0.0000001" value="{{ fermeLat }}" placeholder="36.8065000"></div>
        <div><div class="lbl">Longitude</div>
          <input type="number" id="cfgLng" step="0.0000001" value="{{ fermeLng }}" placeholder="10.1815000"></div>
      </div>
      <div class="config-row">
        <div><div class="lbl">Rayon de validation (m)</div>
          <input type="number" id="cfgRayon" value="{{ rayonValidation }}" min="50" max="5000"></div>
        <div><div class="lbl">Nom de la ferme</div>
          <input type="text" id="cfgNom" value="Ma ferme" placeholder="Exploitation ARDHI"></div>
      </div>
      <div>
        <button class="btn-locate" onclick="localiserMaFerme()">Utiliser ma position</button>
        <button class="btn-save" onclick="sauvegarderConfig()">Enregistrer</button>
      </div>
      <p style="font-size:11px;color:var(--text3);margin-top:.75rem">
        La formule Haversine calcule la distance GPS sans API externe.
        Rayon recommandé : 300–500 m.
      </p>
    </div>
  </div>

  {# STATS 7J #}
  <div class="card">
    <div class="chd"><div class="chd-t">Présence 7 derniers jours</div></div>
    <div class="stats-grid" id="statsGrid">
      {% if stats7j is defined and stats7j is not empty %}
      {% set maxP = 1 %}
      {% for s in stats7j %}{% if s.nb > maxP %}{% set maxP = s.nb %}{% endif %}{% endfor %}
      {% for s in stats7j %}
      <div class="stat-day">
        <div class="stat-bar-wrap">
          <div class="stat-bar" style="height:{{ ((s.nb / maxP) * 50)|round }}px"></div>
        </div>
        <div class="stat-n">{{ s.nb }}</div>
        <div class="stat-lbl">{{ s.jour }}</div>
      </div>
      {% endfor %}
      {% else %}
      <div style="grid-column:1/-1;text-align:center;padding:1.5rem;font-size:13px;color:var(--text3)">
        Données disponibles après les premiers pointages
      </div>
      {% endif %}
    </div>
  </div>
</div>
</div>{# /grid #}
</div>{# /body #}
</div>
{% endblock %}

{% block javascripts %}
<script>
function localiserMaFerme() {
  if (!navigator.geolocation) { alert('Géolocalisation non supportée.'); return; }
  navigator.geolocation.getCurrentPosition(pos => {
    document.getElementById('cfgLat').value = pos.coords.latitude.toFixed(7);
    document.getElementById('cfgLng').value = pos.coords.longitude.toFixed(7);
  }, () => alert('Impossible d\'obtenir la position.'), { enableHighAccuracy: true });
}

function sauvegarderConfig() {
  const data = {
    latitude:  parseFloat(document.getElementById('cfgLat').value),
    longitude: parseFloat(document.getElementById('cfgLng').value),
    rayon:     parseInt(document.getElementById('cfgRayon').value),
    nom:       document.getElementById('cfgNom').value,
  };
  fetch('/pointage/api/config-ferme', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify(data)
  }).then(r=>r.json()).then(d=>{
    if(d.success) { alert('Configuration enregistrée.'); location.reload(); }
    else alert('Erreur : ' + (d.message||'Inconnue'));
  });
}
</script>
{% endblock %}
