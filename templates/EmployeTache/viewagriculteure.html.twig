{% extends 'base.html.twig' %}

{% block title %}Ardhi - Gestion Employés{% endblock %}

{% block body_class %}marketplace-page{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/marketplace/marketplace.css') }}" rel="stylesheet">
    <style>
        .notif-badge-circle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #e74c3c;
            color: white;
            border-radius: 50%;
            min-width: 22px;
            height: 22px;
            font-size: 11px;
            font-weight: 700;
            margin-left: 6px;
            padding: 0 4px;
            vertical-align: middle;
            animation: pulse-badge 1.5s ease-in-out infinite;

        }
        @keyframes pulse-badge {
            0%, 100% { transform: scale(1); }
            50%       { transform: scale(1.15); }
        }

        /* Styles Sélecteur de Langue */
        .lang-circle {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white !important;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            cursor: pointer;
        }
        .lang-circle:hover, .lang-circle.active {
            background: #116530;
            border-color: #116530;
            transform: scale(1.1);
        }

        /* Support RTL Dynamique */
        [dir="rtl"] .hero-inner {
            flex-direction: row-reverse;
        }
        [dir="rtl"] .hero-left {
            text-align: right !important;
        }
        [dir="rtl"] .hero-headline br {
            display: none;
        }
        
        .hero-description {
            font-size: 1.05rem; /* Rendre un petit peu plus petit en haut */
            line-height: 1.5;
            max-width: 600px;
            opacity: 0.9;
        }
        [dir="rtl"] .category-item {
            flex-direction: row-reverse;
            text-align: right;
            border-left: none !important;
            border-right: 4px solid transparent;
        }
        [dir="rtl"] .category-item:hover {
            border-right-color: #116530;
        }
        [dir="rtl"] .category-icon {
            margin-left: 1.5rem;
            margin-right: 0;
        }
        [dir="rtl"] .hero-btn-primary i {
            margin-left: 8px;
            margin-right: 0;
        }
        .category-item--finance:hover {
          border-left-color: #c9a84c !important;
        }
        .category-item--finance:hover .category-icon {
          transform: scale(1.05);
          transition: transform .2s;
        }

    </style>
{% endblock %}

{% block body %}

    <section class="marketplace-hero">
      <div class="hero-bg">
       <img src="{{ asset('assets/img/emp4.jpg?v=2') }}">
      </div>

      <div class="container">
        <div class="hero-inner">

          <div class="hero-left">
            <div class="hero-label">{{ 'dashboard.rh_label'|trans }}</div>
            <h1 class="hero-headline">
              {{ 'dashboard.title'|trans|raw|replace({'Employés': 'employés ', 'Tâches': 'tâches'}) }}
            </h1>
            <p class="hero-description">
              {{ 'dashboard.subtitle'|trans }}
            </p>

            <a href="{{ path('employe_index') }}" class="hero-btn-primary" style="margin-bottom: 2rem;">
              <i class="bi bi-people"></i> {{ 'employe.go_tasks'|trans }}
            </a>
            
            <!-- Widget Météo Agricole moved to left -->
            <div style="margin-top: 1rem; max-width: 90%;">
               {{ render(controller('App\\Controller\\EmployeTache\\MeteoController::widgetMeteo')) }}
            </div>
          </div>

          <div class="hero-right">
            <div class="categories-glass-panel">

              <div class="categories-panel-title">
                {{ 'dashboard.services'|trans }}
              </div>

              {# EMPLOYES — connecté ✅ #}
              <a href="{{ path('employe_index') }}" class="category-item">
                <div class="category-icon">
                  <i class="bi bi-people-fill"></i>
                </div>
                <div class="category-text">
                  <h4>{{ 'dashboard.card.employees'|trans }}</h4>
                  <span>{{ 'dashboard.card.employees_desc'|trans }}</span>
                </div>
              </a>

              {# TACHES — connecté ✅ #}
              <a href="{{ path('tache_index') }}" class="category-item">
                <div class="category-icon">
                  <i class="bi bi-list-check"></i>
                </div>
                <div class="category-text">
                  <h4>{{ 'dashboard.card.tasks'|trans }}</h4>
                  <span>{{ 'dashboard.card.tasks_desc'|trans }}</span>
                </div>
              </a>

              {# GESTION EMPLOYES — FIN DE LISTE #}
              <a href="{{ path('finance_rh_dashboard') }}" class="category-item category-item--finance">
                <div class="category-icon" style="background:rgba(201,168,76,.15);color:#c9a84c">
                  <i class="bi bi-currency-exchange"></i>
                </div>
                <div class="category-text">
                  <h4>Finance RH</h4>
                  <span>Paie · CNSS · Coûts</span>
                </div>
              </a>

            </div>

          </div>

        </div>
      </div>
    </section>

    {% include 'EmployeTache/rh_chatbot_widget.html.twig' %}
    {% include 'EmployeTache/_i18n_support.html.twig' %}
{% endblock %}
