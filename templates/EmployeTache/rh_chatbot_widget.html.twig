    {# Chips de suggestion #}
    <div id="rh-cb-chips">
      <div class="cb-chip" data-action="recommander" data-msg="{{ 'chatbot.suggestion.reco'|trans|default('Recommander un employé') }}">🎯 {{ 'chatbot.suggestion.reco'|trans|default('Recommander') }}</div>
      <div class="cb-chip" data-action="performances" data-msg="{{ 'chatbot.suggestion.perf'|trans|default('Analyser les performances') }}">📊 {{ 'chatbot.suggestion.perf'|trans|default('Performances') }}</div>
