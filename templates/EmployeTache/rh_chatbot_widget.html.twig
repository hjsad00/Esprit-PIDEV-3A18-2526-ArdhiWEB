     • Actions rapides dans les cartes (voir fiche, envoyer email)
     • Formatage Markdown basique (gras, listes) dans les réponses
   ═══════════════════════════════════════════════════════════════ #}

<style>
/* ─── Variables ──────────────────────────────────────────────── */
:root {
  --cb-green:       #116530; /* Vert Ardhi Forest */
  --cb-green-dark:  #0d4f26; /* Vert foncé hover */
  --cb-green-light: #e8f5e9; /* Vert pâle fond */
  --cb-green-glow:  rgba(17,101,48,.45); /* Glow vert */
  --cb-bot-bg:      #ffffff;
  --cb-user-bg:     #27ae60; /* Vert émeraude vibrant */
  --cb-user-color:  #ffffff;
  --cb-msg-bg:      #f5f7f5; /* Fond légèrement teinté vert */
  --cb-radius:      18px;
  --cb-shadow:      0 8px 30px rgba(17,101,48,.22);
  --cb-font:        -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --cb-accent:      #2ecc71; /* Accent secondaire */
}

/* ─── Conteneur principal ────────────────────────────────────── */
#rh-cb {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 9998;
  font-family: var(--cb-font);
}

/* ─── Launcher ────────────────────────────────────────────────── */
#rh-cb-launch {
  width: 62px;
  height: 62px;
  border-radius: 50%;
  background: linear-gradient(135deg, #116530 0%, #27ae60 100%);
  border: none;
  box-shadow: 0 4px 24px var(--cb-green-glow), 0 0 0 0 rgba(17,101,48,.3);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  color: white;
  transition: transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s;
  position: relative;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
#rh-cb-launch:hover {
  transform: scale(1.12);
  box-shadow: 0 6px 32px rgba(17,101,48,.55), 0 0 0 4px rgba(46,204,113,.2);
}
#rh-cb-launch .cb-notif-dot {
  position: absolute;
  top: 2px; right: 2px;
  width: 14px; height: 14px;
  background: #e74c3c;
  border: 2px solid white;
  border-radius: 50%;
  animation: cbPulse 2s infinite;
}
/* Cat ear decorations on launcher */
#rh-cb-launch::before,
#rh-cb-launch::after {
  content: '';
  position: absolute;
  top: -4px;
  width: 14px;
  height: 14px;
  background: linear-gradient(135deg, #116530 0%, #27ae60 100%);
  border-radius: 2px 8px 0 0;
  transition: transform .3s;
}
#rh-cb-launch::before { left: 6px; transform: rotate(-20deg); }
#rh-cb-launch::after  { right: 6px; transform: rotate(20deg); }
#rh-cb-launch:hover::before { transform: rotate(-30deg) scale(1.1); }
#rh-cb-launch:hover::after  { transform: rotate(30deg) scale(1.1); }

@keyframes cbPulse {
  0%,100%{transform:scale(1);opacity:1}
  50%{transform:scale(1.3);opacity:.7}
}

/* ─── Fenêtre ─────────────────────────────────────────────────── */
#rh-cb-window {
  position: absolute;
  bottom: 74px;
  right: 0;
  width: 420px;
  height: 600px;
  max-height: calc(100vh - 100px);
  background: white;
  border-radius: 16px;
  box-shadow: var(--cb-shadow);
  display: none;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid rgba(17,101,48,.12);
  transform-origin: bottom right;
}
#rh-cb-window.cb-open {
  display: flex;
  animation: cbWindowIn .32s cubic-bezier(.34,1.56,.64,1);
}
@keyframes cbWindowIn {
  from{opacity:0;transform:scale(.85) translateY(16px)}
  to  {opacity:1;transform:scale(1)   translateY(0)}
}

/* ─── Header (Glassmorphism Premium) ─────────────────────────── */
#rh-cb-header {
  background: linear-gradient(135deg, rgba(17,101,48,.92) 0%, rgba(13,79,38,.95) 100%);
  backdrop-filter: blur(16px) saturate(180%);
  -webkit-backdrop-filter: blur(16px) saturate(180%);
  padding: 14px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
  border-bottom: 1px solid rgba(255,255,255,.1);
}
.cb-bot-avatar {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: rgba(255,255,255,.18);
  border: 2px solid rgba(255,255,255,.35);
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; color: white; flex-shrink: 0; position: relative;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.cb-online-dot {
  position: absolute; bottom: 1px; right: 1px;
  width: 10px; height: 10px;
  background: #2ecc71;
  border: 2px solid white; border-radius: 50%;
  box-shadow: 0 0 6px rgba(46,204,113,.6);
}
.cb-header-info { flex: 1; }
.cb-header-name { color: white; font-size: 15px; font-weight: 700; line-height: 1.2; letter-spacing: .3px; }
.cb-header-status { color: rgba(255,255,255,.8); font-size: 11px; margin-top: 2px; }
.cb-header-actions { display: flex; gap: 4px; }
.cb-header-btn {
  width: 32px; height: 32px; border-radius: 50%;
  background: rgba(255,255,255,.12); border: none; color: white;
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  font-size: 14px; transition: background .2s, transform .2s;
}
.cb-header-btn:hover { background: rgba(255,255,255,.25); transform: scale(1.08); }

/* ─── Zone messages ──────────────────────────────────────────── */
#rh-cb-messages {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  background: var(--cb-msg-bg);
  display: flex;
  flex-direction: column;
  gap: 2px;
  scroll-behavior: smooth;
}
#rh-cb-messages::-webkit-scrollbar { width: 4px; }
#rh-cb-messages::-webkit-scrollbar-thumb { background: #ccc; border-radius: 2px; }

/* ─── Groupes de messages ─────────────────────────────────────── */
.cb-group {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-bottom: 12px;
}
.cb-group.bot  { align-items: flex-start; }
.cb-group.user { align-items: flex-end; }

/* Avatar de groupe */
.cb-group-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}
.cb-group.user .cb-group-header { flex-direction: row-reverse; }

.cb-msg-avatar {
  width: 28px; height: 28px; border-radius: 50%;
  background: linear-gradient(135deg, #116530, #27ae60);
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; color: white; flex-shrink: 0;
}
.cb-msg-avatar.user-av { background: linear-gradient(135deg, #555, #888); }
.cb-sender-label { font-size: 11px; font-weight: 600; color: #555; }
.cb-timestamp    { font-size: 10px; color: #aaa; margin-left: 4px; }

/* ─── Bulles ─────────────────────────────────────────────────── */
.cb-bubble {
  padding: 10px 14px;
  font-size: 14px;
  line-height: 1.5;
  color: #1d1d1d;
  max-width: 100%;
  word-break: break-word;
  animation: cbMsgIn .2s ease;
}
@keyframes cbMsgIn {
  from{opacity:0;transform:translateY(6px)}
  to  {opacity:1;transform:translateY(0)}
}
.cb-group.bot  .cb-bubble {
  background: white;
  border-radius: 4px 16px 16px 16px;
  border: 1px solid rgba(0,0,0,.06);
  box-shadow: 0 1px 3px rgba(0,0,0,.04);
}
.cb-group.user .cb-bubble {
  background: var(--cb-user-bg);
  color: var(--cb-user-color);
  border-radius: 16px 4px 16px 16px;
}
.cb-group.bot  .cb-bubble + .cb-bubble { border-radius: 4px 16px 16px 16px; }
.cb-group.user .cb-bubble + .cb-bubble { border-radius: 16px 4px 16px 16px; }

/* ─── Typing indicator ───────────────────────────────────────── */
.cb-typing {
  display: flex; gap: 4px; padding: 10px 14px;
  background: white; border-radius: 4px 16px 16px 16px;
  border: 1px solid rgba(0,0,0,.06);
  width: fit-content;
  animation: cbMsgIn .2s ease;
}
.cb-typing span {
  width: 7px; height: 7px; background: var(--cb-green);
  border-radius: 50%; display: block;
  animation: cbDot 1.3s infinite ease-in-out;
}
.cb-typing span:nth-child(2){animation-delay:.16s}
.cb-typing span:nth-child(3){animation-delay:.32s}
@keyframes cbDot {
  0%,80%,100%{transform:scale(.8);opacity:.4}
  40%{transform:scale(1.1);opacity:1}
}

/* ─── CARTE EMPLOYÉ style LinkedIn ─────────────────────────────── */
.cb-emp-card {
  background: white;
  border: 1px solid rgba(0,0,0,.08);
  border-radius: 12px;
  overflow: hidden;
  margin-top: 6px;
  width: 100%;
  box-shadow: 0 2px 8px rgba(0,0,0,.06);
  animation: cbMsgIn .25s ease;
}
.cb-emp-card-top {
  background: linear-gradient(135deg, #116530 0%, #27ae60 100%);
  height: 44px;
  position: relative;
}
.cb-emp-card-body { padding: 0 14px 14px; }
.cb-emp-photo-wrap {
  margin-top: -22px;
  margin-bottom: 8px;
}
.cb-emp-photo, .cb-emp-initials {
  width: 48px; height: 48px; border-radius: 50%;
  border: 3px solid white;
  object-fit: cover;
  display: flex; align-items: center; justify-content: center;
  font-size: 15px; font-weight: 700; color: white;
  box-shadow: 0 2px 8px rgba(0,0,0,.15);
}
.cb-emp-initials { background: var(--cb-green); }
.cb-emp-name { font-size: 14px; font-weight: 700; color: #1d1d1d; line-height: 1.2; }
.cb-emp-poste { font-size: 12px; color: #555; margin-top: 1px; }
.cb-emp-rank {
  float: right; margin-top: -42px;
  background: rgba(255,255,255,.2);
  color: white; border-radius: 20px;
  padding: 3px 10px; font-size: 11px; font-weight: 700;
}

/* Badge confiance */
.cb-confidence {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 11px; font-weight: 700;
  margin: 8px 0;
}

/* Barres de score */
.cb-scores { margin: 8px 0; display: flex; flex-direction: column; gap: 6px; }
.cb-score-row { display: flex; flex-direction: column; gap: 3px; }
.cb-score-lbl {
  display: flex; justify-content: space-between;
  font-size: 11px; color: #555; font-weight: 600;
}
.cb-bar-bg { height: 5px; background: #eee; border-radius: 3px; overflow: hidden; }
.cb-bar-fill { height: 100%; border-radius: 3px; transition: width 1.2s cubic-bezier(.4,0,.2,1); }

/* Raison */
.cb-reason {
  font-size: 11px; color: #666; font-style: italic;
  margin: 6px 0 10px;
  padding: 6px 10px;
  background: #f8f8f8;
  border-left: 3px solid var(--cb-green);
  border-radius: 0 6px 6px 0;
}

/* Actions carte */
.cb-card-actions { display: flex; gap: 8px; margin-top: 10px; }
.cb-card-btn {
  flex: 1; padding: 7px 10px;
  border-radius: 20px; font-size: 12px; font-weight: 600;
  cursor: pointer; transition: .2s; text-decoration: none;
  display: flex; align-items: center; justify-content: center; gap: 4px;
  border: 1.5px solid;
}
.cb-card-btn.primary {
  background: var(--cb-green); color: white;
  border-color: var(--cb-green);
}
.cb-card-btn.secondary {
  background: white; color: var(--cb-green);
  border-color: var(--cb-green);
}
.cb-card-btn:hover.primary { background: var(--cb-green-dark); }
.cb-card-btn:hover.secondary { background: var(--cb-green-light); }

/* ─── CARTE DISPONIBILITÉ ─────────────────────────────────────── */
.cb-dispo-card {
  background: white;
  border: 1px solid rgba(0,0,0,.08);
  border-radius: 10px;
  padding: 10px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 5px;
  animation: cbMsgIn .2s ease;
}
.cb-dispo-avatar {
  width: 36px; height: 36px; border-radius: 50%;
  background: var(--cb-green); color: white;
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 700; flex-shrink: 0;
}
.cb-dispo-info { flex: 1; min-width: 0; }
.cb-dispo-name { font-size: 13px; font-weight: 700; color: #1d1d1d; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cb-dispo-poste { font-size: 11px; color: #777; }
.cb-dispo-right { text-align: right; flex-shrink: 0; }
.cb-dispo-status { font-size: 11px; font-weight: 700; }
.cb-dispo-tasks { font-size: 10px; color: #aaa; margin-top: 1px; }

/* Jauge de charge */
.cb-load-bar {
  height: 3px; background: #eee; border-radius: 2px;
  overflow: hidden; margin-top: 6px; width: 100%;
}
.cb-load-fill { height: 100%; border-radius: 2px; transition: width .8s ease; }

/* ─── Chips de suggestion ────────────────────────────────────── */
#rh-cb-chips {
  padding: 10px 12px;
  display: flex;
  gap: 6px;
  overflow-x: auto;
  background: white;
  border-top: 1px solid #f0f0f0;
  flex-shrink: 0;
  scrollbar-width: none;
}
#rh-cb-chips::-webkit-scrollbar { display: none; }
.cb-chip {
  white-space: nowrap;
  padding: 6px 13px;
  background: var(--cb-green-light);
  color: var(--cb-green);
  border: 1px solid #b2dfb5;
  border-radius: 20px;
  font-size: 12px; font-weight: 600;
  cursor: pointer; transition: .2s; flex-shrink: 0;
}
.cb-chip:hover { background: var(--cb-green); color: white; border-color: var(--cb-green); box-shadow: 0 2px 8px var(--cb-green-glow); }

/* ─── Zone de saisie ─────────────────────────────────────────── */
#rh-cb-input-area {
  padding: 12px 14px;
  background: white;
  display: flex;
  gap: 8px;
  align-items: flex-end;
  border-top: 1px solid #f0f0f0;
  flex-shrink: 0;
}
#rh-cb-input {
  flex: 1;
  border: 1.5px solid #e0e0e0;
  border-radius: 22px;
  padding: 10px 16px;
  font-size: 14px;
  font-family: var(--cb-font);
  outline: none;
  transition: border-color .2s;
  resize: none;
  max-height: 80px;
  min-height: 40px;
  line-height: 1.4;
  overflow: hidden;
}
#rh-cb-input:focus { border-color: var(--cb-green); }
#rh-cb-send {
  width: 40px; height: 40px; border-radius: 50%;
  background: linear-gradient(135deg, #116530, #27ae60);
  color: white; border: none;
  display: flex; align-items: center; justify-content: center;
  font-size: 15px; cursor: pointer; flex-shrink: 0;
  transition: transform .2s, background .2s, box-shadow .2s;
}
#rh-cb-send:hover { transform: scale(1.08); background: linear-gradient(135deg, #0d4f26, #219a52); box-shadow: 0 2px 12px var(--cb-green-glow); }
#rh-cb-send:disabled { background: #ccc; cursor: not-allowed; transform: none; box-shadow: none; }
</style>

{# ─── HTML ─────────────────────────────────────────────────────── #}
<div id="rh-cb">

  {# Fenêtre #}
  <div id="rh-cb-window">

    {# Header — Glassmorphism Vert Ardhi #}
    <div id="rh-cb-header">
      <div class="cb-bot-avatar">
        {# SVG Chat IA stylisé #}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4.5 3L6.5 8.5H4C3.17 8.5 2.5 9.17 2.5 10V18C2.5 18.83 3.17 19.5 4 19.5H8L12 22.5L16 19.5H20C20.83 19.5 21.5 18.83 21.5 18V10C21.5 9.17 20.83 8.5 20 8.5H17.5L19.5 3" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="rgba(255,255,255,.15)"/>
          <circle cx="8.5" cy="13" r="1.5" fill="#2ecc71"/>
          <circle cx="15.5" cy="13" r="1.5" fill="#2ecc71"/>
          <path d="M10 16.5C10.5 17 11.2 17.3 12 17.3C12.8 17.3 13.5 17 14 16.5" stroke="white" stroke-width="1.3" stroke-linecap="round"/>
          <line x1="5" y1="15" x2="2" y2="14.5" stroke="rgba(255,255,255,.5)" stroke-width="1" stroke-linecap="round"/>
