<style>
/* --- CHATBOT WIDGET PREMIUM STYLES --- */
#rh-chatbot-container {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 9999;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

/* Floating Button */
#rh-chatbot-launcher {
    width: 65px;
    height: 65px;
    border-radius: 50%;
    background: linear-gradient(135deg, #27ae60, #2ecc71);
    color: white;
    border: none;
    box-shadow: 0 10px 25px rgba(39, 174, 96, 0.4);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
}

#rh-chatbot-launcher:hover {
    transform: scale(1.1) translateY(-5px);
    box-shadow: 0 15px 35px rgba(39, 174, 96, 0.5);
}

#rh-chatbot-launcher i {
    transition: transform 0.4s;
}

#rh-chatbot-launcher.active i {
    transform: rotate(90deg);
}

/* Chat Window */
#rh-chatbot-window {
    position: absolute;
    bottom: 85px;
    right: 0;
    width: 400px;
    height: 550px;
    max-height: calc(100vh - 120px);
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
    display: none;
    flex-direction: column;
    overflow: hidden;
    transform-origin: bottom right;
    animation: windowOpen 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 1px solid rgba(0,0,0,0.05);
}

@keyframes windowOpen {
    from { opacity: 0; transform: scale(0.8) translateY(20px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
}

/* Header */
#rh-chatbot-header {
    background: white;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #f0f0f0;
}

.bot-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.bot-avatar {
    width: 40px;
    height: 40px;
    background: #e8f5e9;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #27ae60;
    font-size: 20px;
    position: relative;
}

.bot-avatar::after {
    content: '';
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 10px;
    height: 10px;
    background: #2ecc71;
    border: 2px solid white;
    border-radius: 50%;
}

.bot-name-status {
    display: flex;
    flex-direction: column;
}

.bot-name {
    font-weight: 700;
    color: #333;
    font-size: 15px;
    line-height: 1.2;
}

.bot-status {
    font-size: 11px;
    color: #2ecc71;
    font-weight: 500;
}

#rh-chatbot-close {
    background: none;
    border: none;
    color: #999;
    font-size: 22px;
    cursor: pointer;
    padding: 5px;
    transition: color 0.2s;
}

#rh-chatbot-close:hover {
    color: #e74c3c;
}

/* Messages Area */
#rh-chatbot-messages {
    flex: 1;
    padding: 20px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
    background: #f8f9fa;
    scroll-behavior: smooth;
}

.msg-wrapper {
    display: flex;
    flex-direction: column;
    max-width: 85%;
}

.msg-wrapper.bot { align-self: flex-start; }
.msg-wrapper.user { align-self: flex-end; }

.chat-bubble {
    padding: 12px 16px;
    font-size: 14px;
    line-height: 1.5;
    position: relative;
    box-shadow: 0 2px 5px rgba(0,0,0,0.02);
}

.msg-wrapper.bot .chat-bubble {
    background: white;
    color: #333;
    border-radius: 18px 18px 18px 4px;
    border: 1px solid #efefef;
}

.msg-wrapper.user .chat-bubble {
    background: #27ae60;
    color: white;
    border-radius: 18px 18px 4px 18px;
}

.msg-time {
    font-size: 10px;
    color: #aaa;
    margin-top: 4px;
    margin-left: 5px;
}

.msg-wrapper.user .msg-time { text-align: right; margin-right: 5px; }

/* Typing Indicator */
.typing-indicator {
    padding: 12px 16px;
    background: white;
    border-radius: 18px 18px 18px 4px;
    display: flex;
    gap: 4px;
    width: fit-content;
    border: 1px solid #efefef;
}

.typing-dot {
    width: 6px;
    height: 6px;
    background: #27ae60;
    border-radius: 50%;
    animation: typingBounce 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
    40% { transform: translateY(-5px); opacity: 1; }
}

/* RICH CARDS: Employee Card */
.employee-card {
    background: white;
    border-radius: 15px;
    padding: 15px;
    margin-top: 10px;
    border: 1px solid #eee;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    width: 100%;
}

.emp-header {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 12px;
}

.emp-photo {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    object-fit: cover;
    background: #f0f0f0;
}

.emp-initials {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: #27ae60;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
}

.emp-info h5 { margin: 0; font-size: 14px; font-weight: 700; color: #333; }
.emp-info p { margin: 0; font-size: 12px; color: #777; }

.emp-scores { display: flex; flex-direction: column; gap: 8px; margin-bottom: 15px; }

.score-bar-group { display: flex; flex-direction: column; gap: 3px; }
.score-label { display: flex; justify-content: space-between; font-size: 11px; font-weight: 600; color: #555; }
.progress-bg { height: 6px; background: #f0f0f0; border-radius: 3px; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 3px; transition: width 1s ease-out; }

.overall-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 15px;
}

/* Suggestion Chips */
#rh-chatbot-suggestions {
    padding: 10px 15px;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    background: white;
    border-top: 1px solid #f0f0f0;
    scrollbar-width: none;
}

#rh-chatbot-suggestions::-webkit-scrollbar { display: none; }

.suggestion-chip {
    white-space: nowrap;
    padding: 8px 15px;
    background: #f0f7f4;
    color: #27ae60;
    border: 1px solid #d5eadd;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.suggestion-chip:hover {
    background: #27ae60;
    color: white;
}

/* Input Area */
#rh-chatbot-input-area {
    padding: 15px 20px;
    background: white;
    display: flex;
    gap: 10px;
    align-items: center;
    border-top: 1px solid #f0f0f0;
}

#rh-chatbot-input {
    flex: 1;
    border: 1px solid #e0e0e0;
    padding: 12px 18px;
    border-radius: 25px;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
}

#rh-chatbot-input:focus { border-color: #27ae60; }

#rh-chatbot-send {
    background: #27ae60;
    color: white;
    border: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s;
}

#rh-chatbot-send:hover { transform: scale(1.1); }
</style>

<div id="rh-chatbot-container">
    <!-- Chat Window -->
    <div id="rh-chatbot-window">
        <!-- Header -->
        <div id="rh-chatbot-header">
            <div class="bot-info">
                <div class="bot-avatar">
                    <i class="bi bi-robot"></i>
                </div>
                <div class="bot-name-status">
                    <span class="bot-name">SmartFarm Manager</span>
                    <span class="bot-status">● {{ 'status.online'|trans|default('En ligne') }}</span>
                </div>
            </div>
            <button id="rh-chatbot-close"><i class="bi bi-dash"></i></button>
        </div>

        <!-- Messages Area -->
        <div id="rh-chatbot-messages">
            <div class="msg-wrapper bot">
                <div class="chat-bubble">
                    {{ 'chatbot.welcome'|trans }}
                </div>
                <div class="msg-time">{{ 'common.loading_time'|trans|replace({'%ms%ms': '0'})|replace({'Chargé en 0': "À l'instant", 'Loaded in 0': 'Just now', 'تم التحميل في 0': 'الآن'}) }}</div>
            </div>
        </div>

        <!-- Suggestion Chips -->
        <div id="rh-chatbot-suggestions">
            <div class="suggestion-chip" data-msg="{{ 'chatbot.suggestion.reco'|trans }}">🎯 {{ 'chatbot.suggestion.reco'|trans }}</div>
            <div class="suggestion-chip" data-msg="{{ 'chatbot.suggestion.perf'|trans }}">📊 {{ 'chatbot.suggestion.perf'|trans }}</div>
            <div class="suggestion-chip" data-msg="{{ 'chatbot.suggestion.dispo'|trans }}">📅 {{ 'chatbot.suggestion.dispo'|trans }}</div>
            <div class="suggestion-chip" data-msg="{{ 'chatbot.suggestion.help'|trans }}">❓ {{ 'chatbot.suggestion.help'|trans }}</div>
        </div>

        <!-- Input Area -->
        <div id="rh-chatbot-input-area">
            <input type="text" id="rh-chatbot-input" placeholder="{{ 'chatbot.input_placeholder'|trans }}" autocomplete="off">
            <button id="rh-chatbot-send"><i class="bi bi-send-fill"></i></button>
        </div>
    </div>

    <!-- Launcher Button -->
    <button id="rh-chatbot-launcher">
        <i class="bi bi-robot"></i>
    </button>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const launcher = document.getElementById('rh-chatbot-launcher');
    const windowEl = document.getElementById('rh-chatbot-window');
    const closeBtn = document.getElementById('rh-chatbot-close');
    const sendBtn = document.getElementById('rh-chatbot-send');
    const inputField = document.getElementById('rh-chatbot-input');
    const messagesContainer = document.getElementById('rh-chatbot-messages');
    const chips = document.querySelectorAll('.suggestion-chip');

    // Toggle Chat Window
    launcher.addEventListener('click', () => {
        const isOpen = windowEl.style.display === 'flex';
        windowEl.style.display = isOpen ? 'none' : 'flex';
        launcher.classList.toggle('active', !isOpen);
        if (!isOpen) {
            inputField.focus();
            scrollToBottom();
        }
    });

    closeBtn.addEventListener('click', () => {
        windowEl.style.display = 'none';
        launcher.classList.remove('active');
    });

    // Handle suggestion chips
    chips.forEach(chip => {
        chip.addEventListener('click', () => {
            const msg = chip.getAttribute('data-msg');
            sendMessage(msg);
        });
    });

    // Send Message on Enter
    inputField.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendMessage();
    });

    sendBtn.addEventListener('click', () => sendMessage());

    async function sendMessage(text = null) {
        const msg = text || inputField.value.trim();
        if (!msg) return;

        inputField.value = '';
        appendMessage('user', msg);
        
        scrollToBottom();
        showTypingIndicator();

        try {
            const response = await fetch('{{ path("app_rh_chatbot_send") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg })
            });

            const data = await response.json();
            removeTypingIndicator();

            if (data.error) {
                appendMessage('bot', "Désolé, j'ai rencontré une erreur : " + data.error);
            } else {
                appendMessage('bot', data.reponse);
                
                // Handle Recommendations
                if (data.recommandations && data.recommandations.length > 0) {
                    renderRecommendations(data.recommandations);
                }

                // Handle Disponibilités
                if (data.disponibilites && data.disponibilites.length > 0 && data.intention === 'DISPONIBILITE') {
                    renderDisponibilites(data.disponibilites);
                }
            }
        } catch (error) {
            console.error('Chatbot Error:', error);
            removeTypingIndicator();
            appendMessage('bot', "Oups ! Je n'arrive pas à joindre le serveur.");
        }
        
        scrollToBottom();
    }

    function appendMessage(sender, text) {
        const wrapper = document.createElement('div');
        wrapper.className = `msg-wrapper ${sender}`;
        
        const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        
        wrapper.innerHTML = `
            <div class="chat-bubble">${text.replace(/\n/g, '<br>')}</div>
            <div class="msg-time">${time}</div>
        `;
        
        messagesContainer.appendChild(wrapper);
    }

    function renderRecommendations(recs) {
        recs.forEach(rec => {
            const card = document.createElement('div');
            card.className = 'employee-card';
            
            const initials = (rec.employe.prenom[0] + rec.employe.nom[0]).toUpperCase();
            const photoHtml = rec.employe.photoPath 
                ? `<img src="/uploads/photos/${rec.employe.photoPath}" class="emp-photo">`
                : `<div class="emp-initials">${initials}</div>`;

            card.innerHTML = `
                <div class="emp-header">
                    ${photoHtml}
                    <div class="emp-info">
                        <h5>${rec.employe.prenom} ${rec.employe.nom}</h5>
                        <p>${rec.employe.poste || 'Employé'}</p>
                    </div>
                    <div style="margin-left: auto;">
                        ${rec.emoji}
                    </div>
                </div>
                
                <div class="overall-badge" style="background: ${rec.couleur}15; color: ${rec.couleur}">
                    <i class="bi bi-award-fill"></i> ${rec.appreciation} (${Math.round(rec.scoreTotal)}%)
                </div>

                <div class="emp-scores">
                    ${renderScoreBar("{{ 'ai.matching.reason.skills'|trans|e('js') }}", rec.scoreCompetences, '#3498db')}
                    ${renderScoreBar("{{ 'employe.performance'|trans|e('js') }}", rec.scorePerformance, '#27ae60')}
                    ${renderScoreBar("{{ 'ai.matching.reason.availability'|trans|e('js') }}", rec.scoreDisponibilite, '#f1c40f')}
                </div>

                <div style="font-size: 11px; color: #777; font-style: italic; margin-bottom: 15px;">
                    "${rec.raisonRecommandation}"
                </div>

                <a href="/employes/${rec.employe.id}" class="btn btn-sm btn-outline-success w-100" style="border-radius: 20px; font-size: 12px; font-weight:600;">
                    {{ 'common.view'|trans|default('Voir') }}
                </a>
            `;
            messagesContainer.appendChild(card);
        });
    }

    function renderScoreBar(label, score, color) {
        return `
            <div class="score-bar-group">
                <div class="score-label">
                    <span>${label}</span>
                    <span>${Math.round(score)}%</span>
                </div>
                <div class="progress-bg">
                    <div class="progress-fill" style="width: ${score}%; background: ${color}"></div>
                </div>
            </div>
        `;
    }

    function renderDisponibilites(dispos) {
        const container = document.createElement('div');
        container.style.display = 'flex';
        container.style.flexDirection = 'column';
        container.style.gap = '10px';
        container.style.marginTop = '10px';
        container.style.width = '100%';

        dispos.forEach(d => {
            const item = document.createElement('div');
            item.style.background = 'white';
            item.style.padding = '10px 15px';
            item.style.borderRadius = '12px';
            item.style.border = '1px solid #eee';
            item.style.display = 'flex';
            item.style.alignItems = 'center';
            item.style.gap = '10px';

            item.innerHTML = `
                <span style="font-size: 16px;">${d.dotEmoji}</span>
                <div style="flex: 1;">
                    <div style="font-size: 13px; font-weight: 700;">${d.employe.prenom} ${d.employe.nom}</div>
                    <div style="font-size: 11px; color: #777;">${d.employe.poste || 'Poste non défini'}</div>
                </div>
                <div style="font-size: 11px; font-weight: 700; color: ${d.couleurStatut}">${d.statutLabel}</div>
            `;
            container.appendChild(item);
        });
        messagesContainer.appendChild(container);
    }

    function showTypingIndicator() {
        const indicator = document.createElement('div');
        indicator.id = 'typing-indicator-wrapper';
        indicator.className = 'msg-wrapper bot';
        indicator.innerHTML = `
            <div class="typing-indicator">
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
            </div>
        `;
        messagesContainer.appendChild(indicator);
        scrollToBottom();
    }

    function removeTypingIndicator() {
        const indicator = document.getElementById('typing-indicator-wrapper');
        if (indicator) indicator.remove();
    }

    function scrollToBottom() {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }
});
</script>
