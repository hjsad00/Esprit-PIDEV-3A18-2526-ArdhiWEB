    <span class="cb-notif-dot" id="rh-cb-notif"></span>
  </button>

</div>

<script>
(function() {
'use strict';

const SEND_URL   = '{{ path("app_rh_chatbot_send") }}';
const STORE_KEY  = 'rh_cb_history';
const MAX_HIST   = 30;

const win      = document.getElementById('rh-cb-window');
const launch   = document.getElementById('rh-cb-launch');
const closeBtn = document.getElementById('rh-cb-close');
const clearBtn = document.getElementById('rh-cb-clear');
const msgs     = document.getElementById('rh-cb-messages');
const input    = document.getElementById('rh-cb-input');
const sendBtn  = document.getElementById('rh-cb-send');
const chips    = document.querySelectorAll('.cb-chip');
const notifDot = document.getElementById('rh-cb-notif');
const statusEl = document.getElementById('rh-cb-status');

let isOpen      = false;
let lastIntent  = null;
let msgCount    = 0;

/* ── Ouverture / fermeture ───────────────────────────────────── */
launch.addEventListener('click', () => {
  isOpen = !isOpen;
  win.classList.toggle('cb-open', isOpen);
  if (isOpen) {
    notifDot.style.display = 'none';
    if (msgs.children.length === 0) initConversation();
    setTimeout(() => input.focus(), 200);
    scrollBottom();
  }
});

closeBtn.addEventListener('click', () => {
  isOpen = false;
  win.classList.remove('cb-open');
});

clearBtn.addEventListener('click', () => {
  msgs.innerHTML = '';
  sessionStorage.removeItem(STORE_KEY);
  lastIntent = null;
  initConversation();
});

/* ── Message de bienvenue ────────────────────────────────────── */
function initConversation() {
  const welcome = '{{ "chatbot.welcome"|trans|default("Bonjour ! Je suis votre assistant RH propulsé par Gemini AI. Comment puis-je vous aider ?")|e("js") }}';
  addBotBubble(welcome, false);
}

/* ── Chips ───────────────────────────────────────────────────── */
chips.forEach(c => c.addEventListener('click', () => {
  const chipAction = c.dataset.action || '';
  const chipMsg    = c.dataset.msg    || '';
  send(chipMsg, chipAction);
}));

/* ── Saisie ──────────────────────────────────────────────────── */
input.addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    send();
  }
});
input.addEventListener('input', () => {
  input.style.height = 'auto';
  input.style.height = Math.min(input.scrollHeight, 80) + 'px';
});

sendBtn.addEventListener('click', () => send());

/* ── Envoi ───────────────────────────────────────────────────── */
async function send(text, action = '') {
  const msg = (text || input.value).trim();
  if (!msg && !action) return;

  input.value = '';
  input.style.height = 'auto';
  addUserBubble(msg);
  scrollBottom();

  sendBtn.disabled = true;
  statusEl.textContent = '⟳ {{ "chatbot.thinking"|trans|default("En train d\'analyser...")|e("js") }}';

  const typingId = addTyping();

  try {
    const res  = await fetch(SEND_URL, {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify({ message: msg, action: action, lastIntent: lastIntent })
    });
    const data = await res.json();

    removeTyping(typingId);
    statusEl.textContent = '● {{ "status.online"|trans|default("En ligne")|e("js") }}';

    if (data.error) {
      addBotBubble('❌ ' + data.error);
    } else {
      if (data.reponse) {
        // Badge IA si réponse générée par Gemini
        const geminiPrefix = data.intention === 'GEMINI_FALLBACK'
          ? '<span style="font-size:10px;background:#e8f5e9;color:#116530;padding:2px 8px;border-radius:10px;font-weight:600;display:inline-flex;align-items:center;gap:4px;margin-bottom:6px">🐱 Miaou AI</span><br>'
          : '';
        addBotBubble(geminiPrefix + formatText(data.reponse));
      }
      lastIntent = data.intention;

      if (data.recommandations?.length > 0) {
        data.recommandations.forEach((r, i) => renderEmpCard(r, i));
      }
      if (data.disponibilites?.length > 0 && data.intention === 'DISPONIBILITE') {
        renderDispos(data.disponibilites);
      }
      if (data.suggestions?.length > 0) {
        renderSuggestions(data.suggestions);
      }

      updateChips(data.intention);
    }
  } catch(err) {
    removeTyping(typingId);
    statusEl.textContent = '● {{ "status.online"|trans|default("En ligne")|e("js") }}';
    addBotBubble('❌ {{ "chatbot.error.network"|trans|default("Erreur réseau. Veuillez réessayer.")|e("js") }}');
  }

  sendBtn.disabled = false;
  scrollBottom();
}

/* ── Formatage Markdown basique ─────────────────────────────── */
function formatText(text) {
  return text
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\n\n/g, '</p><p>')
    .replace(/\n/g, '<br>')
    .replace(/^/, '<p>').replace(/$/, '</p>');
}

/* ── Ajout bulle bot ─────────────────────────────────────────── */
function addBotBubble(html, animate = true) {
  const g = getOrCreateGroup('bot');
  const b = document.createElement('div');
  b.className = 'cb-bubble';
  if (!animate) b.style.animation = 'none';
  b.innerHTML = html;
  g.appendChild(b);
  updateGroupTimestamp(g);
  scrollBottom();
  return b;
}

/* ── Ajout bulle utilisateur ─────────────────────────────────── */
function addUserBubble(text) {
  const g = document.createElement('div');
  g.className = 'cb-group user';
  g.dataset.sender = 'user';

  const time = nowTime();
  const initials = '{{ app.user ? (app.user.prenom|default("")|slice(0,1) ~ app.user.nom|default("")|slice(0,1))|upper : "U" }}';

  g.innerHTML = `
    <div class="cb-group-header">
      <div class="cb-sender-label">{{ app.user ? (app.user.prenom ~ " " ~ app.user.nom)|default("Vous") : "Vous" }}</div>
      <span class="cb-timestamp">${time}</span>
      <div class="cb-msg-avatar user-av">${initials}</div>
    </div>
    <div class="cb-bubble">${escHtml(text)}</div>`;
  msgs.appendChild(g);
}

/* ── Groupes de messages bot ─────────────────────────────────── */
function getOrCreateGroup(sender) {
  const last = msgs.lastElementChild;
  if (last && last.classList.contains('cb-group') && last.dataset.sender === sender) {
    return last;
  }
  const g = document.createElement('div');
  g.className = `cb-group ${sender}`;
  g.dataset.sender = sender;

  const time = nowTime();
  g.innerHTML = `
    <div class="cb-group-header">
      <div class="cb-msg-avatar" style="display:flex; align-items:center; justify-content:center; font-size:14px;">🐱</div>
      <div class="cb-sender-label">SmartFarm AI</div>
      <span class="cb-timestamp">${time}</span>
    </div>`;
  msgs.appendChild(g);
  return g;
}

function updateGroupTimestamp(g) {
  const ts = g.querySelector('.cb-timestamp');
  if (ts) ts.textContent = nowTime();
}

/* ── Typing indicator ────────────────────────────────────────── */
function addTyping() {
  const id = 'cb-typing-' + (++msgCount);
  const g = getOrCreateGroup('bot');
  const t = document.createElement('div');
  t.className = 'cb-typing';
  t.id = id;
  t.innerHTML = '<span></span><span></span><span></span>';
  g.appendChild(t);
  scrollBottom();
  return id;
}
function removeTyping(id) {
  const el = document.getElementById(id);
  if (el) el.remove();
}

/* ── CARTE EMPLOYÉ (style LinkedIn) ─────────────────────────── */
function renderEmpCard(rec, rank) {
  const g = getOrCreateGroup('bot');
  const card = document.createElement('div');
  card.className = 'cb-emp-card';

  const emp      = rec.employe;
  const initials = ((emp.prenom||'?')[0] + (emp.nom||'?')[0]).toUpperCase();
  const photoEl  = emp.photoPath
    ? `<img src="${emp.photoPath}" class="cb-emp-photo" alt="${escHtml(emp.prenom)}">`
    : `<div class="cb-emp-initials">${initials}</div>`;

  const medals   = ['🥇','🥈','🥉'];
  const medal    = medals[rank] || `#${rank+1}`;

  const confColor = rec.indiceConfiance >= 80 ? '#27ae60'
                  : rec.indiceConfiance >= 60 ? '#f39c12' : '#e74c3c';

  const scoreTotal = Math.round(rec.scoreTotal || 0);
  const scoreComp  = Math.round(rec.scoreCompetences || 0);
  const scorePerf  = Math.round(rec.scorePerformance  || 0);
  const scoreDispo = Math.round(rec.scoreDisponibilite || 0);
  const conf       = Math.round(rec.indiceConfiance    || 0);

  const emailAction = emp.email
    ? `<a href="mailto:${emp.email}" class="cb-card-btn secondary"><i class="bi bi-envelope"></i></a>`
    : '';

  card.innerHTML = `
    <div class="cb-emp-card-top">
      <span class="cb-emp-rank">${medal} ${scoreTotal}%</span>
    </div>
    <div class="cb-emp-card-body">
      <div class="cb-emp-photo-wrap">${photoEl}</div>
      <div class="cb-emp-name">${escHtml(emp.prenom)} ${escHtml(emp.nom)}</div>
      <div class="cb-emp-poste">${escHtml(emp.poste || '—')}</div>

      <div class="cb-confidence" style="background:${confColor}18;color:${confColor}">
        ${rec.emoji || '⭐'} ${rec.appreciation || ''} — {{ "chatbot.confidence"|trans|default("Confiance")|e("js") }} ${conf}%
      </div>

      <div class="cb-scores">
        ${scoreBar('{{ "ai.matching.reason.skills"|trans|default("Compétences")|e("js") }}',      scoreComp,  '#116530')}
        ${scoreBar('{{ "employe.performance"|trans|default("Performance")|e("js") }}',             scorePerf,  '#27ae60')}
        ${scoreBar('{{ "ai.matching.reason.availability"|trans|default("Disponibilité")|e("js") }}', scoreDispo, '#f39c12')}
      </div>

      ${rec.raisonRecommandation ? `<div class="cb-reason">"${escHtml(rec.raisonRecommandation)}"</div>` : ''}

      <div class="cb-card-actions">
        <a href="/employes/${emp.id}" class="cb-card-btn primary">
          <i class="bi bi-person"></i> {{ "common.view"|trans|default("Voir la fiche")|e("js") }}
        </a>
        ${emailAction}
      </div>
    </div>`;

  g.appendChild(card);

  /* Anime les barres après insertion */
  setTimeout(() => {
    card.querySelectorAll('.cb-bar-fill').forEach(bar => {
      const w = bar.dataset.width;
      if (w) bar.style.width = w + '%';
    });
  }, 100);
}

function scoreBar(label, val, color) {
  return `
    <div class="cb-score-row">
      <div class="cb-score-lbl"><span>${label}</span><span>${val}%</span></div>
      <div class="cb-bar-bg">
        <div class="cb-bar-fill" data-width="${val}" style="width:0%;background:${color}"></div>
      </div>
    </div>`;
}

/* ── CARTE DISPONIBILITÉ ─────────────────────────────────────── */
function renderDispos(dispos) {
  const g = getOrCreateGroup('bot');
  const wrap = document.createElement('div');
  wrap.style.display = 'flex';
  wrap.style.flexDirection = 'column';
  wrap.style.gap = '6px';
  wrap.style.width = '100%';

  dispos.forEach(d => {
    const emp      = d.employe;
    const initials = ((emp.prenom||'?')[0] + (emp.nom||'?')[0]).toUpperCase();
    const charge   = Math.min(100, (d.tachesEnCours || 0) * 20); /* max 5 tâches = 100% */
    const barColor = d.couleurStatut || '#27ae60';

    const card = document.createElement('div');
    card.className = 'cb-dispo-card';

    const photoEl = emp.photoPath
      ? `<img src="${emp.photoPath}" style="width:36px;height:36px;border-radius:50%;object-fit:cover">`
      : `<div class="cb-dispo-avatar">${initials}</div>`;

    card.innerHTML = `
      ${photoEl}
      <div class="cb-dispo-info">
        <div class="cb-dispo-name">${escHtml(emp.prenom)} ${escHtml(emp.nom)}</div>
        <div class="cb-dispo-poste">${escHtml(emp.poste || '—')}</div>
        <div class="cb-load-bar">
          <div class="cb-load-fill" data-w="${charge}" style="width:0%;background:${barColor}"></div>
        </div>
      </div>
      <div class="cb-dispo-right">
        <div class="cb-dispo-status" style="color:${barColor}">${d.dotEmoji} ${d.statutLabel}</div>
        <div class="cb-dispo-tasks">${d.tachesEnCours} {{ "common.tasks"|trans|default("tâche(s)")|e("js") }}</div>
      </div>`;

    wrap.appendChild(card);
  });

  g.appendChild(wrap);

  /* Anime les jauges */
  setTimeout(() => {
    wrap.querySelectorAll('.cb-load-fill').forEach(b => {
      b.style.transition = 'width .8s ease';
      b.style.width = b.dataset.w + '%';
    });
  }, 100);
}

/* ── Chips contextuelles après réponse ───────────────────────── */
function updateChips(intent) {
  const chipsEl = document.getElementById('rh-cb-chips');
  const suggestions = {
    'RECOMMANDER_EMPLOYE': [
      { icon:'📊', action:'performances',  msg:'{{ "chatbot.suggestion.perf"|trans|default("Analyser les performances")|e("js") }}', label:'{{ "chatbot.suggestion.perf"|trans|default("Performances")|e("js") }}' },
      { icon:'📅', action:'disponibilite', msg:'{{ "chatbot.suggestion.dispo"|trans|default("Voir les disponibilités")|e("js") }}',  label:'{{ "chatbot.suggestion.dispo"|trans|default("Disponibilités")|e("js") }}' },
    ],
    'ANALYSER_PERFORMANCE': [
      { icon:'🎯', action:'recommander',   msg:'{{ "chatbot.suggestion.reco"|trans|default("Recommander un employé")|e("js") }}',   label:'{{ "chatbot.suggestion.reco"|trans|default("Recommander")|e("js") }}' },
      { icon:'📅', action:'disponibilite', msg:'{{ "chatbot.suggestion.dispo"|trans|default("Voir les disponibilités")|e("js") }}',  label:'{{ "chatbot.suggestion.dispo"|trans|default("Disponibilités")|e("js") }}' },
    ],
    'DISPONIBILITE': [
      { icon:'🎯', action:'recommander',   msg:'{{ "chatbot.suggestion.reco"|trans|default("Recommander un employé")|e("js") }}',   label:'{{ "chatbot.suggestion.reco"|trans|default("Recommander")|e("js") }}' },
      { icon:'📊', action:'performances',  msg:'{{ "chatbot.suggestion.perf"|trans|default("Analyser les performances")|e("js") }}', label:'{{ "chatbot.suggestion.perf"|trans|default("Performances")|e("js") }}' },
    ],
    'GEMINI_FALLBACK': [
      { icon:'🎯', action:'recommander',   msg:'{{ "chatbot.suggestion.reco"|trans|default("Recommander un employé")|e("js") }}',   label:'{{ "chatbot.suggestion.reco"|trans|default("Recommander")|e("js") }}' },
      { icon:'📊', action:'performances',  msg:'{{ "chatbot.suggestion.perf"|trans|default("Analyser les performances")|e("js") }}', label:'{{ "chatbot.suggestion.perf"|trans|default("Performances")|e("js") }}' },
      { icon:'📅', action:'disponibilite', msg:'{{ "chatbot.suggestion.dispo"|trans|default("Voir les disponibilités")|e("js") }}',  label:'{{ "chatbot.suggestion.dispo"|trans|default("Disponibilités")|e("js") }}' },
    ],
  };

  const newChips = suggestions[intent];
  if (!newChips) return;

  chipsEl.innerHTML = '';
  newChips.forEach(c => {
    const chip = document.createElement('div');
    chip.className = 'cb-chip';
    chip.dataset.msg    = c.msg;
    chip.dataset.action = c.action || '';
    chip.textContent = c.icon + ' ' + c.label;
    chip.addEventListener('click', () => send(c.msg, c.action || ''));
    chipsEl.appendChild(chip);
  });

  /* Rebouton Aide */
  const aide = document.createElement('div');
  aide.className = 'cb-chip';
  aide.dataset.action = 'aide';
  aide.dataset.msg    = 'aide';
  aide.textContent = '❓ Aide';
  aide.addEventListener('click', () => send('aide', 'aide'));
  chipsEl.appendChild(aide);
}


/* ── Utilitaires ─────────────────────────────────────────────── */
function scrollBottom() {
  requestAnimationFrame(() => { msgs.scrollTop = msgs.scrollHeight; });
}
function nowTime() {
  return new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
}
function escHtml(s) {
  if (!s) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ── Init ────────────────────────────────────────────────────── */
initConversation();

/* ── Suggestions dynamiques (Chips dans le flux) ──────────────── */
function renderSuggestions(suggestions) {
  const g = getOrCreateGroup('bot');
  const container = document.createElement('div');
  container.className = 'cb-suggestions-dynamic';
  container.style.display = 'flex';
  container.style.flexWrap = 'wrap';
  container.style.gap = '8px';
  container.style.padding = '10px 0 10px 48px';

  suggestions.forEach(s => {
    const btn = document.createElement('button');
    btn.className = 'cb-dynamic-chip';
    btn.innerHTML = `<i class="bi bi-tag"></i> ${escHtml(s.text)}`;
    btn.style.cssText = `
      background: white;
      border: 1px solid #b2dfb5;
      border-radius: 20px;
      padding: 6px 14px;
      font-size: 13px;
      color: #116530;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 2px 4px rgba(17,101,48,0.08);
      display: flex;
      align-items: center;
      gap: 6px;
    `;
    btn.onmouseover = () => { btn.style.background = '#e8f5e9'; btn.style.borderColor = '#116530'; };
    btn.onmouseout  = () => { btn.style.background = 'white';   btn.style.borderColor = '#b2dfb5'; };
    
    btn.onclick = () => {
      // Désactiver tous les boutons du groupe pour éviter le double clic
      container.querySelectorAll('button').forEach(b => b.disabled = true);
      send(s.msg, s.action);
    };
    container.appendChild(btn);
  });

  g.appendChild(container);
  scrollBottom();
}

})();
</script>
