{% extends 'base.html.twig' %}
{% block title %}Finance RH — Ardhi{% endblock %}
{% block body_class %}finance-rh-page{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600&family=Cormorant+Garamond:wght@600&display=swap" rel="stylesheet">
<style>
:root{
  --g900:#0d2211;--g800:#1a3d25;--g700:#214d2e;--g600:#2a6340;
  --g500:#357a4e;--g400:#4aa368;--g300:#6ec285;--g200:#a2dab2;
  --g100:#d4eedd;--g50:#f0f9f2;
  --gold:#c9a84c;--gold2:#e8c96a;--gold-bg:rgba(201,168,76,.1);
  --red:#e05454;--red-bg:rgba(224,84,84,.1);
  --text1:#f4faf5;--text2:#a3c9af;--text3:#5e8268;
  --border:rgba(93,174,116,.18);--border2:rgba(93,174,116,.32);
  --card:#1a3828;--page:#132b1a;
}
*{box-sizing:border-box;margin:0;padding:0}
body.finance-rh-page{background:var(--page);color:var(--text1);font-family:'Plus Jakarta Sans',sans-serif}
.frh{min-height:100vh;padding-bottom:80px}
.frh-header{background:var(--g700);border-bottom:1px solid var(--border);padding:2rem 2.5rem 1.75rem;position:relative;overflow:hidden}
.frh-header::after{content:'';position:absolute;top:-120px;right:-120px;width:500px;height:500px;background:radial-gradient(circle,rgba(93,174,116,.06),transparent 65%);pointer-events:none}
.frh-bc{font-size:11px;color:var(--text3);letter-spacing:.08em;text-transform:uppercase;margin-bottom:1rem}
.frh-bc a{color:var(--g300);text-decoration:none}
.frh-h1{font-family:'Cormorant Garamond',serif;font-size:clamp(30px,4vw,46px);font-weight:600;line-height:1.05;color:var(--text1)}
.frh-h1 em{color:var(--g300);font-style:normal}
.frh-h1 strong{color:var(--gold);font-style:normal}
.frh-desc{font-size:13px;color:var(--text2);margin-top:.5rem}
.frh-actions{display:flex;gap:10px;margin-top:1.5rem;flex-wrap:wrap}
.btn-g{font-size:13px;padding:8px 20px;border-radius:10px;cursor:pointer;font-family:inherit;transition:all .2s;font-weight:500;text-decoration:none;display:inline-flex;align-items:center}
.btn-outline-g{background:transparent;color:var(--g300);border:1px solid var(--border2)}
.btn-outline-g:hover{background:rgba(93,174,116,.08)}

/* ── KPI STRIP ── */
.frh-kpis{display:grid;grid-template-columns:repeat(6,1fr);background:var(--g700);border-bottom:1px solid var(--border)}
@media(max-width:1100px){.frh-kpis{grid-template-columns:repeat(3,1fr)}}
@media(max-width:600px){.frh-kpis{grid-template-columns:repeat(2,1fr)}}
.kpi{padding:1.25rem 1.5rem;border-right:1px solid var(--border);opacity:0;transform:translateY(10px);animation:up .4s ease forwards}
.kpi:last-child{border-right:none}
.kpi:nth-child(1){animation-delay:.05s}.kpi:nth-child(2){animation-delay:.10s}
.kpi:nth-child(3){animation-delay:.15s}.kpi:nth-child(4){animation-delay:.20s}
.kpi:nth-child(5){animation-delay:.25s}.kpi:nth-child(6){animation-delay:.30s}
.kpi-lbl{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.4rem}
.kpi-n{font-size:20px;font-weight:600;line-height:1;letter-spacing:-.01em}
.kpi-n.green{color:var(--g300)}.kpi-n.gold{color:var(--gold)}.kpi-n.red{color:var(--red)}
.kpi-unit{font-size:10px;color:var(--text3);margin-top:3px}

/* ── LAYOUT ── */
.frh-body{max-width:1440px;margin:0 auto;padding:2rem 2.5rem}
.frh-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:1.5rem;margin-bottom:1.5rem}
@media(max-width:1000px){.frh-grid{grid-template-columns:1fr}}

/* ── CARDS ── */
.card{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;opacity:0;transform:translateY(14px);animation:up .55s ease forwards}
.card:nth-child(1){animation-delay:.35s}.card:nth-child(2){animation-delay:.45s}
.card-hd{display:flex;align-items:center;justify-content:space-between;padding:1.1rem 1.5rem;border-bottom:1px solid var(--border)}
.card-hd-t{font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.08em}
.badge{font-size:10px;font-weight:600;padding:3px 10px;border-radius:20px}
.badge-g{background:rgba(61,143,86,.18);color:var(--g300);border:1px solid rgba(61,143,86,.3)}
.badge-gold{background:var(--gold-bg);color:var(--gold);border:1px solid rgba(201,168,76,.25)}
.badge-r{background:var(--red-bg);color:var(--red)}

/* ── TABLE ── */
.ft{width:100%;border-collapse:collapse}
.ft th{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.06em;padding:.65rem 1.25rem;text-align:left;border-bottom:1px solid var(--border);white-space:nowrap}
.ft td{padding:.85rem 1.25rem;font-size:13px;border-bottom:1px solid var(--border);vertical-align:middle;white-space:nowrap}
.ft tr:last-child td{border-bottom:none}
.ft tbody tr{transition:background .15s;cursor:pointer}
.ft tbody tr:hover td{background:rgba(93,174,116,.04)}
.av{width:34px;height:34px;border-radius:50%;object-fit:cover;border:1.5px solid rgba(93,174,116,.3)}
.av-i{width:34px;height:34px;border-radius:50%;background:rgba(61,143,86,.15);border:1.5px solid rgba(93,174,116,.3);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:var(--g300);flex-shrink:0}
.emp-cell{display:flex;align-items:center;gap:9px}
.emp-nm{font-weight:500;color:var(--text1);font-size:13px}
.emp-ps{font-size:11px;color:var(--text3)}
.num-g{color:var(--g300);font-weight:500}
.num-gold{color:var(--gold);font-weight:500}
.num-r{color:var(--red);font-weight:500}
.cp{font-size:10px;padding:2px 7px;border-radius:8px;font-weight:600}
.cp-cdi{background:rgba(61,143,86,.18);color:var(--g300)}
.cp-sais{background:rgba(186,117,23,.18);color:#ef9f27}
.salaire-input{background:transparent;border:none;color:var(--gold);font-family:inherit;font-size:13px;font-weight:500;width:72px;text-align:right;cursor:pointer;border-bottom:1px dashed rgba(201,168,76,.3);padding:2px 4px}
.salaire-input:focus{outline:none;border-bottom-color:var(--gold);background:rgba(201,168,76,.05);border-radius:4px 4px 0 0}
.btn-sm{font-size:11px;padding:4px 12px;border:1px solid rgba(93,174,116,.3);border-radius:8px;background:transparent;color:var(--g300);cursor:pointer;transition:all .2s}
.btn-sm:hover{background:rgba(93,174,116,.1)}

/* ── CNSS ── */
.cnss-g{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border)}
.cnss-c{background:var(--card);padding:1.5rem;text-align:center}
.cnss-pct{font-family:'Cormorant Garamond',serif;font-size:38px;font-weight:600;color:var(--g300);line-height:1;margin-bottom:.2rem}
.cnss-who{font-size:11px;color:var(--text3);margin-bottom:.75rem}
.cnss-amt{font-size:20px;font-weight:600;color:var(--text1)}
.cnss-lbl{font-size:10px;color:var(--text3);margin-top:3px}

/* ── CATÉGORIES ── */
.cat-r{display:flex;align-items:center;gap:10px;padding:.75rem 1.25rem;border-bottom:1px solid var(--border)}
.cat-r:last-child{border-bottom:none}
.cat-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.cat-nm{font-size:13px;color:var(--text2);flex:1}
.cat-sub{font-size:10px;color:var(--text3)}
.bar-t{flex:1;height:3px;background:rgba(255,255,255,.06);border-radius:2px;overflow:hidden;max-width:100px}
.bar-f{height:100%;border-radius:2px;transition:width 1.3s cubic-bezier(.4,0,.2,1)}
.cat-amt{font-size:12px;font-weight:500;color:var(--text1);min-width:90px;text-align:right}

/* ── TÂCHES BUDGET ── */
.tb-r{padding:1rem 1.5rem;border-bottom:1px solid var(--border)}
.tb-r:last-child{border-bottom:none}
.tb-hd{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.5rem;gap:1rem}
.tb-nm{font-size:13px;font-weight:500;color:var(--text1)}
.tb-sub{font-size:11px;color:var(--text3);margin-top:2px}
.tb-amts{font-size:12px;text-align:right;flex-shrink:0}
.bar-tr{height:4px;background:rgba(255,255,255,.06);border-radius:2px;overflow:hidden}
.bar-ok{background:var(--g400)}.bar-warn{background:var(--gold)}.bar-over{background:var(--red)}
.tb-ecart{font-size:11px;margin-top:4px;text-align:right}
.tb-detail{font-size:11px;color:var(--text3);margin-top:4px}

/* ── MODAL ── */
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:9999;align-items:center;justify-content:center;padding:1rem}
.modal-bg.on{display:flex}
.modal{background:var(--g800);border:1px solid var(--border2);border-radius:20px;width:100%;max-width:520px;animation:slideUp .3s ease;overflow:hidden}
.modal-hd{padding:1.5rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:flex-start}
.modal-t{font-family:'Cormorant Garamond',serif;font-size:20px;color:var(--text1)}
.modal-s{font-size:11px;color:var(--text3);margin-top:2px}
.modal-x{background:none;border:none;color:var(--text3);font-size:18px;cursor:pointer;transition:color .2s;line-height:1}
.modal-x:hover{color:var(--text1)}
.modal-body{padding:1.5rem}
.ms{display:flex;gap:8px;margin-bottom:1.25rem}
.ms select{background:var(--g700);border:1px solid var(--border);color:var(--text1);border-radius:8px;padding:7px 10px;font-size:12px;cursor:pointer;flex:1;font-family:inherit}
.bl-r{display:flex;justify-content:space-between;padding:.6rem 0;font-size:13px;border-bottom:1px solid var(--border)}
.bl-r:last-child{border-bottom:none}
.bl-r.tot{font-weight:600;font-size:14px;padding-top:1rem;margin-top:.5rem;border-top:1px solid var(--border2);border-bottom:none}
.bl-lbl{color:var(--text2)}.bl-v{color:var(--text1);font-weight:500}
.bl-v.minus{color:var(--red)}.bl-v.net{color:var(--g300);font-size:18px}
.spinner{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;margin-right:6px}

@keyframes up{to{opacity:1;transform:translateY(0)}}
@keyframes slideUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes spin{to{transform:rotate(360deg)}}
</style>
{% endblock %}

{% block body %}
<div class="frh">

{# ── HEADER ── #}
<div class="frh-header">
  <div style="max-width:1440px;margin:0 auto">
    <div class="frh-bc">
      <a href="{{ path('employe_index') }}">Employés</a> › Finance RH
    </div>
    <div class="frh-h1"><em>Finance</em> <strong>RH</strong></div>
    <div class="frh-desc">Masse salariale · CNSS Tunisie · Coût de revient · Bulletins de paie</div>
    <div class="frh-actions">
      <a href="{{ path('pointage_dashboard') }}" class="btn-g btn-outline-g">Pointage GPS</a>
    </div>
  </div>
</div>

{# ── KPI STRIP — ✅ CORRIGÉ : |tnd au lieu de number_format avec &#8239; ── #}
<div class="frh-kpis">
  <div class="kpi">
    <div class="kpi-lbl">Masse salariale / mois</div>
    <div class="kpi-n green">{{ masseSalarialeMensuelle|tnd }}</div>
    <div class="kpi-unit">TND</div>
  </div>
  <div class="kpi">
    <div class="kpi-lbl">CNSS employeur</div>
    <div class="kpi-n">{{ coutCNSSEmployeur|tnd }}</div>
    <div class="kpi-unit">TND / mois (16.57%)</div>
  </div>
  <div class="kpi">
    <div class="kpi-lbl">Coût total mensuel</div>
    <div class="kpi-n gold">{{ coutTotalMensuel|tnd }}</div>
    <div class="kpi-unit">TND tout compris</div>
  </div>
  <div class="kpi">
    <div class="kpi-lbl">Projection annuelle</div>
    <div class="kpi-n">{{ chargesAnnuelles|tnd }}</div>
    <div class="kpi-unit">TND / an</div>
  </div>
  <div class="kpi">
    <div class="kpi-lbl">Budget tâches</div>
    <div class="kpi-n green">{{ budgetTaches|tnd }}</div>
    <div class="kpi-unit">TND planifié</div>
  </div>
  <div class="kpi">
    <div class="kpi-lbl">Écart budget / réel</div>
    <div class="kpi-n {{ ecartBudget > 0 ? 'red' : 'green' }}">
      {{ ecartBudget|tnd(0, false, true) }}
    </div>
    <div class="kpi-unit">{{ ecartBudget > 0 ? 'Surcoût' : 'Économie' }}</div>
  </div>
</div>

{# ── BODY ── #}
<div class="frh-body">
<div class="frh-grid">

{# ── TABLEAU EMPLOYÉS ── #}
<div class="card">
  <div class="card-hd">
    <div class="card-hd-t">Masse salariale par employé</div>
    <div class="badge badge-g">{{ nbEmployesActifs }} actifs</div>
  </div>
  <table class="ft">
    <thead>
      <tr>
        <th>Employé</th>
        <th>Contrat</th>
        <th title="Cliquez pour modifier">Sal. jour.</th>
        <th>Brut/mois</th>
        <th>Net</th>
        <th>Coût réel</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {% for ed in employes %}
      <tr>
        <td>
          <div class="emp-cell">
            {% if ed.employe.photoPath %}
              <img src="{{ ed.employe.photoPath }}" class="av" alt="">
            {% else %}
              <div class="av-i">{{ ed.employe.prenom|first }}{{ ed.employe.nom|first }}</div>
            {% endif %}
            <div>
              <div class="emp-nm">{{ ed.employe.prenom }} {{ ed.employe.nom }}</div>
              <div class="emp-ps">{{ ed.employe.poste }}</div>
            </div>
          </div>
        </td>
        <td>
          <span class="cp {{ ed.typeContrat == 'Saisonnier' ? 'cp-sais' : 'cp-cdi' }}">
            {{ ed.typeContrat }}
          </span>
        </td>
        <td>
          {# ✅ CORRIGÉ : input + label séparé #}
          <div style="display:flex;align-items:center;gap:4px">
            <input class="salaire-input"
                   type="number"
                   step="0.001"
                   min="0"
                   value="{{ ed.salaireJ }}"
                   title="Cliquez pour modifier le salaire journalier"
                   onchange="updateSalaire({{ ed.employe.id }}, this.value, this)"
                   data-emp="{{ ed.employe.id }}">
            <span style="font-size:10px;color:var(--text3)">TND</span>
          </div>
        </td>
        {# ✅ CORRIGÉ : |tnd au lieu de number_format avec entité HTML #}
        <td class="num-gold">{{ ed.salaireBrut|tnd }}</td>
        <td class="num-g">{{ ed.salaireNet|tnd }}</td>
        <td style="color:var(--text2)">{{ ed.coutTotal|tnd }}</td>
        <td>
          <button class="btn-sm"
                  onclick="ouvrirBulletin({{ ed.employe.id }},'{{ ed.employe.prenom }} {{ ed.employe.nom }}')">
            Bulletin
          </button>
        </td>
      </tr>
      {% else %}
      <tr>
        <td colspan="7" style="text-align:center;padding:3rem;color:var(--text3)">
          Aucun employé actif — vérifiez que <code>migration_v2.sql</code> a été exécutée.
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{# ── DROITE : CNSS + CATÉGORIES ── #}
<div>

  <div class="card" style="margin-bottom:1.5rem">
    <div class="card-hd">
      <div class="card-hd-t">Cotisations CNSS — Tunisie 2024</div>
      <div class="badge badge-gold">Officiel</div>
    </div>
    <div class="cnss-g">
      <div class="cnss-c">
        <div class="cnss-pct">9.18%</div>
        <div class="cnss-who">Part employé</div>
        {# ✅ CORRIGÉ #}
        <div class="cnss-amt">{{ (masseSalarialeMensuelle * 0.0918)|tnd }}</div>
        <div class="cnss-lbl">TND / mois retenu</div>
      </div>
      <div class="cnss-c">
        <div class="cnss-pct">16.57%</div>
        <div class="cnss-who">Part employeur</div>
        <div class="cnss-amt">{{ coutCNSSEmployeur|tnd }}</div>
        <div class="cnss-lbl">TND / mois à payer</div>
      </div>
    </div>
    <div style="padding:1rem 1.5rem;font-size:11px;color:var(--text3);line-height:1.6;border-top:1px solid var(--border)">
      Décret 2024 · Retraite + Maladie + Accidents travail + Allocations familiales
    </div>
  </div>

  <div class="card">
    <div class="card-hd">
      <div class="card-hd-t">Budget par catégorie</div>
    </div>
    {% set catCols={'Récolte':'#c9a84c','Irrigation':'#378add','Fertilisation':'#5dcaa5','Maintenance':'#888780','Plantation':'#97c459','Administratif':'#7f77dd','Autre':'#4a6b52'} %}
    {% set mx = 1 %}
    {% for cat, v in parCategorie %}{% if v.budget > mx %}{% set mx = v.budget %}{% endif %}{% endfor %}
    {% for cat, v in parCategorie %}
    <div class="cat-r">
      <div class="cat-dot" style="background:{{ catCols[cat] ?? '#888' }}"></div>
      <div>
        <div class="cat-nm">{{ cat }}</div>
        <div class="cat-sub">{{ v.nb }} tâche(s)</div>
      </div>
      <div class="bar-t">
        <div class="bar-f" style="width:{{ ((v.budget / mx) * 100)|round }}%;background:{{ catCols[cat] ?? '#888' }}"></div>
      </div>
      {# ✅ CORRIGÉ #}
      <div class="cat-amt">{{ v.budget|tnd }} TND</div>
    </div>
    {% endfor %}
  </div>

</div>
</div>{# /grid #}

{# ── TÂCHES BUDGET ── #}
<div class="card" style="margin-bottom:1.5rem;animation-delay:.55s">
  <div class="card-hd">
    <div class="card-hd-t">Analyse budgétaire des tâches</div>
    <div style="display:flex;gap:8px">
      <div class="badge badge-g">Sous budget : {{ taches|filter(t => not t.enSurbudget and t.budgetPrevu > 0)|length }}</div>
      <div class="badge badge-r">Dépassement : {{ taches|filter(t => t.enSurbudget and t.budgetPrevu > 0)|length }}</div>
    </div>
  </div>
  {% for td in taches %}
  {% if td.budgetPrevu > 0 or td.coutReel > 0 %}
  <div class="tb-r">
    <div class="tb-hd">
      <div>
        <div class="tb-nm">{{ td.tache.titre }}</div>
        <div class="tb-sub">
          {{ td.categorie }} · {{ td.nomEmploye }} · {{ td.nbJours }} j
          · <span class="cp {{ td.statut in ['Terminé','Validé'] ? 'cp-cdi' : 'cp-sais' }}" style="font-size:10px">{{ td.statut }}</span>
        </div>
      </div>
      <div class="tb-amts">
        {# ✅ CORRIGÉ #}
        <div style="color:{{ td.enSurbudget ? 'var(--red)' : 'var(--g300)' }};font-weight:500">
          Réel : {{ td.coutReel|tnd }} TND
        </div>
        {% if td.budgetPrevu > 0 %}
        <div style="color:var(--text3);font-size:11px">Prévu : {{ td.budgetPrevu|tnd }} TND</div>
        {% endif %}
      </div>
    </div>
    {% if td.budgetPrevu > 0 %}
    {% set pct = min(100, (td.coutReel / td.budgetPrevu * 100)|round) %}
    <div class="bar-tr">
      <div class="{{ pct > 100 ? 'bar-over' : (pct > 80 ? 'bar-warn' : 'bar-ok') }}"
           style="width:{{ pct }}%;height:100%;border-radius:2px;transition:width 1.2s ease"></div>
    </div>
    <div class="tb-ecart {{ td.enSurbudget ? 'num-r' : 'num-g' }}">
      {% if td.enSurbudget %}
        +{{ td.ecart|tnd }} TND dépassement ({{ td.pctEcart|abs }}%)
      {% else %}
        Économie {{ td.ecart|abs|tnd }} TND ({{ td.pctEcart|abs }}%)
      {% endif %}
    </div>
    {% endif %}
    {# ✅ CORRIGÉ #}
    <div class="tb-detail">
      {{ td.salaireJ|tnd(3) }} TND/j × {{ td.nbJours }} j = {{ td.coutSalaire|tnd }} TND
      {% if td.coutMateriel > 0 %} · Matériaux {{ td.coutMateriel|tnd }} TND{% endif %}
    </div>
  </div>
  {% endif %}
  {% endfor %}
</div>

</div>{# /body #}
</div>{# /frh #}

{# ── MODAL BULLETIN ── #}
<div class="modal-bg" id="mBulletin" onclick="closeMod(event)">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-hd">
      <div>
        <div class="modal-t" id="mNom">Bulletin de paie</div>
        <div class="modal-s">CNSS Tunisie 2024 · Calcul automatique</div>
      </div>
      <button class="modal-x" onclick="closeMod()">✕</button>
    </div>
    <div class="modal-body">
      <div class="ms">
        <select id="sMois">
          {% for m in 1..12 %}
          <option value="{{ m }}" {{ m == "now"|date('n') ? 'selected' : '' }}>
            {{ ['','Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'][m] }}
          </option>
          {% endfor %}
        </select>
        <select id="sAnnee">
          {% for y in [2023,2024,2025,2026] %}
          <option value="{{ y }}" {{ y == "now"|date('Y') ? 'selected' : '' }}>{{ y }}</option>
          {% endfor %}
        </select>
        <button class="btn-sm" onclick="loadBulletin()">Calculer</button>
      </div>
      <div id="mContent"
           style="min-height:180px;display:flex;align-items:center;justify-content:center;color:var(--text3);font-size:13px">
        Sélectionnez le mois puis cliquez sur Calculer
      </div>
    </div>
  </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
let curEmp = null;

function ouvrirBulletin(id, nom) {
  curEmp = id;
  document.getElementById('mNom').textContent = nom;
  document.getElementById('mContent').innerHTML =
    '<span style="color:var(--text3)">Sélectionnez le mois puis cliquez sur Calculer</span>';
  document.getElementById('mBulletin').classList.add('on');
}

function closeMod(e) {
  if (!e || e.target === document.getElementById('mBulletin'))
    document.getElementById('mBulletin').classList.remove('on');
}

/* ✅ JS formatage aussi corrigé : vrai U+202F, pas une entité HTML */
function fmt(v, dec = 3) {
  return parseFloat(v)
    .toFixed(dec)
    .replace(/\B(?=(\d{3})+(?!\d))/g, '\u202F'); /* U+202F directement */
}

function loadBulletin() {
  if (!curEmp) return;
  const mois  = document.getElementById('sMois').value;
  const annee = document.getElementById('sAnnee').value;
  const mc    = document.getElementById('mContent');
  mc.innerHTML = '<span class="spinner"></span> Calcul en cours\u2026';

  fetch(`/finance-rh/bulletin/${curEmp}?mois=${mois}&annee=${annee}`)
    .then(r => r.json())
    .then(d => {
      if (d.error) {
        mc.innerHTML = `<span style="color:var(--red)">${d.error}</span>`;
        return;
      }
      mc.innerHTML = `
        <div style="background:rgba(61,143,86,.08);border:1px solid rgba(93,174,116,.2);border-radius:10px;padding:.75rem 1rem;font-size:12px;margin-bottom:1rem">
          Période\u00a0: <strong style="color:var(--g300)">${d.mois} ${d.annee}</strong>
          \u00b7 Jours\u00a0: <strong>${d.nbJoursTravailles}</strong>
          \u00b7 <span class="cp ${d.typeContrat === 'CDI' ? 'cp-cdi' : 'cp-sais'}">${d.typeContrat}</span>
        </div>
        <div class="bl-r">
          <span class="bl-lbl">Salaire journalier</span>
          <span class="bl-v">${fmt(d.salaireJournalier)} TND</span>
        </div>
        <div class="bl-r">
          <span class="bl-lbl">Salaire brut (${d.nbJoursTravailles}\u00a0j)</span>
          <span class="bl-v">${fmt(d.salaireBrut)} TND</span>
        </div>
        <div class="bl-r">
          <span class="bl-lbl">CNSS employ\u00e9 (${parseFloat(d.tauxCNSSEmp).toFixed(2)}\u202f%)</span>
          <span class="bl-v minus">\u2212\u202f${fmt(d.cnssEmploye)} TND</span>
        </div>
        <div class="bl-r">
          <span class="bl-lbl">IRPP (bar\u00e8me mensuel)</span>
          <span class="bl-v minus">\u2212\u202f${fmt(d.irpp)} TND</span>
        </div>
        <div class="bl-r tot">
          <span class="bl-lbl" style="color:var(--g300)">Salaire net \u00e0 payer</span>
          <span class="bl-v net">${fmt(d.salaireNet)} TND</span>
        </div>
        <div style="margin-top:1rem;padding:.85rem 1rem;background:rgba(224,84,84,.08);border-radius:8px;font-size:12px;color:var(--text2)">
          Charge totale employeur\u00a0:
          <strong style="color:var(--text1)">${fmt(d.coutTotalEmpl)} TND</strong>
          <span style="color:var(--text3)">
            (CNSS employeur ${parseFloat(d.tauxCNSSEmpr).toFixed(2)}\u202f% = ${fmt(d.cnssEmployeur)} TND)
          </span>
        </div>`;
    })
    .catch(() => {
      mc.innerHTML = '<span style="color:var(--red)">Erreur de connexion.</span>';
    });
}

function updateSalaire(idEmp, val, input) {
  fetch(`/finance-rh/salaire/${idEmp}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ salaire: parseFloat(val) })
  })
  .then(r => r.json())
  .then(d => {
    if (d.success) {
      input.style.borderBottomColor = 'var(--g300)';
      setTimeout(() => { input.style.borderBottomColor = ''; location.reload(); }, 800);
    }
  })
  .catch(() => {});
}

document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMod(); });
</script>
{% endblock %}
