{% extends 'base.html.twig' %}
{% block title %}Gestion des Employés — Ardhi{% endblock %}

{% block stylesheets %}
<style>
/* ── Page wrapper ──────────────────────────────────────────────── */
.emp-page { padding: 90px 0 60px; background: #f0f2f0; min-height: 100vh; }

/* ── Barre du haut (comme le header JavaFX) ────────────────────── */
.emp-topbar {
    background: white;
    border-radius: 14px;
    padding: 16px 24px;
    margin-bottom: 18px;
    box-shadow: 0 2px 12px rgba(0,0,0,.08);
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
}
.emp-topbar-title {
    font-size: 1.35rem; font-weight: 700; color: #1B5E20;
    display: flex; align-items: center; gap: 10px;
}
.emp-counter {
    background: #e8f5e9; color: #1B5E20; font-weight: 700;
    border-radius: 20px; padding: 4px 14px; font-size: .9rem;
}

/* ── Barre de recherche + tris ─────────────────────────────────── */
.emp-toolbar {
    background: white; border-radius: 12px; padding: 14px 20px;
    margin-bottom: 16px; box-shadow: 0 2px 8px rgba(0,0,0,.06);
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
}
.emp-search {
    flex: 1; min-width: 240px;
    border: 1.5px solid #ccc; border-radius: 8px;
    padding: 9px 14px; font-size: .9rem;
    transition: border-color .2s;
}
.emp-search:focus { border-color: #27ae60; outline: none; box-shadow: 0 0 0 3px rgba(39,174,96,.12); }

/* ── Table — identique couleur header desktop (#4a7c59 vert) ───── */
.emp-table-wrap {
    background: white; border-radius: 14px;
    box-shadow: 0 2px 12px rgba(0,0,0,.08); overflow: hidden;
    margin-bottom: 20px;
}
.emp-table { width: 100%; border-collapse: collapse; }
.emp-table thead th {
    background: #4a7c59; color: white;
    font-size: .82rem; font-weight: 700; letter-spacing: .4px;
    padding: 13px 14px; text-align: left; border: none;
    white-space: nowrap;
}
.emp-table thead th:first-child { border-radius: 0; }
.emp-table tbody tr { border-bottom: 1px solid #f0f0f0; transition: background .15s; }
.emp-table tbody tr:hover { background: #f6fbf6; }
.emp-table tbody td { padding: 12px 14px; vertical-align: middle; font-size: .9rem; color: #333; }

/* ── Avatar / Photo ────────────────────────────────────────────── */
.emp-avatar {
    width: 48px; height: 48px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: .95rem; color: white;
    border: 2px solid rgba(255,255,255,.5);
    flex-shrink: 0;
}
.emp-photo { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 2px solid #27ae60; }

/* ── QR Code miniature ─────────────────────────────────────────── */
.qr-badge {
    font-family: monospace; font-size: .72rem;
    background: #f5f5f5; border: 1px solid #ddd;
    border-radius: 6px; padding: 3px 8px; color: #444;
    white-space: nowrap;
}

/* ── Badges statut ─────────────────────────────────────────────── */
.badge-actif   { background:#d4edda; color:#155724; padding:4px 12px; border-radius:20px; font-size:.78rem; font-weight:600; white-space:nowrap; }
.badge-inactif { background:#f8d7da; color:#721c24; padding:4px 12px; border-radius:20px; font-size:.78rem; font-weight:600; white-space:nowrap; }

/* ── Boutons d'action dans la table ────────────────────────────── */
.btn-voir    { background:#e8f5e9; color:#1B5E20; border:none; border-radius:7px; padding:5px 10px; font-size:.8rem; font-weight:600; cursor:pointer; transition:.15s; }
.btn-modif   { background:#fff3cd; color:#856404; border:none; border-radius:7px; padding:5px 10px; font-size:.8rem; font-weight:600; cursor:pointer; transition:.15s; }
.btn-suppr   { background:#f8d7da; color:#842029; border:none; border-radius:7px; padding:5px 10px; font-size:.8rem; font-weight:600; cursor:pointer; transition:.15s; }
.btn-toggle-on  { background:#d1ecf1; color:#0c5460; border:none; border-radius:7px; padding:5px 10px; font-size:.8rem; font-weight:600; cursor:pointer; }
.btn-toggle-off { background:#e2e3e5; color:#41464b; border:none; border-radius:7px; padding:5px 10px; font-size:.8rem; font-weight:600; cursor:pointer; }
.btn-voir:hover  { background:#27ae60; color:white; }
.btn-modif:hover { background:#ffc107; color:#000; }
.btn-suppr:hover { background:#dc3545; color:white; }

/* ── Barre du bas — boutons principaux (identique desktop) ────── */
.emp-bottombar {
    background: white; border-radius: 14px;
    padding: 16px 24px; box-shadow: 0 2px 12px rgba(0,0,0,.08);
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
}
.btn-ajouter { background:#27ae60; color:white; border:none; border-radius:10px; padding:11px 26px; font-weight:700; font-size:.95rem; cursor:pointer; display:flex; align-items:center; gap:8px; transition:.2s; text-decoration:none; }
.btn-ajouter:hover { background:#219150; color:white; transform:translateY(-1px); }
.btn-bottom-orange { background:#f39c12; color:white; border:none; border-radius:10px; padding:11px 22px; font-weight:700; font-size:.95rem; cursor:pointer; display:flex; align-items:center; gap:8px; transition:.2s; text-decoration:none; }
.btn-bottom-orange:hover { background:#d68910; color:white; }
.btn-bottom-red { background:#e74c3c; color:white; border:none; border-radius:10px; padding:11px 22px; font-weight:700; font-size:.95rem; cursor:pointer; display:flex; align-items:center; gap:8px; transition:.2s; }
.btn-bottom-red:hover { background:#c0392b; color:white; }
.btn-bottom-blue { background:#2980b9; color:white; border:none; border-radius:10px; padding:11px 22px; font-weight:700; font-size:.95rem; cursor:pointer; display:flex; align-items:center; gap:8px; transition:.2s; text-decoration:none; }
.btn-bottom-blue:hover { background:#1f6391; color:white; }
.bottom-info { margin-left:auto; color:#aaa; font-size:.85rem; font-style:italic; }

/* ── Empty state ───────────────────────────────────────────────── */
.emp-empty { text-align:center; padding:60px 20px; color:#bbb; }
.emp-empty i { font-size:4rem; margin-bottom:14px; display:block; }
</style>
{% endblock %}

{% block body %}
<div class="emp-page">
<div class="container-fluid px-4">

    {# ── Barre du haut ─────────────────────────────────────────────── #}
    <div class="emp-topbar">
        <div class="emp-topbar-title">
            <i class="bi bi-people-fill"></i>
            Gestion des Employés
        </div>
        <span class="emp-counter">{{ total }} Total</span>
        <span class="emp-counter" style="background:#d4edda;color:#155724;">{{ total_actifs }} Actifs</span>
        <span class="emp-counter" style="background:#f8d7da;color:#721c24;">{{ total - total_actifs }} Inactifs</span>

        {# Top 3 employés (affichage rapide) #}
        {% for emp in employes|slice(0, 3) %}
            <span class="emp-counter" style="background:#e8eaf6;color:#283593;font-size:.78rem;">
                🏅 {{ emp.nomComplet }}
            </span>
        {% endfor %}
    </div>

    {# ── Toolbar recherche ─────────────────────────────────────────── #}
    <div class="emp-toolbar">
        <form method="GET" action="{{ path('employe_index') }}" class="d-flex align-items-center gap-2 flex-grow-1">
            <i class="bi bi-search text-muted"></i>
            <input type="text" name="search" value="{{ search }}" class="emp-search"
                   placeholder="Rechercher par nom, prénom, email, poste...">
            <button type="submit" class="btn btn-success btn-sm px-3" style="border-radius:7px">Rechercher</button>
            {% if search %}
                <a href="{{ path('employe_index') }}" class="btn btn-outline-secondary btn-sm" style="border-radius:7px">
                    <i class="bi bi-x-lg"></i> Réinitialiser
                </a>
            {% endif %}
        </form>
    </div>

    {# ── Table employés ────────────────────────────────────────────── #}
    <div class="emp-table-wrap">
        {% if employes|length > 0 %}
        <div class="table-responsive">
        <table class="emp-table">
            <thead>
                <tr>
                    <th>Photo</th>
                    <th>QR</th>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Email</th>
                    <th>Poste</th>
                    <th>Téléphone</th>
                    <th>Statut</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for emp in employes %}
            <tr id="row-{{ emp.id }}">
                {# Photo #}
                <td>
                    {% if emp.hasPhoto %}
                        <img src="{{ emp.photoPath }}" class="emp-photo" alt="{{ emp.nomComplet }}">
                    {% else %}
                        {% set colors = ['#1abc9c','#3498db','#9b59b6','#e67e22','#e74c3c','#27ae60'] %}
                        <div class="emp-avatar" style="background:{{ colors[emp.id % 6] }}">
                            {{ emp.initiales }}
                        </div>
                    {% endif %}
                </td>

                {# QR miniature #}
                <td>
                    {% if emp.qrCodeUnique %}
                        <span class="qr-badge" title="{{ emp.qrCodeUnique }}">
                            <i class="bi bi-qr-code me-1"></i>{{ emp.qrCodeUnique }}
                        </span>
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                </td>

                <td><strong>{{ emp.id }}</strong></td>
                <td>{{ emp.nom }}</td>
                <td>{{ emp.prenom }}</td>
                <td>
                    <a href="mailto:{{ emp.email }}" class="text-primary text-decoration-none">
                        {{ emp.email }}
                    </a>
                </td>
                <td>{{ emp.poste ?? '—' }}</td>
                <td>{{ emp.telephone ?? '—' }}</td>

                {# Statut #}
                <td>
                    {% if emp.actif %}
                        <span class="badge-actif">✓ Actif</span>
                    {% else %}
                        <span class="badge-inactif">✗ Inactif</span>
                    {% endif %}
                </td>

                {# Actions #}
                <td>
                    <div class="d-flex gap-1 justify-content-center">
                        {# Voir fiche #}
                        <a href="{{ path('employe_show', {id: emp.id}) }}" class="btn-voir" title="Voir la fiche">
                            <i class="bi bi-eye"></i>
                        </a>

                        {# Modifier #}
                        <a href="{{ path('employe_edit', {id: emp.id}) }}" class="btn-modif" title="Modifier">
                            <i class="bi bi-pencil-square"></i>
                        </a>

                        {# Toggle actif #}
                        <form method="POST" action="{{ path('employe_toggle', {id: emp.id}) }}" style="margin:0">
                            <button type="submit" class="{{ emp.actif ? 'btn-toggle-on' : 'btn-toggle-off' }}"
                                    title="{{ emp.actif ? 'Désactiver' : 'Activer' }}">
                                <i class="bi bi-toggle-{{ emp.actif ? 'on' : 'off' }}"></i>
                            </button>
                        </form>

                        {# Supprimer #}
                        <form method="POST" action="{{ path('employe_delete', {id: emp.id}) }}"
                              onsubmit="return confirmDelete('{{ emp.nomComplet }}')" style="margin:0">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ emp.id) }}">
                            <button type="submit" class="btn-suppr" title="Supprimer">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>

        {% else %}
        <div class="emp-empty">
            <i class="bi bi-people"></i>
            {% if search %}
                <h5>Aucun résultat pour "{{ search }}"</h5>
                <a href="{{ path('employe_index') }}" class="btn btn-outline-success mt-2">Voir tous les employés</a>
            {% else %}
                <h5>Aucun employé pour le moment</h5>
                <p>Cliquez sur "+ Ajouter un Employé" pour commencer</p>
            {% endif %}
        </div>
        {% endif %}
    </div>

    {# ── Barre du bas — boutons principaux (identique desktop) ──────── #}
    <div class="emp-bottombar">
        <a href="{{ path('employe_new') }}" class="btn-ajouter">
            <i class="bi bi-plus-lg"></i> Ajouter un Employé
        </a>

        {# Modifier — nécessite une sélection (JS) #}
        <button class="btn-bottom-orange" id="btnModifier" onclick="modifierSelectionne()" disabled>
            <i class="bi bi-pencil-square"></i> Modifier
        </button>

        {# Supprimer — nécessite une sélection #}
        <button class="btn-bottom-red" id="btnSupprimer" onclick="supprimerSelectionne()" disabled>
            <i class="bi bi-trash3"></i> Supprimer
        </button>

        {# Attestation de Travail #}
        <a href="#" class="btn-bottom-blue" id="btnAttestation" onclick="attestationSelectionne(event)">
            <i class="bi bi-file-earmark-text"></i> Attestation de Travail
        </a>

        <span class="bottom-info" id="selectionInfo">Aucune sélection</span>
    </div>

</div>
</div>

{# Formulaire caché pour suppression via bouton du bas #}
<form id="formDeleteBottom" method="POST" style="display:none">
    <input type="hidden" name="_token" id="tokenDeleteBottom">
</form>
{% endblock %}

{% block javascripts %}
<script>
// ── Sélection d'une ligne ─────────────────────────────────────────
let selectedId   = null;
let selectedNom  = null;
let selectedEdit = null;
let selectedDel  = null;
let selectedTok  = null;

document.querySelectorAll('.emp-table tbody tr').forEach(row => {
    row.style.cursor = 'pointer';
    row.addEventListener('click', function(e) {
        // Ignorer si clic sur un bouton/lien d'action
        if (e.target.closest('a, button, form')) return;

        document.querySelectorAll('.emp-table tbody tr').forEach(r => r.style.background = '');
        this.style.background = '#e8f5e9';

        selectedId   = this.id.replace('row-', '');
        selectedNom  = this.querySelector('td:nth-child(4)').textContent.trim()
                     + ' '
                     + this.querySelector('td:nth-child(5)').textContent.trim();

        // Récupérer les URLs depuis les boutons de la ligne
        const editLink = this.querySelector('a.btn-modif');
        const delForm  = this.querySelector('form:has(button.btn-suppr)');
        if (editLink) selectedEdit = editLink.href;
        if (delForm)  {
            selectedDel = delForm.action;
            selectedTok = delForm.querySelector('input[name="_token"]').value;
        }

        document.getElementById('btnModifier').disabled  = false;
        document.getElementById('btnSupprimer').disabled = false;
        document.getElementById('selectionInfo').textContent = '✔ Sélectionné : ' + selectedNom;
    });
});

function modifierSelectionne() {
    if (selectedEdit) window.location.href = selectedEdit;
}

function supprimerSelectionne() {
    if (!selectedId) return;
    if (!confirm('Supprimer ' + selectedNom + ' ?')) return;
    const form = document.getElementById('formDeleteBottom');
    form.action = selectedDel;
    document.getElementById('tokenDeleteBottom').value = selectedTok;
    form.submit();
}

function attestationSelectionne(e) {
    e.preventDefault();
    if (!selectedId) {
        alert('Veuillez sélectionner un employé dans la liste.');
        return;
    }
    // À implémenter : rediriger vers la génération de l'attestation
    window.location.href = '/employes/' + selectedId + '/attestation';
}

// ── Confirmation suppression via bouton inline ────────────────────
function confirmDelete(nom) {
    return confirm('Supprimer l\'employé ' + nom + ' ?\n\nCette action est irréversible.');
}
</script>
{% endblock %}
