{% extends 'base.html.twig' %}
{% block title %}Gestion des Tâches — Ardhi{% endblock %}

{% block stylesheets %}
<style>
/* ── Page ─────────────────────────────────────────────────────────── */
.tache-page { padding: 90px 0 60px; background: #f0f2f0; min-height: 100vh; }

/* ── KPIs header ─────────────────────────────────────────────────── */
.kpi-bar {
    background: white; border-radius: 14px; padding: 14px 22px;
    margin-bottom: 14px; box-shadow: 0 2px 12px rgba(0,0,0,.08);
    display: flex; align-items: center; gap: 24px; flex-wrap: wrap;
}
.kpi-item { display: flex; align-items: center; gap: 10px; }
.kpi-icon { font-size: 1.4rem; color: #4a7c59; }
.kpi-count { font-size: 1.5rem; font-weight: 700; color: #1B5E20; }
.kpi-label { font-size: .78rem; color: #888; }
.kpi-sep { width: 1px; height: 36px; background: #e0e0e0; }

/* ── Toolbar ─────────────────────────────────────────────────────── */
.tache-toolbar {
    background: white; border-radius: 12px; padding: 12px 16px;
    margin-bottom: 14px; box-shadow: 0 2px 8px rgba(0,0,0,.06);
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
}
.tache-search {
    flex: 1; min-width: 200px; border: 1.5px solid #ccc;
    border-radius: 8px; padding: 7px 12px; font-size: .88rem; transition: .2s;
}
.tache-search:focus { border-color: #27ae60; outline: none; box-shadow: 0 0 0 3px rgba(39,174,96,.12); }

.filter-select {
    border: 1.5px solid #ccc; border-radius: 8px; padding: 6px 10px;
    font-size: .84rem; background: white; cursor: pointer; min-width: 110px;
}
.filter-select:focus { border-color: #27ae60; outline: none; }

.tri-label { font-size: .8rem; font-weight: 600; color: #777; white-space: nowrap; }
.toolbar-sep { width: 1px; height: 30px; background: #e0e0e0; flex-shrink: 0; }

.btn-dir {
    width: 32px; height: 32px; border: 1.5px solid #ccc; border-radius: 7px;
    background: white; cursor: pointer; font-size: .95rem; display: flex;
    align-items: center; justify-content: center; transition: .15s; flex-shrink: 0;
}
.btn-dir:hover, .btn-dir.active { border-color: #27ae60; background: #e8f5e9; color: #1B5E20; }
.btn-dir.active { background: #27ae60; color: white; }
.btn-actualiser {
    border: 1.5px solid #ccc; border-radius: 8px; background: white;
    padding: 6px 12px; font-size: .82rem; font-weight: 600; cursor: pointer;
    display: flex; align-items: center; gap: 5px; color: #555; transition: .15s;
    text-decoration: none;
}
.btn-actualiser:hover { border-color: #27ae60; color: #1B5E20; }
.btn-filtres-avances {
    border: 1.5px solid #ccc; border-radius: 8px; background: white;
    padding: 6px 12px; font-size: .82rem; font-weight: 600; cursor: pointer;
    display: flex; align-items: center; gap: 5px; color: #555;
    text-decoration: none; transition: .15s;
}
.btn-filtres-avances:hover { border-color: #3498db; color: #3498db; }

/* ── Table — identique desktop ───────────────────────────────────── */
.tache-table-wrap {
    background: white; border-radius: 14px;
    box-shadow: 0 2px 12px rgba(0,0,0,.08); overflow: hidden; margin-bottom: 16px;
}
.tache-table { width: 100%; border-collapse: collapse; }
.tache-table thead th {
    background: #4a7c59; color: white; font-size: .8rem; font-weight: 700;
    padding: 11px 12px; text-align: left; border: none; white-space: nowrap;
    letter-spacing: .3px;
}
.tache-table thead th.sortable { cursor: pointer; }
.tache-table thead th.sortable:hover { background: #3d6b4b; }
.tache-table thead th.sorted-asc::after  { content: ' ↑'; opacity: .9; }
.tache-table thead th.sorted-desc::after { content: ' ↓'; opacity: .9; }

.tache-table tbody tr { border-bottom: 1px solid #f0f0f0; transition: background .1s; cursor: pointer; }
.tache-table tbody tr:hover { background: #f6fbf6; }
.tache-table tbody tr.selected { background: #e8f5e9 !important; }
.tache-table tbody td { padding: 10px 12px; vertical-align: middle; font-size: .87rem; color: #333; }

/* Statut badges — identiques au desktop */
.st-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 10px; border-radius: 20px; font-size: .76rem; font-weight: 600;
    white-space: nowrap;
}
.st-attente  { background: #fff3cd; color: #856404; }
.st-encours  { background: #cce5ff; color: #004085; }
.st-termine  { background: #d4edda; color: #155724; }
.st-valide   { background: #d1ecf1; color: #0c5460; }
.st-annule   { background: #f8d7da; color: #721c24; }

/* Retard badge */
.badge-retard { background: #f8d7da; color: #721c24; font-size: .72rem;
    padding: 2px 7px; border-radius: 10px; margin-left: 4px; }

/* Priorité ─ texte coloré */
.prio-basse    { color: #3498db; font-weight: 600; }
.prio-moyenne  { color: #f39c12; font-weight: 600; }
.prio-haute    { color: #e74c3c; font-weight: 600; }
.prio-critique { color: #8e44ad; font-weight: 700; }

/* Boutons action */
.btn-voir  { background:#e8f5e9; color:#1B5E20; border:none; border-radius:6px;
    padding:4px 8px; font-size:.77rem; font-weight:600; cursor:pointer;
    transition:.12s; text-decoration:none; display:inline-flex; align-items:center; }
.btn-modif { background:#fff3cd; color:#856404; border:none; border-radius:6px;
    padding:4px 8px; font-size:.77rem; font-weight:600; cursor:pointer;
    transition:.12s; text-decoration:none; display:inline-flex; align-items:center; }
.btn-suppr { background:#f8d7da; color:#842029; border:none; border-radius:6px;
    padding:4px 8px; font-size:.77rem; font-weight:600; cursor:pointer; transition:.12s; display:inline-flex; align-items:center; }
.btn-voir:hover  { background:#27ae60; color:white; }
.btn-modif:hover { background:#ffc107; color:#000; }
.btn-suppr:hover { background:#dc3545; color:white; }

/* ── Barre du bas ─────────────────────────────────────────────────── */
.tache-bottombar {
    background: white; border-radius: 14px; padding: 12px 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,.08);
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
}
.btn-add    { background:#27ae60; color:white; border:none; border-radius:10px;
    padding:9px 20px; font-weight:700; font-size:.88rem; cursor:pointer;
    display:flex; align-items:center; gap:7px; transition:.2s; text-decoration:none; }
.btn-add:hover { background:#219150; color:white; }
.btn-orange { background:#f39c12; color:white; border:none; border-radius:10px;
    padding:9px 18px; font-weight:700; font-size:.88rem; cursor:pointer;
    display:flex; align-items:center; gap:7px; transition:.2s; }
.btn-orange:hover { background:#d68910; }
.btn-red    { background:#e74c3c; color:white; border:none; border-radius:10px;
    padding:9px 18px; font-weight:700; font-size:.88rem; cursor:pointer;
    display:flex; align-items:center; gap:7px; transition:.2s; }
.btn-red:hover { background:#c0392b; }
.btn-purple { background:#8e44ad; color:white; border:none; border-radius:10px;
    padding:9px 18px; font-weight:700; font-size:.88rem; cursor:pointer;
    display:flex; align-items:center; gap:7px; transition:.2s; }
.btn-purple:hover { background:#7d3c98; }
.bottom-info { margin-left:auto; color:#aaa; font-size:.82rem; font-style:italic; }
.btn-calendrier { background:#1a6b9a; color:white; border:none; border-radius:10px;
    padding:9px 18px; font-weight:700; font-size:.88rem; cursor:pointer;
    display:flex; align-items:center; gap:7px; transition:.2s; text-decoration:none; }
.btn-calendrier:hover { background:#155880; color:white; }

/* ── Empty ────────────────────────────────────────────────────────── */
.tache-empty { text-align:center; padding:55px 20px; color:#bbb; }
.tache-empty i { font-size:3.5rem; margin-bottom:12px; display:block; }
/* ── Modal IA premium ────────────────────────────────────────────── */
.glass-modal .modal-content {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 24px;
    box-shadow: 0 15px 50px rgba(0,0,0,0.15);
    overflow: hidden;
}
.glass-modal .modal-header { border-bottom: none; padding: 25px 25px 0; }
.glass-modal .modal-body { padding: 15px 25px 25px; }
.glass-modal .modal-title { font-weight: 800; color: #1a5c38; font-size: 1.3rem; }

/* Dashboard IA */
.ia-grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: 20px; }
.risk-card {
    background: rgba(255,255,255,0.5); border-radius: 20px; padding: 25px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    border: 1px solid rgba(255,255,255,0.8);
}
.risk-circle {
    width: 140px; height: 140px; border-radius: 50%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    border: 10px solid #eee; position: relative;
}
.risk-percent { font-size: 2.2rem; font-weight: 900; color: #333; }
.risk-label { font-size: 0.75rem; font-weight: 700; color: #888; text-transform: uppercase; }

.factors-card { background: rgba(255,255,255,0.5); border-radius: 20px; padding: 20px; border: 1px solid rgba(255,255,255,0.8); }
.factor-row { margin-bottom: 12px; }
.factor-info { display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: 700; margin-bottom: 4px; color: #555; }
.factor-bar-bg { height: 7px; background: rgba(0,0,0,0.06); border-radius: 10px; overflow: hidden; }
.factor-bar-fill { height: 100%; border-radius: 10px; transition: width 1s cubic-bezier(0.175, 0.885, 0.32, 1.275); }

.ia-details-box { margin-top: 20px; background: #2c3e50; color: #ecf0f1; border-radius: 18px; padding: 18px; }
.ia-details-title { font-weight: 700; font-size: 0.85rem; margin-bottom: 10px; color: #bdc3c7; display: flex; align-items: center; gap: 8px; }
.ia-fact-list { font-size: 0.82rem; margin: 0; padding-left: 20px; opacity: 0.9; }

.reco-box { margin-top: 20px; background: #f1f8f4; border: 1px dashed #27ae60; border-radius: 18px; padding: 18px; }
.reco-title { font-weight: 700; color: #1B5E20; display: flex; align-items: center; gap: 8px; margin-bottom: 8px; font-size: 0.95rem; }
.reco-list { font-size: 0.88rem; color: #333; margin: 0; padding-left: 20px; }

/* Loader IA */
.ia-loader { display: none; text-align: center; padding: 40px; }
.ia-loader i { font-size: 3rem; color: #27ae60; animation: spin 2s linear infinite; }
@keyframes spin { 100% { transform: rotate(360deg); } }
</style>
{% endblock %}

{% block body %}
<div class="tache-page">
<div class="container-fluid px-4">

    {# ── KPI Header — identique au desktop ─────────────────────────── #}
    <div class="kpi-bar">
        <div class="kpi-item">
            <span class="kpi-icon">📋</span>
            <div>
                <div class="kpi-count">{{ kpis.total }}</div>
                <div class="kpi-label">{{ 'tache.stats.total'|trans }}</div>
            </div>
        </div>
        <div class="kpi-sep"></div>
        <div class="kpi-item">
            <span class="kpi-icon">🔄</span>
            <div>
                <div class="kpi-count" style="color:#3498db">{{ kpis.en_cours }}</div>
                <div class="kpi-label">{{ 'tache.stats.in_progress'|trans }}</div>
            </div>
        </div>
        <div class="kpi-sep"></div>
        <div class="kpi-item">
            <span class="kpi-icon">✅</span>
            <div>
                <div class="kpi-count" style="color:#27ae60">{{ kpis.terminees }}</div>
                <div class="kpi-label">{{ 'tache.stats.completed'|trans }}</div>
            </div>
        </div>
        <div class="kpi-sep"></div>
        <div class="kpi-item">
            <span class="kpi-icon">⏳</span>
            <div>
                <div class="kpi-count" style="color:#f39c12">{{ kpis.en_attente }}</div>
                <div class="kpi-label">{{ 'tache.stats.pending'|trans }}</div>
            </div>
        </div>
        <div class="kpi-sep"></div>
        <div class="kpi-item">
            <span class="kpi-icon">❌</span>
            <div>
                <div class="kpi-count" style="color:#e74c3c">{{ kpis.annulees }}</div>
                <div class="kpi-label">{{ 'tache.stats.cancelled'|trans }}</div>
            </div>
        </div>

        {# Boutons haut droite #}
        <div class="ms-auto d-flex gap-2">
            <a href="{{ path('employe_index') }}" class="btn-actualiser" style="background:#1B5E20;color:white;border-color:#1B5E20;">
                <i class="bi bi-people-fill"></i> {{ 'employe.title'|trans|replace({'📋 ': ''}) }}
            </a>
            <a href="{{ path('tache_index', {tri: tri, direction: direction}) }}" class="btn-actualiser">
                <i class="bi bi-arrow-clockwise"></i> {{ 'common.refresh'|trans }}
            </a>
            <a href="{{ path('tache_pdf') }}" target="_blank" class="btn btn-danger" style="border-radius:8px">
                <i class="bi bi-file-earmark-pdf-fill"></i> {{ 'common.export_pdf'|trans|replace({'📄 ': ''}) }}
            </a>
            <a href="{{ path('tache_statistiques') }}" class="btn btn-info text-white" style="border-radius:8px">
                <i class="bi bi-bar-chart-line-fill"></i> {{ 'common.statistics'|trans|replace({'📊 ': ''}) }}
            </a>
        </div>
    </div>

    {# ── Toolbar : recherche + filtres + tri ───────────────────────── #}
    <form method="GET" action="{{ path('tache_index') }}" id="filterForm">
    <div class="tache-toolbar">

        {# Recherche #}
        <i class="bi bi-search text-muted"></i>
        <input type="text" name="search" value="{{ search }}" class="tache-search"
               placeholder="{{ 'tache.search_prompt'|trans }}">

        <div class="toolbar-sep"></div>
        <span class="tri-label">{{ 'tache.col.status'|trans }}</span>
        <select name="statut" class="filter-select" onchange="this.form.submit()">
            {% for s in statuts %}
                <option value="{{ s }}" {{ statut == s ? 'selected' : '' }}>{{ s == 'Tous' ? 'common.all'|trans : s }}</option>
            {% endfor %}
        </select>

        {# Filtre Priorité #}
        <span class="tri-label">{{ 'tache.col.priority'|trans }}</span>
        <select name="priorite" class="filter-select" onchange="this.form.submit()">
            {% for p in priorites %}
                <option value="{{ p }}" {{ priorite == p ? 'selected' : '' }}>{{ p == 'Toutes' ? 'common.all_f'|trans : p }}</option>
            {% endfor %}
        </select>

        {# Filtre Catégorie #}
        <span class="tri-label">{{ 'tache.col.category'|trans }}</span>
        <select name="categorie" class="filter-select" onchange="this.form.submit()">
            {% for c in categories %}
                <option value="{{ c }}" {{ categorie == c ? 'selected' : '' }}>{{ c == 'Toutes' ? 'common.all_f'|trans : c }}</option>
            {% endfor %}
        </select>

        <div class="toolbar-sep"></div>

        {# Tri #}
        <span class="tri-label">{{ 'common.sort.by'|trans }}</span>
        <select name="tri" class="filter-select" onchange="this.form.submit()">
            <option value="id"        {{ tri == 'id'        ? 'selected' : '' }}>{{ 'tache.sort.id'|trans }}</option>
            <option value="titre"     {{ tri == 'titre'     ? 'selected' : '' }}>{{ 'tache.sort.title'|trans }}</option>
            <option value="statut"    {{ tri == 'statut'    ? 'selected' : '' }}>{{ 'tache.sort.status'|trans }}</option>
            <option value="priorite"  {{ tri == 'priorite'  ? 'selected' : '' }}>{{ 'tache.sort.priority'|trans }}</option>
            <option value="dateDebut" {{ tri == 'dateDebut' ? 'selected' : '' }}>{{ 'tache.sort.start_date'|trans }}</option>
            <option value="dateFin"   {{ tri == 'dateFin'   ? 'selected' : '' }}>{{ 'tache.sort.end_date'|trans }}</option>
            <option value="categorie" {{ tri == 'categorie' ? 'selected' : '' }}>{{ 'tache.sort.category'|trans }}</option>
        </select>

        <input type="hidden" name="direction" id="dirInput" value="{{ direction }}">
        <button type="submit" class="btn-dir {{ direction == 'asc' ? 'active' : '' }}"
                onclick="setDir('asc')" title="{{ 'common.ascending'|trans }}">↑</button>
        <button type="submit" class="btn-dir {{ direction == 'desc' ? 'active' : '' }}"
                onclick="setDir('desc')" title="{{ 'common.descending'|trans }}">↓</button>

        <button type="submit" class="btn btn-success btn-sm px-3" style="border-radius:8px">
            <i class="bi bi-search me-1"></i>{{ 'common.search'|trans }}
        </button>

        {% if search or statut != 'Tous' or priorite != 'Toutes' or categorie != 'Toutes' %}
        <a href="{{ path('tache_index') }}" class="btn btn-outline-secondary btn-sm" style="border-radius:7px">
            <i class="bi bi-x-lg"></i> {{ 'common.reset'|trans }}
        </a>
        {% endif %}

    </div>
    </form>

    {# ── Table des tâches ─────────────────────────────────────────── #}
    <div class="tache-table-wrap">
        {% if taches|length > 0 %}
        <div class="table-responsive">
        <table class="tache-table">
            <thead>
            <tr>
                {# Colonnes cliquables — identiques au desktop #}
                <th class="sortable {{ tri == 'id' ? (direction == 'asc' ? 'sorted-asc' : 'sorted-desc') : '' }}">
                    <a href="{{ path('tache_index', {tri:'id', direction:(tri=='id' and direction=='asc')?'desc':'asc', search:search, statut:statut, priorite:priorite, categorie:categorie}) }}" style="color:white;text-decoration:none">{{ 'tache.col.id'|trans }}</a>
                </th>
                <th class="sortable {{ tri == 'titre' ? (direction == 'asc' ? 'sorted-asc' : 'sorted-desc') : '' }}">
                    <a href="{{ path('tache_index', {tri:'titre', direction:(tri=='titre' and direction=='asc')?'desc':'asc', search:search, statut:statut, priorite:priorite, categorie:categorie}) }}" style="color:white;text-decoration:none">{{ 'tache.col.title'|trans }}</a>
                </th>
                <th>{{ 'tache.col.description'|trans }}</th>
                <th class="sortable {{ tri == 'statut' ? (direction == 'asc' ? 'sorted-asc' : 'sorted-desc') : '' }}">
                    <a href="{{ path('tache_index', {tri:'statut', direction:(tri=='statut' and direction=='asc')?'desc':'asc', search:search, statut:statut, priorite:priorite, categorie:categorie}) }}" style="color:white;text-decoration:none">{{ 'tache.col.status'|trans }}</a>
                </th>
                <th class="sortable {{ tri == 'priorite' ? (direction == 'asc' ? 'sorted-asc' : 'sorted-desc') : '' }}">
                    <a href="{{ path('tache_index', {tri:'priorite', direction:(tri=='priorite' and direction=='asc')?'desc':'asc', search:search, statut:statut, priorite:priorite, categorie:categorie}) }}" style="color:white;text-decoration:none">{{ 'tache.col.priority'|trans }}</a>
                </th>
                <th class="sortable {{ tri == 'categorie' ? (direction == 'asc' ? 'sorted-asc' : 'sorted-desc') : '' }}">
                    <a href="{{ path('tache_index', {tri:'categorie', direction:(tri=='categorie' and direction=='asc')?'desc':'asc', search:search, statut:statut, priorite:priorite, categorie:categorie}) }}" style="color:white;text-decoration:none">{{ 'tache.col.category'|trans }}</a>
                </th>
                <th class="sortable {{ tri == 'dateDebut' ? (direction == 'asc' ? 'sorted-asc' : 'sorted-desc') : '' }}">
                    <a href="{{ path('tache_index', {tri:'dateDebut', direction:(tri=='dateDebut' and direction=='asc')?'desc':'asc', search:search, statut:statut, priorite:priorite, categorie:categorie}) }}" style="color:white;text-decoration:none">{{ 'tache.col.start_date'|trans }}</a>
                </th>
                <th class="sortable {{ tri == 'dateFin' ? (direction == 'asc' ? 'sorted-asc' : 'sorted-desc') : '' }}">
                    <a href="{{ path('tache_index', {tri:'dateFin', direction:(tri=='dateFin' and direction=='asc')?'desc':'asc', search:search, statut:statut, priorite:priorite, categorie:categorie}) }}" style="color:white;text-decoration:none">{{ 'tache.col.end_date'|trans }}</a>
                </th>
                <th>{{ 'tache.col.employee'|trans }}</th>
                <th class="text-center">{{ 'common.actions'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for tache in taches %}
            <tr id="row-{{ tache.id }}">
                <td><strong>{{ tache.id }}</strong></td>
                <td>{{ tache.titre }}</td>
                <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                    {{ tache.description ?? '—' }}
                </td>

                {# Statut avec icône — identique au desktop #}
                <td>
                    {% set stClass = {
                        'En attente': 'st-attente',
                        'En cours':   'st-encours',
                        'Terminé':    'st-termine',
                        'Validé':     'st-valide',
                        'Annulé':     'st-annule'
                    } %}
                    {% set statutKeyMap = {
                        'En attente': 'tache.status.en_attente',
                        'En cours':   'tache.status.en_cours',
                        'Terminé':    'tache.status.termine',
                        'Validé':     'tache.status.valide',
                        'Annulé':     'tache.status.annule'
                    } %}
                    <span class="st-badge {{ stClass[tache.statut] ?? 'st-attente' }}">
                        {{ tache.statutIcone }} {{ (statutKeyMap[tache.statut] ?? tache.statut)|trans }}
                    </span>
                    {% if tache.isEnRetard %}
                        <span class="badge-retard">{{ 'tache.stats.overdue'|trans }}</span>
                    {% endif %}
                </td>

                {# Priorité colorée — identique au desktop #}
                <td>
                    {% set prioClass = {1:'prio-basse', 2:'prio-moyenne', 3:'prio-haute', 4:'prio-critique'} %}
                    {% set prioKeys = {1:'tache.form.priority_low', 2:'tache.form.priority_medium', 3:'tache.form.priority_high', 4:'tache.form.priority_critical'} %}
                    <span class="{{ prioClass[tache.priorite] ?? 'prio-moyenne' }}">
                        {{ (prioKeys[tache.priorite] ?? 'tache.form.priority_medium')|trans }}
                    </span>
                </td>

                <td>
                    {% set catKeyMap = {
                        'Plantation': 'tache.category.plantation',
                        'Récolte': 'tache.category.recolte',
                        'Irrigation': 'tache.category.irrigation',
                        'Fertilisation': 'tache.category.fertilisation',
                        'Maintenance': 'tache.category.maintenance',
                        'Administratif': 'tache.category.administratif',
                        'Autre': 'tache.category.autre',
                        'Nettoyage': 'tache.category.nettoyage',
                        'Logistique': 'tache.category.logistique',
                        'Formation': 'tache.category.formation',
                        'Analyse': 'tache.category.analyse',
                        'Gestion': 'tache.category.gestion',
                        'Énergie': 'tache.category.energie',
                        'Planification': 'tache.category.planification'
                    } %}
                    {{ tache.categorie ? (catKeyMap[tache.categorie] is defined ? (catKeyMap[tache.categorie])|trans : tache.categorie) : '—' }}
                </td>
                <td>{{ tache.dateDebut ? tache.dateDebut|date('d/m/Y') : '—' }}</td>
                <td>
                    {{ tache.dateFin ? tache.dateFin|date('d/m/Y') : '—' }}
                    {% if tache.isEnRetard %}
                        <span style="color:#e74c3c;font-size:.75rem">⚠</span>
                    {% endif %}
                </td>
                <td>{{ mapEmployes[tache.idEmploye] ?? '—' }}</td>

                {# Actions inline #}
                <td>
                    <div class="d-flex gap-1 justify-content-center">
                        <a href="{{ path('tache_edit', {id: tache.id}) }}" class="btn-modif" title="{{ 'common.edit'|trans }}">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <form method="POST" action="{{ path('tache_delete', {id: tache.id}) }}"
                              onsubmit="return confirm('{{ 'common.delete'|trans }} « {{ tache.titre }} » ?')" style="margin:0">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tache.id) }}">
                            <button type="submit" class="btn-suppr" title="{{ 'common.delete'|trans }}">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
        {% else %}
        <div class="tache-empty">
            <i class="bi bi-clipboard-x d-block"></i>
            {% if search or statut != 'Tous' or priorite != 'Toutes' or categorie != 'Toutes' %}
                <h5>{{ 'tache.empty_filters'|trans }}</h5>
                <a href="{{ path('tache_index') }}" class="btn btn-outline-success mt-2">{{ 'tache.reset_filters'|trans }}</a>
            {% else %}
                <h5>{{ 'tache.empty_none'|trans }}</h5>
            {% endif %}
        </div>
        {% endif %}
    </div>

    {# ── Barre du bas — identique au desktop + PDF & Stats ────────── #}
    <div class="tache-bottombar">
        <a href="{{ path('tache_new') }}" class="btn-add">
            <i class="bi bi-plus-lg"></i> {{ 'tache.add'|trans }}
        </a>
        <button class="btn-orange" id="btnModifier" onclick="modifierSelectionne()" disabled>
            <i class="bi bi-pencil-square"></i> {{ 'common.edit'|trans }}
        </button>
        <button class="btn-red" id="btnSupprimer" onclick="supprimerSelectionne()" disabled>
            <i class="bi bi-trash3"></i> {{ 'common.delete'|trans }}
        </button>
        <button class="btn-calendrier" id="btnAnalyseIA" onclick="ouvrirAnalyseIA()" disabled style="background:#6c5ce7">
            <i class="bi bi-cpu-fill"></i> {{ 'tache.analyse_ia'|trans }}
        </button>

        <span class="bottom-info" id="selectionInfo">{{ 'tache.no_selection'|trans }}</span>
    </div>

</div>
</div>

{# ── Modal Analyse IA ────────────────────────────────────────────── #}
<div class="modal fade glass-modal" id="iaModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">🔮 Analyse IA — Prédiction de Risque</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                
                {# Loader #}
                <div id="iaLoader" class="ia-loader">
                    <i class="bi bi-gear-wide-connected"></i>
                    <p class="mt-3 fw-bold text-muted">Analyse des facteurs en cours...</p>
                </div>

                {# Résultat #}
                <div id="iaResult" style="display:none">
                    <div class="ia-grid">
                        <div class="risk-card">
                            <div class="risk-circle" id="circleRiskBorder">
                                <span class="risk-percent" id="riskValue">0%</span>
                                <span class="risk-label">Risque</span>
                            </div>
                            <div class="risk-level-badge mt-3" id="riskLevel">CHARGEMENT</div>
                            <div class="mt-3 text-center">
                                <small class="text-muted fw-bold">Probabilité de réussite</small>
                                <div class="h5 fw-bolder text-success" id="successProb">0%</div>
                            </div>
                        </div>

                        <div class="factors-card">
                            <div class="factor-row">
                                <div class="factor-info"><span>Historique employé</span><span id="txtScoreHist">0%</span></div>
                                <div class="factor-bar-bg"><div class="factor-bar-fill" id="barHist" style="width:0;background:#3498db"></div></div>
                            </div>
                            <div class="factor-row">
                                <div class="factor-info"><span>Charge de travail</span><span id="txtScoreCharge">0%</span></div>
                                <div class="factor-bar-bg"><div class="factor-bar-fill" id="barCharge" style="width:0;background:#f39c12"></div></div>
                            </div>
                            <div class="factor-row">
                                <div class="factor-info"><span>Complexité tâche</span><span id="txtScoreComp">0%</span></div>
                                <div class="factor-bar-bg"><div class="factor-bar-fill" id="barComp" style="width:0;background:#9b59b6"></div></div>
                            </div>
                            <div class="factor-row">
                                <div class="factor-info"><span>Saison agricole</span><span id="txtScoreSaison">0%</span></div>
                                <div class="factor-bar-bg"><div class="factor-bar-fill" id="barSaison" style="width:0;background:#e67e22"></div></div>
                            </div>
                            <div class="factor-row">
                                <div class="factor-info"><span>Pression délai</span><span id="txtScoreDelai">0%</span></div>
                                <div class="factor-bar-bg"><div class="factor-bar-fill" id="barDelai" style="width:0;background:#e74c3c"></div></div>
                            </div>
                        </div>
                    </div>

                    <div class="ia-details-box">
                        <div class="ia-details-title"><i class="bi bi-list-check"></i> FACTEURS ANALYSÉS</div>
                        <ul class="ia-fact-list" id="factList"></ul>
                    </div>

                    <div class="reco-box">
                        <div class="reco-title"><i class="bi bi-lightning-charge-fill"></i> RECOMMANDATIONS IA</div>
                        <ul class="reco-list" id="recoList"></ul>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <p class="text-muted small me-auto"><i class="bi bi-info-circle"></i> Algorithme de scoring multi-facteurs v2.1</p>
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" style="border-radius:10px">Fermer</button>
            </div>
        </div>
    </div>
</div>

<form id="formDeleteBottom" method="POST" style="display:none">
    <input type="hidden" name="_token" id="tokenDeleteBottom">
</form>
{% endblock %}

{% block javascripts %}
<script>
function setDir(d) { document.getElementById('dirInput').value = d; }

// Sélection de ligne
let selId = null, selTitre = null, selEdit = null, selDel = null, selTok = null;

document.querySelectorAll('.tache-table tbody tr').forEach(row => {
    row.addEventListener('click', function(e) {
        if (e.target.closest('a, button, form')) return;

        document.querySelectorAll('.tache-table tbody tr').forEach(r => r.classList.remove('selected'));
        this.classList.add('selected');

        selId    = this.id.replace('row-', '');
        selTitre = this.querySelectorAll('td')[1]?.textContent.trim();

        const editBtn = this.querySelector('a.btn-modif');
        const delForm = this.querySelector('form');
        if (editBtn) selEdit = editBtn.href;
        if (delForm) {
            selDel = delForm.action;
            selTok = delForm.querySelector('input[name="_token"]')?.value;
        }

        document.getElementById('btnModifier').disabled = false;
        document.getElementById('btnSupprimer').disabled = false;
        document.getElementById('btnAnalyseIA').disabled = false;
        document.getElementById('selectionInfo').textContent = '{{ 'tache.selected'|trans }} ' + selTitre;
    });
});

function ouvrirAnalyseIA() {
    if (!selId) return;
    
    const modal = new bootstrap.Modal(document.getElementById('iaModal'));
    modal.show();
    
    // UI Init
    document.getElementById('iaLoader').style.display = 'block';
    document.getElementById('iaResult').style.display = 'none';
    
    fetch(`/employe/tache/${selId}/analyse-ia`)
        .then(res => res.json())
        .then(data => {
            document.getElementById('iaLoader').style.display = 'none';
            document.getElementById('iaResult').style.display = 'block';
            
            // Score et cercle
            document.getElementById('riskValue').textContent = data.riskScore + '%';
            document.getElementById('circleRiskBorder').style.borderColor = data.couleur;
            document.getElementById('successProb').textContent = data.probabiliteReussite + '%';
            
            const badge = document.getElementById('riskLevel');
            badge.textContent = data.emoji + ' ' + data.niveau;
            badge.style.backgroundColor = data.couleur;
            
            // Barres
            updateBar('Hist', data.scoreHistorique);
            updateBar('Charge', data.scoreCharge);
            updateBar('Comp', data.scoreComplexite);
            updateBar('Saison', data.scoreSaison);
            updateBar('Delai', data.scoreDelai);
            
            // Listes
            const factList = document.getElementById('factList');
            factList.innerHTML = '';
            data.facteurs.forEach(f => {
                const li = document.createElement('li');
                li.innerHTML = f;
                factList.appendChild(li);
            });
            
            const recoList = document.getElementById('recoList');
            recoList.innerHTML = '';
            data.recommandations.forEach(r => {
                const li = document.createElement('li');
                li.innerHTML = r;
                recoList.appendChild(li);
            });
        });
}

function updateBar(key, value) {
    const bar = document.getElementById('bar' + key);
    const txt = document.getElementById('txtScore' + key);
    setTimeout(() => {
        bar.style.width = value + '%';
        txt.textContent = value + '%';
    }, 100);
}

function modifierSelectionne() {
    if (selEdit) window.location.href = selEdit;
}
function supprimerSelectionne() {
    if (!selId || !confirm('Supprimer « ' + selTitre + ' » ?')) return;
    const form = document.getElementById('formDeleteBottom');
    form.action = selDel;
    document.getElementById('tokenDeleteBottom').value = selTok;
    form.submit();
}
</script>
    {% include 'EmployeTache/_i18n_support.html.twig' %}
{% endblock %}
