{% extends 'admin/materiel/admin_materiel_base.html.twig' %}

{% block title %}Timeline Maintenances - Ardhi Admin{% endblock %}
{% block page_title %}Timeline des Maintenances{% endblock %}

{% block body %}
{# --- SECTION URGENCES --- #}
{% set urgent_maintenances = maintenances|filter(m => m.typeMaintenance == 'urgente' and m.statutMaintenance in ['en_attente', 'planifiee']) %}
{% if urgent_maintenances|length > 0 %}
<div class="card shadow-sm border-0 mb-4 border-start border-4 border-danger">
    <div class="card-header bg-danger text-white py-3">
        <h5 class="mb-0 fw-bold">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> 
            ⚠️ MAINTENANCES EN URGENTE (Signalements récents)
        </h5>
    </div>
    <div class="card-body">
        <div class="list-group list-group-flush">
            {% for m in urgent_maintenances %}
            {% set owner = userMap[m.materiel.userId] ?? null %}
            <div class="list-group-item px-0 py-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="fw-bold fs-5 text-danger">{{ m.materiel.nom }} ({{ m.materiel.type }})</div>
                        <div class="text-muted small">
                            <i class="bi bi-person-fill"></i> Agriculteur : <strong>{{ owner.prenom ?? 'Inconnu' }} {{ owner.nom ?? '' }}</strong> | 
                            <i class="bi bi-calendar"></i> Signalé le : {{ m.dateMaintenance|date('d/m/Y H:i') }}
                        </div>
                        <div class="mt-2 p-2 bg-light rounded border-start border-3 border-danger italic" style="font-size: 0.9rem;">
                            <i class="bi bi-chat-left-text me-2"></i><strong>Description de la panne :</strong> {{ m.description }}
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="d-flex flex-column gap-2">
                            <form method="post" action="{{ path('admin_maintenance_status_update', {id: m.idMaintenance}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('update_status_' ~ m.idMaintenance) }}">
                                <input type="hidden" name="statut_maintenance" value="en_cours">
                                <input type="hidden" name="reponse_type" value="urgent_apportez">
                                <button type="submit" class="btn btn-sm btn-dark w-100 shadow-sm fw-bold">
                                    <i class="bi bi-truck me-1"></i> Urgent : Apportez le matériel
                                </button>
                            </form>
                            
                            <form method="post" action="{{ path('admin_maintenance_status_update', {id: m.idMaintenance}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('update_status_' ~ m.idMaintenance) }}">
                                <input type="hidden" name="statut_maintenance" value="en_cours">
                                <input type="hidden" name="reponse_type" value="non_urgent_planifier">
                                <button type="submit" class="btn btn-sm btn-outline-primary w-100 shadow-sm fw-bold">
                                    <i class="bi bi-calendar-plus me-1"></i> Non-urgent : Planifiez
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold" style="color: #2b5876;">
            <i class="bi bi-clock-history me-2"></i> 
            {% if materielFilter %}
                Historique de: <span class="text-secondary">{{ materielFilter.nom }}</span>
                <a href="{{ path('admin_maintenance_timeline') }}" class="btn btn-sm btn-outline-secondary ms-3">Voir tous</a>
            {% else %}
                Historique Global des Maintenances
            {% endif %}
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr class="text-uppercase small fw-bold text-muted">
                        <th class="ps-4">📅 Date</th>
                        <th>🚜 Matériel</th>
                        <th>👤 Agriculteur</th>
                        <th>🔧 Type</th>
                        <th class="text-center">📌 Statut actuel</th>
                        <th class="text-end pe-4">⚡ Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for m in maintenances %}
                    {% set owner = userMap[m.materiel.userId] ?? null %}
                    <tr>
                        <td class="ps-4 fw-bold text-dark">
                            {{ m.dateMaintenance ? m.dateMaintenance|date('d/m/Y') : 'Non définie' }}
                        </td>
                        <td>
                            <div class="fw-bold">{{ m.materiel.nom }}</div>
                            <span class="badge bg-light border text-muted" style="font-size: 0.7rem;">{{ m.materiel.type }}</span>
                        </td>
                        <td>
                            {% if owner %}
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                        <i class="bi bi-person text-secondary"></i>
                                    </div>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold small" style="color: #116530;">{{ owner.prenom }} {{ owner.nom }}</span>
                                    </div>
                                </div>
                            {% else %}
                                <span class="badge bg-danger-subtle text-danger border border-danger small">Utilisateur #{{ m.materiel.userId }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if m.typeMaintenance == 'preventive' %}
                                <span class="badge bg-info-subtle text-info border border-info px-2 py-1">Préventive</span>
                            {% elseif m.typeMaintenance == 'corrective' %}
                                <span class="badge bg-warning-subtle text-warning border border-warning px-2 py-1">Corrective</span>
                            {% elseif m.typeMaintenance == 'urgente' %}
                                <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">Urgente</span>
                            {% else %}
                                <span class="badge bg-secondary-subtle text-secondary px-2 py-1">{{ m.typeMaintenance }}</span>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            {% if m.statutMaintenance == 'planifiee' or m.statutMaintenance == 'en_attente' %}
                                <span class="badge bg-light text-dark border"><i class="bi bi-calendar-event me-1"></i> Planifiée</span>
                            {% elseif m.statutMaintenance == 'en_cours' %}
                                <span class="badge bg-primary-subtle text-primary border border-primary"><i class="bi bi-gear-wide-connected form-spin me-1"></i> En cours</span>
                            {% elseif m.statutMaintenance == 'terminee' or m.statutMaintenance == 'verifie' %}
                                <span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-check-circle-fill me-1"></i> Terminée</span>
                            {% elseif m.statutMaintenance == 'annulee' %}
                                <span class="badge bg-danger-subtle text-danger border border-danger"><i class="bi bi-x-circle-fill me-1"></i> Annulée</span>
                            {% else %}
                                <span class="badge bg-secondary">{{ m.statutMaintenance }}</span>
                            {% endif %}
                        </td>
                        <td class="text-end pe-4">
                            <form method="post" action="{{ path('admin_maintenance_status_update', {id: m.idMaintenance}) }}" class="d-inline-flex align-items-center">
                                <input type="hidden" name="_token" value="{{ csrf_token('update_status_' ~ m.idMaintenance) }}">
                                <select name="statut_maintenance" class="form-select form-select-sm me-2 shadow-sm" style="width: auto; min-width: 140px; font-size: 0.8rem; font-weight: 500;">
                                    <option value="planifiee" {% if m.statutMaintenance == 'planifiee' %}selected{% endif %}>Planifiée</option>
                                    <option value="en_cours" {% if m.statutMaintenance == 'en_cours' %}selected{% endif %}>En cours</option>
                                    <option value="terminee" {% if m.statutMaintenance == 'terminee' %}selected{% endif %}>Terminée</option>
                                    <option value="annulee" {% if m.statutMaintenance == 'annulee' %}selected{% endif %}>Annulée</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-success shadow-sm rounded-circle" data-bs-toggle="tooltip" title="Mettre à jour" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                    <i class="bi bi-arrow-repeat"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <i class="bi bi-clock-history display-1 text-light d-block mb-3"></i>
                            <p class="text-muted">Aucune intervention dans la timeline.</p>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
