{% extends 'admin/materiel/admin_materiel_base.html.twig' %}

{% block title %}Historique Maintenance - Ardhi Admin{% endblock %}
{% block page_title %}Historique Maintenance par Matériel{% endblock %}

{% block body %}
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold" style="color: #2b5876;"><i class="bi bi-clock-history me-2"></i> Historique d'intervention pour chaque matériel</h5>
    </div>
    <div class="card-body p-4">
        
        <div class="accordion" id="accordionHistorique">
            {% for item in materiels %}
                {% set owner = userMap[item.userId] ?? null %}
                <div class="accordion-item mb-3 border rounded shadow-sm">
                    <h2 class="accordion-header" id="heading-{{ item.id }}">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-{{ item.id }}" aria-expanded="false" aria-controls="collapse-{{ item.id }}">
                            <div class="d-flex w-100 justify-content-between align-items-center pe-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-success-subtle rounded p-2 me-3 text-success">
                                        <i class="bi bi-gear-wide-connected fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold fs-6 text-dark">{{ item.nom }}</div>
                                        <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">{{ item.type }}</span>
                                    </div>
                                </div>
                                <div class="text-end">
                                    {% if owner %}
                                        <div class="small text-muted"><i class="bi bi-person me-1"></i> {{ owner.prenom }} {{ owner.nom }}</div>
                                    {% endif %}
                                    <span class="badge bg-primary rounded-pill mt-1">{{ item.maintenances|length }} intervention(s)</span>
                                </div>
                            </div>
                        </button>
                    </h2>
                    <div id="collapse-{{ item.id }}" class="accordion-collapse collapse" aria-labelledby="heading-{{ item.id }}" data-bs-parent="#accordionHistorique">
                        <div class="accordion-body p-0">
                            {% if item.maintenances|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="bg-light">
                                            <tr class="small fw-bold text-muted text-uppercase">
                                                <th class="ps-4">Date</th>
                                                <th>Type</th>
                                                <th>Statut</th>
                                                <th>Description</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for m in item.maintenances %}
                                                <tr>
                                                    <td class="ps-4 fw-bold">
                                                        {{ m.dateMaintenance ? m.dateMaintenance|date('d/m/Y à H:i') : 'Non définie' }}
                                                    </td>
                                                    <td>
                                                        {% if m.typeMaintenance == 'preventive' %}
                                                            <span class="text-info"><i class="bi bi-shield-check me-1"></i> Préventive</span>
                                                        {% elseif m.typeMaintenance == 'corrective' %}
                                                            <span class="text-warning"><i class="bi bi-wrench me-1"></i> Corrective</span>
                                                        {% else %}
                                                            <span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i> Urgente</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        {% if m.statutMaintenance == 'planifiee' or m.statutMaintenance == 'en_attente' %}
                                                            <span class="badge bg-light text-dark border"><i class="bi bi-calendar-event me-1"></i> Planifiée</span>
                                                        {% elseif m.statutMaintenance == 'en_cours' %}
                                                            <span class="badge bg-primary-subtle text-primary border"><i class="bi bi-gear-wide-connected form-spin me-1"></i> En cours</span>
                                                        {% elseif m.statutMaintenance == 'terminee' or m.statutMaintenance == 'verifie' %}
                                                            <span class="badge bg-success-subtle text-success border"><i class="bi bi-check-circle-fill me-1"></i> Terminée</span>
                                                        {% elseif m.statutMaintenance == 'annulee' %}
                                                            <span class="badge bg-danger-subtle text-danger border"><i class="bi bi-x-circle-fill me-1"></i> Annulée</span>
                                                        {% else %}
                                                            <span class="badge bg-secondary">{{ m.statutMaintenance }}</span>
                                                        {% endif %}
                                                    </td>
                                                    <td class="small text-muted" style="max-width: 250px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                                        {{ m.description ?: 'Aucune description.' }}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-cup text-light display-4 d-block mb-2"></i>
                                    Aucune maintenance enregistrée pour ce matériel.
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <h3 class="text-muted"><i class="bi bi-inbox d-block mb-3 display-1"></i> Aucun matériel trouvé.</h3>
                </div>
            {% endfor %}
        </div>

    </div>
</div>
{% endblock %}
