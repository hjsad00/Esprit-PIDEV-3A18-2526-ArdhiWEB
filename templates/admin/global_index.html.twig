<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ardhi Admin — Portail</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ═══════════════════════════════════════════
       SLIDER ARRIÈRE-PLAN PLEIN ÉCRAN
       ═══════════════════════════════════════════ */
    .bg-slider {
      position: fixed;
      inset: 0;
      z-index: 0;
    }
    .bg-slide {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      opacity: 0;
      transition: opacity 1.6s ease-in-out;
    }
    .bg-slide.active { opacity: 1; }

    .bg-slide:nth-child(1) { background-image: url("{{ asset('assets/img/employees.jpg') }}"); }
    .bg-slide:nth-child(2) { background-image: url("{{ asset('assets/img/machine.jpg') }}"); }
    .bg-slide:nth-child(3) { background-image: url("{{ asset('assets/img/event.jpg') }}"); }
    .bg-slide:nth-child(4) { background-image: url("{{ asset('assets/img/ai.jpg') }}"); }
    .bg-slide:nth-child(5) { background-image: url("{{ asset('assets/img/parcelle.jpg') }}"); }
    .bg-slide:nth-child(6) { background-image: url("{{ asset('assets/img/market.jpg') }}"); }

    /* Overlay sombre sur le slider */
    .bg-overlay {
      position: fixed;
      inset: 0;
      background: linear-gradient(
        135deg,
        rgba(5, 30, 12, 0.75) 0%,
        rgba(10, 60, 25, 0.65) 50%,
        rgba(0, 0, 0, 0.70) 100%
      );
      z-index: 1;
    }

    /* Particules animées */
    .particles {
      position: fixed;
      inset: 0;
      z-index: 2;
      overflow: hidden;
      pointer-events: none;
    }
    .particle {
      position: absolute;
      border-radius: 50%;
      background: rgba(255,255,255,0.08);
      animation: float linear infinite;
    }

    @keyframes float {
      0%   { transform: translateY(100vh) scale(0); opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 1; }
      100% { transform: translateY(-120px) scale(1); opacity: 0; }
    }

    /* ═══════════════════════════════════════════
       PAGE LAYOUT
       ═══════════════════════════════════════════ */
    body {
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
      background: #0a1f0d;
    }

    .page-wrapper {
      position: relative;
      z-index: 10;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ═══════════════════════════════════════════
       HEADER GLASSMORPHISM
       ═══════════════════════════════════════════ */
    .admin-header {
      background: rgba(255,255,255,0.08);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255,255,255,0.12);
      padding: 14px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }
    .header-brand img { height: 38px; filter: drop-shadow(0 0 8px rgba(52,211,76,0.4)); }
    .header-brand span {
      font-size: 1.2rem;
      font-weight: 800;
      color: white;
      letter-spacing: -0.5px;
      text-shadow: 0 0 20px rgba(52,211,76,0.3);
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .user-pill {
      display: flex;
      align-items: center;
      gap: 9px;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 30px;
      padding: 7px 16px;
      color: white;
      font-size: .88rem;
      font-weight: 600;
      text-decoration: none;
      transition: all .2s;
    }
    .user-pill:hover { background: rgba(255,255,255,0.2); color: white; }
    .user-pill i { font-size: 1.1rem; color: #4ade80; }

    .btn-logout {
      display: flex;
      align-items: center;
      gap: 7px;
      background: rgba(239,68,68,0.2);
      border: 1px solid rgba(239,68,68,0.35);
      border-radius: 10px;
      padding: 8px 16px;
      color: #fca5a5;
      font-size: .85rem;
      font-weight: 600;
      text-decoration: none;
      transition: all .25s;
    }
    .btn-logout:hover { background: rgba(239,68,68,0.4); color: white; transform: translateY(-1px); }

    /* ═══════════════════════════════════════════
       HERO SECTION
       ═══════════════════════════════════════════ */
    .hero {
      text-align: center;
      padding: 60px 24px 40px;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(74,222,128,0.15);
      border: 1px solid rgba(74,222,128,0.3);
      border-radius: 30px;
      padding: 6px 18px;
      color: #4ade80;
      font-size: .8rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 22px;
      animation: fadeInDown .7s ease both;
    }

    .hero h1 {
      font-size: clamp(2rem, 4vw, 3.2rem);
      font-weight: 900;
      color: white;
      letter-spacing: -1.5px;
      line-height: 1.1;
      margin-bottom: 16px;
      animation: fadeInDown .8s ease both;
      text-shadow: 0 4px 24px rgba(0,0,0,0.4);
    }

    .hero h1 span {
      background: linear-gradient(90deg, #4ade80, #22d3ee, #a78bfa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-sub {
      color: rgba(255,255,255,0.65);
      font-size: 1.1rem;
      font-weight: 400;
      animation: fadeInDown .9s ease both;
      margin-bottom: 0;
    }

    /* Slider indicators */
    .slider-dots {
      display: flex;
      justify-content: center;
      gap: 7px;
      margin-top: 18px;
      animation: fadeInDown 1s ease both;
    }
    .slider-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgba(255,255,255,0.3);
      cursor: pointer;
      transition: all .3s;
    }
    .slider-dot.active {
      background: #4ade80;
      width: 22px;
      border-radius: 3px;
      box-shadow: 0 0 8px #4ade80;
    }

    /* ═══════════════════════════════════════════
       MODULE CARDS GRID
       ═══════════════════════════════════════════ */
    .modules-grid {
      padding: 20px 40px 60px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 22px;
      max-width: 1300px;
      margin: 0 auto;
      width: 100%;
    }

    /* Card principale */
    .mod-card {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      height: 240px;
      cursor: pointer;
      text-decoration: none;
      display: block;
      animation: fadeInUp .6s ease both;
      transition: transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s;
    }

    .mod-card:nth-child(1) { animation-delay: .05s; }
    .mod-card:nth-child(2) { animation-delay: .10s; }
    .mod-card:nth-child(3) { animation-delay: .15s; }
    .mod-card:nth-child(4) { animation-delay: .20s; }
    .mod-card:nth-child(5) { animation-delay: .25s; }
    .mod-card:nth-child(6) { animation-delay: .30s; }
    .mod-card:nth-child(7) { animation-delay: .35s; }

    .mod-card:hover {
      transform: translateY(-10px) scale(1.02);
      box-shadow: 0 28px 60px rgba(0,0,0,.5);
    }

    /* Image */
    .mod-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .5s ease;
    }
    .mod-card:hover .mod-img { transform: scale(1.12); }

    /* Calque verre */
    .mod-glass {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        160deg,
        rgba(0,0,0,0) 20%,
        rgba(0,0,0,0.75) 100%
      );
      transition: background .3s;
    }
    .mod-card:hover .mod-glass {
      background: linear-gradient(
        160deg,
        rgba(0,0,0,0.1) 0%,
        rgba(0,0,0,0.85) 100%
      );
    }

    /* Accent couleur en haut */
    .mod-accent {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      opacity: 0;
      transition: opacity .3s;
    }
    .mod-card:hover .mod-accent { opacity: 1; }

    /* Contenu carte */
    .mod-content {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 20px 20px 22px;
    }

    .mod-icon-wrap {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      margin-bottom: 10px;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.2);
      transform: translateY(8px);
      opacity: 0;
      transition: all .35s ease;
    }
    .mod-card:hover .mod-icon-wrap {
      transform: translateY(0);
      opacity: 1;
    }

    .mod-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: white;
      letter-spacing: -0.3px;
      text-shadow: 0 2px 10px rgba(0,0,0,.5);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .mod-desc {
      font-size: .78rem;
      color: rgba(255,255,255,0.65);
      margin-top: 4px;
      transform: translateY(6px);
      opacity: 0;
      transition: all .3s ease .05s;
    }
    .mod-card:hover .mod-desc {
      transform: translateY(0);
      opacity: 1;
    }

    .mod-arrow {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 32px;
      height: 32px;
      background: rgba(255,255,255,0.15);
      border: 1px solid rgba(255,255,255,0.25);
      backdrop-filter: blur(8px);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: .85rem;
      transform: translate(4px, -4px);
      opacity: 0;
      transition: all .3s;
    }
    .mod-card:hover .mod-arrow {
      transform: translate(0, 0);
      opacity: 1;
    }

    /* Statistique rapide dans la carte */
    .mod-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      background: rgba(0,0,0,0.4);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 20px;
      padding: 3px 11px;
      font-size: .72rem;
      font-weight: 700;
      color: white;
      letter-spacing: .5px;
    }

    /* ═══════════════════════════════════════════
       FOOTER BAR
       ═══════════════════════════════════════════ */
    .admin-footer {
      margin-top: auto;
      text-align: center;
      padding: 18px;
      color: rgba(255,255,255,0.3);
      font-size: .76rem;
      border-top: 1px solid rgba(255,255,255,0.07);
    }

    /* ═══════════════════════════════════════════
       ANIMATIONS
       ═══════════════════════════════════════════ */
    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-25px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(35px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ═══════════════════════════════════════════
       RESPONSIVE
       ═══════════════════════════════════════════ */
    @media (max-width: 768px) {
      .admin-header { padding: 12px 18px; }
      .hero { padding: 40px 18px 28px; }
      .modules-grid { padding: 10px 18px 40px; gap: 14px; }
      .mod-card { height: 190px; }
    }
  </style>
</head>
<body>

  {# ── Slider arrière-plan ─────────────────────────────── #}
  <div class="bg-slider" id="bgSlider">
    <div class="bg-slide active"></div>
    <div class="bg-slide"></div>
    <div class="bg-slide"></div>
    <div class="bg-slide"></div>
    <div class="bg-slide"></div>
    <div class="bg-slide"></div>
  </div>
  <div class="bg-overlay"></div>

  {# ── Particules flottantes ────────────────────────────── #}
  <div class="particles" id="particles"></div>

  {# ── Contenu principal ────────────────────────────────── #}
  <div class="page-wrapper">

    {# HEADER #}
