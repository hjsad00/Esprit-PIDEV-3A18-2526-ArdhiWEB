        <div class="mod-badge">MODULE</div>
        <div class="mod-arrow"><i class="bi bi-arrow-up-right"></i></div>
        <div class="mod-content">
          <div class="mod-icon-wrap" style="background:rgba(236,72,153,0.25)">🛒</div>
