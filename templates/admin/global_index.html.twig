            <a href="{{ path('app_profile') }}" style="text-decoration: none; color: #444; display: flex; align-items: center; gap: 8px; margin-right: 15px; font-weight: 500;">
                <i class="bi bi-person-circle" style="font-size: 1.2rem;"></i>
