{% extends 'base.html.twig' %}

{% block title %}Ardhi - Portail d'Administration{% endblock %}

{% block body %}

<div class="container py-5" style="margin-top: 60px;">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="fw-bold" style="color: #116530;">Portail d'Administration</h1>
            <p class="text-muted">Sélectionnez un module pour continuer</p>
        </div>
    </div>
    
    <div class="row g-4 justify-content-center">
        <!-- User & Diag -->
        <div class="col-md-4 col-lg-3">
            <a href="{{ path('admin_user_diag_dashboard') }}" class="card h-100 text-center text-decoration-none shadow-sm" style="border: 2px solid transparent; transition: all 0.3s;" onmouseover="this.style.borderColor='#212529'; this.style.transform='translateY(-5px)';" onmouseout="this.style.borderColor='transparent'; this.style.transform='translateY(0)';">
                <div class="card-body py-5">
                    <i class="bi bi-heart-pulse display-4 text-dark mb-3"></i>
                    <h5 class="card-title fw-bold text-dark">User & Diagnostics</h5>
                    <p class="text-muted small">19 entités de gestion...</p>
                </div>
            </a>
        </div>

        <!-- Marketplace -->
        <div class="col-md-4 col-lg-3">
            <a href="{{ path('app_marketplace') }}" class="card h-100 text-center text-decoration-none shadow-sm" style="border: 2px solid transparent; transition: all 0.3s;" onmouseover="this.style.borderColor='#198754'; this.style.transform='translateY(-5px)';" onmouseout="this.style.borderColor='transparent'; this.style.transform='translateY(0)';">
                <div class="card-body py-5">
                    <i class="bi bi-shop display-4 text-success mb-3"></i>
                    <h5 class="card-title fw-bold text-dark mb-0">Marketplace</h5>
                </div>
            </a>
        </div>

        <!-- Maintenance -->
        <div class="col-md-4 col-lg-3">
            <a href="#" class="card h-100 text-center text-decoration-none shadow-sm" style="border: 2px solid transparent; transition: all 0.3s;" onmouseover="this.style.borderColor='#fd7e14'; this.style.transform='translateY(-5px)';" onmouseout="this.style.borderColor='transparent'; this.style.transform='translateY(0)';">
                <div class="card-body py-5">
                    <i class="bi bi-tools display-4 text-warning mb-3"></i>
                    <h5 class="card-title fw-bold text-dark mb-0">Maintenance</h5>
                </div>
            </a>
        </div>

        <!-- Cultures -->
        <div class="col-md-4 col-lg-3">
            <a href="{{ path('admin_parcelle_index') }}" class="card h-100 text-center text-decoration-none shadow-sm" style="border: 2px solid transparent; transition: all 0.3s;" onmouseover="this.style.borderColor='#20c997'; this.style.transform='translateY(-5px)';" onmouseout="this.style.borderColor='transparent'; this.style.transform='translateY(0)';">
                <div class="card-body py-5">
                    <i class="bi bi-tree display-4 text-info mb-3"></i>
                    <h5 class="card-title fw-bold text-dark mb-0">Cultures</h5>
                </div>
            </a>
        </div>

        <!-- Évènements -->
        <div class="col-md-4 col-lg-3">
            <a href="#" class="card h-100 text-center text-decoration-none shadow-sm" style="border: 2px solid transparent; transition: all 0.3s;" onmouseover="this.style.borderColor='#6f42c1'; this.style.transform='translateY(-5px)';" onmouseout="this.style.borderColor='transparent'; this.style.transform='translateY(0)';">
                <div class="card-body py-5">
                    <i class="bi bi-calendar-event display-4 text-purple mb-3" style="color: #6f42c1;"></i>
                    <h5 class="card-title fw-bold text-dark mb-0">Évènements</h5>
                </div>
            </a>
        </div>

        <!-- Employés -->
        <div class="col-md-4 col-lg-3">
            <a href="#" class="card h-100 text-center text-decoration-none shadow-sm" style="border: 2px solid transparent; transition: all 0.3s;" onmouseover="this.style.borderColor='#dc3545'; this.style.transform='translateY(-5px)';" onmouseout="this.style.borderColor='transparent'; this.style.transform='translateY(0)';">
                <div class="card-body py-5">
                    <i class="bi bi-people display-4 text-danger mb-3"></i>
                    <h5 class="card-title fw-bold text-dark mb-0">Employés</h5>
                </div>
            </a>
        </div>
    </div>
</div>

{% endblock %}
