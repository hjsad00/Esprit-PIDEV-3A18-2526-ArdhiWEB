      <div class="slider-dots" id="sliderDots"></div>
    </section>

    {# GRILLE DES MODULES #}
    <div class="modules-grid">

      {# Utilisateurs #}
      <a href="{{ path('admin_users_dashboard') }}" class="mod-card">
