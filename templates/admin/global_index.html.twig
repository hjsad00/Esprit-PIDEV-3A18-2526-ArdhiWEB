      {# Parcelles #}
      <a href="{{ path('admin_parcelle_index') }}" class="mod-card">
        <img src="{{ asset('assets/img/parcelle.jpg') }}" class="mod-img" alt="Parcelles">
        <div class="mod-glass"></div>
        <div class="mod-accent" style="background:linear-gradient(90deg,#10b981,#84cc16)"></div>
        <div class="mod-badge">MODULE</div>
        <div class="mod-arrow"><i class="bi bi-arrow-up-right"></i></div>
        <div class="mod-content">
          <div class="mod-icon-wrap" style="background:rgba(16,185,129,0.25)">🌱</div>
