      {# Diagnostic AI #}
      <a href="{{ path('admin_diags_dashboard') }}" class="mod-card">
        <img src="{{ asset('assets/img/ai.jpg') }}" class="mod-img" alt="Diagnostic AI">
        <div class="mod-glass"></div>
        <div class="mod-accent" style="background:linear-gradient(90deg,#06b6d4,#3b82f6)"></div>
        <div class="mod-badge">MODULE</div>
        <div class="mod-arrow"><i class="bi bi-arrow-up-right"></i></div>
        <div class="mod-content">
          <div class="mod-icon-wrap" style="background:rgba(6,182,212,0.25)">🤖</div>
