<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Admin Marketplace - Gestion Coupons</title>

    <link href="{{ asset('assets/img/ardhi_logo.png') }}" rel="icon">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/admin.css') }}" rel="stylesheet">
    <style>
        body { background-color: #f1f5f9; font-family: 'Inter', sans-serif; }

        /* HEADER */
        .page-header { background: #06402B; color: white; padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: center; border-radius: 0 0 20px 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); margin-top: -20px; position: relative; z-index: 10; }
        .page-title { font-size: 1.25rem; font-weight: 700; display: flex; align-items: center; gap: 12px; margin: 0; }
        .page-title img { height: 32px; filter: brightness(0) invert(1); }
        .btn-add { background: #116530; color: white; font-weight: 600; border: none; padding: 10px 20px; border-radius: 12px; transition: all 0.2s; box-shadow: 0 4px 10px rgba(17, 101, 48, 0.3); display: flex; align-items: center; gap: 8px; }
        .btn-add:hover { background: #0b4420; transform: translateY(-2px); box-shadow: 0 6px 15px rgba(17, 101, 48, 0.4); }
        .btn-back { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: white; width: 44px; height: 44px; display: flex; justify-content: center; align-items: center; border-radius: 12px; transition: all 0.2s; }
        .btn-back:hover { background: rgba(255,255,255,0.2); transform: translateX(-2px); }

        /* SUBHEADER */
        .subheader { color: #88a798; font-size: 0.85rem; padding: 0.8rem 2rem; font-weight: 500; d-flex; justify-content: space-between; align-items: center; }

        /* FILTERS */
        .filter-bar { background: white; padding: 20px 24px; border-radius: 16px; margin: 0 2rem 24px 2rem; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: 1px solid #edf2f7; }
        .filter-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
        .filter-title { font-size: 0.8rem; font-weight: 700; color: #1e293b; text-transform: uppercase; display: flex; align-items: center; gap: 8px; }
        .filter-reset { background: none; border: none; font-size: 0.8rem; font-weight: 600; color: #116530; cursor: pointer; }
        .filter-reset:hover { text-decoration: underline; }
        
        .filter-label { font-size: 0.65rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 6px; display: block; letter-spacing: 0.05em; }
        .filter-input { border-radius: 10px; border: 1.5px solid #e2e8f0; padding: 12px 16px; font-size: 0.9rem; width: 100%; transition: all 0.2s; background: #fff; color: #475569; font-weight: 500; }
        .filter-input:focus { border-color: #116530; outline: none; box-shadow: 0 0 0 3px rgba(17, 101, 48, 0.1); }

        /* GRID */
        .coupon-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; padding: 0 2rem 3rem 2rem; }

        /* CARDS */
        .c-card { background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); position: relative; cursor: pointer; display: flex; flex-direction: column; }
        .c-card:hover { transform: translateY(-5px); box-shadow: 0 12px 25px rgba(0,0,0,0.08); border-color: #cbd5e1; }
        
        /* CARD BADGES */
        .c-badge { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 50rem; font-size: 0.75rem; font-weight: 700; margin-bottom: 20px; align-self: flex-start; }
        .badge-valide { background: #ecfdf5; color: #047857; border: 1px solid #d1fae5; }
        .badge-inactif { background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }
        .badge-expire { background: #fef2f2; color: #b91c1c; border: 1px solid #fee2e2; }
        .badge-epuise { background: #fffbeb; color: #d97706; border: 1px solid #fef3c7; }

        /* CARD CONTENT */
        .c-code { font-size: 1.4rem; font-weight: 800; color: #1e293b; margin-bottom: 12px; letter-spacing: -0.02em; }
        .c-type { font-size: 0.8rem; font-weight: 700; color: #116530; text-transform: uppercase; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
        .c-type::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #116530; }
        
        .c-date { font-size: 0.75rem; color: #64748b; margin-bottom: 6px; font-weight: 500; }
        .c-min { font-size: 0.75rem; color: #94a3b8; font-weight: 500; margin-bottom: 24px; }
        
        /* PROGRESS BAR */
        .c-usage { font-size: 0.75rem; font-weight: 600; color: #475569; margin-bottom: 10px; margin-top: auto; }
        .progress-track { height: 8px; background: #f1f5f9; border-radius: 4px; overflow: hidden; border: 1px solid #e2e8f0; }
        .progress-bar { height: 100%; background: #116530; border-radius: 4px; transition: width 0.5s ease; }
        
        /* CARD ACTIONS (Hover) */
        .card-actions { position: absolute; top: 16px; right: 16px; display: flex; gap: 6px; opacity: 0; transition: opacity 0.2s; }
        .c-card:hover .card-actions { opacity: 1; }
        .btn-action { width: 32px; height: 32px; border-radius: 8px; border: none; display: flex; align-items: center; justify-content: center; font-size: 14px; cursor: pointer; transition: all 0.2s; }
        .btn-delete { background: #fee2e2; color: #b91c1c; }
        .btn-delete:hover { background: #fca5a5; color: white; }
        .btn-toggle { background: #f1f5f9; color: #475569; }
        .btn-toggle:hover { background: #cbd5e1; color: #1e293b; }

        /* MODAL */
        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); z-index: 1050; display: none; align-items: center; justify-content: center; }
        .modal-overlay.active { display: flex; animation: fadeIn 0.2s ease; }
        .modal-container { background: white; border-radius: 24px; width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); transform: translateY(20px); transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .modal-overlay.active .modal-container { transform: translateY(0); }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        
        .modal-header { padding: 24px 32px; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; background: #fff; position: sticky; top: 0; z-index: 1; border-radius: 24px 24px 0 0; }
        .modal-title { font-size: 1.25rem; font-weight: 800; color: #1e293b; margin: 0; }
        .btn-close-modal { background: #f1f5f9; border: none; width: 36px; height: 36px; border-radius: 50%; color: #64748b; font-size: 1.2rem; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; }
        .btn-close-modal:hover { background: #fee2e2; color: #b91c1c; }
        
        .modal-body { padding: 32px; }
        .form-group { margin-bottom: 20px; }
        .form-label { font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 8px; display: block; }
        .form-control { border-radius: 12px; border: 1.5px solid #e2e8f0; padding: 12px 16px; font-size: 0.95rem; background: #f8fafc; transition: all 0.2s; }
        .form-control:focus { background: #fff; border-color: #116530; box-shadow: 0 0 0 4px rgba(17, 101, 48, 0.08); }
        
        .modal-footer { padding: 24px 32px; border-top: 1px solid #f1f5f9; display: flex; justify-content: flex-end; gap: 12px; background: #f8fafc; border-radius: 0 0 24px 24px; }
        .btn-cancel { background: white; border: 1px solid #cbd5e1; color: #475569; padding: 10px 24px; border-radius: 12px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
        .btn-cancel:hover { background: #f8fafc; border-color: #94a3b8; }
        .btn-submit { background: #116530; border: none; color: white; padding: 10px 24px; border-radius: 12px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
        .btn-submit:hover { background: #0b4420; }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header class="page-header">
        <h1 class="page-title">
            <img src="{{ asset('assets/img/ardhi_logo.png') }}" alt="Ardhi">
            Gestion des Coupons
        </h1>
        <div class="d-flex align-items-center gap-3">
            <button class="btn-add" onclick="openModal()">
                <i class="bi bi-plus-lg"></i> Ajouter un coupon
            </button>
            <a href="{{ path('admin_marketplace_accueil') }}" class="btn-back">
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </header>

    <div class="subheader d-flex justify-content-between">
        <span><i class="bi bi-hand-index-thumb"></i> Cliquez sur un coupon pour le modifier</span>
        <span class="fw-bold"><span id="count-display">{{ coupons|length }}</span> coupon(s)</span>
    </div>

    <!-- FILTER BAR -->
    <section class="filter-bar">
        <div class="filter-header">
            <div class="filter-title"><i class="bi bi-search"></i> Recherche & Filtres</div>
            <button class="filter-reset" onclick="resetFilters()">Réinitialiser</button>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <label class="filter-label">Code</label>
                <input type="text" id="filter-code" class="filter-input" placeholder="Ex: SOLDES2024" onkeyup="filterLayout()">
            </div>
            <div class="col-md-4">
                <label class="filter-label">Type</label>
                <select id="filter-type" class="filter-input" onchange="filterLayout()">
                    <option value="">Tous les types</option>
                    <option value="POURCENTAGE">Pourcentage (%)</option>
                    <option value="FIXE">Montant Fixe (DT)</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="filter-label">Statut</label>
                <select id="filter-status" class="filter-input" onchange="filterLayout()">
                    <option value="">Tous</option>
                    <option value="valide">Valide</option>
                    <option value="inactif">Inactif</option>
                    <option value="expire">Expiré</option>
                    <option value="epuise">Épuisé</option>
                </select>
            </div>
        </div>
    </section>

    <!-- GRID -->
    <main class="coupon-grid" id="grid">
        {% set now = "now"|date("Y-m-d") %}
        
        {% for c in coupons %}
            
            {# Calcul du Statut #}
            {% set status = 'valide' %}
            {% set statusText = 'Valide' %}
            {% set icon = 'bi-check-circle' %}
            
            {% if not c.actif %}
                {% set status = 'inactif' %}
                {% set statusText = 'Inactif' %}
                {% set icon = 'bi-pause-circle' %}
            {% elseif c.dateFin|date("Y-m-d") < now %}
                {% set status = 'expire' %}
                {% set statusText = 'Expiré' %}
                {% set icon = 'bi-x-circle' %}
            {% elseif c.utilisationMax > 0 and c.utilisationActuelle >= c.utilisationMax %}
                {% set status = 'epuise' %}
                {% set statusText = 'Épuisé' %}
                {% set icon = 'bi-exclamation-triangle' %}
            {% endif %}

            {# Formattage de la valeur #}
            {% set valStr = c.typeReduction == 'POURCENTAGE' ? c.valeur ~ '%' : c.valeur ~ ' DT' %}
            
            {# Barre de progression #}
            {% set pct = 0 %}
            {% if c.utilisationMax > 0 %}
                {% set rawPct = (c.utilisationActuelle / c.utilisationMax) * 100 %}
                {% set pct = min(rawPct, 100) %}
            {% endif %}

            <article class="c-card" 
                     data-code="{{ c.code|lower }}" 
                     data-type="{{ c.typeReduction }}" 
                     data-status="{{ status }}"
                     onclick="openModal({{ c.id }})">
                
                <div class="card-actions">
                    <button class="btn-action btn-toggle" onclick="toggleCoupon(event, {{ c.id }})" title="{{ c.actif ? 'Désactiver' : 'Activer' }}">
                        <i class="bi {{ c.actif ? 'bi-pause-fill' : 'bi-play-fill' }}"></i>
                    </button>
                    <button class="btn-action btn-delete" onclick="deleteCoupon(event, {{ c.id }})" title="Supprimer">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>

                <div class="c-badge badge-{{ status }}">
                    <i class="bi {{ icon }}"></i> {{ statusText }}
                </div>
                
                <h2 class="c-code">{{ c.code }}</h2>
                <div class="c-type">{{ c.typeReduction }} — {{ valStr }}</div>
                
                <div class="c-date">Du {{ c.dateDebut|date('Y m d') }}<br>au {{ c.dateFin|date('Y-m-d') }}</div>
                <div class="c-min">Min. commande : {{ c.montantMin|number_format(2, ',', ' ') }} DT</div>
                
                <div class="c-usage">Utilisé : {{ c.utilisationActuelle }} / {{ c.utilisationMax > 0 ? c.utilisationMax : '∞' }}</div>
                <div class="progress-track">
                    <div class="progress-bar {% if status == 'epuise' or status == 'expire' %}bg-secondary{% endif %}" style="width: {{ pct }}%;"></div>
                </div>
            </article>
        {% else %}
            <div style="grid-column: 1 / -1; text-align: center; padding: 4rem; color: #94a3b8;">
                <i class="bi bi-ticket-perforated" style="font-size: 3rem; margin-bottom: 1rem; display: block; opacity: 0.5;"></i>
                <h4 class="fw-bold">Aucun coupon créé</h4>
                <p>Cliquez sur "Ajouter un coupon" pour commencer.</p>
            </div>
        {% endfor %}
    </main>

    <!-- MODAL -->
    <div class="modal-overlay" id="couponModal" onclick="if(event.target === this) closeModal()">
        <div class="modal-container">
            <div class="modal-header">
                <h3 class="modal-title" id="modalTitle">Créer un coupon</h3>
                <button class="btn-close-modal" onclick="closeModal()"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="couponForm" onsubmit="submitForm(event)">
                <div class="modal-body">
                    <div id="form-error" class="alert alert-danger d-none" style="border-radius: 12px; font-size: 0.9rem;"></div>
                    <input type="hidden" id="c_id">
                    
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Code du coupon *</label>
                            <input type="text" id="c_code" class="form-control" placeholder="Ex: WINTER24" required>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Type de réduction *</label>
                            <select id="c_type" class="form-control" required>
                                <option value="POURCENTAGE">Pourcentage (%)</option>
                                <option value="FIXE">Montant Fixe (DT)</option>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Valeur *</label>
                            <input type="number" id="c_valeur" class="form-control" step="0.1" min="0.1" required>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Date Début *</label>
                            <input type="date" id="c_debut" class="form-control" onchange="updateDateValidation()" required>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Date Fin *</label>
                            <input type="date" id="c_fin" class="form-control" required>
                        </div>
                        <div class="col-12" style="margin-top: 24px; padding-top: 24px; border-top: 1px dashed #cbd5e1;">
                            <h6 class="fw-bold" style="color: #64748b; font-size: 0.8rem; text-transform: uppercase;">Limites d'utilisation (Optionnel)</h6>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label">Montant Min (DT)</label>
                            <input type="number" id="c_min" class="form-control" value="0" min="0" step="0.1">
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label">Utilisation Max (Global)</label>
                            <input type="number" id="c_max" class="form-control" value="0" min="0" title="0 = Illimité">
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label">Max par client</label>
                            <input type="number" id="c_limit" class="form-control" value="1" min="1">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel" onclick="closeModal()">Annuler</button>
                    <button type="submit" class="btn-submit" id="btn-submit-form">
                        <span class="spinner-border spinner-border-sm d-none" id="spinner"></span> 
                        <span id="btn-text">Enregistrer</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

<script>
    // --- FILTRES ---
    function filterLayout() {
        const codeVal = document.getElementById('filter-code').value.toLowerCase();
        const typeVal = document.getElementById('filter-type').value;
        const statusVal = document.getElementById('filter-status').value;
        let count = 0;

        document.querySelectorAll('.c-card').forEach(card => {
            const matchCode = !codeVal || card.dataset.code.includes(codeVal);
            const matchType = !typeVal || card.dataset.type === typeVal;
            const matchStatus = !statusVal || card.dataset.status === statusVal;

            if (matchCode && matchType && matchStatus) {
                card.style.display = '';
                count++;
            } else {
                card.style.display = 'none';
            }
        });
        document.getElementById('count-display').innerText = count;
    }

    function resetFilters() {
        document.getElementById('filter-code').value = '';
        document.getElementById('filter-type').value = '';
        document.getElementById('filter-status').value = '';
        filterLayout();
    }

    // --- MODAL ---
    const modal = document.getElementById('couponModal');
    
    function updateDateValidation() {
        const start = document.getElementById('c_debut').value;
        const endInput = document.getElementById('c_fin');
        if (start) {
            endInput.min = start;
            if (endInput.value && endInput.value < start) {
                endInput.value = start;
            }
        }
    }

    async function openModal(id = null) {
        document.getElementById('form-error').classList.add('d-none');
        document.getElementById('couponForm').reset();
        document.getElementById('c_id').value = '';
        
        if (id) {
            document.getElementById('modalTitle').innerText = 'Modifier le coupon';
            try {
                const res = await fetch(`/marketplace/admin/coupon/${id}`);
                const data = await res.json();
                if(data.success) {
                    const c = data.coupon;
                    document.getElementById('c_id').value = c.id;
                    document.getElementById('c_code').value = c.code;
                    document.getElementById('c_type').value = c.typeReduction;
                    document.getElementById('c_valeur').value = c.valeur;
                    document.getElementById('c_debut').value = c.dateDebut;
                    document.getElementById('c_fin').value = c.dateFin;
                    document.getElementById('c_max').value = c.utilisationMax;
                    document.getElementById('c_min').value = c.montantMin;
                    document.getElementById('c_limit').value = c.limiteParUser;
                }
            } catch (e) {
                alert("Erreur de chargement des données.");
                return;
            }
        } else {
            document.getElementById('modalTitle').innerText = 'Créer un coupon';
        }
        
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        modal.classList.remove('active');
        document.body.style.overflow = '';
    }

    // --- AJAX SUBMIT ---
    async function submitForm(e) {
        e.preventDefault();
        const btn = document.getElementById('btn-submit-form');
        const spinner = document.getElementById('spinner');
        const text = document.getElementById('btn-text');
        const errorDiv = document.getElementById('form-error');
        
        errorDiv.classList.add('d-none');
        btn.disabled = true; spinner.classList.remove('d-none'); text.innerText = 'Enregistrement...';

        const payload = {
            id: document.getElementById('c_id').value,
            code: document.getElementById('c_code').value,
            typeReduction: document.getElementById('c_type').value,
            valeur: document.getElementById('c_valeur').value,
            dateDebut: document.getElementById('c_debut').value,
            dateFin: document.getElementById('c_fin').value,
            utilisationMax: document.getElementById('c_max').value || 0,
            montantMin: document.getElementById('c_min').value || 0,
            limiteParUser: document.getElementById('c_limit').value || 1
        };

        if (payload.typeReduction === 'POURCENTAGE' && (payload.valeur < 1 || payload.valeur > 100)) {
            btn.disabled = false; spinner.classList.add('d-none'); text.innerText = 'Enregistrer';
            errorDiv.innerText = 'Le pourcentage doit être compris entre 1 et 100.';
            errorDiv.classList.remove('d-none');
            return;
        }

        if (payload.dateDebut > payload.dateFin) {
            btn.disabled = false; spinner.classList.add('d-none'); text.innerText = 'Enregistrer';
            errorDiv.innerText = 'La date de début ne peut pas être postérieure à la date de fin.';
            errorDiv.classList.remove('d-none');
            return;
        }

        try {
            const res = await fetch('/marketplace/admin/coupon/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            
            if (data.success) {
                window.location.reload(); // Rechargement simple pour mettre à jour la grille pour le moment
            } else {
                errorDiv.innerText = data.message;
                errorDiv.classList.remove('d-none');
            }
        } catch (error) {
            errorDiv.innerText = 'Erreur réseau.';
            errorDiv.classList.remove('d-none');
        } finally {
            btn.disabled = false; spinner.classList.add('d-none'); text.innerText = 'Enregistrer';
        }
    }

    // --- AJAX ACTIONS ---
    async function toggleCoupon(e, id) {
        e.stopPropagation(); // Évite d'ouvrir la modale d'édition
        try {
            const res = await fetch(`/marketplace/admin/coupon/${id}/toggle`, { method: 'POST' });
            if(res.ok) window.location.reload();
        } catch(err) { alert('Erreur'); }
    }

    async function deleteCoupon(e, id) {
        e.stopPropagation();
        e.preventDefault();
        if(!confirm('Êtes-vous sûr de vouloir supprimer ce coupon définitivement ?')) return;
        try {
            const res = await fetch(`/marketplace/admin/coupon/${id}/delete`, { method: 'DELETE' });
            if(res.ok) {
                window.location.reload();
            } else {
                const data = await res.json();
                alert('Impossible de supprimer : ' + (data.message || 'Erreur serveur.'));
            }
        } catch(err) { alert('Erreur de connexion : ' + err.message); }
    }
</script>
</body>
</html>
