<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
window.marketplaceToggleChatbot = function (event) {
  // Stop propagation so the document click-outside handler does not fire
  if (event && event.stopPropagation) event.stopPropagation();

  const root = document.getElementById('marketChatbot');
  const panel = document.getElementById('marketChatbotPanel');
  const input = document.getElementById('marketChatbotInput');

  if (!root || !panel) {
    return false;
  }

  root.classList.toggle('open');
  const isOpen = root.classList.contains('open');
  panel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');

  if (isOpen && input) {
    input.focus();
  }

  return false;
};

window.marketplaceCloseChatbot = function () {
  const root = document.getElementById('marketChatbot');
  const panel = document.getElementById('marketChatbotPanel');

  if (root) {
    root.classList.remove('open');
  }

  if (panel) {
    panel.setAttribute('aria-hidden', 'true');
  }

  return false;
};

window.marketplaceSendNow = async function (event) {
  if (event) {
    event.preventDefault();
  }

  if (typeof window.marketplaceSendChatMessage === 'function') {
    await window.marketplaceSendChatMessage();
    return false;
  }

  const input = document.getElementById('marketChatbotInput');
  const messages = document.getElementById('marketChatbotMessages');
  const sendButton = document.getElementById('marketChatbotSend');
  const endpoint = '{{ path('app_marketplace_chatbot_send') }}';
  const text = (input?.value || '').trim();

  if (!input || !messages || text === '') {
    return false;
  }

  const appendBubble = (msg, role = 'bot') => {
    const bubble = document.createElement('div');
    bubble.className = `market-chatbot-message ${role}`;
    bubble.textContent = msg;
    messages.appendChild(bubble);
    messages.scrollTop = messages.scrollHeight;
  };

  appendBubble(text, 'user');
  input.value = '';
  input.disabled = true;
  if (sendButton) sendButton.disabled = true;

  try {
    const response = await fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
      },
      body: JSON.stringify({ message: text }),
    });

    const data = await response.json();

    if (typeof window.marketplaceHandleChatbotResponse === 'function') {
      await window.marketplaceHandleChatbotResponse(data);
    } else {
      appendBubble((data && data.message) ? data.message : 'Action executee.', 'bot');

      if (data && data.cart && typeof window.marketplaceSyncCartIndicators === 'function') {
        window.marketplaceSyncCartIndicators(data.cart);
      }
    }
  } catch (error) {
    appendBubble('Erreur de connexion au chatbot.', 'bot');
  } finally {
    input.disabled = false;
    if (sendButton) sendButton.disabled = false;
    input.focus();
  }

  return false;
};
</script>
<script>
// ── Sidebar Mobile Toggle ───────────────────────────────────────────
const filterToggle  = document.getElementById('filterToggle');
const sidebarClose  = document.getElementById('sidebarClose');
const filterSidebar = document.querySelector('.filter-sidebar');

if (filterToggle && filterSidebar) {
    filterToggle.addEventListener('click', () => {
        filterSidebar.classList.toggle('sidebar-open');
        document.body.classList.toggle('sidebar-overlay-active');
    });
}
if (sidebarClose && filterSidebar) {
    sidebarClose.addEventListener('click', () => {
        filterSidebar.classList.remove('sidebar-open');
        document.body.classList.remove('sidebar-overlay-active');
    });
}

// Fermer sidebar si clic sur l'overlay
document.addEventListener('click', (e) => {
    if (
        document.body.classList.contains('sidebar-overlay-active') &&
        !filterSidebar.contains(e.target) &&
        !filterToggle.contains(e.target)
    ) {
        filterSidebar.classList.remove('sidebar-open');
        document.body.classList.remove('sidebar-overlay-active');
    }
});

// ── Custom Checkbox ─────────────────────────────────────────────────
const checkboxEl     = document.getElementById('checkboxEnSolde');
const hiddenCheckbox = document.getElementById('filter-en-solde');

// ── Auto-submit Form (AJAX sans rafraîchissement) ───────────────────
const filterForm = document.getElementById('filterForm');
let timeout = null;
const compareStorageKey = 'marketplace_compare_products';

const fetchCatalogueContent = async (url, keepQueryInAddressBar = false) => {
    // Feedback visuel pendant le chargement
    const productContent = document.querySelector('.product-content');
  if (productContent) productContent.classList.add('ajax-loading');

    try {
        const response = await fetch(url, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const html = await response.text();
        
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        
        // Mettre à jour la grille de produits
        const newProductContent = doc.querySelector('.product-content');
        if (newProductContent && productContent) {
            productContent.innerHTML = newProductContent.innerHTML;
            productContent.style.opacity = '1';
            
            // Réinitialiser les événements (ex: panier et favoris) après remplacement du DOM
            initCartListeners();
          syncCompareUi();

            // Mettre à jour les prix si une devise est sélectionnée
            const savedCurrency = localStorage.getItem('marketplace_currency');
            if (savedCurrency && savedCurrency !== 'TND') {
                updatePrices(savedCurrency);
            }
        }

        // Mettre à jour le badge Filtres Actifs
        const currentBadge = document.querySelector('.active-filters-badge');
        const newBadge = doc.querySelector('.active-filters-badge');
        if (newBadge) {
            if (currentBadge) {
                currentBadge.outerHTML = newBadge.outerHTML;
            } else {
                filterForm.appendChild(newBadge);
            }
        } else if (currentBadge) {
            currentBadge.remove();
        }

        if (keepQueryInAddressBar) {
          window.history.replaceState({}, '', url.toString());
        } else {
          // On garde l'URL propre dans le navigateur (on masque les paramètres)
          window.history.replaceState({}, '', window.location.pathname);
        }

    } catch (err) {
        console.error('Erreur AJAX filtre:', err);
      if (productContent) productContent.classList.remove('ajax-loading');
    } finally {
      if (productContent) productContent.classList.remove('ajax-loading');
    }
};

    const applyFiltersAjax = async () => {
      if (!filterForm) return;

      const url = new URL(filterForm.action, window.location.origin);
      const formData = new FormData(filterForm);
      const searchParams = new URLSearchParams();

      for (let [key, value] of formData.entries()) {
        if (value !== '') {
          searchParams.append(key, value);
        }
      }
      url.search = searchParams.toString();

      await fetchCatalogueContent(url, false);
    };

const getCompareIds = () => {
  try {
    const parsed = JSON.parse(localStorage.getItem(compareStorageKey) || '[]');
    if (!Array.isArray(parsed)) return [];
    return parsed
      .map((id) => Number(id))
      .filter((id) => Number.isInteger(id) && id > 0)
      .slice(0, 2);
  } catch (e) {
    return [];
  }
};

const setCompareIds = (ids) => {
  localStorage.setItem(compareStorageKey, JSON.stringify(ids.slice(0, 2)));
};

const syncCompareUi = () => {
  const ids = getCompareIds();
  const countEl = document.getElementById('compareSelectedCount');
  const labelEl = document.getElementById('compareSelectedLabel');
  const launchLink = document.getElementById('compareLaunchLink');

  if (countEl) countEl.textContent = String(ids.length);
  if (labelEl) labelEl.textContent = `${ids.length} / 2 produits`;

  if (launchLink) {
    if (ids.length === 2) {
      launchLink.classList.remove('disabled');
      launchLink.setAttribute('aria-disabled', 'false');
      launchLink.href = `/marketplace/comparer?x=${ids[0]}&y=${ids[1]}`;
    } else {
      launchLink.classList.add('disabled');
      launchLink.setAttribute('aria-disabled', 'true');
      launchLink.href = '#';
    }
  }

  document.querySelectorAll('.compare-toggle-btn').forEach((btn) => {
    const productId = Number(btn.dataset.productId || 0);
    const selected = ids.includes(productId);
    btn.classList.toggle('active', selected);
    btn.innerHTML = selected
      ? '<i class="bi bi-check2-circle"></i> Selectionne'
      : '<i class="bi bi-columns-gap"></i> Comparer';
  });
};

window.toggleCompareSelection = (id) => {
  const productId = Number(id);
  if (!Number.isInteger(productId) || productId <= 0) {
    return;
  }

  let ids = getCompareIds();
  const idx = ids.indexOf(productId);

  if (idx >= 0) {
    ids.splice(idx, 1);
    setCompareIds(ids);
    syncCompareUi();
    showToast('Produit retire du comparateur.', false, 'Comparaison');
    return;
  }

  if (ids.length >= 2) {
    showToast('Vous pouvez comparer seulement 2 produits.', true, 'Comparaison');
    return;
  }

  ids.push(productId);
  setCompareIds(ids);
  syncCompareUi();

  if (ids.length === 2) {
    showToast('2 produits selectionnes. Ouvrez le comparateur.', false, 'Comparaison');
  } else {
    showToast('Produit ajoute au comparateur.', false, 'Comparaison');
  }
};

document.getElementById('compareLaunchLink')?.addEventListener('click', (e) => {
  const ids = getCompareIds();
  if (ids.length !== 2) {
    e.preventDefault();
    showToast('Selectionnez 2 produits pour comparer.', true, 'Comparaison');
  }
});

document.addEventListener('click', (event) => {
    const pageLink = event.target.closest('.catalogue-pagination a');
    if (!pageLink) return;

    event.preventDefault();
    const href = pageLink.getAttribute('href');
    if (!href || href === '#') return;

    const pageUrl = new URL(href, window.location.origin);
    fetchCatalogueContent(pageUrl, true);
});

if (checkboxEl && hiddenCheckbox) {
    checkboxEl.addEventListener('click', () => {
        hiddenCheckbox.checked = !hiddenCheckbox.checked;
        checkboxEl.classList.toggle('checked', hiddenCheckbox.checked);
        applyFiltersAjax();
    });
}

if (filterForm) {
    // Cacher le bouton "Appliquer" standard
    const applyBtn = document.getElementById('applyFilters');
    if (applyBtn) applyBtn.style.display = 'none';

    filterForm.querySelectorAll('input, select').forEach(element => {
        if (element.id === 'filter-en-solde' || element.id === 'filter-currency') return;
        
        if (element.tagName === 'INPUT' && (element.type === 'text' || element.type === 'number' || element.type === 'range')) {
            element.addEventListener('input', () => {
                clearTimeout(timeout);
                timeout = setTimeout(applyFiltersAjax, 600);
            });
        } else {
            element.addEventListener('change', applyFiltersAjax);
        }
    });

    filterForm.addEventListener('submit', (e) => {
        e.preventDefault();
        applyFiltersAjax();
    });
}

// ── Toast ───────────────────────────────────────────────────────────
function showToast(message, isError = false, title = null) {
  const resolvedTitle = title ?? (isError ? 'Erreur' : 'Succes');
    const toast = document.createElement('div');
    toast.className = 'mp-toast' + (isError ? ' error' : '');
    toast.innerHTML = `
        <div class="mp-toast-icon">
            <i class="bi bi-${isError ? 'x-circle-fill' : 'cart-check-fill'}"></i>
        </div>
        <div class="mp-toast-body">
      <strong>${resolvedTitle}</strong>
            <span>${message}</span>
        </div>
        <button class="mp-toast-close" onclick="dismissToast(this.parentElement)">
            <i class="bi bi-x-lg"></i>
        </button>
    `;
    document.body.appendChild(toast);
    setTimeout(() => dismissToast(toast), 3000);
}

function dismissToast(toast) {
    if (!toast || toast.classList.contains('hiding')) return;
    toast.classList.add('hiding');
    toast.addEventListener('animationend', () => toast.remove(), { once: true });
}

// ── Marketplace Chatbot ────────────────────────────────────────────
const chatbotEndpoint = '{{ path('app_marketplace_chatbot_send') }}';
const panierSummaryEndpoint = '{{ path('app_marketplace_panier_summary') }}';
const marketChatbotRoot = document.getElementById('marketChatbot');
const marketChatbotToggle = document.getElementById('marketChatbotToggle');
const marketChatbotPanel = document.getElementById('marketChatbotPanel');
const marketChatbotClose = document.getElementById('marketChatbotClose');
const marketChatbotMessages = document.getElementById('marketChatbotMessages');
const marketChatbotForm = document.getElementById('marketChatbotForm');
const marketChatbotInput = document.getElementById('marketChatbotInput');
const marketChatbotSend = document.getElementById('marketChatbotSend');
let marketChatbotSending = false;
let marketChatbotHistory = [];
let marketChatbotHistoryIndex = -1;
let marketChatbotTempInput = '';
const escapeChatHtml = (value) => {
  return (value ?? '').toString()
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;')
    .replaceAll('\n', '<br>');
};

const addChatMessage = (message, role = 'bot') => {
  if (!marketChatbotMessages || !message) return;

  const bubble = document.createElement('div');
  bubble.className = `market-chatbot-message ${role}`;
  bubble.innerHTML = escapeChatHtml(message);
  marketChatbotMessages.appendChild(bubble);
  marketChatbotMessages.scrollTop = marketChatbotMessages.scrollHeight;
};

const setChatbotSendingState = (isLoading) => {
  marketChatbotSending = isLoading;
  if (marketChatbotInput) marketChatbotInput.disabled = isLoading;
  if (marketChatbotSend) marketChatbotSend.disabled = isLoading;
};

const syncCartIndicatorsFromChat = (cart) => {
  if (!cart) return;

  const normalizedCount = Number(
    cart.count ?? cart.cartCount ?? 0
  );
  const normalizedTotal = String(
    cart.total ?? cart.cartTotal ?? '0.00'
  );

  const links = [
    ...document.querySelectorAll('a#cataloguePanierIndicator'),
    ...document.querySelectorAll('a.cart-indicator[href*="/marketplace/panier"]'),
  ];

  if (links.length === 0) {
    return;
  }

  links.forEach((cartLink) => {
    const badge = cartLink.querySelector('.cart-badge');
    const countLabel = cartLink.querySelector('.cart-info span');
    const totalLabel = cartLink.querySelector('.cart-info strong');

    if (badge) badge.textContent = String(normalizedCount);
    if (countLabel) countLabel.textContent = `${normalizedCount} article(s)`;
    if (totalLabel) totalLabel.textContent = `${normalizedTotal} DT`;
  });
};

const syncCartFromServer = async () => {
  try {
    const response = await fetch(`${panierSummaryEndpoint}?_ts=${Date.now()}`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      cache: 'no-store',
    });

    if (!response.ok) {
      return;
    }

    const data = await response.json();
    if (data && data.success) {
      syncCartIndicatorsFromChat({
        count: data.count ?? 0,
        total: data.total ?? '0.00',
      });
    }
  } catch (error) {
    // silent fail: keep current UI state
  }
};

const applyChatFilters = async (filters) => {
  if (!filters || !filterForm) return;

  const nomInput = document.getElementById('filter-nom');
  const categorieSelect = document.getElementById('filter-categorie');
  const triSelect = document.getElementById('filter-tri');
  const prixMinInput = document.getElementById('filter-prix-min');
  const prixMaxInput = document.getElementById('filter-prix-max');
  const prixMinLabel = document.getElementById('v-min-p');
  const prixMaxLabel = document.getElementById('v-max-p');

  // Reset or set nom filter
  if (nomInput) {
    nomInput.value = (typeof filters.nom === 'string') ? filters.nom : '';
  }

  // Accent-insensitive + case-insensitive category match
  const stripAccents = (s) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

  if (categorieSelect) {
    if (typeof filters.categorie === 'string' && filters.categorie !== '') {
      const needle = stripAccents(filters.categorie);
      const matchedOption = Array.from(categorieSelect.options).find(
        (opt) => stripAccents(opt.value) === needle
      );
      categorieSelect.value = matchedOption ? matchedOption.value : '';
    } else {
      categorieSelect.value = '';
    }
  }

  if (triSelect && typeof filters.tri === 'string' && filters.tri !== '') {
    const hasOption = Array.from(triSelect.options).some((opt) => opt.value === filters.tri);
    if (hasOption) {
      triSelect.value = filters.tri;
    }
  }

  if (prixMinInput && filters.prix_min !== '' && filters.prix_min !== undefined) {
    const minValue = Number(filters.prix_min);
    if (!Number.isNaN(minValue)) {
      prixMinInput.value = `${Math.max(0, minValue)}`;
      if (prixMinLabel) prixMinLabel.innerText = prixMinInput.value;
    }
  }

  if (prixMaxInput && filters.prix_max !== '' && filters.prix_max !== undefined) {
    const maxValue = Number(filters.prix_max);
    if (!Number.isNaN(maxValue)) {
      prixMaxInput.value = `${Math.max(0, maxValue)}`;
      if (prixMaxLabel) prixMaxLabel.innerText = prixMaxInput.value;
    }
  }

  if (prixMinInput && prixMaxInput && Number(prixMinInput.value) > Number(prixMaxInput.value)) {
    const min = prixMaxInput.value;
    prixMinInput.value = min;
    if (prixMinLabel) prixMinLabel.innerText = min;
  }

  await applyFiltersAjax();
};

const handleMarketplaceChatbotResponse = async (data) => {
  if (!data || typeof data !== 'object') {
    addChatMessage('Reponse invalide du serveur.', 'bot');
    return;
  }

  addChatMessage(data.message || 'Action executee.', 'bot');

  if (data.cart) {
    syncCartIndicatorsFromChat(data.cart);
  }

  if (['achat', 'supprimer_produit', 'vider_panier'].includes(data.intent)) {
    // Single delayed server sync as safety net — inline data.cart is trusted
    setTimeout(() => syncCartFromServer(), 500);
  }

  if (data.intent === 'filtrer' && data.filters) {
    await applyChatFilters(data.filters);
    showToast('Filtres appliques depuis le chatbot.', false, 'Catalogue');
    return;
  }
};

window.marketplaceHandleChatbotResponse = handleMarketplaceChatbotResponse;
window.marketplaceSyncCartIndicators = syncCartIndicatorsFromChat;
window.marketplaceSyncCartFromServer = syncCartFromServer;

const sendMarketplaceChatMessage = async (message) => {
  const text = (message || '').trim();
  if (text === '' || marketChatbotSending) return;

  addChatMessage(text, 'user');
  
  // Enregistrer dans l'historique
  marketChatbotHistory.unshift(text);
  if (marketChatbotHistory.length > 50) marketChatbotHistory.pop(); // Garder max 50
  marketChatbotHistoryIndex = -1;
  marketChatbotTempInput = '';

  if (marketChatbotInput) marketChatbotInput.value = '';
  setChatbotSendingState(true);
  // Safety timeout: auto-unlock send button after 45s if stuck
  const safetyTimeout = setTimeout(() => setChatbotSendingState(false), 45000);

  try {
    const response = await fetch(chatbotEndpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
      },
      body: JSON.stringify({ message: text }),
    });

    const data = await response.json();
    await handleMarketplaceChatbotResponse(data);
  } catch (error) {
    addChatMessage('Erreur de connexion au chatbot. Verifiez Ollama puis reessayez.', 'bot');
  } finally {
    clearTimeout(safetyTimeout);
    await syncCartFromServer();
    setChatbotSendingState(false);
    if (marketChatbotInput) marketChatbotInput.focus();
  }
};

window.marketplaceSendChatMessage = async function () {
  const message = marketChatbotInput ? marketChatbotInput.value : '';
  await sendMarketplaceChatMessage(message);
  return false;
};

// Toggle handled by inline onclick — no duplicate addEventListener needed

if (marketChatbotClose && marketChatbotRoot && marketChatbotPanel) {
  marketChatbotClose.addEventListener('click', (event) => {
    event.preventDefault();
    window.marketplaceCloseChatbot();
  });
}

document.addEventListener('click', (event) => {
