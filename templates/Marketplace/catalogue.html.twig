{% extends 'base.html.twig' %}

{% block title %}Ardhi - Catalogue{% endblock %}

{% block body_class %}marketplace-page{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/marketplace/marketplace.css') }}?v={{ date().timestamp }}" rel="stylesheet">
{% endblock %}

{% block body %}

    {# ============================
       PAGE HEADER
       ============================ #}
    <section class="marketplace-hero" style="min-height: 40vh;">
      <div class="hero-bg">
        <img src="{{ asset('assets/img/hero_1.jpg') }}" alt="Catalogue Ardhi">
      </div>
      <div class="container">
        <div class="hero-inner" style="padding: 30px 0;">
          <div class="hero-left" style="max-width: 100%; text-align: center; position: relative;">
            <div class="hero-label">ARDHI MARKETPLACE</div>
            <h1 class="hero-headline">Catalogue<br>des produits</h1>
            <p class="hero-description" style="margin-left: auto; margin-right: auto;">
              Parcourez tous les produits disponibles sur le marché agricole.
            </p>
            <a href="{{ path('app_marketplace') }}" class="hero-btn-primary">
              <i class="bi bi-arrow-left"></i> Retour au Marketplace
            </a>
          </div>
        </div>
      </div>
    </section>

    {# ============================
       CATALOGUE PRODUCTS
       ============================ #}
    <section id="catalogue-products" class="marketplace-section">
      <div class="container">

        {# Section Header + Cart Indicators #}
        <div class="cat-top-bar">
          <div class="marketplace-section-header" style="margin-bottom: 0; text-align: left;">
            <h2>Tous les produits</h2>
            <p>Découvrez les offres des autres agriculteurs</p>
          </div>

          <div class="cat-top-indicators">
            {# Indicateur Panier #}
            <a href="{{ path('app_marketplace_panier') }}" class="cart-indicator">
              <div class="cart-icon-wrapper">
                <i class="bi bi-cart3"></i>
                <span class="cart-badge">{{ panier ? panier.totalProduits : 0 }}</span>
              </div>
              <div class="cart-info">
                <span>{{ panier ? panier.totalProduits : 0 }} article(s)</span>
                <strong>{{ panier ? panier.totalMontant|number_format(2, '.', ' ') : '0.00' }} DT</strong>
              </div>
            </a>

            {# Indicateur Points #}
            {% if app.user %}
            <div class="cart-indicator" style="cursor:default; border-color: #f1c40f; background: #fffcf0;">
              <div class="cart-icon-wrapper" style="background: rgba(241, 196, 15, 0.1); color: #f1c40f; border: 1px solid rgba(241, 196, 15, 0.2);">
                <i class="bi bi-gem"></i>
              </div>
              <div class="cart-info">
                <span style="color: #868e96; font-size: 11px;">Mes Points</span>
                <strong style="color: #d4ac0d;">{{ app.user.pointsFidelite|default(0)|number_format(2, ',', ' ') }} pts</strong>
              </div>
            </div>
            {% endif %}
          </div>
        </div>

        {# ============================
           MAIN LAYOUT: Sidebar + Grid
           ============================ #}
        <div class="cat-main-layout">

          {# ── SIDEBAR FILTRES ─────────────────────────────── #}
          <aside class="filter-sidebar">
            <div class="sidebar-header">
              <i class="bi bi-sliders"></i>
              <span>Filtres & Tri</span>
              <button class="sidebar-mobile-close" id="sidebarClose" aria-label="Fermer les filtres">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>

            <form method="GET" action="{{ path('app_marketplace_catalogue') }}" id="filterForm">

              {# ── Recherche par Nom ── #}
              <div class="sidebar-group">
                <label class="sidebar-label" for="filter-nom">
                  <i class="bi bi-search"></i> Recherche
                </label>
                <div class="sidebar-input-wrap">
                  <input
                    type="text"
                    id="filter-nom"
                    name="nom"
                    class="sidebar-input"
                    placeholder="Nom du produit..."
                    value="{{ filters.nom }}"
                    autocomplete="off"
                  >
                </div>
              </div>

              {# ── Catégorie ── #}
              <div class="sidebar-group">
                <label class="sidebar-label" for="filter-categorie">
                  <i class="bi bi-tag"></i> Catégorie
                </label>
                <div class="sidebar-select-wrap">
                  <select id="filter-categorie" name="categorie" class="sidebar-select">
                    <option value="">Toutes les catégories</option>
                    {% for cat in categories %}
                      <option value="{{ cat }}" {{ filters.categorie == cat ? 'selected' : '' }}>
                        {{ cat }}
                      </option>
                    {% endfor %}
                  </select>
                  <i class="bi bi-chevron-down sidebar-select-arrow"></i>
                </div>
              </div>

              {# ── Plage de Prix ── #}
              <div class="sidebar-group range-container">
                  <div class="range-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                      <label class="sidebar-label mb-0"><i class="bi bi-currency-dollar"></i> Prix (TND)</label>
                  </div>
                  <div style="display:flex; flex-direction:column; gap:12px;">
                      <div>
                          <small class="text-muted" style="font-size:0.7rem;">Min: <span id="v-min-p">{{ filters.prix_min ?: 0 }}</span> DT</small>
                          <input type="range" name="prix_min" id="filter-prix-min" class="custom-range-slider" value="{{ filters.prix_min ?: 0 }}" min="0" max="{{ priceRange.pMax|default(5000)|round(0, 'ceil') }}" step="1" oninput="if(parseFloat(this.value) > parseFloat(document.getElementById('filter-prix-max').value)){this.value = document.getElementById('filter-prix-max').value;} document.getElementById('v-min-p').innerText = this.value;">
                      </div>
                      <div>
                          <small class="text-muted" style="font-size:0.7rem;">Max: <span id="v-max-p">{{ filters.prix_max ?: priceRange.pMax|default(5000)|round(0, 'ceil') }}</span> DT</small>
                          <input type="range" name="prix_max" id="filter-prix-max" class="custom-range-slider" value="{{ filters.prix_max ?: priceRange.pMax|default(5000)|round(0, 'ceil') }}" min="0" max="{{ priceRange.pMax|default(5000)|round(0, 'ceil') }}" step="1" oninput="if(parseFloat(this.value) < parseFloat(document.getElementById('filter-prix-min').value)){this.value = document.getElementById('filter-prix-min').value;} document.getElementById('v-max-p').innerText = this.value;">
                      </div>
                  </div>
              </div>

              {# ── Plage de Stock ── #}
              <div class="sidebar-group range-container">
                  <div class="range-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                      <label class="sidebar-label mb-0"><i class="bi bi-boxes"></i> Stock (Qté)</label>
                  </div>
                  <div style="display:flex; flex-direction:column; gap:12px;">
                      <div>
                          <small class="text-muted" style="font-size:0.7rem;">Mini: <span id="v-min-s">{{ filters.stock_min ?: 0 }}</span></small>
                          <input type="range" name="stock_min" id="filter-stock-min" class="custom-range-slider" value="{{ filters.stock_min ?: 0 }}" min="0" max="10000" step="1" oninput="if(parseInt(this.value) > parseInt(document.getElementById('filter-stock-max').value)){this.value = document.getElementById('filter-stock-max').value;} document.getElementById('v-min-s').innerText = this.value;">
                      </div>
                      <div>
                          <small class="text-muted" style="font-size:0.7rem;">Maxi: <span id="v-max-s">{{ filters.stock_max ?: 10000 }}</span></small>
                          <input type="range" name="stock_max" id="filter-stock-max" class="custom-range-slider" value="{{ filters.stock_max ?: 10000 }}" min="0" max="10000" step="1" oninput="if(parseInt(this.value) < parseInt(document.getElementById('filter-stock-min').value)){this.value = document.getElementById('filter-stock-min').value;} document.getElementById('v-max-s').innerText = this.value;">
                      </div>
                  </div>
              </div>

              {# ── En Solde ── #}
              <div class="sidebar-group">
                <label class="sidebar-checkbox-label" for="filter-en-solde">
                  <div class="custom-checkbox {{ filters.en_solde ? 'checked' : '' }}" id="checkboxEnSolde">
                    <i class="bi bi-check-lg"></i>
                  </div>
                  <input
                    type="checkbox"
                    id="filter-en-solde"
                    name="en_solde"
                    value="1"
                    {{ filters.en_solde ? 'checked' : '' }}
                    class="hidden-checkbox"
                  >
                  <div class="checkbox-text">
                    <span class="checkbox-title"><i class="bi bi-percent"></i> En solde uniquement</span>
                    <span class="checkbox-sub">Afficher les produits avec remise</span>
                  </div>
                </label>
              </div>

              {# ── Trier par ── #}
              <div class="sidebar-group">
                <label class="sidebar-label" for="filter-tri">
                  <i class="bi bi-sort-down-alt"></i> Trier par
                </label>
                <div class="sidebar-select-wrap">
                  <select id="filter-tri" name="tri" class="sidebar-select">
                    <option value="recent"   {{ filters.tri == 'recent'   ? 'selected' : '' }}>Plus récents</option>
                    <option value="prix_asc" {{ filters.tri == 'prix_asc' ? 'selected' : '' }}>Prix croissant</option>
                    <option value="prix_desc"{{ filters.tri == 'prix_desc'? 'selected' : '' }}>Prix décroissant</option>
                    <option value="nom_az"   {{ filters.tri == 'nom_az'   ? 'selected' : '' }}>Nom A → Z</option>
                    <option value="nom_za"   {{ filters.tri == 'nom_za'   ? 'selected' : '' }}>Nom Z → A</option>
                    <option value="solde"    {{ filters.tri == 'solde'    ? 'selected' : '' }}>En solde en premier</option>
                  </select>
                  <i class="bi bi-chevron-down sidebar-select-arrow"></i>
                </div>
              </div>

              {# ── Boutons d'action ── #}
              <div class="sidebar-actions">
                <button type="submit" class="btn-filter-apply" id="applyFilters">
                  <i class="bi bi-funnel-fill"></i> Appliquer
                </button>
                <a href="{{ path('app_marketplace_catalogue') }}" class="btn-filter-reset">
                  <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser
                </a>
              </div>

              {# Indicateur de filtres actifs #}
              {% set hasFilters = filters.nom or filters.categorie or filters.prix_min or filters.prix_max or filters.stock_min or filters.stock_max or filters.en_solde or (filters.tri != 'recent') %}
              {% if hasFilters %}
              <div class="active-filters-badge">
                <i class="bi bi-funnel-fill"></i>
                Filtres actifs —
                <strong>{{ produits|length }} résultat(s)</strong>
              </div>
              {% endif %}

            </form>
          </aside>

          {# ── GRILLE DE PRODUITS ───────────────────────────── #}
          <div class="product-content">

            {# Mobile Toggle Button #}
            <button class="filter-mobile-toggle" id="filterToggle" aria-label="Ouvrir les filtres">
              <i class="bi bi-sliders"></i>
              <span>Filtres & Tri</span>
              {% if hasFilters %}<span class="mobile-filter-dot"></span>{% endif %}
            </button>

            {# Résumé de la recherche #}
            <div class="product-results-summary">
              <span><strong>{{ produits|length }}</strong> produit(s) trouvé(s)</span>
              {% if filters.categorie %}
                <span class="summary-tag"><i class="bi bi-tag-fill"></i> {{ filters.categorie }}</span>
              {% endif %}
              {% if filters.tri and filters.tri != 'recent' %}
                <span class="summary-tag"><i class="bi bi-sort-down-alt"></i>
                  {% if filters.tri == 'prix_asc' %}Prix ↑
                  {% elseif filters.tri == 'prix_desc' %}Prix ↓
                  {% elseif filters.tri == 'nom_az' %}A→Z
                  {% elseif filters.tri == 'nom_za' %}Z→A
                  {% elseif filters.tri == 'solde' %}Soldes
                  {% endif %}
                </span>
              {% endif %}
            </div>

            {# Product Grid #}
            <div class="product-grid">

              {% for produit in produits %}
                <div class="product-card">
                  <div class="product-card-img">
                    {% if produit.image %}
                      <img src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="{{ produit.nom }}">
                    {% else %}
                      <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);">
                        <i class="bi bi-flower1" style="font-size:4rem;color:#4a8c3f;opacity:0.5;"></i>
                      </div>
                    {% endif %}
                    {% if produit.remise > 0 %}
                      {% if produit.typeRemise == 'POURCENTAGE' %}
                        <span class="product-badge badge-promo">-{{ produit.remise|number_format(0) }}%</span>
                      {% else %}
                        <span class="product-badge badge-promo">-{{ produit.remise|number_format(2, '.', ' ') }} TND</span>
                      {% endif %}
                    {% endif %}

                    {# Indicateur de Stock #}
                    <div class="product-stock-status {{ produit.quantiteStock > 0 ? 'stock-in' : 'stock-out' }}">
                      {{ produit.quantiteStock > 0 ? 'En stock (' ~ produit.quantiteStock ~ ')' : 'Rupture' }}
                    </div>
                  </div>
                  <div class="product-card-body">
                    {% if produit.categorie %}
                      <div class="product-card-category" style="display: flex; justify-content: space-between; align-items: center;">
                        <span>{{ produit.categorie }}</span>
                        <div style="display:flex; align-items:center; gap:10px;">
                          {# Bouton Favoris #}
                          {% if app.user %}
                            {% set isFav = produit.id in favIds %}
                            <button class="fav-icon-btn {{ isFav ? 'active' : '' }}"
                                    onclick="toggleWishlist({{ produit.id }}, this)"
                                    title="{{ isFav ? 'Retirer des favoris' : 'Ajouter aux favoris' }}"
                                    style="background:none; border:none; padding:0; cursor:pointer; font-size:1.1rem; line-height:1; transition:0.2s;">
                              <i class="bi bi-heart" style="{{ isFav ? 'display:none;' : '' }}"></i>
                              <i class="bi bi-heart-fill" style="{{ isFav ? 'display:block;' : 'display:none;' }} color:#e17055;"></i>
                            </button>
                          {% endif %}

                          {% if app.user and produit.user.id != app.user.id %}
                              <a href="{{ path('app_marketplace_reclamations', {'produit_id': produit.id}) }}" title="Signaler ce produit" style="color: #cbd5e1; transition: color 0.2s; font-size: 12px;">
                                  <i class="bi bi-flag-fill"></i>
                              </a>
                          {% endif %}
                        </div>
                      </div>
                    {% else %}
                      {% if app.user and produit.user.id != app.user.id %}
                          <div style="text-align: right; margin-bottom: 8px;">
                            <a href="{{ path('app_marketplace_reclamations', {'produit_id': produit.id}) }}" title="Signaler ce produit" style="color: #cbd5e1; transition: color 0.2s; font-size: 12px; margin-right: 5px;">
                                <i class="bi bi-flag-fill"></i>
                            </a>
                          </div>
                      {% endif %}
                    {% endif %}
                    <h3 class="product-card-title">{{ produit.nom }}</h3>
                    <div class="product-card-seller">
                      <i class="bi bi-person-circle"></i> Vendu par <strong>{{ produit.user.prenom ?? '' }} {{ produit.user.nom ?? '' }}</strong>
                    </div>
                    <p class="product-card-description">
                      {% if produit.description %}
                        {{ produit.description|length > 80 ? produit.description|slice(0, 80) ~ '...' : produit.description }}
                      {% endif %}
                    </p>
                    <div class="product-card-footer">
                      <div class="product-price">
                        {% if produit.remise > 0 %}
                          <small style="text-decoration:line-through;color:#b2bec3;">{{ produit.prix|number_format(2, '.', ' ') }} TND</small>
                          <span style="font-size:11px;color:#e17055;font-weight:600;">
                            {% if produit.typeRemise == 'POURCENTAGE' %}
                              (-{{ produit.remise|number_format(0) }}%)
                            {% else %}
                              (-{{ produit.remise|number_format(2, '.', ' ') }} TND)
                            {% endif %}
                          </span><br>
                          {{ produit.prixFinal|number_format(2, '.', ' ') }}
                        {% else %}
                          {{ produit.prix|number_format(2, '.', ' ') }}
                        {% endif %}
                        <small>TND/{{ produit.uniteMesure }}</small>
                      </div>
                      <a href="{{ path('app_marketplace_produit_show', {id: produit.id}) }}" class="product-btn"><i class="bi bi-eye"></i> Détails</a>
                    </div>

                    {# Actions Panier #}
                    <div class="product-card-actions">
                      <form action="{{ path('app_marketplace_panier_add', {id: produit.id}) }}" method="POST" class="product-cart-controls">
                        <input type="number" name="quantite" class="product-qty-input" value="1" min="1" max="{{ produit.quantiteStock }}"
                               {{ produit.quantiteStock <= 0 ? 'disabled' : '' }}>
                        <button type="submit" class="product-btn-cart {{ produit.quantiteStock <= 0 ? 'disabled' : '' }}"
                                {{ produit.quantiteStock <= 0 ? 'disabled' : '' }}>
                          <i class="bi bi-cart-plus"></i> Ajouter
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              {% else %}
                <div class="cat-empty-state">
                  <div class="cat-empty-icon">
                    <i class="bi bi-search"></i>
                  </div>
                  <h3>Aucun produit trouvé</h3>
                  <p>Essayez de modifier vos critères de recherche ou de réinitialiser les filtres.</p>
                  <a href="{{ path('app_marketplace_catalogue') }}" class="btn-filter-apply" style="display:inline-flex; width:auto; margin-top:8px;">
                    <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser
                  </a>
                </div>
              {% endfor %}

            </div>{# end .product-grid #}
          </div>{# end .product-content #}
        </div>{# end .cat-main-layout #}

      </div>
    </section>

{% block javascripts %}
<script>
// ── Sidebar Mobile Toggle ───────────────────────────────────────────
const filterToggle  = document.getElementById('filterToggle');
const sidebarClose  = document.getElementById('sidebarClose');
const filterSidebar = document.querySelector('.filter-sidebar');

if (filterToggle && filterSidebar) {
    filterToggle.addEventListener('click', () => {
        filterSidebar.classList.toggle('sidebar-open');
        document.body.classList.toggle('sidebar-overlay-active');
    });
}
if (sidebarClose && filterSidebar) {
    sidebarClose.addEventListener('click', () => {
        filterSidebar.classList.remove('sidebar-open');
        document.body.classList.remove('sidebar-overlay-active');
    });
}

// Fermer sidebar si clic sur l'overlay
document.addEventListener('click', (e) => {
    if (
        document.body.classList.contains('sidebar-overlay-active') &&
        !filterSidebar.contains(e.target) &&
        !filterToggle.contains(e.target)
    ) {
        filterSidebar.classList.remove('sidebar-open');
        document.body.classList.remove('sidebar-overlay-active');
    }
});

// ── Custom Checkbox ─────────────────────────────────────────────────
const checkboxEl     = document.getElementById('checkboxEnSolde');
const hiddenCheckbox = document.getElementById('filter-en-solde');

// ── Auto-submit Form (AJAX sans rafraîchissement) ───────────────────
const filterForm = document.getElementById('filterForm');
let timeout = null;

const applyFiltersAjax = async () => {
    if (!filterForm) return;
    
    // Feedback visuel pendant le chargement
    const productContent = document.querySelector('.product-content');
    if (productContent) productContent.style.opacity = '0.5';

    // Construire l'URL avec les paramètres
    const url = new URL(filterForm.action);
    const formData = new FormData(filterForm);
    const searchParams = new URLSearchParams();
    
    for (let [key, value] of formData.entries()) {
        if (value !== '') {
            searchParams.append(key, value);
        }
    }
    url.search = searchParams.toString();

    try {
        const response = await fetch(url, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const html = await response.text();
        
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        
        // Mettre à jour la grille de produits
        const newProductContent = doc.querySelector('.product-content');
        if (newProductContent && productContent) {
            productContent.innerHTML = newProductContent.innerHTML;
            productContent.style.opacity = '1';
            
            // Réinitialiser les événements (ex: panier et favoris) après remplacement du DOM
            initCartListeners();
        }

        // Mettre à jour le badge Filtres Actifs
        const currentBadge = document.querySelector('.active-filters-badge');
        const newBadge = doc.querySelector('.active-filters-badge');
        if (newBadge) {
            if (currentBadge) {
                currentBadge.outerHTML = newBadge.outerHTML;
            } else {
                filterForm.appendChild(newBadge);
            }
        } else if (currentBadge) {
            currentBadge.remove();
        }

        // Mettre à jour l'URL du navigateur (pratique pour le partage)
        window.history.pushState({}, '', url);

    } catch (err) {
        console.error('Erreur AJAX filtre:', err);
        if (productContent) productContent.style.opacity = '1';
    }
};

if (checkboxEl && hiddenCheckbox) {
    checkboxEl.addEventListener('click', () => {
        hiddenCheckbox.checked = !hiddenCheckbox.checked;
        checkboxEl.classList.toggle('checked', hiddenCheckbox.checked);
        applyFiltersAjax();
    });
}

if (filterForm) {
    // Cacher le bouton "Appliquer" standard
    const applyBtn = document.getElementById('applyFilters');
    if (applyBtn) applyBtn.style.display = 'none';

    filterForm.querySelectorAll('input, select').forEach(element => {
        if (element.id === 'filter-en-solde') return;
        
        if (element.tagName === 'INPUT' && (element.type === 'text' || element.type === 'number' || element.type === 'range')) {
            element.addEventListener('input', () => {
                clearTimeout(timeout);
                timeout = setTimeout(applyFiltersAjax, 600);
            });
        } else {
            element.addEventListener('change', applyFiltersAjax);
        }
    });

    filterForm.addEventListener('submit', (e) => {
        e.preventDefault();
        applyFiltersAjax();
    });
}

// ── Toast ───────────────────────────────────────────────────────────
function showToast(message, isError = false) {
    const toast = document.createElement('div');
    toast.className = 'mp-toast' + (isError ? ' error' : '');
    toast.innerHTML = `
        <div class="mp-toast-icon">
            <i class="bi bi-${isError ? 'x-circle-fill' : 'cart-check-fill'}"></i>
        </div>
        <div class="mp-toast-body">
            <strong>${isError ? 'Erreur' : 'Panier mis à jour'}</strong>
            <span>${message}</span>
        </div>
        <button class="mp-toast-close" onclick="dismissToast(this.parentElement)">
            <i class="bi bi-x-lg"></i>
        </button>
    `;
    document.body.appendChild(toast);
    setTimeout(() => dismissToast(toast), 3000);
}

function dismissToast(toast) {
    if (!toast || toast.classList.contains('hiding')) return;
    toast.classList.add('hiding');
    toast.addEventListener('animationend', () => toast.remove(), { once: true });
}

// ── AJAX Add to Cart ────────────────────────────────────────────────
function initCartListeners() {
    document.querySelectorAll('form.product-cart-controls').forEach(form => {
        form.onsubmit = async function(e) {
            e.preventDefault();
            const btn = form.querySelector('.product-btn-cart');
            if (btn.disabled) return;
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-arrow-repeat" style="animation:spin 0.6s linear infinite"></i>';
            btn.disabled = true;
            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new FormData(form),
                });
                const data = await response.json();
                if (data.success) {
                    document.querySelectorAll('.cart-badge').forEach(el => el.textContent = data.cartCount);
                    document.querySelectorAll('a.cart-indicator .cart-info span').forEach(el => el.textContent = data.cartCount + ' article(s)');
                    document.querySelectorAll('a.cart-indicator .cart-info strong').forEach(el => el.textContent = data.cartTotal + ' DT');
                    showToast(data.message);
                    const cartIcon = document.querySelector('.cart-icon-wrapper');
                    if (cartIcon) {
                        cartIcon.style.transform = 'scale(1.3)';
                        setTimeout(() => cartIcon.style.transform = 'scale(1)', 300);
                    }
                } else {
                    showToast(data.message, true);
                }
            } catch (err) {
                showToast('Une erreur est survenue.', true);
            } finally {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
        };
    });
}
initCartListeners();

// ── AJAX Toggle Wishlist ────────────────────────────────────────────
async function toggleWishlist(productId, btn) {
    if (btn.disabled) return;
    btn.disabled = true;
    try {
        const response = await fetch(`/marketplace/favoris/toggle/${productId}`, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const data = await response.json();
        if (data.success) {
            if (data.isFavorite) {
                btn.classList.add('active');
                btn.title = "Retirer des favoris";
                if(btn.querySelector('.bi-heart')) btn.querySelector('.bi-heart').style.display = 'none';
                if(btn.querySelector('.bi-heart-fill')) btn.querySelector('.bi-heart-fill').style.display = 'block';
            } else {
                btn.classList.remove('active');
                btn.title = "Ajouter aux favoris";
                if(btn.querySelector('.bi-heart')) btn.querySelector('.bi-heart').style.display = 'block';
                if(btn.querySelector('.bi-heart-fill')) btn.querySelector('.bi-heart-fill').style.display = 'none';
            }
            showToast(data.message);
        } else {
            showToast(data.message || 'Une erreur est survenue.', true);
        }
    } catch (err) {
        showToast('Erreur de connexion.', true);
    } finally {
        btn.disabled = false;
    }
}
</script>

