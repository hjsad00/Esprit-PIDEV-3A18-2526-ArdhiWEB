}

.market-chatbot-chips {
  display: flex;
  gap: 7px;
  flex-wrap: wrap;
  padding: 0 12px 10px;
}

.market-chatbot-chip {
  border: 1px solid rgba(185, 235, 202, 0.35);
  background: rgba(12, 76, 58, 0.55);
  color: #ceffe0;
  border-radius: 999px;
  font-size: 11px;
  padding: 6px 10px;
  cursor: pointer;
}

.market-chatbot-form {
  border-top: 1px solid rgba(220, 255, 230, 0.12);
  display: flex;
  gap: 8px;
  padding: 12px;
  background: rgba(7, 24, 19, 0.45);
}

.market-chatbot-form input {
  flex: 1;
  border-radius: 10px;
  border: 1px solid rgba(220, 255, 230, 0.18);
  background: rgba(255, 255, 255, 0.08);
  color: #f3fff7;
  padding: 9px 10px;
  font-size: 13px;
  outline: none;
}

.market-chatbot-form input:disabled,
.market-chatbot-form button:disabled {
  opacity: 0.65;
  cursor: not-allowed;
}

.market-chatbot-form button {
  width: 40px;
  border: none;
  border-radius: 10px;
  background: linear-gradient(135deg, #2db56d 0%, #178f58 100%);
  color: #fff;
}

@media (max-width: 768px) {
  .reviews-modal { border-radius: 14px; }
  .review-item-head { align-items: flex-start; flex-direction: column; }
  .product-card-actions { gap: 8px; }

  .chatbot-launch-indicator {
    width: 100%;
    min-width: 220px;
  }

  .market-chatbot-panel {
    position: fixed;
    right: 12px;
    left: 12px;
    top: auto;
    bottom: 12px;
    width: auto;
    max-height: 80vh;
  }
}
