  right: 20px;
  bottom: 20px;
  top: auto;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.market-chatbot-panel {
  z-index: 21000;
  width: min(380px, calc(100vw - 30px));
  background: linear-gradient(180deg, #0f2f2c 0%, #11221d 100%);
  border: 1px solid rgba(144, 220, 170, 0.22);
  border-radius: 16px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
  position: absolute;
  right: 0;
  bottom: 72px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(12px) scale(0.98);
  transition: all 0.18s ease;
  overflow: hidden;
}

.market-chatbot.open .market-chatbot-panel {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
}

.market-chatbot-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
  padding: 12px 14px;
  border-bottom: 1px solid rgba(220, 255, 230, 0.12);
  background: rgba(5, 20, 16, 0.45);
}

.market-chatbot-header strong {
  color: #ebfff2;
