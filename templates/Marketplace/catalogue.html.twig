{% extends 'base.html.twig' %}

{% block title %}Ardhi - Catalogue{% endblock %}

{% block body_class %}marketplace-page{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <link href="{{ asset('assets/css/marketplace/marketplace.css') }}?v={{ date().timestamp }}" rel="stylesheet">
{% endblock %}

{% block body %}

    {# ============================
       PAGE HEADER
       ============================ #}
    <section class="marketplace-hero" style="min-height: 40vh;">
      <div class="hero-bg">
        <img src="{{ asset('assets/img/hero_1.jpg') }}" alt="Catalogue Ardhi">
      </div>
      <div class="container">
        <div class="hero-inner" style="padding: 30px 0;">
          <div class="hero-left" style="max-width: 100%; text-align: center; position: relative;">
            <div class="hero-label">ARDHI MARKETPLACE</div>
            <h1 class="hero-headline">Catalogue<br>des produits</h1>
            <p class="hero-description" style="margin-left: auto; margin-right: auto;">
              Parcourez tous les produits disponibles sur le marché agricole.
            </p>
            <a href="{{ path('app_marketplace') }}" class="hero-btn-primary">
              <i class="bi bi-arrow-left"></i> Retour au Marketplace
            </a>
          </div>
        </div>
      </div>
    </section>

    {# ============================
       CATALOGUE PRODUCTS
       ============================ #}
    <section id="catalogue-products" class="marketplace-section">
      <div class="container">

        {# Section Header + Cart Indicators #}
        <div class="cat-top-bar">
          <div class="marketplace-section-header" style="margin-bottom: 0; text-align: left;">
            <h2>Tous les produits</h2>
            <p>Découvrez les offres des autres agriculteurs</p>
          </div>

          <div class="cat-top-indicators">
            <a href="#" class="cart-indicator compare-indicator disabled" id="compareLaunchLink" aria-disabled="true">
              <div class="cart-icon-wrapper" style="background: rgba(13, 110, 253, 0.12); color: #0d6efd; border: 1px solid rgba(13, 110, 253, 0.2);">
                <i class="bi bi-columns-gap"></i>
                <span class="cart-badge" id="compareSelectedCount">0</span>
              </div>
              <div class="cart-info">
                <span>Comparateur</span>
                <strong id="compareSelectedLabel">0 / 2 produits</strong>
              </div>
            </a>

            <div id="marketChatbot" class="market-chatbot">
              <button id="marketChatbotToggle" class="cart-indicator chatbot-launch-indicator" type="button" aria-label="Ouvrir le chatbot marketplace" onclick="return window.marketplaceToggleChatbot(event);">
                <div class="cart-icon-wrapper" style="background: rgba(16, 185, 129, 0.14); color: #0b8f62; border: 1px solid rgba(16, 185, 129, 0.26);">
                  <i class="bi bi-robot"></i>
                </div>
                <div class="cart-info">
                  <span>Assistant IA</span>
                  <strong>Ouvrir le chatbot</strong>
                </div>
              </button>

              <div id="marketChatbotPanel" class="market-chatbot-panel" aria-hidden="true">
                <div class="market-chatbot-header">
                  <div>
                    <strong>Assistant Marketplace</strong>
                    <span>Panier et filtres en langage naturel</span>
                  </div>
                  <button id="marketChatbotClose" type="button" aria-label="Fermer le chatbot" onclick="return window.marketplaceCloseChatbot();">
                    <i class="bi bi-x-lg"></i>
                  </button>
                </div>

                <div id="marketChatbotMessages" class="market-chatbot-messages">
                  <div class="market-chatbot-message bot">
                    Bonjour. Dites par exemple: "ajoute 2 tomates", "supprime la pomme", "vide mon panier", "montre les fruits moins chers".
                  </div>
                </div>



                <form id="marketChatbotForm" class="market-chatbot-form" onsubmit="return window.marketplaceSendNow(event);" novalidate>
                  <input
                    type="text"
                    id="marketChatbotInput"
                    placeholder="Ecrivez votre demande..."
                    autocomplete="off"
                    maxlength="300"
                  >
                  <button id="marketChatbotSend" type="button" onclick="return window.marketplaceSendNow(event);">
                    <i class="bi bi-send-fill"></i>
                  </button>
                </form>
              </div>
            </div>

            {# Indicateur Panier #}
            <a href="{{ path('app_marketplace_panier') }}" class="cart-indicator" id="cataloguePanierIndicator">
              <div class="cart-icon-wrapper">
                <i class="bi bi-cart3"></i>
                <span class="cart-badge">{{ panier ? panier.totalProduits : 0 }}</span>
              </div>
              <div class="cart-info">
                <span>{{ panier ? panier.totalProduits : 0 }} article(s)</span>
                <strong>{{ panier ? panier.totalMontant|number_format(2, '.', ' ') : '0.00' }} DT</strong>
              </div>
            </a>

            {# Indicateur Points #}
            {% if app.user %}
            <div class="cart-indicator" style="cursor:default; border-color: #f1c40f; background: #fffcf0;">
              <div class="cart-icon-wrapper" style="background: rgba(241, 196, 15, 0.1); color: #f1c40f; border: 1px solid rgba(241, 196, 15, 0.2);">
                <i class="bi bi-gem"></i>
              </div>
              <div class="cart-info">
                <span style="color: #868e96; font-size: 11px;">Mes Points</span>
                <strong style="color: #d4ac0d;">{{ app.user.pointsFidelite|default(0)|number_format(2, ',', ' ') }} pts</strong>
              </div>
            </div>
            {% endif %}
          </div>
        </div>

        {# ============================
           MAIN LAYOUT: Sidebar + Grid
           ============================ #}
        <div class="cat-main-layout">

          {# ── SIDEBAR FILTRES ─────────────────────────────── #}
          <aside class="filter-sidebar custom-sidebar-scroll">
            <div class="sidebar-header">
              <i class="bi bi-sliders"></i>
              <span>Filtres & Tri</span>
              <button class="sidebar-mobile-close" id="sidebarClose" aria-label="Fermer les filtres">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>

            <form method="GET" action="{{ path('app_marketplace_catalogue') }}" id="filterForm" novalidate>

              {# ── Recherche par Nom ── #}
              <div class="sidebar-group">
                <label class="sidebar-label" for="filter-nom">
                  <i class="bi bi-search"></i> Recherche
                </label>
                <div class="sidebar-input-wrap">
                  <input
                    type="text"
                    id="filter-nom"
                    name="nom"
                    class="sidebar-input"
                    placeholder="Nom du produit..."
                    value="{{ filters.nom }}"
                    autocomplete="off"
                  >
                </div>
              </div>

              {# ── Catégorie ── #}
              <div class="sidebar-group">
                <label class="sidebar-label" for="filter-categorie">
                  <i class="bi bi-tag"></i> Catégorie
                </label>
                <div class="sidebar-select-wrap">
                  <select id="filter-categorie" name="categorie" class="sidebar-select">
                    <option value="">Toutes les catégories</option>
                    {% for cat in categories %}
                      <option value="{{ cat }}" {{ filters.categorie == cat ? 'selected' : '' }}>
                        {{ cat }}
                      </option>
                    {% endfor %}
                  </select>
                  <i class="bi bi-chevron-down sidebar-select-arrow"></i>
                </div>
              </div>

              {# ── Localisation (Map) ── #}
              <div class="sidebar-group">
                <label class="sidebar-label">
                  <i class="bi bi-geo-alt"></i> Localisation
                </label>
                <div style="border: 1px solid #e0e6e0; border-radius: 10px; padding: 12px; background: #f8faf9; cursor: pointer; display: flex; flex-direction: column; gap: 5px; transition: all 0.2s;" onclick="openLocationModal()" onmouseover="this.style.borderColor='#4a8c3f'" onmouseout="this.style.borderColor='#e0e6e0'">
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <i class="bi bi-geo" style="color: #4a8c3f;"></i>
                    <span id="currentLocationText" style="font-size: 14px; font-weight: 600; color: #2d3436;">
                      {{ filters.location_name ?: 'Changer le lieu' }}
                    </span>
                  </div>
                  <div id="currentRadiusWrap" style="display: {{ filters.radius and filters.location_name ? 'block' : 'none' }};">
                     <span style="font-size: 12px; color: #636e72;">Rayon : <strong id="currentRadiusText">{{ filters.radius ?: '25' }}</strong> km</span>
                  </div>
                </div>
                
                {# Hidden inputs for form submission #}
                <input type="hidden" name="location_name" id="filter-location-name" value="{{ filters.location_name }}">
                <input type="hidden" name="lat" id="filter-lat" value="{{ filters.lat }}">
                <input type="hidden" name="lng" id="filter-lng" value="{{ filters.lng }}">
                <input type="hidden" name="radius" id="filter-radius" value="{{ filters.radius ?: '25' }}">
              </div>

              {# ── Plage de Prix ── #}
              <div class="sidebar-group range-container">
                  <div class="range-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                      <label class="sidebar-label mb-0"><i class="bi bi-currency-dollar"></i> Prix (TND)</label>
                  </div>
                  <div style="display:flex; flex-direction:column; gap:12px;">
                      <div>
                          <small class="text-muted" style="font-size:0.7rem;">Min: <span id="v-min-p">{{ filters.prix_min ?: 0 }}</span> DT</small>
                          <input type="range" name="prix_min" id="filter-prix-min" class="custom-range-slider" value="{{ filters.prix_min ?: 0 }}" min="0" max="{{ priceRange.pMax|default(5000)|round(0, 'ceil') }}" step="1" oninput="let maxVal = parseInt(document.getElementById('filter-prix-max').value); if(parseInt(this.value) > maxVal) this.value = maxVal; document.getElementById('v-min-p').innerText = this.value;">
                      </div>
                      <div>
                          <small class="text-muted" style="font-size:0.7rem;">Max: <span id="v-max-p">{{ filters.prix_max ?: priceRange.pMax|default(5000)|round(0, 'ceil') }}</span> DT</small>
                          <input type="range" name="prix_max" id="filter-prix-max" class="custom-range-slider" value="{{ filters.prix_max ?: priceRange.pMax|default(5000)|round(0, 'ceil') }}" min="0" max="{{ priceRange.pMax|default(5000)|round(0, 'ceil') }}" step="1" oninput="let minVal = parseInt(document.getElementById('filter-prix-min').value); if(parseInt(this.value) < minVal) this.value = minVal; document.getElementById('v-max-p').innerText = this.value;">
                      </div>
                  </div>
              </div>

              {# ── Plage de Stock ── #}
              <div class="sidebar-group range-container">
                  <div class="range-header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                      <label class="sidebar-label mb-0"><i class="bi bi-boxes"></i> Stock (Qté)</label>
                  </div>
                  <div style="display:flex; flex-direction:column; gap:12px;">
                      <div>
                          <small class="text-muted" style="font-size:0.7rem;">Mini: <span id="v-min-s">{{ filters.stock_min ?: 0 }}</span></small>
                          <input type="range" name="stock_min" id="filter-stock-min" class="custom-range-slider" value="{{ filters.stock_min ?: 0 }}" min="0" max="10000" step="1" oninput="let maxVal = parseInt(document.getElementById('filter-stock-max').value); if(parseInt(this.value) > maxVal) this.value = maxVal; document.getElementById('v-min-s').innerText = this.value;">
                      </div>
                      <div>
                          <small class="text-muted" style="font-size:0.7rem;">Maxi: <span id="v-max-s">{{ filters.stock_max ?: 10000 }}</span></small>
                          <input type="range" name="stock_max" id="filter-stock-max" class="custom-range-slider" value="{{ filters.stock_max ?: 10000 }}" min="0" max="10000" step="1" oninput="let minVal = parseInt(document.getElementById('filter-stock-min').value); if(parseInt(this.value) < minVal) this.value = minVal; document.getElementById('v-max-s').innerText = this.value;">
                      </div>
                  </div>
              </div>

              {# ── En Solde ── #}
              <div class="sidebar-group">
                <label class="sidebar-checkbox-label" for="filter-en-solde">
                  <div class="custom-checkbox {{ filters.en_solde ? 'checked' : '' }}" id="checkboxEnSolde">
                    <i class="bi bi-check-lg"></i>
                  </div>
                  <input
                    type="checkbox"
                    id="filter-en-solde"
                    name="en_solde"
                    value="1"
                    {{ filters.en_solde ? 'checked' : '' }}
                    class="hidden-checkbox"
                  >
                  <div class="checkbox-text">
                    <span class="checkbox-title"><i class="bi bi-percent"></i> En solde uniquement</span>
                    <span class="checkbox-sub">Afficher les produits avec remise</span>
                  </div>
                </label>
              </div>

              {# ── Trier par ── #}
              <div class="sidebar-group">
                <label class="sidebar-label" for="filter-tri">
                  <i class="bi bi-sort-down-alt"></i> Trier par
                </label>
                <div class="sidebar-select-wrap">
                  <select id="filter-tri" name="tri" class="sidebar-select">
                    <option value="recent"   {{ filters.tri == 'recent'   ? 'selected' : '' }}>Plus récents</option>
                    <option value="prix_asc" {{ filters.tri == 'prix_asc' ? 'selected' : '' }}>Prix croissant</option>
                    <option value="prix_desc"{{ filters.tri == 'prix_desc'? 'selected' : '' }}>Prix décroissant</option>
                    <option value="nom_az"   {{ filters.tri == 'nom_az'   ? 'selected' : '' }}>Nom A → Z</option>
                    <option value="nom_za"   {{ filters.tri == 'nom_za'   ? 'selected' : '' }}>Nom Z → A</option>
                    <option value="solde"    {{ filters.tri == 'solde'    ? 'selected' : '' }}>En solde en premier</option>
                  </select>
                  <i class="bi bi-chevron-down sidebar-select-arrow"></i>
                </div>
              </div>

              {# ── Devise ── #}
              <div class="sidebar-group">
                <label class="sidebar-label" for="filter-currency">
                  <i class="bi bi-currency-exchange"></i> Devise du prix
                </label>
                <div class="sidebar-select-wrap">
                  <select id="filter-currency" name="currency" class="sidebar-select">
                    <option value="TND" selected>TND (Dinar Tunisien)</option>
                    <option value="EUR">EUR (Euro)</option>
                    <option value="USD">USD (Dollar US)</option>
                  </select>
                  <i class="bi bi-chevron-down sidebar-select-arrow"></i>
                </div>
              </div>

              {# ── Boutons d'action ── #}
              <div class="sidebar-actions">
                <button type="submit" class="btn-filter-apply" id="applyFilters">
                  <i class="bi bi-funnel-fill"></i> Appliquer
                </button>
                <a href="{{ path('app_marketplace_catalogue') }}" class="btn-filter-reset">
                  <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser
                </a>
              </div>

              {# Indicateur de filtres actifs #}
              {% set hasFilters = filters.nom or filters.categorie or filters.prix_min or filters.prix_max or filters.stock_min or filters.stock_max or filters.en_solde or (filters.tri != 'recent') %}
              {% if hasFilters %}
              <div class="active-filters-badge">
                <i class="bi bi-funnel-fill"></i>
                Filtres actifs —
                <strong>{{ produits.getTotalItemCount }} résultat(s)</strong>
              </div>
              {% endif %}

            </form>
          </aside>

          {# ── GRILLE DE PRODUITS ───────────────────────────── #}
          <div class="product-content">

            {# Mobile Toggle Button #}
            <button class="filter-mobile-toggle" id="filterToggle" aria-label="Ouvrir les filtres">
              <i class="bi bi-sliders"></i>
              <span>Filtres & Tri</span>
              {% if hasFilters %}<span class="mobile-filter-dot"></span>{% endif %}
            </button>

            {# Résumé de la recherche #}
            <div class="product-results-summary">
              <span><strong>{{ produits.getTotalItemCount }}</strong> produit(s) trouvé(s)</span>
              {% if filters.categorie %}
                <span class="summary-tag"><i class="bi bi-tag-fill"></i> {{ filters.categorie }}</span>
              {% endif %}
              {% if filters.tri and filters.tri != 'recent' %}
                <span class="summary-tag"><i class="bi bi-sort-down-alt"></i>
                  {% if filters.tri == 'prix_asc' %}Prix ↑
                  {% elseif filters.tri == 'prix_desc' %}Prix ↓
                  {% elseif filters.tri == 'nom_az' %}A→Z
                  {% elseif filters.tri == 'nom_za' %}Z→A
                  {% elseif filters.tri == 'solde' %}Soldes
                  {% endif %}
                </span>
              {% endif %}
            </div>

            {# Product Grid #}
            <div class="product-grid">

              {% for produit in produits %}
                <div class="product-card">
                  <div class="product-card-img">
                    {% if produit.image %}
                      <img src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="{{ produit.nom }}">
                    {% else %}
                      <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);">
                        <i class="bi bi-flower1" style="font-size:4rem;color:#4a8c3f;opacity:0.5;"></i>
                      </div>
                    {% endif %}
                    {% if produit.remise > 0 %}
                      {% if produit.typeRemise == 'POURCENTAGE' %}
                        <span class="product-badge badge-promo">-{{ produit.remise|number_format(0) }}%</span>
                      {% else %}
                        <span class="product-badge badge-promo">-{{ produit.remise|number_format(2, '.', ' ') }} TND</span>
                      {% endif %}
                    {% endif %}

                    {# Indicateur de Stock #}
                    <div class="product-stock-status {{ produit.quantiteStock > 0 ? 'stock-in' : 'stock-out' }}">
                      {{ produit.quantiteStock > 0 ? 'En stock (' ~ produit.quantiteStock ~ ')' : 'Rupture' }}
                    </div>
                  </div>
                  <div class="product-card-body">
                    {% if produit.categorie %}
                      <div class="product-card-category" style="display: flex; justify-content: space-between; align-items: center;">
                        <span>{{ produit.categorie }}</span>
                        <div style="display:flex; align-items:center; gap:10px;">
                          {# Bouton Favoris #}
                          {% if app.user %}
                            {% set isFav = produit.id in favIds %}
                            <button class="fav-icon-btn {{ isFav ? 'active' : '' }}"
                                    onclick="toggleWishlist({{ produit.id }}, this)"
                                    title="{{ isFav ? 'Retirer des favoris' : 'Ajouter aux favoris' }}"
                                    style="background:none; border:none; padding:0; cursor:pointer; font-size:1.1rem; line-height:1; transition:0.2s;">
                              <i class="bi bi-heart" style="{{ isFav ? 'display:none;' : '' }}"></i>
                              <i class="bi bi-heart-fill" style="{{ isFav ? 'display:block;' : 'display:none;' }} color:#e17055;"></i>
                            </button>
                          {% endif %}

                          {% if app.user and produit.user.id != app.user.id %}
                              <a href="{{ path('app_marketplace_reclamations', {'produit_id': produit.id}) }}" title="Signaler ce produit" style="color: #cbd5e1; transition: color 0.2s; font-size: 12px;">
                                  <i class="bi bi-flag-fill"></i>
                              </a>
                          {% endif %}
                        </div>
                      </div>
                    {% else %}
                      {% if app.user and produit.user.id != app.user.id %}
                          <div style="text-align: right; margin-bottom: 8px;">
                            <a href="{{ path('app_marketplace_reclamations', {'produit_id': produit.id}) }}" title="Signaler ce produit" style="color: #cbd5e1; transition: color 0.2s; font-size: 12px; margin-right: 5px;">
                                <i class="bi bi-flag-fill"></i>
                            </a>
                          </div>
                      {% endif %}
                    {% endif %}
                    <h3 class="product-card-title">{{ produit.nom }}</h3>
                    <div class="product-rating-inline" role="button" tabindex="0" onclick="openReviewsModal({{ produit.id }}, '{{ produit.nom|e('js') }}')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openReviewsModal({{ produit.id }}, '{{ produit.nom|e('js') }}');}">
                      <div class="stars" aria-label="Note moyenne {{ produit.averageRating|number_format(1, '.', ' ') }} sur 5">
                        {% for i in 1..5 %}
                          {% if produit.averageRating >= i %}
                            <i class="bi bi-star-fill"></i>
                          {% elseif produit.averageRating >= (i - 0.5) %}
                            <i class="bi bi-star-half"></i>
                          {% else %}
                            <i class="bi bi-star"></i>
                          {% endif %}
                        {% endfor %}
                      </div>
                      <span class="rating-value">{{ produit.averageRating|number_format(1, '.', ' ') }}</span>
                      <span class="reviews-count">({{ produit.reviewsCount }} avis)</span>
                    </div>
                    <div class="product-card-seller">
                      <i class="bi bi-person-circle"></i> Vendu par <strong>{{ produit.user.prenom ?? '' }} {{ produit.user.nom ?? '' }}</strong>
                    </div>
                    <p class="product-card-description">
                      {% if produit.description %}
                        {{ produit.description|length > 80 ? produit.description|slice(0, 80) ~ '...' : produit.description }}
                      {% endif %}
                    </p>
                    <div class="product-card-footer">
                      <div class="product-price" data-base-price="{{ produit.prixFinal }}" data-original-price="{{ produit.prix }}">
                        {% if produit.remise > 0 %}
                          <small class="old-price" style="text-decoration:line-through;color:#b2bec3;"><span class="old-price-value">{{ produit.prix|number_format(2, '.', ' ') }}</span> <span class="currency-label">TND</span></small>
                          <span class="discount-badge" style="font-size:11px;color:#e17055;font-weight:600;">
                            {% if produit.typeRemise == 'POURCENTAGE' %}
                              (-{{ produit.remise|number_format(0) }}%)
                            {% else %}
                              (-<span class="discount-value">{{ produit.remise|number_format(2, '.', ' ') }}</span> <span class="currency-label">TND</span>)
                            {% endif %}
                          </span><br>
                          <span class="current-price-value">{{ produit.prixFinal|number_format(2, '.', ' ') }}</span>
                        {% else %}
                          <span class="current-price-value">{{ produit.prix|number_format(2, '.', ' ') }}</span>
                        {% endif %}
                        <span class="currency-label">TND</span><small>/{{ produit.uniteMesure }}</small>
                      </div>
                      <a href="{{ path('app_marketplace_produit_show', {id: produit.id}) }}" class="product-btn"><i class="bi bi-eye"></i> Détails</a>
                    </div>

                    {# Actions Panier #}
                    <div class="product-card-actions">
                      <form action="{{ path('app_marketplace_panier_add', {id: produit.id}) }}" method="POST" class="product-cart-controls" novalidate>
                        <input type="number" name="quantite" class="product-qty-input" value="1" min="1" max="{{ produit.quantiteStock }}"
                               {{ produit.quantiteStock <= 0 ? 'disabled' : '' }}>
                        <button type="submit" class="product-btn-cart {{ produit.quantiteStock <= 0 ? 'disabled' : '' }}"
                                {{ produit.quantiteStock <= 0 ? 'disabled' : '' }}>
                          <i class="bi bi-cart-plus"></i> Ajouter
                        </button>
                      </form>
                      <button
                        type="button"
                        class="product-btn-cart compare-toggle-btn"
                        data-product-id="{{ produit.id }}"
                        onclick="toggleCompareSelection({{ produit.id }}, this)"
                      >
                        <i class="bi bi-columns-gap"></i> Comparer
                      </button>
                    </div>
                  </div>
                </div>
              {% else %}
                <div class="cat-empty-state">
                  <div class="cat-empty-icon">
                    <i class="bi bi-search"></i>
                  </div>
                  <h3>Aucun produit trouvé</h3>
                  <p>Essayez de modifier vos critères de recherche ou de réinitialiser les filtres.</p>
                  <a href="{{ path('app_marketplace_catalogue') }}" class="btn-filter-apply" style="display:inline-flex; width:auto; margin-top:8px;">
                    <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser
                  </a>
                </div>
              {% endfor %}

            </div>{# end .product-grid #}

