  padding: 10px 14px;
  font-weight: 700;
  cursor: pointer;
}
.review-submit-btn:disabled { opacity: 0.7; cursor: not-allowed; }

.review-login-hint {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding-top: 14px;
  color: #d0d8ea;
  font-size: 14px;
}

.market-chatbot {
  position: fixed;
  right: 22px;
  bottom: 22px;
  z-index: 1900;
}

.market-chatbot-toggle {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  border: none;
  background: linear-gradient(135deg, #1f9d55 0%, #0f6f4a 100%);
