});

if (marketChatbotForm && marketChatbotInput) {
  marketChatbotForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    await window.marketplaceSendNow();
  });

  marketChatbotInput.addEventListener('keydown', (event) => {
    if (marketChatbotHistory.length === 0) return;

    if (event.key === 'ArrowUp') {
      event.preventDefault(); // Empêcher le curseur d'aller au début du texte
      if (marketChatbotHistoryIndex === -1) {
        marketChatbotTempInput = marketChatbotInput.value;
      }
      if (marketChatbotHistoryIndex < marketChatbotHistory.length - 1) {
        marketChatbotHistoryIndex++;
        marketChatbotInput.value = marketChatbotHistory[marketChatbotHistoryIndex];
      }
    } else if (event.key === 'ArrowDown') {
      event.preventDefault(); // Empêcher le curseur d'aller à la fin du texte
      if (marketChatbotHistoryIndex > 0) {
        marketChatbotHistoryIndex--;
        marketChatbotInput.value = marketChatbotHistory[marketChatbotHistoryIndex];
      } else if (marketChatbotHistoryIndex === 0) {
        marketChatbotHistoryIndex = -1;
        marketChatbotInput.value = marketChatbotTempInput;
      }
    }
  });
}

if (marketChatbotSend) {
