{% extends 'base.html.twig' %}

{% block title %}Ardhi - Catalogue{% endblock %}

{% block body_class %}marketplace-page{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/marketplace/marketplace.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}

    {# ============================
       PAGE HEADER
       ============================ #}
    <section class="marketplace-hero" style="min-height: 40vh;">
      <div class="hero-bg">
        <img src="{{ asset('assets/img/hero_1.jpg') }}" alt="Catalogue Ardhi">
      </div>
      <div class="container">
        <div class="hero-inner" style="padding: 30px 0;">
          <div class="hero-left" style="max-width: 100%; text-align: center; position: relative;">
            

            <div class="hero-label">ARDHI MARKETPLACE</div>
            <h1 class="hero-headline">Catalogue<br>des produits</h1>
            <p class="hero-description" style="margin-left: auto; margin-right: auto;">
              Parcourez tous les produits disponibles sur le marché agricole.
            </p>
            <a href="{{ path('app_marketplace') }}" class="hero-btn-primary">
              <i class="bi bi-arrow-left"></i> Retour au Marketplace
            </a>
          </div>
        </div>
      </div>
    </section>

    {# ============================
       CATALOGUE PRODUCTS
       ============================ #}
    <section id="catalogue-products" class="marketplace-section">
      <div class="container">

        {# Section Header #}
        <div class="marketplace-section-header">
          <h2>Tous les produits</h2>
          <p>Découvrez les offres des autres agriculteurs</p>
        </div>
{# Search & Filter Bar + Cart #}
<div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap; margin-bottom:20px;">

  <div class="marketplace-filters" style="flex:1; margin-bottom:0;">
    <div class="filter-search">
      <i class="bi bi-search"></i>
      <input type="text" placeholder="Rechercher un produit...">
    </div>
    <div class="filter-select">
      <select>
        <option value="">Catégorie</option>
        <option value="semences">Semences</option>
        <option value="equipement">Équipement</option>
        <option value="engrais">Engrais</option>
        <option value="betail">Bétail</option>
        <option value="services">Services</option>
      </select>
    </div>
    <div class="filter-select">
      <select>
        <option value="">Prix</option>
        <option value="asc">Prix croissant</option>
        <option value="desc">Prix décroissant</option>
      </select>
    </div>
    <button class="filter-btn">
      <i class="bi bi-funnel"></i> Filtrer
    </button>
  </div>
    <a href="{{ path('app_marketplace_panier') }}" class="cart-indicator" style="flex-shrink:0;">
    <div class="cart-icon-wrapper">
      <i class="bi bi-cart3"></i>
      <span class="cart-badge">{{ panier ? panier.totalProduits : 0 }}</span>
    </div>
    <div class="cart-info">
      <span>{{ panier ? panier.totalProduits : 0 }} article(s)</span>
      <strong>{{ panier ? panier.totalMontant|number_format(2, '.', ' ') : '0.00' }} DT</strong>
    </div>
  </a>

</div>
       
        {# Product Grid — Dynamic (exclut les produits du user connecté) #}
        <div class="product-grid">

          {% for produit in produits %}
            <div class="product-card">
              <div class="product-card-img">
                {% if produit.image %}
                  <img src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="{{ produit.nom }}">
                {% else %}
                  <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#e8f5e9,#f1f8e9);">
                    <i class="bi bi-flower1" style="font-size:4rem;color:#4a8c3f;opacity:0.5;"></i>
                  </div>
                {% endif %}
                {% if produit.remise > 0 %}
                  {% if produit.typeRemise == 'POURCENTAGE' %}
                    <span class="product-badge badge-promo">-{{ produit.remise|number_format(0) }}%</span>
                  {% else %}
                    <span class="product-badge badge-promo">-{{ produit.remise|number_format(2, '.', ' ') }} TND</span>
                  {% endif %}
                {% endif %}

                {# Indicateur de Stock #}
                <div class="product-stock-status {{ produit.quantiteStock > 0 ? 'stock-in' : 'stock-out' }}">
                  {{ produit.quantiteStock > 0 ? 'En stock (' ~ produit.quantiteStock ~ ')' : 'Rupture' }}
                </div>

                {# Indicateur de Stock #}
                <div class="product-stock-status {{ produit.quantiteStock > 0 ? 'stock-in' : 'stock-out' }}">
                  {{ produit.quantiteStock > 0 ? 'En stock (' ~ produit.quantiteStock ~ ')' : 'Rupture' }}
                </div>
              </div>
              <div class="product-card-body">
                {% if produit.categorie %}
                  <div class="product-card-category" style="display: flex; justify-content: space-between; align-items: center;">
                    <span>{{ produit.categorie }}</span>
                    <div style="display:flex; align-items:center; gap:10px;">
                      {# Bouton Favoris #}
                      {% if app.user %}
                        {% set isFav = produit.id in favIds %}
                        <button class="fav-icon-btn {{ isFav ? 'active' : '' }}" 
                                onclick="toggleWishlist({{ produit.id }}, this)" 
                                title="{{ isFav ? 'Retirer des favoris' : 'Ajouter aux favoris' }}"
                                style="background:none; border:none; padding:0; cursor:pointer; font-size:1.1rem; line-height:1; transition:0.2s;">
                          <i class="bi bi-heart" style="{{ isFav ? 'display:none;' : '' }}"></i>
                          <i class="bi bi-heart-fill" style="{{ isFav ? 'display:block;' : 'display:none;' }} color:#e17055;"></i>
                        </button>
                      {% endif %}
                      
                      {% if app.user and produit.user.id != app.user.id %}
                          <a href="{{ path('app_marketplace_reclamations', {'produit_id': produit.id}) }}" title="Signaler ce produit" style="color: #cbd5e1; transition: color 0.2s; font-size: 12px;">
                              <i class="bi bi-flag-fill"></i>
                          </a>
                      {% endif %}
                    </div>
                  </div>
                {% else %}
                  {% if app.user and produit.user.id != app.user.id %}
                      <div style="text-align: right; margin-bottom: 8px;">
                        <a href="{{ path('app_marketplace_reclamations', {'produit_id': produit.id}) }}" title="Signaler ce produit" style="color: #cbd5e1; transition: color 0.2s; font-size: 12px; margin-right: 5px;">
                            <i class="bi bi-flag-fill"></i>
                        </a>
                      </div>
                  {% endif %}
                {% endif %}
                <h3 class="product-card-title">{{ produit.nom }}</h3>
                <div class="product-card-seller">
                  <i class="bi bi-person-circle"></i> Vendu par <strong>{{ produit.user.prenom ?? '' }} {{ produit.user.nom ?? '' }}</strong>
                </div>
                <p class="product-card-description">
                  {% if produit.description %}
                    {{ produit.description|length > 80 ? produit.description|slice(0, 80) ~ '...' : produit.description }}
                  {% endif %}
                </p>
                <div class="product-card-footer">
                  <div class="product-price">
                    {% if produit.remise > 0 %}
                      <small style="text-decoration:line-through;color:#b2bec3;">{{ produit.prix|number_format(2, '.', ' ') }} TND</small>
                      <span style="font-size:11px;color:#e17055;font-weight:600;">
                        {% if produit.typeRemise == 'POURCENTAGE' %}
                          (-{{ produit.remise|number_format(0) }}%)
                        {% else %}
                          (-{{ produit.remise|number_format(2, '.', ' ') }} TND)
                        {% endif %}
                      </span><br>
                      {{ produit.prixFinal|number_format(2, '.', ' ') }}
                    {% else %}
                      {{ produit.prix|number_format(2, '.', ' ') }}
                    {% endif %}
                    <small>TND/{{ produit.uniteMesure }}</small>
                  </div>
                  <a href="{{ path('app_marketplace_produit_show', {id: produit.id}) }}" class="product-btn"><i class="bi bi-eye"></i> Détails</a>
                </div>

                {# Actions Panier #}
                <div class="product-card-actions">
                  <form action="{{ path('app_marketplace_panier_add', {id: produit.id}) }}" method="POST" class="product-cart-controls">
                    <input type="number" name="quantite" class="product-qty-input" value="1" min="1" max="{{ produit.quantiteStock }}" 
                           {{ produit.quantiteStock <= 0 ? 'disabled' : '' }}>
                    <button type="submit" class="product-btn-cart {{ produit.quantiteStock <= 0 ? 'disabled' : '' }}" 
                            {{ produit.quantiteStock <= 0 ? 'disabled' : '' }}>
                      <i class="bi bi-cart-plus"></i> Ajouter
                    </button>
                  </form>
                </div>
              </div>
            </div>
          {% else %}
            <div class="text-center w-100 py-5">
              <i class="bi bi-basket" style="font-size:3rem;color:#b2bec3;"></i>
              <p style="color:#636e72;margin-top:12px;">Aucun produit disponible pour le moment.</p>
            </div>
          {% endfor %}

        </div>

      </div>
    </section>
{% block javascripts %}
<script>
// ── Toast ──────────────────────────────────────────────────────────
function showToast(message, isError = false) {
    const toast = document.createElement('div');
    toast.className = 'mp-toast' + (isError ? ' error' : '');
    toast.innerHTML = `
        <div class="mp-toast-icon">
            <i class="bi bi-${isError ? 'x-circle-fill' : 'cart-check-fill'}"></i>
        </div>
        <div class="mp-toast-body">
            <strong>${isError ? 'Erreur' : 'Panier mis à jour'}</strong>
            <span>${message}</span>
        </div>
        <button class="mp-toast-close" onclick="dismissToast(this.parentElement)">
            <i class="bi bi-x-lg"></i>
        </button>
    `;
    document.body.appendChild(toast);

    // Auto-dismiss après 3s
    setTimeout(() => dismissToast(toast), 3000);
}

function dismissToast(toast) {
    if (!toast || toast.classList.contains('hiding')) return;
    toast.classList.add('hiding');
    toast.addEventListener('animationend', () => toast.remove(), { once: true });
}

// ── AJAX Add to Cart ───────────────────────────────────────────────
document.querySelectorAll('form.product-cart-controls').forEach(form => {
    form.addEventListener('submit', async function(e) {
        e.preventDefault();

        const btn = form.querySelector('.product-btn-cart');
        if (btn.disabled) return;

        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-arrow-repeat" style="animation:spin 0.6s linear infinite"></i>';
        btn.disabled = true;

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(form),
            });

            const data = await response.json();

            if (data.success) {
                // Mettre à jour le badge et le montant
                document.querySelectorAll('.cart-badge').forEach(el => el.textContent = data.cartCount);
                document.querySelectorAll('.cart-info span').forEach(el => el.textContent = data.cartCount + ' article(s)');
                document.querySelectorAll('.cart-info strong').forEach(el => el.textContent = data.cartTotal + ' DT');

                showToast(data.message);

                // Petite animation sur l'icône panier
                const cartIcon = document.querySelector('.cart-icon-wrapper');
                if (cartIcon) {
                    cartIcon.style.transform = 'scale(1.3)';
                    setTimeout(() => cartIcon.style.transform = 'scale(1)', 300);
                }
            } else {
                showToast(data.message, true);
            }
        } catch (err) {
            showToast('Une erreur est survenue.', true);
        } finally {
            btn.innerHTML = originalHtml;
            btn.disabled = false;
        }
    });
});

// ── AJAX Toggle Wishlist ───────────────────────────────────────────
async function toggleWishlist(productId, btn) {
    if (btn.disabled) return;
    btn.disabled = true;

    try {
        const response = await fetch(`/marketplace/favoris/toggle/${productId}`, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });

        const data = await response.json();

        if (data.success) {
            if (data.isFavorite) {
                btn.classList.add('active');
                btn.title = "Retirer des favoris";
                if(btn.querySelector('.bi-heart')) btn.querySelector('.bi-heart').style.display = 'none';
                if(btn.querySelector('.bi-heart-fill')) btn.querySelector('.bi-heart-fill').style.display = 'block';
            } else {
                btn.classList.remove('active');
                btn.title = "Ajouter aux favoris";
                if(btn.querySelector('.bi-heart')) btn.querySelector('.bi-heart').style.display = 'block';
                if(btn.querySelector('.bi-heart-fill')) btn.querySelector('.bi-heart-fill').style.display = 'none';
            }
            showToast(data.message);
        } else {
            showToast(data.message || 'Une erreur est survenue.', true);
        }
    } catch (err) {
        showToast('Erreur de connexion.', true);
    } finally {
        btn.disabled = false;
    }
}
</script>

<style>
@keyframes spin { to { transform: rotate(360deg); } }
</style>
{% endblock %}
{% endblock %}
