{% extends 'base.html.twig' %}

{% block title %}Ardhi - Comparaison produits{% endblock %}

{% block body_class %}marketplace-page{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/marketplace/marketplace.css') }}?v={{ date().timestamp }}" rel="stylesheet">
{% endblock %}

{% block body %}
<section class="mp-header">
    <div class="container">
        <div class="mp-header-inner">
            <div class="mp-header-left">
                <h1 class="mp-header-title">
                    <i class="bi bi-columns-gap"></i>
                    {% if produitX and produitY and not error %}
                        {{ produitX.nom }} vs {{ produitY.nom }}
                    {% else %}
                        Comparateur de produits
                    {% endif %}
                </h1>
            </div>
            <div class="mp-header-right">
                <a href="{{ path('app_marketplace_catalogue') }}" class="mp-btn-back" title="Retour au catalogue">
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="marketplace-section compare-section">
    <div class="container compare-container">
        {% if error %}
            <div class="compare-alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>{{ error }}</span>
            </div>
        {% endif %}

        {% if produitX and produitY and not error %}
            <div class="compare-head-cards">
                <article class="compare-product-card">
                    <div class="compare-media">
                        {% if produitX.image %}
                            <img src="{{ product_image_url(produitX.image) }}" alt="{{ produitX.nom }}">
                        {% else %}
                            <div class="compare-placeholder"><i class="bi bi-flower1"></i></div>
                        {% endif %}
                    </div>
                    <h3>{{ produitX.nom }}</h3>
                    <p>{{ produitX.user.prenom ?? '' }} {{ produitX.user.nom ?? '' }}</p>
                    <a href="{{ path('app_marketplace_produit_show', {id: produitX.id}) }}" class="compare-btn">Voir {{ produitX.nom }}</a>
                </article>

                <div class="compare-versus">VS</div>

                <article class="compare-product-card">
                    <div class="compare-media">
                        {% if produitY.image %}
                            <img src="{{ product_image_url(produitY.image) }}" alt="{{ produitY.nom }}">
                        {% else %}
                            <div class="compare-placeholder"><i class="bi bi-flower1"></i></div>
                        {% endif %}
                    </div>
                    <h3>{{ produitY.nom }}</h3>
                    <p>{{ produitY.user.prenom ?? '' }} {{ produitY.user.nom ?? '' }}</p>
                    <a href="{{ path('app_marketplace_produit_show', {id: produitY.id}) }}" class="compare-btn">Voir {{ produitY.nom }}</a>
                </article>
            </div>

            <div class="compare-metrics-table-wrap">
                <table class="compare-metrics-table">
                    <thead>
                        <tr>
                            <th>Critere</th>
                            <th>{{ produitX.nom }}</th>
                            <th>{{ produitY.nom }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Prix final</td>
                            <td>
                                {{ produitX.prixFinal|number_format(2, '.', ' ') }} TND
                                {% if winners.price == 'x' %}<span class="metric-win"><i class="bi bi-trophy-fill"></i> Meilleur prix</span>{% endif %}
                            </td>
                            <td>
                                {{ produitY.prixFinal|number_format(2, '.', ' ') }} TND
                                {% if winners.price == 'y' %}<span class="metric-win"><i class="bi bi-trophy-fill"></i> Meilleur prix</span>{% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td>Stock disponible</td>
                            <td>
                                {{ produitX.quantiteStock }} unite(s)
                                {% if winners.stock == 'x' %}<span class="metric-win"><i class="bi bi-graph-up-arrow"></i> Stock +</span>{% endif %}
                            </td>
                            <td>
                                {{ produitY.quantiteStock }} unite(s)
                                {% if winners.stock == 'y' %}<span class="metric-win"><i class="bi bi-graph-up-arrow"></i> Stock +</span>{% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td>Categorie</td>
                            <td>{{ produitX.categorie ?: 'Non renseignee' }}</td>
                            <td>
                                {{ produitY.categorie ?: 'Non renseignee' }}
                                {% if winners.categoryMatch %}<span class="metric-info"><i class="bi bi-check2-circle"></i> Meme categorie</span>{% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td>Note moyenne</td>
                            <td>
                                {{ produitX.averageRating|number_format(1, '.', ' ') }} / 5
                                <small>({{ produitX.reviewsCount }} avis)</small>
                                {% if winners.rating == 'x' %}<span class="metric-win"><i class="bi bi-star-fill"></i> Mieux note</span>{% endif %}
                            </td>
                            <td>
                                {{ produitY.averageRating|number_format(1, '.', ' ') }} / 5
                                <small>({{ produitY.reviewsCount }} avis)</small>
                                {% if winners.rating == 'y' %}<span class="metric-win"><i class="bi bi-star-fill"></i> Mieux note</span>{% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td>Vendeur</td>
                            <td>{{ produitX.user.prenom ?? '' }} {{ produitX.user.nom ?? '' }}</td>
                            <td>{{ produitY.user.prenom ?? '' }} {{ produitY.user.nom ?? '' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="compare-empty-state">
                <div class="compare-empty-icon"><i class="bi bi-columns-gap"></i></div>
                <h3>Comparaison indisponible</h3>
                <p>Selectionnez 2 produits depuis le catalogue puis revenez sur cette page.</p>
                <a href="{{ path('app_marketplace_catalogue') }}" class="compare-btn compare-btn-inline">Choisir mes produits</a>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<style>
.compare-section {
    background: linear-gradient(180deg, #f8faf7 0%, #f3f7f1 100%);
    padding-top: 34px;
    padding-bottom: 50px;
}

.compare-container {
    max-width: 1150px;
}

.compare-alert {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff6e7;
    border: 1px solid #ffd899;
    color: #8a5a00;
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 20px;
}

.compare-head-cards {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 16px;
    margin-bottom: 18px;
    align-items: stretch;
}

.compare-product-card {
    background: #fff;
    border: 1px solid #e2ece0;
    border-radius: 16px;
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.06);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.compare-badge {
    display: inline-flex;
    width: fit-content;
    background: rgba(74, 140, 63, 0.12);
    color: #2d6a2f;
    border: 1px solid rgba(74, 140, 63, 0.25);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
}

.compare-media {
    width: 100%;
    height: 150px;
    border-radius: 12px;
    overflow: hidden;
    background: #f0f6ed;
}

.compare-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.compare-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6ea563;
    font-size: 42px;
}

.compare-product-card h3 {
    margin: 0;
    font-family: 'Marcellus', serif;
    font-size: 1.35rem;
    color: #1e2a21;
}

.compare-product-card p {
    margin: 0;
    color: #5a6d5d;
    font-size: 14px;
}

.compare-versus {
    align-self: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #4a8c3f, #3a7030);
    color: #fff;
    font-weight: 800;
    letter-spacing: 0.04em;
    box-shadow: 0 8px 20px rgba(74, 140, 63, 0.4);
}

.compare-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: #4a8c3f;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    border: 1px solid #3e7a35;
    padding: 9px 12px;
    transition: all 0.2s ease;
}

.compare-btn:hover {
    background: #3f7d36;
    color: #fff;
}

.compare-metrics-table-wrap {
    background: #fff;
    border: 1px solid #e2ece0;
    border-radius: 16px;
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.05);
    overflow: hidden;
}

.compare-metrics-table {
    width: 100%;
    border-collapse: collapse;
}

.compare-metrics-table th {
    background: #f0f7ed;
    color: #27432a;
    text-align: left;
    font-size: 14px;
    padding: 14px;
    border-bottom: 1px solid #e2ece0;
}

.compare-metrics-table td {
    padding: 14px;
    border-bottom: 1px solid #eef3ec;
    vertical-align: middle;
}

.compare-metrics-table tbody tr:last-child td {
    border-bottom: none;
}

.compare-metrics-table td:first-child {
    font-weight: 700;
    color: #1f3521;
    width: 26%;
}

.metric-win,
.metric-info {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: 10px;
    border-radius: 999px;
    padding: 3px 9px;
    font-size: 11px;
    font-weight: 700;
}

.metric-win {
    background: #e9f7ee;
    color: #187144;
    border: 1px solid #b5e2c5;
}

.metric-info {
    background: #e8f1ff;
    color: #1f5dbb;
    border: 1px solid #c7ddff;
}

.compare-empty-state {
    background: #fff;
    border: 1px dashed #b9d0b2;
    border-radius: 16px;
    padding: 34px 24px;
    text-align: center;
}

.compare-empty-icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    margin: 0 auto 10px;
    background: #edf7e9;
    color: #4a8c3f;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 34px;
}

.compare-empty-state h3 {
    margin: 6px 0;
    color: #213422;
    font-family: 'Marcellus', serif;
}

.compare-empty-state p {
    margin: 0 0 12px;
    color: #567058;
}

.compare-btn-inline {
    width: auto;
}

@media (max-width: 991px) {
    .compare-head-cards {
        grid-template-columns: 1fr;
    }

    .compare-versus {
        margin: 0 auto;
    }

    .compare-metrics-table-wrap {
        overflow-x: auto;
    }

    .compare-metrics-table {
        min-width: 760px;
    }
}
</style>
{% endblock %}
