{% extends 'base.html.twig' %}

{% block title %}Mes Statistiques - Marketplace Ardhi{% endblock %}

{% block body_class %}marketplace-page{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/marketplace/marketplace.css') }}" rel="stylesheet">
    <style>
        .stat-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            border: 1px solid rgba(255, 255, 255, 0.3);
            text-align: center;
            transition: all 0.3s;
        }
        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 15px 40px rgba(0,0,0,0.08); }
        .stat-icon { font-size: 2.5rem; margin-bottom: 0.5rem; display: block; }
        .stat-label { font-size: 0.85rem; font-weight: 600; text-transform: uppercase; color: #64748b; letter-spacing: 0.05em; }
        .stat-value { font-size: 1.8rem; font-weight: 800; color: #1e293b; margin: 0.5rem 0; }
        .chart-container {
            background: #fff;
            border-radius: 24px;
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            margin-top: 2rem;
            border: 1px solid #f1f5f9;
            height: 450px;
            position: relative;
        }
        .chart-title { font-weight: 700; color: #1e293b; margin-bottom: 2rem; display: flex; align-items: center; gap: 10px; }
        .section-header { margin-bottom: 2.5rem; text-align: center; }
        .section-header h2 { font-weight: 800; color: #116530; letter-spacing: -0.02em; }
    </style>
{% endblock %}

{% block body %}
    {# Header sombre pour la visibilité de la navbar #}
    <section class="marketplace-hero" style="min-height: 250px; padding-top: 120px; background: linear-gradient(135deg, #116530 0%, #1a8a44 100%);">
        <div class="container text-center">
            <h1 class="text-white fw-bold mb-2">Tableau de Bord Statistiques</h1>
            <p class="text-white-50">Analysez vos performances de vente et d'achat en temps réel.</p>
            
            <nav aria-label="breadcrumb" class="d-inline-block mt-3">
                <ol class="breadcrumb mb-0" style="background:transparent; padding:0;">
                    <li class="breadcrumb-item"><a href="{{ path('app_marketplace') }}" class="text-white-50 text-decoration-none">Marketplace</a></li>
                    <li class="breadcrumb-item active text-white fw-bold" aria-current="page">Statistiques</li>
                </ol>
            </nav>
        </div>
    </section>

    <div class="container py-5">

        {# KPIs Section #}
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="stat-card">
                    <span class="stat-icon text-success"><i class="bi bi-cash-stack"></i></span>
                    <span class="stat-label">Total Ventes</span>
                    <div class="stat-value">{{ sellerStats.totalGagne|number_format(2, ',', ' ') }} <small style="font-size: 0.8rem;">DT</small></div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <span class="stat-icon text-primary"><i class="bi bi-cart-check-fill"></i></span>
                    <span class="stat-label">Commandes Reçues</span>
                    <div class="stat-value">{{ sellerStats.nbCommandes }}</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <span class="stat-icon text-danger"><i class="bi bi-wallet2"></i></span>
                    <span class="stat-label">Total Dépensé</span>
                    <div class="stat-value">{{ buyerStats.totalDepense|number_format(2, ',', ' ') }} <small style="font-size: 0.8rem;">DT</small></div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <span class="stat-icon text-info"><i class="bi bi-bag-check-fill"></i></span>
                    <span class="stat-label">Mes Commandes</span>
                    <div class="stat-value">{{ buyerStats.nbCommandes }}</div>
                </div>
            </div>
        </div>

        <div class="row">
            {# Courbe Évolution #}
            <div class="col-lg-8">
                <div class="chart-container">
                    <h5 class="chart-title"><i class="bi bi-graph-up text-success"></i> Évolution Achats vs Ventes</h5>
                    <canvas id="evolutionChart" height="320"></canvas>
                </div>
            </div>

            {# Répartition par Produit #}
            <div class="col-lg-4">
                <div class="chart-container">
                    <h5 class="chart-title"><i class="bi bi-pie-chart-fill text-warning"></i> Top 5 Produits vendus</h5>
                    <canvas id="productChart" height="320"></canvas>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // 1. Chart Évolution (Achats vs Ventes)
        const evolutionCtx = document.getElementById('evolutionChart');
        if (evolutionCtx) {
            new Chart(evolutionCtx, {
                type: 'line',
                data: {
                    labels: {{ chartLabels|json_encode|raw }},
                    datasets: [
                        {
                            label: 'Ventes (Commandes reçues)',
                            data: {{ salesChartData|json_encode|raw }},
                            borderColor: '#116530',
                            backgroundColor: 'rgba(17, 101, 48, 0.1)',
                            fill: true,
                            tension: 0.4,
                            borderWidth: 3,
                            pointBackgroundColor: '#116530'
                        },
                        {
                            label: 'Achats (Mes commandes)',
                            data: {{ purchaseChartData|json_encode|raw }},
                            borderColor: '#dc3545',
                            backgroundColor: 'rgba(220, 53, 69, 0.05)',
                            fill: true,
                            tension: 0.4,
                            borderWidth: 3,
                            pointBackgroundColor: '#dc3545'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { font: { family: 'Inter', weight: '600' } } }
                    },
                    scales: {
                        y: { 
                            beginAtZero: true, 
                            grid: { color: '#f1f5f9' }, 
                            suggestedMax: 100,
                            ticks: { 
                                callback: v => v + ' DT'
                            } 
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        // 2. Chart Répartition par Produit
        const productCtx = document.getElementById('productChart');
        if (productCtx) {
            new Chart(productCtx, {
                type: 'doughnut',
                data: {
                    labels: {{ productLabels|json_encode|raw }},
                    datasets: [{
                        data: {{ productValues|json_encode|raw }},
                        backgroundColor: ['#116530', '#1a8a44', '#2ec165', '#9ae6b4', '#c6f6d5'],
                        borderWidth: 0,
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }
    });
    </script>
{% endblock %}
