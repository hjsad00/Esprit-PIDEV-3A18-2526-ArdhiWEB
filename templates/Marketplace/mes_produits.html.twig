{% extends 'base.html.twig' %}

{% block title %}Ardhi - Gestion des Produits{% endblock %}

{% block body_class %}marketplace-page{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/marketplace/marketplace.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}

    {# ============================
       TOP HEADER BAR
       ============================ #}
    <section class="mp-header">
      <div class="container">
        <div class="mp-header-inner">
          <div class="mp-header-left">
          
            <h1 class="mp-header-title">
              <i class="bi bi-shop-window"></i> Gestion des Produits
            </h1>
          </div>
          <div class="mp-header-right">
            <button type="button" class="mp-btn-add" onclick="toggleForm()">
              <i class="bi bi-plus-lg"></i> Ajouter un produit
            </button>
       <a href="{{ path('app_marketplace') }}" class="mp-btn-back">
    <i class="bi bi-arrow-left"></i>
</a>
          </div>
        </div>
      </div>
    </section>

    {# ============================
       INFO BANNER
       ============================ #}
    <section class="mp-info-banner">
      <div class="container">
        <div class="mp-info-inner">
          <span class="mp-info-text">
            <i class="bi bi-hand-index-thumb"></i> Cliquez sur un produit pour le modifier
          </span>
          <span class="mp-info-count">
            <i class="bi bi-check-circle-fill"></i> Produits ajoutés/créés : <strong>{{ produits|length }}</strong>
          </span>
        </div>
      </div>
    </section>

    {# ============================
       SEARCH & FILTERS
       ============================ #}
    <section class="mp-filters-section">
      <div class="container">
        <div class="mp-filters-bar">
          <div class="mp-filters-toggle" onclick="document.querySelector('.mp-filters-fields').classList.toggle('open')">
            <i class="bi bi-search"></i> Recherche & Filtres
          </div>
          <a href="{{ path('app_marketplace_mes_produits') }}" class="mp-filters-reset">Réinitialiser</a>
        </div>
        <div class="mp-filters-fields open">
          <div class="mp-filter-group">
            <label>ID</label>
            <input type="text" id="filter-id" placeholder="Ex: 12" oninput="filterTable()">
          </div>
          <div class="mp-filter-group">
            <label>NOM</label>
            <input type="text" id="filter-nom" placeholder="Nom du produit..." oninput="filterTable()">
          </div>
          <div class="mp-filter-group">
            <label>CATÉGORIE</label>
            <input type="text" id="filter-cat" placeholder="Catégorie..." oninput="filterTable()">
          </div>
        </div>
      </div>
    </section>

    {# ============================
       PRODUCT TABLE
       ============================ #}
    <section class="mp-table-section">
      <div class="container">
        <div class="mp-table-wrapper">
          <table class="mp-table" id="produits-table">
            <thead>
              <tr>
                <th>Image</th>
                <th>ID</th>
                <th>Nom</th>
                <th>Catégorie</th>
                <th>Prix (DT)</th>
                <th>Stock</th>
                <th>Remise</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for produit in produits %}
                <tr class="mp-table-row" onclick="editProduit(this)" style="cursor:pointer;"
                    data-id="{{ produit.id }}"
                    data-nom="{{ produit.nom }}"
                    data-description="{{ produit.description }}"
                    data-prix="{{ produit.prix }}"
                    data-stock="{{ produit.quantiteStock }}"
                    data-categorie="{{ produit.categorie }}"
                    data-unite="{{ produit.uniteMesure }}"
                    data-remise="{{ produit.remise }}"
                    data-type-remise="{{ produit.typeRemise }}"
                    data-image="{{ produit.image }}">
                  <td>
                    <div class="mp-table-img">
                      {% if produit.image %}
                        <img src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="{{ produit.nom }}">
                      {% else %}
                        <div class="mp-table-img-placeholder">
                          <i class="bi bi-image"></i>
                        </div>
                      {% endif %}
                    </div>
                  </td>
                  <td><span class="mp-table-id">#{{ produit.id }}</span></td>
                  <td><strong>{{ produit.nom }}</strong></td>
                  <td>
                    {% if produit.categorie %}
                      <span class="mp-table-badge">{{ produit.categorie }}</span>
                    {% else %}
                      <span style="color:#b2bec3;">—</span>
                    {% endif %}
                  </td>
                  <td>
                    {% if produit.remise > 0 %}
                      <span style="text-decoration:line-through;color:#b2bec3;font-size:12px;">{{ produit.prix|number_format(2, '.', ' ') }}</span><br>
                      <strong style="color:#4a8c3f;">{{ produit.prixFinal|number_format(2, '.', ' ') }}</strong>
                    {% else %}
                      <strong>{{ produit.prix|number_format(2, '.', ' ') }}</strong>
                    {% endif %}
                    <small style="color:#b2bec3;"> /{{ produit.uniteMesure }}</small>
                  </td>
                  <td>
                    <span class="mp-table-stock {{ produit.quantiteStock > 0 ? 'in-stock' : 'out-stock' }}">
                      {{ produit.quantiteStock }}
                    </span>
                  </td>
                  <td>
                    {% if produit.remise > 0 %}
                      {% if produit.typeRemise == 'POURCENTAGE' %}
                        <span class="mp-table-remise">-{{ produit.remise|number_format(0) }}%</span>
                      {% else %}
                        <span class="mp-table-remise">-{{ produit.remise|number_format(2, '.', ' ') }} DT</span>
                      {% endif %}
                    {% else %}
                      <span style="color:#b2bec3;">—</span>
                    {% endif %}
                  </td>
                  <td onclick="event.stopPropagation();">
                    <div class="mp-table-actions">
                      <button type="button" class="mp-action-edit" title="Modifier" onclick="editProduit(this.closest('tr'))">
                        <i class="bi bi-pencil-square"></i>
                      </button>
                      <form action="{{ path('app_marketplace_produit_delete', {id: produit.id}) }}" method="POST" style="display:inline;" onsubmit="return confirm('Supprimer ce produit ?');">
                        <button type="submit" class="mp-action-delete" title="Supprimer">
                          <i class="bi bi-trash3"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="8" style="text-align:center;padding:40px;color:#b2bec3;">
                    <i class="bi bi-inbox" style="font-size:2.5rem;display:block;margin-bottom:10px;"></i>
                    Aucun produit. Cliquez sur "Ajouter un produit" pour commencer.
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {# ============================
       ADD / EDIT FORM PANEL
       ============================ #}
    <section class="mp-form-section" id="form-section" style="display:none;">
      <div class="container">
        <div class="mp-form-card">

          <div class="mp-form-header">
            <h2 id="form-title"><i class="bi bi-plus-square"></i> Ajouter un nouveau produit</h2>
            <button type="button" class="mp-form-close" onclick="toggleForm()">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>

          <form action="{{ path('app_marketplace_produit_save') }}" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="id" id="form-id" value="">

            <div class="mp-form-grid">
              {# LEFT COLUMN #}
              <div class="mp-form-left">

                <div class="mp-form-group">
                  <label>NOM DU PRODUIT *</label>
                  <input type="text" name="nom" id="form-nom" placeholder="Ex: Engrais organique" required>
                </div>

                <div class="mp-form-group">
                  <label>DESCRIPTION</label>
                  <textarea name="description" id="form-description" rows="4" placeholder="Description détaillée..."></textarea>
                </div>

                <div class="mp-form-row">
                  <div class="mp-form-group">
                    <label>PRIX (DT) *</label>
                    <input type="number" step="0.01" name="prix" id="form-prix" placeholder="29.99" required>
                    <small><i class="bi bi-info-circle"></i> En Dinar Tunisien (DT)</small>
                  </div>
                  <div class="mp-form-group">
                    <label>STOCK *</label>
                    <input type="number" name="quantiteStock" id="form-stock" placeholder="100" required>
                  </div>
                </div>

                <div class="mp-form-group">
                  <label>UNITÉ DE MESURE *</label>
                  <select name="uniteMesure" id="form-unite" required>
                    <option value="Kg">Kg</option>
                    <option value="L">L</option>
                    <option value="Piece">Pièce</option>
                  </select>
                </div>

              </div>

              {# RIGHT COLUMN #}
              <div class="mp-form-right">

                <div class="mp-form-group">
                  <label>CATÉGORIE *</label>
                  <select name="categorie" id="form-categorie" required>
                    <option value="">— Choisir une catégorie —</option>
                    {% for cat in categories %}
                      <option value="{{ cat }}">{{ cat }}</option>
                    {% endfor %}
                  </select>
                  <div class="mp-form-newcat" style="margin-top:8px;">
                    <small style="color:#636e72;">Ou ajouter une nouvelle :</small>
                    <input type="text" id="new-categorie" placeholder="Nouvelle catégorie..." style="margin-top:4px;">
                    <button type="button" class="mp-btn-newcat" onclick="addNewCategory()">
                      <i class="bi bi-plus"></i> Ajouter
                    </button>
                  </div>
                </div>

                <div class="mp-form-group">
                  <label>REMISE / SOLDE</label>
                  <select name="typeRemise" id="form-type-remise" onchange="toggleRemiseField()">
                    <option value="AUCUNE">Aucune remise</option>
                    <option value="POURCENTAGE">Pourcentage (%)</option>
                    <option value="FIXE">Montant fixe (DT)</option>
                  </select>
                </div>

                <div class="mp-form-group" id="remise-value-group" style="display:none;">
                  <label>VALEUR DE LA REMISE *</label>
                  <input type="number" step="0.01" name="remise" id="form-remise" placeholder="0">
                </div>

                <div class="mp-form-group">
                  <label>IMAGE DU PRODUIT</label>
                  <div class="mp-form-upload" id="upload-area">
                    <div class="mp-form-upload-preview" id="upload-preview">
                      <i class="bi bi-cloud-arrow-up"></i>
                      <span>Glissez ou cliquez pour choisir</span>
                    </div>
                    <input type="file" name="image" id="form-image" accept="image/*" onchange="previewImage(this)">
                  </div>
                  <button type="button" class="mp-btn-upload" onclick="document.getElementById('form-image').click()">
                    <i class="bi bi-camera"></i> Choisir une image
                  </button>
                </div>

              </div>
            </div>

            <div class="mp-form-submit">
              <button type="submit" class="mp-btn-submit" id="form-submit-btn">
                <i class="bi bi-plus-lg"></i> Ajouter le produit
              </button>
            </div>

          </form>
        </div>
      </div>
    </section>

{% endblock %}

{% block javascripts %}
<script>
  // ==================== TOGGLE FORM ====================
  function toggleForm(reset = true) {
    const section = document.getElementById('form-section');
    const isHidden = section.style.display === 'none';
    section.style.display = isHidden ? 'block' : 'none';

    if (isHidden && reset) {
      resetForm();
    }

    if (isHidden) {
      setTimeout(() => {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);
    }
  }

  // ==================== RESET FORM ====================
  function resetForm() {
    document.getElementById('form-id').value = '';
    document.getElementById('form-nom').value = '';
    document.getElementById('form-description').value = '';
    document.getElementById('form-prix').value = '';
    document.getElementById('form-stock').value = '';
    document.getElementById('form-unite').value = 'Kg';
    document.getElementById('form-categorie').value = '';
    document.getElementById('form-type-remise').value = 'AUCUNE';
    document.getElementById('form-remise').value = '';
    document.getElementById('remise-value-group').style.display = 'none';
    document.getElementById('form-image').value = '';

    // Reset preview
    const preview = document.getElementById('upload-preview');
    preview.innerHTML = '<i class="bi bi-cloud-arrow-up"></i><span>Glissez ou cliquez pour choisir</span>';

    document.getElementById('form-title').innerHTML = '<i class="bi bi-plus-square"></i> Ajouter un nouveau produit';
    document.getElementById('form-submit-btn').innerHTML = '<i class="bi bi-plus-lg"></i> Ajouter le produit';
  }

  // ==================== EDIT PRODUCT ====================
  function editProduit(row) {
    const data = row.dataset;

    document.getElementById('form-id').value = data.id;
    document.getElementById('form-nom').value = data.nom;
    document.getElementById('form-description').value = data.description || '';
    document.getElementById('form-prix').value = data.prix;
    document.getElementById('form-stock').value = data.stock;
    document.getElementById('form-unite').value = data.unite;
    document.getElementById('form-categorie').value = data.categorie || '';

    // Remise
    const typeRemise = data.typeRemise;
    if (typeRemise && typeRemise !== '' && typeRemise !== 'null') {
      document.getElementById('form-type-remise').value = typeRemise;
      document.getElementById('form-remise').value = data.remise;
      document.getElementById('remise-value-group').style.display = 'block';
    } else {
      document.getElementById('form-type-remise').value = 'AUCUNE';
      document.getElementById('form-remise').value = '';
      document.getElementById('remise-value-group').style.display = 'none';
    }

    // Image preview
    const preview = document.getElementById('upload-preview');
    if (data.image) {
      preview.innerHTML = '<img src="/uploads/produits/' + data.image + '" alt="Image actuelle">';
    } else {
      preview.innerHTML = '<i class="bi bi-cloud-arrow-up"></i><span>Glissez ou cliquez pour choisir</span>';
    }

    document.getElementById('form-title').innerHTML = '<i class="bi bi-pencil-square"></i> Modifier le produit #' + data.id;
    document.getElementById('form-submit-btn').innerHTML = '<i class="bi bi-check-lg"></i> Enregistrer les modifications';

    // Show form
    const section = document.getElementById('form-section');
    section.style.display = 'block';
    setTimeout(() => {
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 100);
  }

  // ==================== TOGGLE REMISE FIELD ====================
  function toggleRemiseField() {
    const type = document.getElementById('form-type-remise').value;
    const group = document.getElementById('remise-value-group');
    group.style.display = (type !== 'AUCUNE') ? 'block' : 'none';
    if (type === 'AUCUNE') {
      document.getElementById('form-remise').value = '';
    }
  }

  // ==================== IMAGE PREVIEW ====================
  function previewImage(input) {
    const preview = document.getElementById('upload-preview');
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        preview.innerHTML = '<img src="' + e.target.result + '" alt="Preview">';
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  // ==================== ADD NEW CATEGORY ====================
  function addNewCategory() {
    const input = document.getElementById('new-categorie');
    const val = input.value.trim();
    if (!val) return;

    const select = document.getElementById('form-categorie');
    // Check if already exists
    for (let opt of select.options) {
      if (opt.value.toLowerCase() === val.toLowerCase()) {
        select.value = opt.value;
        input.value = '';
        return;
      }
    }
    // Add new option
    const option = new Option(val, val, true, true);
    select.add(option);
    input.value = '';
  }

  // ==================== CLIENT-SIDE FILTER ====================
  function filterTable() {
    const filterId = document.getElementById('filter-id').value.toLowerCase();
    const filterNom = document.getElementById('filter-nom').value.toLowerCase();
    const filterCat = document.getElementById('filter-cat').value.toLowerCase();

    const rows = document.querySelectorAll('#produits-table tbody .mp-table-row');
    rows.forEach(row => {
      const id = (row.dataset.id || '').toLowerCase();
      const nom = (row.dataset.nom || '').toLowerCase();
      const cat = (row.dataset.categorie || '').toLowerCase();

      const matchId = !filterId || id.includes(filterId);
      const matchNom = !filterNom || nom.includes(filterNom);
      const matchCat = !filterCat || cat.includes(filterCat);

      row.style.display = (matchId && matchNom && matchCat) ? '' : 'none';
    });
  }
</script>
{% endblock %}
