{% extends 'base.html.twig' %}

{% block title %}Matériel & Maintenance{% endblock %}

{% block body_class %}marketplace-page{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/marketplace/marketplace.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
    <section class="marketplace-hero" style="min-height: 100vh;">
      <div class="hero-bg">
        <img src="{{ asset('assets/img/materiel.jpg') }}" alt="Matériel et Maintenance Ardhi">
      </div>

      <div class="container">
        <div class="hero-inner">

          {# --- Left Content --- #}
          <div class="hero-left">
            <a href="{{ path('app_home') }}" class="btn btn-outline-light btn-sm rounded-pill mb-4" style="border-color: rgba(255,255,255,0.4); color: white; display: inline-flex; align-items: center; gap: 6px;">
              <i class="bi bi-arrow-left"></i> Retour à l'accueil
            </a>
            <div class="hero-label">ARDHI SERVICES</div>
            <h1 class="hero-headline">Gérez votre<br>Matériel<br>en toute simplicité.</h1>
            <p class="hero-description">
              Suivez l'état de votre matériel agricole, planifiez les maintenances préventives et évitez les pannes en pleine saison grâce à notre outil intelligent.
            </p>
          </div>

          {# --- Right: Categories Panel --- #}
          <div class="hero-right">
            <div class="categories-glass-panel">
              <div class="categories-panel-header">
                <div class="categories-panel-title">Service Matériel & Maintenance</div>

                <div class="maintenance-notif-wrap">
                  <a href="{{ path('app_notification_maintenance_index') }}" class="market-notif-toggle" aria-label="Notifications matériel et maintenance" title="Notifications">
                    <i class="bi bi-bell-fill"></i>
                    <span class="market-notif-badge" style="display: {{ unreadCount|default(0) > 0 ? 'inline-flex' : 'none' }};">{{ unreadCount|default(0) > 9 ? '9+' : unreadCount|default(0) }}</span>
                  </a>

                  <div class="maintenance-notif-panel" aria-hidden="true">
                    <div class="maintenance-notif-head">
                      <h4>Notifications</h4>
                      <a href="{{ path('app_notification_maintenance_index') }}" class="maintenance-notif-all">Voir tout</a>
                    </div>

                    <div class="maintenance-notif-list">
                      {% for notif in recentNotifs|default([]) %}
                        <a href="{{ path('app_notification_maintenance_read', {'id': notif.id}) }}" class="maintenance-notif-item {{ notif.read ? '' : 'is-unread' }}">
                          <div class="maintenance-notif-title">{{ notif.materiel ? notif.materiel.nom : 'Matériel' }}</div>
                          <div class="maintenance-notif-text">
                            {% if notif.nouveauStatut == 'reclamation_soumise' %}
                              Votre réclamation a été soumise.
                            {% elseif notif.nouveauStatut == 'reclamation_en_attente' %}
                              Votre réclamation est en attente.
                            {% elseif notif.nouveauStatut == 'reclamation_en_cours' %}
                              Votre réclamation est en cours de traitement.
                            {% elseif notif.nouveauStatut == 'reclamation_resolue' %}
                              Votre réclamation a été résolue.
                            {% else %}
                              Statut mis à jour : {{ notif.nouveauStatut }}
                            {% endif %}
                          </div>
                          <small>{{ notif.createdAt|date('d/m/Y H:i') }}</small>
                        </a>
                      {% else %}
                        <div class="maintenance-notif-empty">Aucune notification pour le moment.</div>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              </div>

              <a href="{{ path('app_materiel_index') }}" class="category-item py-4 my-2">
                <div class="category-icon" style="font-size: 24px; width: 56px; height: 56px;"><i class="bi bi-truck-front"></i></div>
                <div class="category-text">
                  <h4 style="font-size: 16px;">Gérer mon Matériel</h4>
                  <span style="font-size: 13px;">Tracteurs, moissonneuses...</span>
                </div>
              </a>

              <a href="{{ path('app_maintenance_index') }}" class="category-item py-4 my-2">
                <div class="category-icon" style="font-size: 24px; width: 56px; height: 56px;"><i class="bi bi-tools"></i></div>
                <div class="category-text">
                  <h4 style="font-size: 16px;">Gérer les Maintenances</h4>
                  <span style="font-size: 13px;">Planifier les interventions</span>
                </div>
              </a>

            </div>
          </div>

        </div>
      </div>
    </section>

    <style>
      .categories-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .categories-panel-header .categories-panel-title {
        margin: 0;
      }

      .market-notif-toggle {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,0.2);
        background: rgba(255,255,255,0.12);
        color: #fff;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        text-decoration: none;
      }

      .maintenance-notif-wrap {
        position: relative;
        display: inline-flex;
      }

      .maintenance-notif-panel {
        position: absolute;
        top: 52px;
        right: 0;
        width: min(340px, 88vw);
        max-height: 360px;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.2);
        background: rgba(7, 20, 18, 0.95);
        box-shadow: 0 14px 34px rgba(0,0,0,0.35);
        overflow: hidden;
        display: none;
        z-index: 30;
      }

      .maintenance-notif-wrap:hover .maintenance-notif-panel,
      .maintenance-notif-wrap:focus-within .maintenance-notif-panel {
        display: block;
      }

      .maintenance-notif-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        border-bottom: 1px solid rgba(255,255,255,0.12);
      }

      .maintenance-notif-head h4 {
        margin: 0;
        color: #f1f5f3;
        font-size: 14px;
      }

      .maintenance-notif-all {
        color: #7df2bb;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
      }

      .maintenance-notif-list {
        max-height: 300px;
        overflow-y: auto;
      }

      .maintenance-notif-item {
        display: block;
        text-decoration: none;
        padding: 11px 14px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        color: #f7fffc;
      }

      .maintenance-notif-item:hover {
        background: rgba(125, 242, 187, 0.14);
      }

      .maintenance-notif-item.is-unread {
        background: rgba(29, 161, 117, 0.16);
      }

      .maintenance-notif-title {
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 3px;
      }

      .maintenance-notif-text {
        font-size: 12px;
        color: #d4e8e1;
        margin-bottom: 2px;
      }

      .maintenance-notif-item small {
        color: #98b8ad;
        font-size: 11px;
      }

      .maintenance-notif-empty {
        padding: 18px 14px;
        color: #d4e8e1;
        font-size: 12px;
        text-align: center;
      }

      .market-notif-toggle:hover {
        color: #fff;
        background: rgba(255,255,255,0.18);
      }

      .market-notif-badge {
        position: absolute;
        top: -8px;
        right: -8px;
        min-width: 21px;
        height: 21px;
        padding: 0 6px;
        border-radius: 999px;
        background: #e74c3c;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        align-items: center;
        justify-content: center;
      }
    </style>
{% endblock %}
