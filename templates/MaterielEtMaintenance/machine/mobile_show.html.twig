<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ardhi - Fiche Machine Mobile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --ardhi-green-dark: #2d3e2d;
            --ardhi-green-primary: #4a5c4a;
            --ardhi-green-light: #d4e4d4;
            --ardhi-accent: #c5a059;
        }
        body {
            background-color: #f8fcf8;
            font-family: 'Outfit', sans-serif;
            color: var(--ardhi-green-dark);
        }
        .mobile-header {
            background: linear-gradient(135deg, var(--ardhi-green-dark) 0%, var(--ardhi-green-primary) 100%);
            padding: 2rem 1rem;
            color: white;
            border-bottom-left-radius: 2rem;
            border-bottom-right-radius: 2rem;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .status-badge {
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
            display: inline-block;
            margin-top: 1rem;
        }
        .status-En-maintenance { background-color: #e3f2fd; color: #1976d2; }
        .status-En-panne { background-color: #ffebee; color: #d32f2f; }
        .status-Bon { background-color: #e8f5e9; color: #388e3c; }
        .status-Moyen { background-color: #fff3e0; color: #f57c00; }
        
        .info-card {
            background: white;
            border-radius: 1.5rem;
            padding: 1.5rem;
            margin-top: -1rem;
            margin-left: 1rem;
            margin-right: 1rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            border: 1px solid rgba(0,0,0,0.03);
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 0.8rem 0;
            border-bottom: 1px solid #f0f0f0;
        }
        .info-row:last-child { border-bottom: none; }
        .info-label { font-weight: 500; color: #777; font-size: 0.9rem; }
        .info-value { font-weight: 600; color: var(--ardhi-green-dark); }
        
        .action-button {
            background: var(--ardhi-green-dark);
            color: white;
            border: none;
            padding: 1rem;
            border-radius: 1rem;
            width: 100%;
            font-weight: 700;
            margin-top: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.8rem;
            transition: all 0.3s;
            text-decoration: none;
        }
        .btn-report { background: #d32f2f; }
        .action-button:active { transform: scale(0.98); }
        
        .footer {
            text-align: center;
            padding: 2rem;
            font-size: 0.8rem;
            color: #999;
        }
    </style>
</head>
<body>
    <div class="mobile-header">
        <h4 class="mb-1">{{ materiel.nom }}</h4>
        <p class="mb-0 opacity-75">{{ materiel.type }}</p>
        <div class="status-badge status-{{ materiel.etat|replace({' ': '-'}) }}">
            <i class="bi bi-circle-fill me-2 fs-xs"></i>{{ materiel.etat }}
        </div>
    </div>

    <div class="container pb-5">
        <div class="info-card">
            <h5 class="mb-4 border-bottom pb-2">Détails Techniques</h5>
            
            <div class="info-row">
                <span class="info-label">Dernière Maintenance</span>
                <span class="info-value">{{ materiel.derniereMaintenance ? materiel.derniereMaintenance|date('d/m/Y') : 'Aucune' }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Compteur Horaire</span>
                <span class="info-value">{{ materiel.heuresUtilisation }} h</span>
            </div>
            <div class="info-row">
                <span class="info-label">Statut Workflow</span>
                <span class="info-value text-uppercase" style="font-size: 0.8rem;">{{ materiel.statut|replace({'_': ' '}) }}</span>
            </div>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success mx-3 mt-4 rounded-4 shadow-sm border-0">
                <i class="bi bi-check-circle-fill me-2"></i> {{ message }}
            </div>
        {% endfor %}

        <div class="px-3 mt-4">
            <button class="action-button btn-report" data-bs-toggle="modal" data-bs-target="#reportModal">
                <i class="bi bi-exclamation-triangle-fill"></i> Signaler une Panne
            </button>
            <p class="text-center mt-3 text-muted small">
                Scannez le code QR pour accéder à cette fiche à tout moment sur le terrain.
            </p>
        </div>
    </div>

    <!-- Modal Signalement -->
    <div class="modal fade" id="reportModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0">
                <form action="{{ path('app_mobile_machine_report', {token: materiel.qrCodeToken}) }}" method="POST">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold">Signaler une Panne</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-3">Décrivez brièvement le problème constaté sur le terrain.</p>
                        <textarea name="description" class="form-control rounded-3" rows="4" placeholder="Ex: Fuite d'huile, bruit moteur suspect, etc." required></textarea>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="submit" class="action-button btn-report py-2">
                            Confirmer le Signalement
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="footer">
        <p>© 2026 Ardhi Agriculture - Système d'Identification QR</p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
