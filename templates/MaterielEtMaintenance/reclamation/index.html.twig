{% extends 'base.html.twig' %}
{% block title %}Mes Réclamations - Ardhi{% endblock %}
{% block body_class %}materiel-theme{% endblock %}

{% block stylesheets %}
<link href="{{ asset('assets/css/materiel/materiel.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="materiel-page-wrapper">
<div class="container py-5" style="margin-top: 70px;">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show border-0 shadow-sm rounded-3">
                <i class="bi bi-{{ label == 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill' }} me-2"></i>
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-megaphone me-2 text-danger"></i> Mes Réclamations</h2>
            <p class="text-muted small mb-0">Suivez l'état de vos réclamations sur votre matériel agricole</p>
        </div>
        <a href="{{ path('app_materiel_index') }}" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Retour au parc
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            {% if reclamations|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-uppercase small text-muted">
                        <tr>
                            <th class="ps-4">Urgence</th>
                            <th>Matériel</th>
                            <th>Sujet</th>
                            <th>Statut</th>
                            <th>Date</th>
                            <th>Réponse Admin</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for r in reclamations %}
                        <tr>
                            <td class="ps-4">
                                {% if r.urgence == 'urgente' %}
                                    <span class="badge bg-danger rounded-pill"><i class="bi bi-exclamation-triangle-fill me-1"></i> Urgente</span>
                                {% else %}
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill">Normale</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="fw-bold">{{ r.materiel ? r.materiel.nom : '—' }}</div>
                                {% if r.materiel %}<small class="badge bg-light border text-muted">{{ r.materiel.type }}</small>{% endif %}
                            </td>
                            <td>
                                <div class="fw-semibold">{{ r.sujet }}</div>
                                <small class="text-muted">{{ r.description|slice(0, 60) }}{% if r.description|length > 60 %}...{% endif %}</small>
                            </td>
                            <td>
                                {% if r.statut == 'en_attente' %}
                                    <span class="badge bg-warning-subtle text-warning border border-warning"><i class="bi bi-hourglass-split me-1"></i> En attente</span>
                                {% elseif r.statut == 'en_cours' %}
                                    <span class="badge bg-primary-subtle text-primary border border-primary"><i class="bi bi-gear-wide-connected me-1"></i> En cours</span>
                                {% elseif r.statut == 'resolue' %}
                                    <span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-check-circle-fill me-1"></i> Résolue</span>
                                {% endif %}
                            </td>
                            <td class="text-muted small">{{ r.createdAt|date('d/m/Y H:i') }}</td>
                            <td>
                                {% if r.commentaireAdmin %}
                                    <div class="bg-light rounded p-2 small border-start border-primary border-3">
                                        <i class="bi bi-chat-left-quote me-1 text-primary"></i>
                                        {{ r.commentaireAdmin }}
                                    </div>
                                {% else %}
                                    <span class="text-muted small fst-italic">En attente de réponse...</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="text-center py-5">
                <i class="bi bi-inbox text-light display-1 d-block mb-3"></i>
                <h5 class="text-muted fw-bold">Aucune réclamation soumise</h5>
                <p class="text-secondary small">Accédez à la fiche d'un matériel pour soumettre une réclamation.</p>
                <a href="{{ path('app_materiel_index') }}" class="btn btn-success rounded-pill px-4 mt-2">
                    <i class="bi bi-list-ul me-1"></i> Voir mon parc matériel
                </a>
            </div>
            {% endif %}
        </div>
    </div>

</div>
</div>
{% endblock %}
