{% extends 'base.html.twig' %}

{% block title %}Mes Notifications - Ardhi{% endblock %}

{% block body %}
<div class="container py-5" style="margin-top: 80px;">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold text-dark"><i class="bi bi-bell me-2 text-primary"></i> Historique de Notifications</h2>
            <p class="text-muted">Retrouvez toutes les alertes de mise à jour sur vos équipements</p>
        </div>
        <div class="col-auto">
            <a href="{{ path('app_materiel_et_maintenance') }}" class="btn btn-outline-secondary rounded-pill pe-4">
                <i class="bi bi-arrow-left-circle me-2"></i> Retour au Tableau de bord
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            {% if notifications|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-uppercase small text-muted">
                            <tr>
                                <th class="ps-4">Statut</th>
                                <th>Date & Heure</th>
                                <th>Matériel Concerné</th>
                                <th>Nouveau Statut Global</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for notif in notifications %}
                                <tr class="{{ notif.read ? '' : 'table-light' }}" style="transition: background-color 0.3s;">
                                    <td class="ps-4">
                                        {% if not notif.read %}
                                            <span class="badge bg-primary rounded-pill"><i class="bi bi-envelope-fill me-1"></i> Non-lue</span>
                                        {% else %}
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill"><i class="bi bi-envelope-open me-1"></i> Lue</span>
                                        {% endif %}
                                    </td>
                                    <td class="fw-bold text-dark">
                                        {{ notif.createdAt|date('d/m/Y') }} <span class="text-muted fw-normal ms-2">{{ notif.createdAt|date('H:i') }}</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <i class="bi bi-tractor fs-5"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block text-dark">{{ notif.materiel ? notif.materiel.nom : 'Matériel supprimé' }}</strong>
                                                {% if notif.materiel %}
                                                    <small class="text-muted badge bg-light border">{{ notif.materiel.type }}</small>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-dark-subtle border text-dark fs-6">{{ notif.nouveauStatut }}</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        {% if notif.materiel %}
                                            <a href="{{ path('app_notification_maintenance_read', {'id': notif.id}) }}" class="btn btn-sm {{ notif.read ? 'btn-outline-primary' : 'btn-primary shadow-sm' }} rounded-pill px-3">
                                                <i class="bi bi-eye me-1"></i> Voir la Fiche
                                            </a>
                                        {% else %}
                                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" disabled>Indisponible</button>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-bell-slash text-light display-1"></i>
                    </div>
                    <h4 class="text-muted fw-bold">Aucune notification</h4>
                    <p class="text-secondary">Vous serez alerté ici dès que l'administration mettra à jour l'état de votre matériel agricole.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
