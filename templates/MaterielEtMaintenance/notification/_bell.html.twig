<li class="dropdown nav-item notification-bell px-2" style="position: relative;">
    <a href="#" class="nav-link d-flex align-items-center position-relative">
        <div class="nav-user-circle d-flex align-items-center justify-content-center" style="background: rgba(255,255,255,0.1); width: 32px; height: 32px; border-radius: 50%;">
            <i class="bi bi-bell-fill" style="font-size: 1.1rem; color: white;"></i>
        </div>
        {% if unreadCount > 0 %}
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-2 border-white shadow-sm" style="font-size: 0.65rem; padding: 0.25em 0.5em; margin-top: 5px; margin-left: -10px;">
                {{ unreadCount > 9 ? '9+' : unreadCount }}
            </span>
        {% endif %}
    </a>
    <ul class="shadow-lg border-0 py-0" style="position: absolute; right: -10px; left: auto; top: calc(100% + 10px); min-width: 320px; border-radius: 12px; overflow: hidden; background: white; z-index: 1050; list-style: none; padding: 0; margin: 0;">
        <li class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center" style="padding: 15px !important;">
            <h6 class="mb-0 fw-bold text-dark" style="margin:0;"><i class="bi bi-bell me-2 mt-1"></i> Notifications</h6>
            {% if unreadCount > 0 %}
                <span class="badge bg-primary rounded-pill">{{ unreadCount }} nouvelle(s)</span>
            {% endif %}
        </li>
        <li style="padding: 0 !important;">
            <div class="notification-list" style="max-height: 350px; overflow-y: auto;">
                {% for notif in recentNotifs %}
                    <a href="{{ path('app_notification_maintenance_read', {'id': notif.id}) }}" class="d-flex text-decoration-none py-3 px-3 border-bottom text-wrap position-relative {{ notif.read ? 'bg-white' : 'bg-primary-subtle' }}" style="white-space: normal; transition: all 0.2s; padding: 15px !important; margin: 0; display: flex !important;">
                        {% if not notif.read %}
                            <span class="position-absolute bg-primary rounded-circle" style="width: 8px; height: 8px; top: 15px; right: 15px;"></span>
                        {% endif %}
                        <div class="d-flex w-100">
                            <div class="me-3 mt-1">
                                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 35px; height: 35px;">
                                    <i class="bi bi-gear-wide-connected fs-6"></i>
                                </div>
                            </div>
                            <div>
                                <small class="text-muted d-block mb-1"><i class="bi bi-clock me-1"></i> {{ notif.createdAt|date('d/m/Y H:i') }}</small>
                                <strong class="fs-6 text-dark d-block mb-1">{{ notif.materiel ? notif.materiel.nom : 'Matériel' }}</strong>
                                <span class="text-dark small d-block">L'administrateur a changé le statut de votre intervention à : <span class="badge bg-secondary-subtle text-secondary">{{ notif.nouveauStatut }}</span></span>
                            </div>
                        </div>
                    </a>
                {% else %}
                    <div class="py-4 text-center text-muted bg-white" style="padding: 20px !important;">
                        <i class="bi bi-bell-slash fs-3 d-block mb-2 text-light"></i>
                        <small>Aucune notification</small>
                    </div>
                {% endfor %}
            </div>
        </li>
        <li class="p-2 border-top bg-light text-center" style="padding: 0 !important;">
            <a href="{{ path('app_notification_maintenance_index') }}" class="text-decoration-none fw-bold text-primary" style="padding: 10px !important; margin: 0; display: block !important;">View all notifications</a>
        </li>
    </ul>
</li>
