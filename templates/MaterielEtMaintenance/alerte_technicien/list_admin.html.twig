{% extends 'base.html.twig' %}

{% block title %}Historique des Alertes - {{ materiel.nom }}{% endblock %}

{% block body %}
<div class="container" style="margin-top: 120px; margin-bottom: 50px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent p-0 mb-3">
            <li class="breadcrumb-item"><a href="{{ path('app_maintenance_index') }}" class="text-secondary">Maintenances</a></li>
            <li class="breadcrumb-item active" aria-current="page">Alertes de {{ materiel.nom }}</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold" style="color: #b0352b;"><i class="fas fa-bell me-2"></i>Alertes Technicien : {{ materiel.nom }}</h1>
    </div>

    <div class="table-responsive shadow-sm rounded border">
        <table class="table table-hover mb-0">
            <thead class="thead-light">
                <tr>
                    <th>Date du signalement</th>
                    <th>Description du Technicien</th>
                    <th>Statut de lecture</th>
                </tr>
            </thead>
            <tbody>
                {% for alerte in alertes %}
                    <tr>
                        <td class="align-middle">
                            <span class="font-weight-bold">{{ alerte.dateSignalement|date('d/m/Y') }}</span><br>
                            <small class="text-muted">{{ alerte.dateSignalement|date('H:i') }}</small>
                        </td>
                        <td class="align-middle" style="max-width: 400px;">
                            <div class="p-2 bg-light rounded shadow-xs fw-bold" style="color: #b0352b;">
                                {{ alerte.description|nl2br }}
                            </div>
                        </td>
                        <td class="align-middle">
                            {% if alerte.statut == 'lu' %}
                                <span class="badge border text-secondary" style="background: #f8f9fa;"><i class="fas fa-check"></i> Lu par l'agriculteur</span>
                            {% else %}
                                <span class="badge badge-warning"><i class="fas fa-clock"></i> Non lu</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center py-5 text-muted">
                            <i class="fas fa-info-circle fa-2x mb-2"></i><br>
                            Aucun signalement terrain pour ce matériel.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
