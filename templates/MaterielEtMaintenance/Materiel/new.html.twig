{% extends 'base.html.twig' %}

{% block title %}Ajouter un matériel{% endblock %}

{% block body_class %}materiel-theme{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/materiel/materiel.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="materiel-page-wrapper">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-lg" style="border-radius: 20px; border: none; overflow: hidden;">
                    <div class="card-header text-white" style="background: linear-gradient(135deg, #2d5a27 0%, #4a8c3f 100%); padding: 25px 30px;">
                        <h4 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Ajouter un nouveau matériel</h4>
                    </div>
                    <div class="card-body p-5">
                        {{ form_start(form) }}
                            {{ form_widget(form) }}
                            <div class="d-flex justify-content-between mt-5 pt-3 border-top">
                                <a href="{{ path('app_materiel_index') }}" class="btn-mat-outline px-4"><i class="bi bi-arrow-left"></i> Annuler</a>
                                <button class="btn-mat-primary px-5" type="submit"><i class="bi bi-check-circle"></i> Enregistrer</button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
