{% extends 'base.html.twig' %}
{% block title %}{% if materiel.id %}Modifier{% else %}Ajouter{% endif %} un Matériel{% endblock %}

{% block body_class %}materiel-theme{% endblock %}

{% block stylesheets %}
<link href="{{ asset('assets/css/materiel/materiel.css') }}" rel="stylesheet">
<style>
  .form-page-hero {
    background: linear-gradient(135deg, rgba(45,74,30,0.9) 0%, rgba(74,124,63,0.9) 100%), url('{{ asset("assets/img/materiel.jpg") }}') center/cover;
    color: #fff;
    padding: 1.5rem 2rem;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    border: 1px solid rgba(255,255,255,0.5);
  }
  .form-page-hero h1 { font-size: 1.7rem; font-weight: 700; margin-bottom: 0.3rem; }

  .form-card {
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(5px);
    border-radius: 18px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.09);
    padding: 2.5rem;
    max-width: 650px;
    margin: 0 auto;
  }
  .form-label { font-weight: 600; color: #333; font-size: 0.9rem; margin-bottom: 0.4rem; }
  .form-control, .form-select {
    border-radius: 10px;
    border: 1.5px solid #e0e0e0;
    padding: 0.65rem 1rem;
    font-size: 0.9rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .form-control:focus, .form-select:focus {
    border-color: #4a7c3f;
    box-shadow: 0 0 0 3px rgba(74,124,63,0.12);
    outline: none;
  }
  .is-invalid { border-color: #e74c3c !important; }
  .invalid-feedback { color: #e74c3c; font-size: 0.82rem; margin-top: 4px; }
  .form-hint { color: #888; font-size: 0.8rem; margin-top: 4px; }

  .btn-submit {
    background: #4a7c3f;
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 0.75rem 2rem;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .btn-submit:hover { background: #3a6030; color: #fff; }
  .btn-cancel {
    background: #f8f9fa;
    color: #555;
    border: 1.5px solid #ddd;
    border-radius: 10px;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .btn-cancel:hover { background: #eee; color: #333; }

  .section-divider {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #4a7c3f;
    font-weight: 700;
    border-bottom: 2px solid #e8f5e9;
    padding-bottom: 0.5rem;
    margin-bottom: 1.2rem;
    margin-top: 1.5rem;
  }
  .info-box {
    background: #e8f5e9;
    border-left: 4px solid #4a7c3f;
    border-radius: 8px;
    padding: 0.8rem 1rem;
    font-size: 0.85rem;
    color: #2e7d32;
    margin-bottom: 1.5rem;
  }
</style>
{% endblock %}

{% block body %}
<div class="materiel-page-wrapper">
<div class="container">
<div class="form-page-hero mt-3">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <h1>
        <i class="bi bi-{% if materiel.id %}pencil{% else %}plus-circle{% endif %} me-2"></i>
        {% if materiel.id %}Modifier{% else %}Ajouter{% endif %} un Matériel
      </h1>
      <p style="color:rgba(255,255,255,0.75);margin:0;">
        {% if materiel.id %}Mettre à jour les informations de {{ materiel.nom }}{% else %}Enregistrer un nouvel équipement agricole{% endif %}
      </p>
    </div>
    <a href="{{ path('app_materiel_index') }}" class="btn btn-outline-light btn-sm rounded-pill">
      <i class="bi bi-arrow-left me-1"></i> Retour à la liste
    </a>
  </div>
</div>

<div class="py-4">
  <div class="form-card">

    {% if not materiel.id %}
    <div class="info-box">
      <i class="bi bi-info-circle me-2"></i>
      Une date de prochaine maintenance sera calculée automatiquement selon la fréquence choisie.
    </div>
    {% endif %}

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

    {# Alerte globale si le formulaire contient des erreurs #}
    {% if not form.vars.valid %}
        <div class="alert alert-danger shadow-sm border-start border-4 border-danger py-3 mb-4">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>
            <strong>Attention !</strong> Le formulaire contient des erreurs. Veuillez vérifier les champs en rouge ci-dessous.
            <ul class="mt-2 mb-0 small">
                {% for error in form.vars.errors %}<li>{{ error.message }}</li>{% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="section-divider">Informations générales</div>

    <div class="mb-3">
      {{ form_label(form.nom) }}
      {{ form_widget(form.nom, {'attr': {'class': 'form-control ' ~ (form.nom.vars.errors|length > 0 ? 'is-invalid' : '')}}) }}
      {% if form.nom.vars.errors|length > 0 %}
        <div class="invalid-feedback d-block">
          {% for error in form.nom.vars.errors %}{{ error.message }}{% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="row g-3 mb-3">
      <div class="col-sm-6">
        {{ form_label(form.type) }}
        {{ form_widget(form.type, {'attr': {'class': 'form-select ' ~ (form.type.vars.errors|length > 0 ? 'is-invalid' : '')}}) }}
        {% if form.type.vars.errors|length > 0 %}
          <div class="invalid-feedback d-block fw-bold">
            {% for error in form.type.vars.errors %}{{ error.message }}{% endfor %}
          </div>
        {% endif %}
      </div>
      <div class="col-sm-6">
        {{ form_label(form.etat) }}
        {{ form_widget(form.etat, {'attr': {'class': 'form-select ' ~ (form.etat.vars.errors|length > 0 ? 'is-invalid' : '')}}) }}
        {% if form.etat.vars.errors|length > 0 %}
          <div class="invalid-feedback d-block fw-bold">
            {% for error in form.etat.vars.errors %}{{ error.message }}{% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="mb-3">
      {{ form_label(form.image) }}
      {{ form_widget(form.image) }}
      {% if form.image.vars.errors|length > 0 %}
        <div class="invalid-feedback d-block">
          {% for error in form.image.vars.errors %}{{ error.message }}{% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="section-divider">Maintenance</div>

    <div class="row g-3 mb-3">
      <div class="col-sm-6">
        {{ form_label(form.dateAchat) }}
        {{ form_widget(form.dateAchat, {'attr': {'class': 'form-control ' ~ (form.dateAchat.vars.errors|length > 0 ? 'is-invalid' : '')}}) }}
        <div class="form-hint">La prochaine maintenance sera automatiquement fixée à 6 mois après cette date.</div>
      </div>
      <div class="col-sm-6">
        {{ form_label(form.heuresUtilisation) }}
        {{ form_widget(form.heuresUtilisation, {'attr': {'class': 'form-control ' ~ (form.heuresUtilisation.vars.errors|length > 0 ? 'is-invalid' : '')}}) }}
      </div>
    </div>

    <div class="mb-4">
      <div class="d-flex justify-content-between align-items-center mb-1">
          {{ form_label(form.seuilMaintenanceHeures) }}
          <span id="threshold-indicator" class="badge bg-primary rounded-pill px-2 py-1 shadow-sm" style="font-size: 0.75rem; display: none;">
             Recommandé : <span id="threshold-val">500</span>h
          </span>
      </div>
      {{ form_widget(form.seuilMaintenanceHeures, {'attr': {'class': 'form-control ' ~ (form.seuilMaintenanceHeures.vars.errors|length > 0 ? 'is-invalid' : '')}}) }}
      <div class="form-hint text-primary fw-medium">
          <i class="bi bi-info-circle-fill me-1"></i> {{ form.seuilMaintenanceHeures.vars.help }}
      </div>
    </div>

    <div class="d-flex gap-3 pt-3 border-top mt-5">
      <button type="submit" class="btn-submit px-4">
        <i class="bi bi-check-lg"></i>
        {% if materiel.id %}Enregistrer les modifications{% else %}Ajouter le matériel{% endif %}
      </button>
      <a href="{{ path('app_materiel_index') }}" class="btn-cancel px-4">
        <i class="bi bi-x"></i> Annuler
      </a>
    </div>

    {{ form_end(form) }}
  </div>
</div>
</div>
</div>
{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const typeSelect = document.querySelector('select[name*="[type]"]');
        const thresholdInput = document.querySelector('input[name*="[seuilMaintenanceHeures]"]');
        const indicator = document.getElementById('threshold-indicator');
        const valSpan = document.getElementById('threshold-val');

        const thresholds = {
            'Tracteur': 500,
            'Moissonneuse': 300,
            'Semoir': 200,
            'Pulvérisateur': 400,
            'Charrue': 200,
            'Herse': 200,
            'Autre': 500
        };

        function updateThreshold() {
            const selectedType = typeSelect.value;
            if (selectedType && thresholds[selectedType]) {
                const recommended = thresholds[selectedType];
                valSpan.textContent = recommended;
                indicator.style.display = 'inline-block';
                
                // Si le champ est vide ou par défaut, on met la recommandation
                if (!thresholdInput.value || thresholdInput.value == 500) {
                    thresholdInput.value = recommended;
                }
            } else {
                indicator.style.display = 'none';
            }
        }

        typeSelect.addEventListener('change', updateThreshold);
        updateThreshold(); // Init au chargement
    });
</script>
{% endblock %}
