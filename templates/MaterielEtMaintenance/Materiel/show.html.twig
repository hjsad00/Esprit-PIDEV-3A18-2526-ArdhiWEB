{% extends 'base.html.twig' %}
{% block title %}{{ materiel.nom }} - Détail{% endblock %}

{% block body_class %}materiel-theme{% endblock %}

{% block flashes %}{# On désactive les flashes globaux pour les afficher localement dans le bloc d'urgence #}{% endblock %}

{% block stylesheets %}
<link href="{{ asset('assets/css/materiel/materiel.css') }}" rel="stylesheet">
<style>
  .detail-hero {
    background: linear-gradient(135deg, rgba(45,74,30,0.9) 0%, rgba(74,124,63,0.9) 100%), url('{{ asset("assets/img/materiel.jpg") }}') center/cover;
    color: #fff;
    padding: 1.5rem 2rem;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    border: 1px solid rgba(255,255,255,0.5);
  }
  .detail-card {
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(5px);
    border-radius: 18px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.09);
    padding: 2rem;
    margin-bottom: 1.5rem;
  }
  .detail-card h3 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #4a7c3f;
    font-weight: 700;
    border-bottom: 2px solid #e8f5e9;
    padding-bottom: 0.6rem;
    margin-bottom: 1.2rem;
  }
  .info-row { display: flex; justify-content: space-between; padding: 0.6rem 0; border-bottom: 1px solid #f5f5f5; font-size: 0.9rem; }
  .info-row:last-child { border-bottom: none; }
  .info-key { color: #888; font-weight: 500; }
  .info-val { font-weight: 600; text-align: right; color: #1a1a1a; }
  .badge-etat { padding: 0.35rem 0.9rem; border-radius: 50px; font-size: 0.78rem; font-weight: 600; }
  .badge-neuf { background: #e8f5e9; color: #2e7d32; }
  .badge-bon { background: #e3f2fd; color: #1565c0; }
  .badge-moyen { background: #fff8e1; color: #e65100; }
  .badge-panne { background: #ffebee; color: #c62828; }
  .badge-maintenance { background: #f3e5f5; color: #6a1b9a; }

  .hist-table th { background: #f5f5f5; font-size: 0.82rem; }
  .hist-table td { font-size: 0.88rem; vertical-align: middle; }
  .badge-statut-planifiee { background: #e3f2fd; color: #1565c0; }
  .badge-statut-en_cours { background: #fff8e1; color: #e65100; }
  .badge-statut-terminee { background: #e8f5e9; color: #2e7d32; }
  .badge-statut-annulee { background: #f5f5f5; color: #888; }
  .badge-statut-attente_planification { background: #e0f2f1; color: #00796b; border: 1px solid #b2dfdb; }
  .badge-statut-en_service { background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; }
  .badge-statut-en_maintenance { background: #fff3e0; color: #ef6c00; border: 1px solid #ffe0b2; }
  .badge-statut-reforme { background: #efebe9; color: #4e342e; border: 1px solid #d7ccc8; }
  .badge-statut-en_vente { background: #e8f5e9; color: #2e7d32; border: 1px solid #a5d6a7; }

  .hours-card {
    background: linear-gradient(135deg, #1a2d1b 0%, #2d4a1e 100%);
    color: #fff;
    border-radius: 18px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    position: relative;
    overflow: hidden;
  }
  .hours-card::after {
    content: '\F639';
    font-family: 'bootstrap-icons';
    position: absolute;
    right: -10px;
    bottom: -10px;
    font-size: 5rem;
    opacity: 0.1;
  }
  .ai-card {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 18px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    border-top: 5px solid #6366f1;
    transition: all 0.3s ease;
  }
  .ai-card.loading { opacity: 0.7; pointer-events: none; }
  .risk-badge { padding: 0.5rem 1rem; border-radius: 50px; font-weight: 700; text-transform: uppercase; font-size: 0.8rem; }
  .risk-Faible { background: #e8f5e9; color: #2e7d32; }
  .risk-Modéré { background: #fff3e0; color: #e65100; }
  .risk-Élevé { background: #ffebee; color: #c62828; }

  .sale-cta-wrap {
    display: flex;
    justify-content: center;
    margin: 0.25rem 0 0.75rem;
  }
  .btn-sale-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border: 1px solid #2f5d29;
    border-radius: 999px;
    padding: 0.56rem 1.05rem;
    min-width: 320px;
    background: linear-gradient(135deg, #2d4a1e 0%, #4a7c3f 100%);
    color: #fff;
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.2px;
    box-shadow: 0 8px 20px rgba(45, 74, 30, 0.28);
    transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
  }
  .btn-sale-cta:hover {
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(45, 74, 30, 0.33);
    filter: brightness(1.04);
  }
  .btn-sale-cta:focus-visible {
    color: #fff;
    outline: none;
    box-shadow: 0 0 0 0.2rem rgba(74, 124, 63, 0.35), 0 10px 22px rgba(45, 74, 30, 0.28);
  }
  .btn-sale-cta .icon-chip {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }
  @media (max-width: 576px) {
    .sale-cta-wrap {
      justify-content: center;
    }
    .btn-sale-cta {
      width: 100%;
      justify-content: center;
      min-width: 0;
    }
  }
</style>
{% endblock %}

{% block body %}
<div class="materiel-page-wrapper">
<div class="container">
<div class="detail-hero mt-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h1 style="font-size:1.8rem;font-weight:700;margin-bottom:0.2rem;">
          <i class="bi bi-tractor me-2"></i>{{ materiel.nom }}
        </h1>
        <p style="color:rgba(255,255,255,0.75);margin:0;">
          {{ materiel.type }}
          <span class="ms-2 badge badge-statut-{{ materiel.statut }}">{{ materiel.statut|replace({'_': ' '})|upper }}</span>
        </p>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <a href="{{ path('app_materiel_index') }}" class="btn btn-outline-light btn-sm rounded-pill">
          <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
        <a href="{{ path('app_reclamation_new', {materielId: materiel.id}) }}" class="btn btn-sm rounded-pill btn-danger shadow-sm">
          <i class="bi bi-megaphone-fill me-1"></i> Faire une réclamation
        </a>
        <a href="{{ path('app_admin_alertes_materiel', {id: materiel.id}) }}" class="btn btn-sm rounded-pill btn-warning shadow-sm position-relative">
          <i class="bi bi-bell-fill me-1"></i> Alertes Technicien
          {% if countUnread > 0 %}
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light shadow-sm">
              {{ countUnread }}
            </span>
          {% endif %}
        </a>
      </div>
    </div>
</div>

<div class="py-4">
  <div class="row g-4">
    <div class="col-lg-5">
      {# --- SECTION QR CODE --- #}
      <div class="detail-card text-center" style="border-top: 5px solid #2d4a1e;">
        <h3 class="text-start"><i class="bi bi-qr-code-scan me-2"></i>Identification QR</h3>
        {% if materiel.qrCodePath %}
            <div class="qr-container p-3 bg-white rounded-3 shadow-sm mb-3 d-inline-block border">
                <img src="{{ asset(materiel.qrCodePath) }}" alt="QR Code" class="img-fluid" style="max-width: 150px;">
            </div>
            <div class="d-grid gap-2">
                <a href="{{ asset(materiel.qrCodePath) }}" download="QR_Machine_{{ materiel.id }}.svg" class="btn btn-outline-dark btn-sm rounded-pill">
                    <i class="bi bi-download me-1"></i>Télécharger le SVG
                </a>
                <button onclick="window.print()" class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="bi bi-printer me-1"></i>Imprimer
                </button>
            </div>
            <div class="mt-3 text-start">
                <p class="small text-muted mb-0" style="line-height: 1.2;">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>Usage terrain :</strong> Scannable par n'importe quel smartphone pour signaler une panne instantanément.
                </p>
            </div>
        {% else %}
            <div class="py-4">
                <div class="spinner-border text-success spinner-border-sm" role="status"></div>
                <p class="small text-muted mt-2">Génération du code...</p>
            </div>
        {% endif %}
      </div>

      <div class="detail-card">
        <h3>Informations Générales</h3>
        <div class="info-row"><span class="info-key">Nom</span><span class="info-val">{{ materiel.nom }}</span></div>
        <div class="info-row"><span class="info-key">Type</span><span class="info-val">{{ materiel.type }}</span></div>
        <div class="info-row"><span class="info-key">Date d'achat</span><span class="info-val">{{ materiel.dateAchat ? materiel.dateAchat|date('d/m/Y') : '—' }}</span></div>
        <div class="info-row"><span class="info-key">Seuil de maintenance</span><span class="info-val">{{ materiel.seuilMaintenanceHeures }} heures</span></div>
        <div class="info-row"><span class="info-key">Fréquence temps</span><span class="info-val">Tous les 6 mois (automatique)</span></div>
      </div>

       <div class="detail-card">
        <h3>Calendrier & Dates</h3>
        <div class="info-row"><span class="info-key">Dernière maintenance</span><span class="info-val">{{ materiel.derniereMaintenance ? materiel.derniereMaintenance|date('d/m/Y') : '—' }}</span></div>
        <div class="info-row">
          <span class="info-key">Prochaine maintenance</span>
          <span class="info-val">
            {% if materiel.dateProchaineMaintenance %}
               {% set daysLeft = ((materiel.dateProchaineMaintenance.timestamp - 'now'|date('U')) / 86400)|round(0, 'floor') %}
               {% if daysLeft < 0 %}
                 <span class="text-danger fw-bold">{{ materiel.dateProchaineMaintenance|date('d/m/Y') }} (RETARD)</span>
               {% elseif daysLeft <= 7 %}
                 <span class="text-warning fw-bold">{{ materiel.dateProchaineMaintenance|date('d/m/Y') }} (Bientôt)</span>
               {% else %}
                 {{ materiel.dateProchaineMaintenance|date('d/m/Y') }}
               {% endif %}
            {% else %}—{% endif %}
          </span>
        </div>
        <div class="info-row"><span class="info-key">Nb. maintenances</span><span class="info-val">{{ materiel.maintenances|length }}</span></div>
      </div>
    </div>

    <div class="col-lg-7">
      {# --- Compteur d'heures --- #}
      <div class="hours-card shadow-sm mb-4">
        <h3 class="text-white border-white mb-3" style="font-size: 0.9rem; opacity: 0.9;">Compteur d'heures d'utilisation</h3>
        <div class="d-flex align-items-baseline gap-2 mb-3">
          <span class="display-3 fw-bold">{{ materiel.heuresUtilisation }}</span>
          <span class="fs-4 opacity-75">heures cumulées</span>
        </div>
        
        {% if materiel.statut not in ['reforme', 'en_vente'] %}
        <form action="{{ path('app_materiel_update_hours', {id: materiel.id}) }}" method="POST" class="d-flex gap-2">
          <input type="number" name="heures" value="{{ materiel.heuresUtilisation }}" min="{{ materiel.heuresUtilisation }}" class="form-control bg-white border-0" style="max-width: 150px;" placeholder="Nouvelles heures...">
          <button type="submit" class="btn btn-success rounded-pill fw-bold px-4">Enregistrer les heures</button>
        </form>
        <p class="small mt-2 opacity-75">Saisissez la valeur lue sur le compteur de la machine.</p>
        {% else %}
        <div class="alert alert-light bg-opacity-10 border-0 py-2 d-inline-flex align-items-center mb-0" style="background: rgba(255,255,255,0.15); color: #fff; border-radius: 10px;">
            <i class="bi bi-pause-circle-fill me-2 fs-5"></i>
            <span class="small fw-bold">Compteur gelé : Le matériel est {{ materiel.statut == 'en_vente' ? 'en vente' : 'réformé' }}.</span>
        </div>
        {% endif %}

        {% set heuresDepuisRevision = materiel.heuresUtilisation - materiel.derniereMaintenanceHeures %}
        {% set progress = (heuresDepuisRevision / materiel.seuilMaintenanceHeures * 100)|round %}
        <div class="mt-3">
            <div class="d-flex justify-content-between small opacity-75 mb-1">
                <span>Progression : <strong>{{ heuresDepuisRevision }}h / {{ materiel.seuilMaintenanceHeures }}h</strong></span>
                <span class="fw-bold">{{ progress }}%</span>
            </div>
            <div class="progress" style="height: 10px; background: rgba(255,255,255,0.2); border-radius: 10px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-{{ progress >= 90 ? 'danger' : (progress >= 75 ? 'warning' : 'success') }}" role="progressbar" style="width: {{ progress > 100 ? 100 : progress }}%"></div>
            </div>
        </div>
        </div>

      {# --- Cycle de Vie Workflow --- #}
      <div class="detail-card border-start border-4 border-danger mb-4" style="background: #fffafa;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0 text-danger"><i class="bi bi-shield-exclamation me-2"></i>Cycle de Vie & Urgences</h3>
            <span class="badge badge-statut-{{ materiel.statut }} fs-6">
                <i class="bi bi-info-circle-fill me-1"></i> {{ materiel.statut|replace({'_': ' '})|upper }}
            </span>
        </div>

        <div class="mb-4 text-muted small p-2 bg-light rounded border">
            <i class="bi bi-cpu me-2 text-primary"></i> 
            <strong>Gestion intelligente :</strong> Ce statut se met à jour automatiquement dès que l'Admin valide votre intervention ou le jour du rendez-vous.
        </div>

        <div class="row g-2">
            {% if materiel.statut in ['en_maintenance', 'panne_signalee', 'attente_planification'] %}
                <div class="col-12">
                    <div class="btn-group w-100 shadow-sm">
                        <button class="btn btn-{{ materiel.statut == 'panne_signalee' ? 'warning' : (materiel.statut == 'en_maintenance' ? 'success' : 'info') }} w-100 fw-bold" disabled>
                            <i class="bi bi-info-circle-fill me-2"></i> 
                            {% if materiel.statut == 'panne_signalee' %}
                                Panne Signalée (En attente Admin)
                            {% elseif materiel.statut == 'attente_planification' %}
                                En Attente de Planification
                            {% else %}
                                Matériel en Maintenance
                            {% endif %}
                        </button>
                    </div>
                    <p class="small text-muted mt-2 text-center text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        {% if materiel.statut == 'panne_signalee' %}
                            <i class="bi bi-clock-history"></i> L'administrateur va traiter votre demande d'urgence.
                        {% elseif materiel.statut == 'attente_planification' %}
                            <i class="bi bi-calendar-event"></i> L'urgence a été refusée. Veuillez planifier une maintenance standard.
                        {% else %}
                            <i class="bi bi-tools"></i> Une intervention est en cours sur ce matériel.
                        {% endif %}
                    </p>
                </div>
            {% elseif workflow_can(materiel, 'mettre_en_maintenance') %}
                <div class="col-12">
                    {# Affichage local des erreurs de validation pour ce formulaire #}
                    {% for message in app.flashes('danger') %}
                        <div class="alert alert-danger shadow-sm border-0 border-start border-4 border-danger mb-3 py-2">
                            <i class="bi bi-exclamation-circle-fill me-2"></i> {{ message }}
                        </div>
                    {% endfor %}

                    <form action="{{ path('app_materiel_transition', {id: materiel.id, transition: 'mettre_en_maintenance'}) }}" method="POST" class="bg-white p-3 rounded border shadow-sm">
                        <input type="hidden" name="_token" value="{{ csrf_token('workflow_' ~ materiel.id) }}">
                        <label class="form-label fw-bold text-danger"><i class="bi bi-megaphone me-1"></i> Signaler une panne / Urgence</label>
                        <textarea name="description" class="form-control mb-3" placeholder="Décrivez le problème ici pour l'administrateur..." rows="2"></textarea>
                        <button type="submit" class="btn btn-danger w-100 shadow-sm fw-bold">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> METTRE EN MAINTENANCE (URGENT)
                        </button>
                    </form>
                </div>
            {% endif %}
            

            {% if workflow_can(materiel, 'reformer') %}
                <div class="col-md-6">
                    <form action="{{ path('app_materiel_transition', {id: materiel.id, transition: 'reformer'}) }}" method="POST" onsubmit="return confirm('Attention ! Cette action est irréversible. Réformer cette machine ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('workflow_' ~ materiel.id) }}">
                        <button type="submit" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-trash me-2"></i> Réformer
                        </button>
                    </form>
                </div>
            {% endif %}
        </div>
      </div>
        
        {% if workflow_can(materiel, 'mettre_en_vente') %}
          <div class="sale-cta-wrap">
            <button type="button" class="btn btn-sale-cta" data-bs-toggle="modal" data-bs-target="#modalMettreEnVente">
              <span class="icon-chip"><i class="bi bi-shop"></i></span>
              Mettre en vente
            </button>
          </div>
        {% endif %}

        {% if materiel.statut == 'en_vente' %}
            <div class="alert alert-success border-0 mt-3 shadow-sm">
                <i class="bi bi-shop-window me-2"></i> <strong>Ce matériel est actuellement en vente sur le Marketplace.</strong>
                <a href="{{ path('app_marketplace_mes_produits') }}" class="alert-link ms-2">Voir mes produits →</a>
            </div>
        {% endif %}

        {% if materiel.statut == 'reforme' %}
            <div class="alert alert-secondary border-0 mt-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Ce matériel a été retiré du parc actif.
            </div>
        {% endif %}


      {# --- Diagnostic IA --- #}
      <div class="ai-card shadow-sm" id="aiContainer">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="mb-0 text-indigo-600" style="color: #6366f1; border: none; padding: 0;">
            <i class="bi bi-robot me-2"></i>Analyse Prédictive IA
          </h3>
          <button id="btnGenerateAI" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
            <i class="bi bi-stars me-1"></i> Générer l'analyse
          </button>
        </div>

        <div id="aiPlaceholder" class="text-center py-4 text-muted">
          <p class="mb-0 small italic">Cliquez sur le bouton pour obtenir une analyse de risque et des conseils de maintenance personnalisés par Gemini AI.</p>
        </div>

        <div id="aiResult" class="d-none">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div id="aiRiskBadge" class="risk-badge">FAIBLE</div>
            <div class="flex-grow-1">
              <div class="progress" style="height: 8px; background: #eee;">
                <div id="aiRiskScore" class="progress-bar" role="progressbar" style="width: 25%"></div>
              </div>
            </div>
          </div>
          
          <div class="bg-light p-3 rounded border mb-3 small" id="aiAnalysisText" style="line-height: 1.5;"></div>
          
          <div class="mb-3">
            <label class="fw-bold small text-uppercase text-muted mb-2 d-block">Conseils Experts :</label>
            <ul class="list-unstyled mb-0" id="aiTips"></ul>
          </div>

          <div class="alert alert-info border-0 mb-0 py-2 small">
             <i class="bi bi-lightning-fill me-1"></i> <strong>Prochaine étape :</strong> <span id="aiNextStep"></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row mt-2">
    <div class="col-12">
      <div class="detail-card">
        <h3>Historique Complet des Interventions</h3>
        {% if materiel.maintenances|length > 0 %}
        <table class="table hist-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Type</th>
              <th>Statut</th>
              <th>Description</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for maint in materiel.maintenances %}
            <tr>
              <td>{{ maint.dateMaintenance|date('d/m/Y') }}</td>
              <td>
                {% set typeLabels = {'preventive':'Préventive','corrective':'Corrective','urgente':'Urgente'} %}
                {{ typeLabels[maint.typeMaintenance] ?? maint.typeMaintenance }}
              </td>
              <td>
                <span class="badge badge-statut-{{ maint.statutMaintenance }} px-2 py-1 rounded-pill small fw-semibold">
                  {% set sl = {'planifiee':'Planifiée','en_cours':'En cours','terminee':'Terminée','annulee':'Annulée'} %}
                  {{ sl[maint.statutMaintenance] ?? maint.statutMaintenance }}
                </span>
              </td>
              <td class="text-muted small">{{ maint.description ? maint.description|slice(0,60) ~ '...' : '—' }}</td>
              <td>
                <a href="{{ path('app_maintenance_show', {id: maint.idMaintenance}) }}" class="btn btn-sm btn-outline-secondary rounded-pill">
                  <i class="bi bi-eye"></i>
                </a>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
        <div class="text-center py-4 text-muted">
          <i class="bi bi-calendar-x display-5 d-block mb-2"></i>
          Aucune maintenance enregistrée.
          <a href="{{ path('app_maintenance_new') }}" class="d-block mt-2 text-success">Planifier la première →</a>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
</div>
</div>
</div>
{% include 'MaterielEtMaintenance/materiel/_chatbot.html.twig' %}

<script>
document.getElementById('btnGenerateAI').addEventListener('click', function() {
    const container = document.getElementById('aiContainer');
    const btn = this;
    const placeholder = document.getElementById('aiPlaceholder');
    const result = document.getElementById('aiResult');

    container.classList.add('loading');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Analyse en cours...';

    fetch('{{ path('app_materiel_ia_analyse', {id: materiel.id}) }}', {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        container.classList.remove('loading');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Actualiser l\'analyse';

        if (data.error) {
            alert(data.message);
            return;
        }

        placeholder.classList.add('d-none');
        result.classList.remove('d-none');

        // Update UI
        const badge = document.getElementById('aiRiskBadge');
        badge.textContent = data.risque;
        badge.className = 'risk-badge risk-' + data.risque;

        const progressBar = document.getElementById('aiRiskScore');
        progressBar.style.width = data.score_risque + '%';
        const barColor = data.score_risque > 70 ? 'bg-danger' : (data.score_risque > 40 ? 'bg-warning' : 'bg-success');
        progressBar.className = 'progress-bar ' + barColor;

        document.getElementById('aiAnalysisText').textContent = data.analyse;
        
        const tipsList = document.getElementById('aiTips');
        tipsList.innerHTML = '';
        data.conseils.forEach(tip => {
            const li = document.createElement('li');
            li.className = 'mb-1';
            li.innerHTML = '<i class="bi bi-check2-circle text-success me-2"></i>' + tip;
            tipsList.appendChild(li);
        });

        document.getElementById('aiNextStep').textContent = data.prochaine_etape;
    })
    .catch(error => {
        container.classList.remove('loading');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-stars me-1"></i> Générer l\'analyse';
        console.error('Error:', error);
        alert('Une erreur technique est survenue.');
    });
});
</script>

{# ===== MODAL : Mettre en Vente ===== #}
{% if workflow_can(materiel, 'mettre_en_vente') %}
<div class="modal fade" id="modalMettreEnVente" tabindex="-1" aria-labelledby="modalMettreEnVenteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border: none; border-radius: 18px; overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #2d4a1e 0%, #4a7c3f 100%); color: #fff; border: none;">
                <h5 class="modal-title fw-bold" id="modalMettreEnVenteLabel">
                    <i class="bi bi-shop me-2"></i> Mettre ce matériel en vente
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <form action="{{ path('app_materiel_mettre_en_vente', {id: materiel.id}) }}" method="POST">
                <input type="hidden" name="_token" value="{{ csrf_token('vente_' ~ materiel.id) }}">
                <div class="modal-body p-4">
                    <div class="row g-4">
                        {# Colonne gauche #}
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-uppercase small text-muted">Nom du produit</label>
                                <input type="text" class="form-control" value="{{ materiel.nom }}" readonly 
                                       style="background: #f8f9fa; font-weight: 600; border: 1px solid #dee2e6;">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold text-uppercase small text-muted">Description *</label>
                                <textarea name="description" class="form-control" rows="4" required
                                          placeholder="Décrivez l'état de votre matériel, ses caractéristiques, heures d'utilisation, raison de la vente..."
                                          style="border: 1px solid #dee2e6;"></textarea>
                            </div>
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="form-label fw-bold text-uppercase small text-muted">Prix (DT) *</label>
                                    <input type="number" name="prix" class="form-control" step="0.01" min="0.1" required 
                                           placeholder="Ex: 15000"
                                           style="border: 1px solid #dee2e6;">
                                    <small class="text-muted"><i class="bi bi-info-circle"></i> En Dinar Tunisien (DT)</small>
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-bold text-uppercase small text-muted">Stock</label>
                                    <input type="number" class="form-control" value="1" readonly 
                                           style="background: #f8f9fa; border: 1px solid #dee2e6;">
                                </div>
                            </div>
                        </div>

                        {# Colonne droite #}
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-uppercase small text-muted">Catégorie</label>
                                <input type="text" class="form-control" value="{{ materiel.type }}" readonly 
                                       style="background: #f8f9fa; font-weight: 600; border: 1px solid #dee2e6;">
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-uppercase small text-muted">Remise / Solde</label>
                                <input type="text" class="form-control" value="Aucune remise" readonly 
                                       style="background: #f8f9fa; border: 1px solid #dee2e6;">
                            </div>

                            {% if materiel.image %}
                            <div class="mb-3">
                                <label class="form-label fw-bold text-uppercase small text-muted">Image du matériel</label>
                                <div class="border rounded p-2 text-center" style="background: #f8f9fa;">
                                    <img src="{{ asset('uploads/materiel/' ~ materiel.image) }}" alt="{{ materiel.nom }}" 
                                         class="img-fluid rounded" style="max-height: 150px; object-fit: cover;">
                                    <p class="small text-muted mt-1 mb-0"><i class="bi bi-check-circle text-success"></i> Image récupérée automatiquement</p>
                                </div>
                            </div>
                            {% endif %}

                            <div class="alert alert-info border-0 py-2 mb-0" style="font-size: 0.85rem;">
                                <i class="bi bi-info-circle-fill me-1"></i>
                                Le matériel sera visible sur le <strong>Marketplace Ardhi</strong> dès la validation.
                                Son statut passera à <strong>"En vente"</strong>.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid #eee; background: #fafafa;">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-shop me-2"></i> Confirmer la mise en vente
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}

