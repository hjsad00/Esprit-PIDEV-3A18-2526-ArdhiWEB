{% extends 'base.html.twig' %}

{% block title %}Détails du Matériel{% endblock %}

{% block body_class %}materiel-theme{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/materiel/materiel.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="materiel-page-wrapper">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="display-6 fw-bold text-dark">{{ materiel.nom }} <span class="badge bg-secondary ms-2 align-middle" style="font-size: 0.9rem;">{{ materiel.type }}</span></h1>
            <div>
                <a href="{{ path('app_materiel_edit', {'id': materiel.id}) }}" class="btn-mat-action shadow-sm border-0 me-2" style="background: #e67e22; color: white;"><i class="bi bi-pencil"></i> Modifier</a>
                <a href="{{ path('app_materiel_index') }}" class="btn-mat-outline shadow-sm bg-white"><i class="bi bi-arrow-left"></i> Retour</a>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-5">
                {% if materiel.image %}
                <div class="card shadow-sm mb-4" style="border-radius: 20px; border: none; overflow: hidden;">
                    <img src="{{ asset('uploads/materiel/' ~ materiel.image) }}" class="card-img-top" alt="{{ materiel.nom }}" style="max-height: 250px; object-fit: cover;">
                </div>
                {% endif %}
                <div class="card shadow-sm h-100" style="border-radius: 20px; border: none;">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle text-success me-2"></i>Informations générales</h5>
                    </div>
                    <div class="card-body p-4">
                        <ul class="mat-details-list">
                            <li>
                                <strong>État :</strong> 
                                <span class="ms-auto mat-badge shadow-none position-static {{ materiel.etat == 'En panne' ? 'badge-danger' : (materiel.etat == 'Bon' or materiel.etat == 'Neuf' ? 'badge-success' : 'badge-warning') }}">{{ materiel.etat }}</span>
                            </li>
                            <li><strong>Date d'achat :</strong> <span class="ms-auto">{{ materiel.dateAchat ? materiel.dateAchat|date('d/m/Y') : 'Non renseignée' }}</span></li>
                            <li><strong>Fréquence de maintenance :</strong> <span class="ms-auto fw-bold text-dark">{{ materiel.frequenceMaintenanceMois ? materiel.frequenceMaintenanceMois ~ ' mois' : 'Non renseignée' }}</span></li>
                            <li><strong>Dernière maintenance :</strong> <span class="ms-auto">{{ materiel.derniereMaintenance ? materiel.derniereMaintenance|date('d/m/Y') : 'Aucune' }}</span></li>
                            <li class="align-items-start flex-column pb-0">
                                <strong>Prochaine maintenance prévue :</strong> 
                                {% if materiel.dateProchaineMaintenance %}
                                    {% set isRetard = date(materiel.dateProchaineMaintenance) < date() %}
                                    <div class="mt-2 w-100 p-3 rounded" style="background: {{ isRetard ? '#ffeaa7' : '#e9f2e9' }};">
                                        <span class="fs-5 fw-bold {{ isRetard ? 'text-danger' : 'text-success' }}">
                                            {{ materiel.dateProchaineMaintenance|date('d/m/Y') }}
                                        </span>
                                        {% if isRetard %}<div class="text-danger small mt-1"><i class="bi bi-exclamation-triangle-fill"></i> Maintenance en retard</div>{% endif %}
                                    </div>
                                {% else %}
                                    <span class="mt-2 text-muted">Non planifiée</span>
                                {% endif %}
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-7">
                <div class="card shadow-sm h-100" style="border-radius: 20px; border: none;">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history text-primary me-2"></i>Historique des maintenances</h5>
                        <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Maintenance+de+{{ materiel.nom|url_encode }}" target="_blank" class="btn-mat-outline py-1 px-3" style="font-size: 0.85rem;"><i class="bi bi-calendar-plus"></i> Google Calendar</a>
                    </div>
                    <div class="card-body p-4">
                        {% if materiel.maintenances|length > 0 %}
                        <div class="list-group list-group-flush rounded border p-2">
                            {% for maint in materiel.maintenances %}
                                <div class="list-group-item d-flex justify-content-between align-items-start border-0 border-bottom mb-2 pb-3">
                                    <div>
                                        <strong class="d-block mb-1 fs-5">{{ maint.dateMaintenance ? maint.dateMaintenance|date('d/m/Y') : 'Date inconnue' }}</strong>
                                        <p class="mb-1 text-muted small">{{ maint.description ?: 'Aucune description fournie.' }}</p>
                                    </div>
                                    <div class="d-flex flex-column align-items-end ms-3">
                                        <span class="badge {{ maint.typeMaintenance == 'urgente' ? 'bg-danger' : (maint.typeMaintenance == 'preventive' ? 'bg-info text-dark' : 'bg-secondary') }} mb-1 opacity-75 rounded-pill">{{ maint.typeMaintenance }}</span>
                                        <span class="badge border text-dark bg-light rounded-pill">{{ maint.statutMaintenance|capitalize|replace({'_': ' '}) }}</span>
                                        <a href="{{ path('app_maintenance_show', {id: maint.idMaintenance}) }}" class="mt-2 text-decoration-none small text-primary fw-bold">Détails <i class="bi bi-arrow-right"></i></a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        {% else %}
                            <div class="p-5 text-center text-muted bg-light rounded">
                                <i class="bi bi-clipboard fs-1 d-block mb-3 opacity-50"></i>
                                <p>Aucun historique de maintenance statique enregistré.</p>
                                <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Maintenance+de+{{ materiel.nom|url_encode }}" target="_blank" class="btn-mat-primary mt-2"><i class="bi bi-google"></i> Planifier via Google Calendar</a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        
        <div class="mt-5 pt-4 border-top">
            <form method="post" action="{{ path('app_materiel_delete', {'id': materiel.id}) }}" onsubmit="return confirm('Attention ! La suppression de ce matériel entraînera la suppression de tout son historique de maintenance. Êtes-vous sûr de vouloir continuer ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_materiel_' ~ materiel.id) }}">
                <button class="btn btn-outline-danger shadow-sm py-2 px-4 rounded-pill fw-bold"><i class="bi bi-trash"></i> Supprimer définitivement ce matériel</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
