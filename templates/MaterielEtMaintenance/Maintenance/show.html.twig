{% extends 'base.html.twig' %}

{% block title %}Détails de la Maintenance{% endblock %}

{% block body_class %}materiel-theme{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/materiel/materiel.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="materiel-page-wrapper">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="display-6 fw-bold text-dark">Détails de l'intervention</h1>
            <div>
                <a href="{{ path('app_maintenance_edit', {'id': maintenance.idMaintenance}) }}" class="btn-mat-action shadow-sm border-0 me-2" style="background: #e67e22; color: white;"><i class="bi bi-pencil"></i> Modifier</a>
                <a href="{{ path('app_maintenance_index') }}" class="btn-mat-outline shadow-sm bg-white"><i class="bi bi-arrow-left"></i> Retour</a>
            </div>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-md-9">
                <div class="card shadow-sm h-100" style="border-radius: 20px; border: none;">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-clipboard2-data text-primary me-2"></i>Rapport de maintenance</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4 bg-light p-3 rounded d-flex align-items-center">
                            <div class="me-3 fs-1 text-primary"><i class="bi bi-truck-front"></i></div>
                            <div>
                                <h6 class="mb-1 text-muted"><strong>Matériel concerné :</strong></h6>
                                <p class="fs-5 mb-0">
                                    <a href="{{ path('app_materiel_show', {id: maintenance.materiel.id}) }}" class="text-decoration-none fw-bold text-dark">
                                        {{ maintenance.materiel.nom }}
                                    </a>
                                    <span class="badge bg-secondary ms-2 align-middle">{{ maintenance.materiel.type }}</span>
                                </p>
                            </div>
                        </div>

                        <div class="row mb-5 pb-3 border-bottom g-4">
                            <div class="col-sm-4">
                                <h6 class="text-muted mb-2"><strong><i class="bi bi-calendar px-1"></i> Date :</strong></h6>
                                <p class="fs-5 fw-bold mb-0">{{ maintenance.dateMaintenance ? maintenance.dateMaintenance|date('d/m/Y') : 'Non renseignée' }}</p>
                            </div>
                            <div class="col-sm-4 text-center">
                                <h6 class="text-muted mb-2"><strong><i class="bi bi-tag px-1"></i> Type :</strong></h6>
                                <p class="mb-0"><span class="badge rounded-pill px-3 py-2 fs-6 {{ maintenance.typeMaintenance == 'urgente' ? 'bg-danger' : (maintenance.typeMaintenance == 'preventive' ? 'bg-info text-dark' : 'bg-secondary') }}">{{ maintenance.typeMaintenance }}</span></p>
                            </div>
                            <div class="col-sm-4 text-end">
                                <h6 class="text-muted mb-2"><strong><i class="bi bi-activity px-1"></i> Statut :</strong></h6>
                                <p class="mb-0">
                                    {% if maintenance.statutMaintenance == 'terminee' %}
                                        <span class="badge rounded-pill px-3 py-2 fs-6 bg-success">Terminée</span>
                                    {% elseif maintenance.statutMaintenance == 'en_cours' %}
                                        <span class="badge rounded-pill px-3 py-2 fs-6 bg-warning text-dark">En cours</span>
                                    {% elseif maintenance.statutMaintenance == 'annulee' %}
                                        <span class="badge rounded-pill px-3 py-2 fs-6 bg-dark">Annulée</span>
                                    {% else %}
                                        <span class="badge rounded-pill px-3 py-2 fs-6 bg-primary">Planifiée</span>
                                    {% endif %}
                                </p>
                            </div>
                        </div>

                        <div>
                            <h6 class="mb-3"><i class="bi bi-chat-left-text text-primary me-2"></i><strong>Description / Observations du technicien :</strong></h6>
                            <div class="bg-light p-4 rounded border-start border-4 border-primary" style="min-height: 120px;">
                                {{ maintenance.description ? maintenance.description|nl2br : '<em class="text-muted">Aucune description fournie pour cette intervention. Le technicien n\'a pas encore rédigé le rapport de fin d\'intervention.</em>'|raw }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="mt-5 pt-4 text-center border-top">
            <form method="post" action="{{ path('app_maintenance_delete', {'id': maintenance.idMaintenance}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette maintenance du registre ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_maintenance_' ~ maintenance.idMaintenance) }}">
                <button class="btn btn-outline-danger shadow-sm py-2 px-4 rounded-pill fw-bold"><i class="bi bi-trash"></i> Supprimer définitivement cette intervention</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
