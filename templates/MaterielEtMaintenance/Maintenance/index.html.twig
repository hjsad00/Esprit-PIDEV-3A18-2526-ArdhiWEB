{% extends 'base.html.twig' %}

{% block title %}Gestion des Maintenances{% endblock %}

{% block body_class %}materiel-theme{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/materiel/materiel.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="materiel-page-wrapper" style="background: url('{{ asset("assets/img/maintenance.webp") }}') center/cover no-repeat fixed; min-height: 100vh; padding-bottom: 3rem;">
    <div class="container pb-5">
        
        {# Glassmorphism Stats Header #}
        <div class="mat-stats-header" data-aos="fade-down" style="background: linear-gradient(to right, rgba(45, 74, 30, 0.88), rgba(45, 74, 30, 0.55)), url('{{ asset("assets/img/maintenance.webp") }}') center/cover no-repeat; padding: 1.2rem 2rem; border-radius: 15px; color: #fff; border: 1px solid rgba(255,255,255,0.4); margin-bottom: 1.5rem;">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <h1 style="font-size:1.5rem; font-weight:700; margin:0; color: #fff !important;"><i class="bi bi-tools me-2"></i>Calendrier des Interventions</h1>
                <a href="{{ path('app_materiel_et_maintenance') }}" class="btn btn-outline-light btn-sm rounded-pill" style="border-color: rgba(255,255,255,0.4); color: white; display: inline-flex; align-items: center; gap: 6px;">
                    <i class="bi bi-arrow-left"></i> Retour
                </a>
            </div>
            <p style="font-size:0.88rem; opacity:0.75; margin:0 0 1rem;">Suivez l'historique et la progression des réparations.</p>
            
            <div style="display:flex; gap:1rem; flex-wrap:wrap;">
                <div style="background:rgba(255,255,255,0.15); backdrop-filter:blur(8px); border:1px solid rgba(255,255,255,0.2); border-radius:12px; padding:1rem 1.8rem; text-align:center; min-width:130px;">
                    <div style="font-size:2rem; font-weight:800;">{{ stats.total }}</div>
                    <div style="font-size:0.75rem; text-transform:uppercase; letter-spacing:1px; opacity:0.85;">Total</div>
                </div>
                <div style="background:rgba(254,202,87,0.2); backdrop-filter:blur(8px); border:1px solid rgba(254,202,87,0.4); border-radius:12px; padding:1rem 1.8rem; text-align:center; min-width:130px;">
                    <div style="font-size:2rem; font-weight:800;">{{ stats.en_cours }}</div>
                    <div style="font-size:0.75rem; text-transform:uppercase; letter-spacing:1px; opacity:0.85;">En Cours</div>
                </div>
            </div>
        </div>

        {% if enRetard is defined and enRetard|length > 0 %}
        <div class="alert alert-danger mb-4 shadow-sm" style="border-radius: 16px; border: none; background: #ffeaa7;" data-aos="zoom-in">
            <h5 class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Rappel Urgent : Matériel en retard de maintenance</h5>
            <ul class="mb-0 mt-3 text-dark">
                {% for mat in enRetard %}
                <li class="py-1">
                    <a href="{{ path('app_materiel_show', {id: mat.id}) }}" class="fw-bold text-danger text-decoration-none">{{ mat.nom }}</a> 
                    - L'intervention était prévue le <strong>{{ mat.dateProchaineMaintenance|date('d/m/Y') }}</strong>
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}

        {# Action Bar & Filters #}
        <div class="mat-action-bar flex-wrap gap-4" data-aos="fade-up" data-aos-delay="100">
            <div class="mat-filters flex-grow-1">
                <form id="filter-form-maintenance" method="get" action="{{ path('app_maintenance_index') }}" class="w-100 d-flex gap-3 align-items-center">
                    <input type="text" name="search" id="filter-search-maint" class="mat-input flex-grow-1" placeholder="Rechercher (ex: Tracteur John Deere...)" value="{{ search }}">
                    <select name="type" class="mat-input">
                        <option value="">Types d'intervention</option>
                        <option value="preventive" {% if type == 'preventive' %}selected{% endif %}>Préventive</option>
                        <option value="corrective" {% if type == 'corrective' %}selected{% endif %}>Corrective</option>
                        <option value="urgente" {% if type == 'urgente' %}selected{% endif %}>Urgente</option>
                    </select>
                    <select name="statut" class="mat-input">
                        <option value="">Tous les statuts</option>
                        <option value="planifiee" {% if statut == 'planifiee' %}selected{% endif %}>Planifié (Rendez-vous)</option>
                        <option value="en_attente" {% if statut == 'en_attente' %}selected{% endif %}>En attente</option>
                        <option value="en_cours" {% if statut == 'en_cours' %}selected{% endif %}>En cours</option>
                        <option value="verifie" {% if statut == 'verifie' %}selected{% endif %}>Vérifié</option>
                        <option value="terminee" {% if statut == 'terminee' %}selected{% endif %}>Terminé</option>
                        <option value="annulee" {% if statut == 'annulee' %}selected{% endif %}>Annulée</option>
                    </select>
                    <button type="submit" class="btn-mat-action" style="display: none;">Filtrer</button>
                    <a href="{{ path('app_maintenance_index') }}" class="btn-mat-outline" style="padding: 12px 25px; flex:none;">Effacer</a>
                </form>
            </div>
            
            <div class="text-end">
                {% if not app.user.googleAccessToken %}
                    <a href="{{ path('app_google_connect') }}" class="btn-mat-primary">
                        <i class="bi bi-calendar-plus-fill"></i> Lier Google & Planifier
                    </a>
                {% else %}
                    <a href="{{ path('app_maintenance_new') }}" class="btn-mat-primary">
                        <i class="bi bi-calendar-plus-fill"></i> Nouvelle Intervention
                    </a>
                {% endif %}
            </div>
        </div>

        {# Grid #}
        <div class="mat-grid" id="maintenance-grid-container">
            {% for m in maintenances %}
                <div class="mat-card" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 100 }}" style="{% if m.statutMaintenance == 'urgente' %}border-top: 5px solid #ff6b6b;{% endif %}">
                    <div class="mat-card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <h3 class="mat-card-title m-0" style="font-size: 1.2rem;">{{ m.materiel.nom }}</h3>
                            
                            {% if m.statutMaintenance == 'terminee' %}
                                <span class="mat-badge badge-success" style="position: static; font-size: 0.7rem;">Terminé</span>
                            {% elseif m.statutMaintenance == 'verifie' %}
                                <span class="mat-badge bg-info text-dark" style="position: static; font-size: 0.7rem;">Vérifié</span>
                            {% elseif m.statutMaintenance == 'en_cours' %}
                                <span class="mat-badge badge-warning" style="position: static; font-size: 0.7rem;">En cours</span>
                            {% elseif m.statutMaintenance == 'en_attente' %}
                                <span class="mat-badge bg-secondary text-white" style="position: static; font-size: 0.7rem;">En attente</span>
                            {% elseif m.statutMaintenance == 'annulee' %}
                                <span class="mat-badge bg-dark text-white" style="position: static; font-size: 0.7rem;">Annulée</span>
                            {% else %}
                                <span class="mat-badge bg-primary text-white" style="position: static; font-size: 0.7rem;">Planifié</span>
                            {% endif %}
                        </div>
                        
                        <p class="mat-card-subtitle mb-4">
                            {% if m.typeMaintenance == 'urgente' %}
                                <span class="text-danger fw-bold"><i class="bi bi-shield-exclamation"></i> Urgente</span>
                            {% elseif m.typeMaintenance == 'preventive' %}
                                <span class="text-info"><i class="bi bi-shield-check"></i> Préventive</span>
                            {% else %}
                                <span class="text-secondary"><i class="bi bi-wrench"></i> Corrective</span>
                            {% endif %}
                        </p>
                        
                        <ul class="mat-details-list">
                            <li>
                                <i class="bi bi-calendar-event" style="color: var(--mat-primary);"></i>
                                Date: 
                                <strong class="fs-5">{{ m.dateMaintenance ? m.dateMaintenance|date('d/m/Y') : 'Non fixée' }}</strong>
                            </li>
                        </ul>
                        
                        {# Mini progression bar #}
                        <div class="progress mt-2 mb-3" style="height: 6px; border-radius: 10px; background-color: #e9ecef;">
                            {% if m.statutMaintenance == 'terminee' %}
                                <div class="progress-bar bg-success" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                            {% elseif m.statutMaintenance == 'verifie' %}
                                <div class="progress-bar bg-info" role="progressbar" style="width: 80%" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                            {% elseif m.statutMaintenance == 'en_cours' %}
                                <div class="progress-bar bg-warning" role="progressbar" style="width: 60%" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100"></div>
                            {% elseif m.statutMaintenance == 'en_attente' %}
                                <div class="progress-bar bg-secondary" role="progressbar" style="width: 40%" aria-valuenow="40" aria-valuemin="0" aria-valuemax="100"></div>
                            {% elseif m.statutMaintenance == 'annulee' %}
                                <div class="progress-bar bg-danger" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                            {% else %}
                                <div class="progress-bar" role="progressbar" style="width: 20%; background-color: var(--mat-primary);" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100"></div>
                            {% endif %}
                        </div>
                        
                        <p class="text-muted small mb-4" style="height: 40px; overflow: hidden;">
                            {{ m.description ?: 'Aucun détail fourni.' }}
                        </p>
                        
                        <div class="mat-card-footer mt-auto" style="display:flex; gap: 8px; align-items: center;">
                            {% if m.googleCalendarEventId or m.dateMaintenance %}
                                <a href="https://calendar.google.com/calendar/r/day/{{ m.dateMaintenance|date('Y/m/d') }}" target="_blank" class="btn-mat-outline d-flex align-items-center justify-content-center" style="border-color: #4285F4; color: #4285F4; width: 45px; padding: 8px 0;" title="Ouvrir Google Agenda"><i class="bi bi-google fs-6"></i></a>
                            {% endif %}
                            
                            <a href="{{ path('app_maintenance_show', {'id': m.idMaintenance}) }}" class="btn-mat-action" style="flex: 1; text-align: center; padding: 8px 0; font-size: 0.9rem;">Timeline</a>
                            
                            <a href="{{ path('app_maintenance_edit', {'id': m.idMaintenance}) }}" class="btn-mat-outline d-flex align-items-center justify-content-center" style="width: 45px; padding: 8px 0; border-color: #e67e22; color: #e67e22;" title="Modifier"><i class="bi bi-pencil fs-6"></i></a>
                            
                            <form method="post" action="{{ path('app_maintenance_delete', {'id': m.idMaintenance}) }}" onsubmit="return confirm('Supprimer cette intervention ?');" style="margin:0;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_maintenance_' ~ m.idMaintenance) }}">
                                <button type="submit" class="btn-mat-outline d-flex align-items-center justify-content-center" style="width: 45px; padding: 8px 0; border-color: #e74c3c; color: #e74c3c; background: transparent;" title="Supprimer">
                                    <i class="bi bi-trash fs-6"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 py-5 text-center w-100" style="grid-column: 1 / -1;">
                    <h3 class="text-muted"><i class="bi bi-clipboard-check fs-1 d-block mb-3"></i>Aucune intervention planifiée.</h3>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('filter-form-maintenance');
        const inputs = form.querySelectorAll('input, select');
        const searchInput = document.getElementById('filter-search-maint');
        
        if (searchInput && searchInput.value) {
            const val = searchInput.value;
            searchInput.focus();
            searchInput.setSelectionRange(val.length, val.length);
        }

        let debounceTimeout;

        inputs.forEach(input => {
            const eventType = input.tagName === 'SELECT' ? 'change' : 'input';
            input.addEventListener(eventType, () => {
                clearTimeout(debounceTimeout);
                debounceTimeout = setTimeout(() => {
                    const url = new URL(form.action, window.location.origin);
                    const formData = new FormData(form);
                    const params = new URLSearchParams(formData);
                    url.search = params.toString();

                    window.history.pushState({}, '', url);

                    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(response => response.text())
                        .then(html => {
                            const parser = new DOMParser();
                            const doc = parser.parseFromString(html, 'text/html');
                            
                            const newGrid = doc.getElementById('maintenance-grid-container');
                            
                            if (newGrid) {
                                document.getElementById('maintenance-grid-container').innerHTML = newGrid.innerHTML;
                            }
                        })
                        .catch(error => console.error("Filter error: ", error));
                }, 400); // 400ms debounce
            });
        });
    });
</script>
{% endblock %}
