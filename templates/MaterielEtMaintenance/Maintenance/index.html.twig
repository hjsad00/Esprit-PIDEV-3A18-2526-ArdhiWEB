{% extends 'base.html.twig' %}

{% block title %}Gestion des Maintenances{% endblock %}

{% block body_class %}materiel-theme{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/materiel/materiel.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="materiel-page-wrapper">
    <div class="container">
        
        {# Glassmorphism Stats Header #}
        <div class="mat-stats-header" data-aos="fade-down" style="background: linear-gradient(135deg, var(--mat-primary) 0%, var(--mat-accent) 100%);">
            <h1 class="display-5 fw-bold mb-3"><i class="bi bi-tools me-3"></i>Calendrier des Interventions</h1>
            <p class="fs-5 opacity-75 mb-0">Suivez l'historique et la progression des réparations.</p>
            
            <div class="mat-stats-grid">
                <div class="mat-stat-box">
                    <div class="mat-stat-value">{{ stats.total }}</div>
                    <div class="mat-stat-label">Total</div>
                </div>
                <div class="mat-stat-box" style="{% if stats.en_cours > 0 %}border-color: #feca57; background: rgba(254, 202, 87, 0.2);{% endif %}">
                    <div class="mat-stat-value">{{ stats.en_cours }}</div>
                    <div class="mat-stat-label">En Cours</div>
                </div>
            </div>
        </div>

        {% if enRetard is defined and enRetard|length > 0 %}
        <div class="alert alert-danger mb-4 shadow-sm" style="border-radius: 16px; border: none; background: #ffeaa7;" data-aos="zoom-in">
            <h5 class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Rappel Urgent : Matériel en retard de maintenance</h5>
            <ul class="mb-0 mt-3 text-dark">
                {% for mat in enRetard %}
                <li class="py-1">
                    <a href="{{ path('app_materiel_show', {id: mat.id}) }}" class="fw-bold text-danger text-decoration-none">{{ mat.nom }}</a> 
                    - L'intervention était prévue le <strong>{{ mat.dateProchaineMaintenance|date('d/m/Y') }}</strong>
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}

        {# Action Bar & Filters #}
        <div class="mat-action-bar flex-wrap gap-4" data-aos="fade-up" data-aos-delay="100">
            <div class="mat-filters flex-grow-1">
                <form id="filter-form-maintenance" method="get" class="w-100 d-flex gap-3 align-items-center">
                    <input type="text" name="search" class="mat-input flex-grow-1" placeholder="Rechercher (ex: Tracteur John Deere...)" value="{{ search }}" oninput="clearTimeout(window.searchTimeout); window.searchTimeout = setTimeout(() => { document.getElementById('filter-form-maintenance').submit(); }, 600);">
                    <select name="type" class="mat-input" onchange="document.getElementById('filter-form-maintenance').submit();">
                        <option value="">Types d'intervention</option>
                        <option value="preventive" {% if type == 'preventive' %}selected{% endif %}>Préventive</option>
                        <option value="corrective" {% if type == 'corrective' %}selected{% endif %}>Corrective</option>
                        <option value="urgente" {% if type == 'urgente' %}selected{% endif %}>Urgente</option>
                    </select>
                    <select name="statut" class="mat-input" onchange="document.getElementById('filter-form-maintenance').submit();">
                        <option value="">Tous les statuts</option>
                        <option value="planifiee" {% if statut == 'planifiee' %}selected{% endif %}>Planifié (Rendez-vous)</option>
                        <option value="en_attente" {% if statut == 'en_attente' %}selected{% endif %}>En attente</option>
                        <option value="en_cours" {% if statut == 'en_cours' %}selected{% endif %}>En cours</option>
                        <option value="verifie" {% if statut == 'verifie' %}selected{% endif %}>Vérifié</option>
                        <option value="terminee" {% if statut == 'terminee' %}selected{% endif %}>Terminé</option>
                        <option value="annulee" {% if statut == 'annulee' %}selected{% endif %}>Annulée</option>
                    </select>
                    <button type="submit" class="btn-mat-action" style="display: none;">Filtrer</button>
                    <a href="{{ path('app_maintenance_index') }}" class="btn-mat-outline" style="padding: 12px 25px; flex:none;">Effacer</a>
                </form>
            </div>
            
            <div class="text-end">
                {% if not app.user.googleAccessToken %}
                    <a href="{{ path('app_google_connect') }}" class="btn-mat-primary">
                        <i class="bi bi-calendar-plus-fill"></i> Lier Google & Planifier
                    </a>
                {% else %}
                    <a href="{{ path('app_maintenance_new') }}" class="btn-mat-primary">
                        <i class="bi bi-calendar-plus-fill"></i> Nouvelle Intervention
                    </a>
                {% endif %}
            </div>
        </div>

        {# Grid #}
        <div class="mat-grid">
            {% for m in maintenances %}
                <div class="mat-card" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 100 }}" style="{% if m.statutMaintenance == 'urgente' %}border-top: 5px solid #ff6b6b;{% endif %}">
                    <div class="mat-card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <h3 class="mat-card-title m-0" style="font-size: 1.2rem;">{{ m.materiel.nom }}</h3>
                            
                            {% if m.statutMaintenance == 'terminee' %}
                                <span class="mat-badge badge-success" style="position: static; font-size: 0.7rem;">Terminé</span>
                            {% elseif m.statutMaintenance == 'verifie' %}
                                <span class="mat-badge bg-info text-dark" style="position: static; font-size: 0.7rem;">Vérifié</span>
                            {% elseif m.statutMaintenance == 'en_cours' %}
                                <span class="mat-badge badge-warning" style="position: static; font-size: 0.7rem;">En cours</span>
                            {% elseif m.statutMaintenance == 'en_attente' %}
                                <span class="mat-badge bg-secondary text-white" style="position: static; font-size: 0.7rem;">En attente</span>
                            {% elseif m.statutMaintenance == 'annulee' %}
                                <span class="mat-badge bg-dark text-white" style="position: static; font-size: 0.7rem;">Annulée</span>
                            {% else %}
                                <span class="mat-badge bg-primary text-white" style="position: static; font-size: 0.7rem;">Planifié</span>
                            {% endif %}
                        </div>
                        
                        <p class="mat-card-subtitle mb-4">
                            {% if m.typeMaintenance == 'urgente' %}
                                <span class="text-danger fw-bold"><i class="bi bi-shield-exclamation"></i> Urgente</span>
                            {% elseif m.typeMaintenance == 'preventive' %}
                                <span class="text-info"><i class="bi bi-shield-check"></i> Préventive</span>
                            {% else %}
                                <span class="text-secondary"><i class="bi bi-wrench"></i> Corrective</span>
                            {% endif %}
                        </p>
                        
                        <ul class="mat-details-list">
                            <li>
                                <i class="bi bi-calendar-event" style="color: var(--mat-primary);"></i>
                                Date: 
                                <strong class="fs-5">{{ m.dateMaintenance ? m.dateMaintenance|date('d/m/Y') : 'Non fixée' }}</strong>
                            </li>
                        </ul>
                        
                        {# Mini progression bar #}
                        <div class="progress mt-2 mb-3" style="height: 6px; border-radius: 10px; background-color: #e9ecef;">
                            {% if m.statutMaintenance == 'terminee' %}
                                <div class="progress-bar bg-success" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                            {% elseif m.statutMaintenance == 'verifie' %}
                                <div class="progress-bar bg-info" role="progressbar" style="width: 80%" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                            {% elseif m.statutMaintenance == 'en_cours' %}
                                <div class="progress-bar bg-warning" role="progressbar" style="width: 60%" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100"></div>
                            {% elseif m.statutMaintenance == 'en_attente' %}
                                <div class="progress-bar bg-secondary" role="progressbar" style="width: 40%" aria-valuenow="40" aria-valuemin="0" aria-valuemax="100"></div>
                            {% elseif m.statutMaintenance == 'annulee' %}
                                <div class="progress-bar bg-danger" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                            {% else %}
                                <div class="progress-bar" role="progressbar" style="width: 20%; background-color: var(--mat-primary);" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100"></div>
                            {% endif %}
                        </div>
                        
                        <p class="text-muted small mb-4" style="height: 40px; overflow: hidden;">
                            {{ m.description ?: 'Aucun détail fourni.' }}
                        </p>
                        
                        <div class="mat-card-footer mt-auto" style="display:flex; gap: 10px; align-items: center;">
                            {% if m.googleCalendarEventId or m.dateMaintenance %}
                                <a href="https://calendar.google.com/calendar/r/day/{{ m.dateMaintenance|date('Y/m/d') }}" target="_blank" class="btn-mat-outline d-flex align-items-center justify-content-center" style="border-color: #4285F4; color: #4285F4; width: 60px; padding: 10px 0;" title="Ouvrir Google Agenda"><i class="bi bi-google fs-5"></i></a>
                            {% endif %}
                            <a href="{{ path('app_maintenance_show', {'id': m.idMaintenance}) }}" class="btn-mat-action" style="flex: 1; text-align: center;">Timeline</a>
                            <a href="{{ path('app_maintenance_edit', {'id': m.idMaintenance}) }}" class="btn-mat-outline d-flex align-items-center justify-content-center" style="width: 60px; padding: 10px 0;"><i class="bi bi-pencil fs-5"></i></a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 py-5 text-center w-100" style="grid-column: 1 / -1;">
                    <h3 class="text-muted"><i class="bi bi-clipboard-check fs-1 d-block mb-3"></i>Aucune intervention planifiée.</h3>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
