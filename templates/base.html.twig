<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>{% block title %}Ardhi - Agriculture{% endblock %}</title>
  <link href="{{ asset('assets/img/ardhi_logo.png') }}" rel="icon">
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&family=Marcellus:wght@400&display=swap" rel="stylesheet">
  <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/aos/aos.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/swiper/swiper-bundle.min.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/glightbox/css/glightbox.min.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/css/main.css') }}" rel="stylesheet">
  {% block stylesheets %}{% endblock %}
</head>
{% set currentRoute = app.request.attributes.get('_route') %}
{% set isEvenementPath = app.request.pathInfo starts with('/evenement') %}
<body class="{% if app.request.pathInfo == '/' %}index-page{% endif %} {{ (currentRoute starts with('app_evenement') or isEvenementPath) ? 'event-page' : '' }} {{ currentRoute == 'app_evenement_index' ? 'event-index-page' : '' }}">
  <style>
    /* Keep evenement pages visually consistent (including scrolled state) */
    body.event-page .header,
    .event-page .header {
      background: transparent !important;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    body.event-page.scrolled .header,
    .scrolled .event-page .header {
      background: rgba(15, 20, 15, 0.85) !important;
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
    }
    body.event-page .header .navmenu ul > li > a,
    body.event-page .header .nav-user-circle,
    body.event-page .header .mobile-nav-toggle {
      color: #fff !important;
    }
    body.event-page .header .navmenu ul > li > a:hover {
      background: rgba(255, 255, 255, 0.12) !important;
      border-radius: 8px;
    }
    /* Fixed User Dropdown Legibility */
    body.event-page .header .navmenu .dropdown ul,
    .event-page .header .navmenu .dropdown ul {
      background-color: #ffffff !important;
      visibility: visible !important;
      opacity: 1 !important;
      border: 1px solid rgba(0,0,0,0.1) !important;
    }
    body.event-page .header .navmenu .dropdown ul a,
    .event-page .header .navmenu .dropdown ul a {
      color: #212529 !important;
      font-weight: 600 !important;
    }
    body.event-page .header .navmenu .dropdown ul a i,
    .event-page .header .navmenu .dropdown ul a i {
      color: #116530 !important;
    }
    body.event-page .header .navmenu .dropdown ul a:hover,
    .event-page .header .navmenu .dropdown ul a:hover {
      background-color: #f8f9fa !important;
      color: #116530 !important;
    }
  </style>
  <header id="header" class="header d-flex align-items-center fixed-top">
    <div class="container-fluid container-xl position-relative d-flex align-items-center justify-content-between">
      <a href="/" class="logo d-flex align-items-center">
        <img src="{{ asset('assets/img/ardhi_logo.png') }}" alt="Ardhi" style="max-height: 50px;">
      </a>
      {% set currentRoute = app.request.attributes.get('_route') %}
      <nav id="navmenu" class="navmenu">
        <ul>
          <li><a href="/">Diagnostic IA</a></li>
          <li><a href="#">Marketplace</a></li>
          <li><a href="#">Maintenance</a></li>
          <li><a href="#">Cultures</a></li>
          <li class="{{ currentRoute starts with('app_evenement') ? 'active' : '' }}">
            <a href="{{ path('app_evenement_index') }}">Evènements</a>
          </li>
          <li><a href="#">Employes</a></li>
          {% if app.user %}
          <li class="dropdown"><a href="#" class="d-flex align-items-center px-2">
            <div class="nav-user-circle">
              <i class="bi bi-person-fill" style="font-size: 1.3rem;"></i>
            </div></a>
            <ul>
              <li><a href="{{ path('app_profile') }}"><i class="bi bi-person me-2"></i>Mon Profil {{ app.user.prenom ? ('(' ~ app.user.prenom ~ ')') : '' }}</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a href="{{ path('app_logout') }}" class="text-danger"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
            </ul>
          </li>
          {% else %}
          <li><a href="{{ path('app_login') }}" class="nav-cta-btn">Se connecter</a></li>
          {% endif %}
        </ul>
        <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
      </nav>
    </div>
  </header>
  <main class="main" style="min-height: 70vh;">
    {% for label, messages in app.flashes %}
    <div class="container mt-4">
      {% for message in messages %}
      <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
        {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
    {% block body %}{% endblock %}
  </main>
  <footer id="footer" class="footer dark-background">
    <div class="footer-top">
      <div class="container">
        <div class="row gy-4">
          <div class="col-lg-4 col-md-6 footer-about">
            <a href="/" class="logo d-flex align-items-center"><span class="sitename">Ardhi</span></a>
            <div class="footer-contact pt-3">
              <p>Votre plateforme d'agriculture intelligente</p>
              <p>Tunisie</p>
              <p class="mt-3"><strong>Email:</strong> <span>contact@ardhi.com</span></p>
            </div>
          </div>
          <div class="col-lg-2 col-md-3 footer-links">
            <h4>Liens utiles</h4>
            <ul>
              <li><a href="/">Accueil</a></li>
              <li><a href="#">A propos</a></li>
              <li><a href="#">Services</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="copyright text-center">
      <div class="container">
        <div>Copyright <strong><span>Ardhi</span></strong>. Tous droits reserves</div>
      </div>
    </div>
  </footer>
  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>
  <div id="preloader"></div>
  <script src="{{ asset('assets/vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
  <script src="{{ asset('assets/vendor/aos/aos.js') }}"></script>
  <script src="{{ asset('assets/vendor/swiper/swiper-bundle.min.js') }}"></script>
  <script src="{{ asset('assets/vendor/glightbox/js/glightbox.min.js') }}"></script>
  <script src="{{ asset('assets/js/main.js') }}"></script>
  {% block javascripts %}{% endblock %}
</body>
</html>
