<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>{% block title %}Ardhi - Agriculture{% endblock %}</title>

  <!-- Favicons -->
  <link href="{{ asset('assets/img/ardhi_logo.png') }}" rel="icon">
  <link href="{{ asset('assets/img/ardhi_logo.png') }}" rel="apple-touch-icon">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700;1,800&family=Marcellus:wght@400&display=swap" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/aos/aos.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/swiper/swiper-bundle.min.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/glightbox/css/glightbox.min.css') }}" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="{{ asset('assets/css/main.css') }}" rel="stylesheet">
  
  {% block stylesheets %}{% endblock %}

  <style>
    /* Correction Ultime Header - Priorité Maximale */
    body.premium-header-active #header.header {
      background: transparent !important;
      background-color: transparent !important;
      transition: all 0.4s ease-in-out !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.15) !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
    }

    /* Texte et titres en Blanc pur */
    body.premium-header-active #header.header .sitename,
    body.premium-header-active #header.header .navmenu ul li a {
      color: #ffffff !important;
      text-shadow: 0 2px 10px rgba(0,0,0,0.5) !important;
      opacity: 1 !important;
      font-weight: 700 !important;
    }

    /* État au scroll : Effet verre foncé très classe pour Ardhi */
    body.premium-header-active.scrolled #header.header {
      background: rgba(26, 45, 27, 0.95) !important; /* Vert Noir Ardhi Premium */
      backdrop-filter: blur(25px) saturate(180%) !important;
      -webkit-backdrop-filter: blur(25px) saturate(180%) !important;
      padding: 10px 0 !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
      box-shadow: 0 4px 40px rgba(0,0,0,0.4) !important;
    }

    /* Sécurité pour le logo et les icônes */
    body.premium-header-active #header.header .mobile-nav-toggle,
    body.premium-header-active #header.header i {
      color: #ffffff !important;
    }

    /* Liens du menu déroulant (Dropdown) en noir/sombre pour lisibilité sur fond blanc */
    body.premium-header-active #header.header .navmenu .dropdown ul li a {
      color: #212529 !important;
      text-shadow: none !important;
      font-weight: 500 !important;
    }

    body.premium-header-active #header.header .navmenu .dropdown ul li a:hover {
      color: #116530 !important; /* Vert Ardhi au survol */
      background: #f8f9fa !important;
    }
  </style>
</head>

<body class="{% block body_class %}index-page{% endblock %} premium-header-active">

  <header id="header" class="header d-flex align-items-center fixed-top">
    <div class="container-fluid container-xl position-relative d-flex align-items-center justify-content-between">

      <a href="{{ is_granted('ROLE_ADMIN') ? path('admin_dashboard') : '/' }}" class="logo d-flex align-items-center text-decoration-none">
        <img src="{{ asset('assets/img/ardhi_logo.png') }}" alt="Ardhi">
        <h1 class="sitename">ARDHI</h1>
      </a>

      {% set currentRoute = app.request.get('_route') %}
      {% set isUserAndDiagRoute = currentRoute starts with 'app_user_and_diag_' 
          or currentRoute starts with 'app_client_dashboard'
          or currentRoute starts with 'app_expert_dashboard'
          or currentRoute starts with 'app_login'
          or currentRoute starts with 'app_register'
          or currentRoute starts with 'app_profile'
          or currentRoute starts with 'app_logout'
          or currentRoute starts with 'admin_diags_'
          or currentRoute starts with 'admin_users_'
          or currentRoute starts with 'admin_abonnement_'
          or currentRoute starts with 'admin_badge_'
          or currentRoute starts with 'admin_community_'
          or currentRoute starts with 'admin_offre_'
          or currentRoute starts with 'admin_traitement_'
          or currentRoute starts with 'admin_farm_health_'
          or currentRoute starts with 'admin_prevention_'
          or currentRoute starts with 'admin_treatment_'
          or currentRoute starts with 'admin_vulnerability_'
          or currentRoute starts with 'admin_review_'
          or currentRoute starts with 'admin_diag_notification_'
      %}

      <nav id="navmenu" class="navmenu">
        <ul>
          {% if app.request.get('_route') == 'app_employe_dashboard' %}
              {{ render(controller('App\\Controller\\EmployeTache\\NotificationController::renderNavbarIcon')) }}
          {% endif %}
          <li>
            {% if is_granted('ROLE_ADMIN') %}
              <a href="{{ path('admin_diags_dashboard') }}" class="{{ app.request.get('_route') == 'admin_diags_dashboard' ? 'active' : '' }}">Diagnostic IA</a>
            {% else %}
              <a href="{{ path('app_user_and_diag_hub') }}" class="{{ app.request.get('_route') == 'app_user_and_diag_hub' ? 'active' : '' }}">Diagnostic IA</a>
            {% endif %}
          </li>
          <li>
            {% if is_granted('ROLE_ADMIN') %}
              <a href="{{ path('admin_marketplace_accueil') }}" class="{{ app.request.get('_route') == 'admin_marketplace_accueil' ? 'active' : '' }}">Marketplace</a>
            {% else %}
              <a href="{{ path('app_marketplace') }}" class="{{ app.request.get('_route') == 'app_marketplace' ? 'active' : '' }}">Marketplace</a>
            {% endif %}
          </li>
          <li>
            {% if is_granted('ROLE_ADMIN') %}
              <a href="{{ path('admin_materiel_index') }}" class="{{ app.request.get('_route') == 'admin_materiel_index' ? 'active' : '' }}">Matériel & Maintenance</a>
            {% else %}
              <a href="{{ path('app_materiel_et_maintenance') }}" class="{{ (app.request.get('_route') == 'app_materiel_et_maintenance') or (app.request.get('_route') starts with 'app_materiel_') or (app.request.get('_route') starts with 'app_maintenance_') ? 'active' : '' }}">Matériel & Maintenance</a>
            {% endif %}
          </li>
          <li>
            {% if is_granted('ROLE_AGRICULTEUR') %}
              <a href="{{ path('farmer_agriculture_index') }}" class="{{ app.request.get('_route') == 'farmer_agriculture_index' ? 'active' : '' }}">Cultures</a>
            {% elseif is_granted('ROLE_ADMIN') %}
              <a href="{{ path('admin_parcelle_index') }}" class="{{ app.request.get('_route') == 'admin_parcelle_index' ? 'active' : '' }}">Cultures</a>
            {% else %}
              <a href="#">Cultures</a>
            {% endif %}
          </li>
          <li>
            {% if is_granted('ROLE_ADMIN') %}
              <a href="{{ path('app_evenement_admin_dashboard') }}" class="{{ app.request.get('_route') starts with 'app_evenement_admin' ? 'active' : '' }}">Évènements</a>
            {% else %}
              <a href="{{ path('app_evenement_index') }}" class="{{ app.request.get('_route') starts with 'app_evenement' ? 'active' : '' }}">Évènements</a>
            {% endif %}
          </li>
          {% if app.user %}
          <li>
            {% if is_granted('ROLE_ADMIN') %}
              <a href="{{ path('admin_agriculteurs_employe') }}" class="{{ app.request.get('_route') == 'admin_agriculteurs_employe' ? 'active' : '' }}">Employés</a>
            {% elseif is_granted('ROLE_AGRICULTEUR') %}
              <a href="{{ path('app_employe_dashboard') }}" class="{{ app.request.get('_route') == 'app_employe_dashboard' ? 'active' : '' }}">Employés</a>
            {% else %}
              <a href="javascript:void(0)" style="cursor:default;opacity:0.7" title="Module Agriculteur / Réservé aux agriculteurs et gérants d'exploitation">Employés <i class="bi bi-lock-fill" style="font-size:0.75rem;margin-left:3px"></i></a>
            {% endif %}
          </li>
          {% endif %}
          
          {% if app.user %}
            {% if isUserAndDiagRoute %}
              <!-- NOTIFICATIONS BELL (UserAndDiag Only) -->
              <li class="dropdown" id="notificationDropdownContainer" onmouseenter="onBellHover()">
                <a href="#" class="d-flex align-items-center px-2">
                  <div style="position: relative;">
                    <i class="bi bi-bell-fill" style="font-size: 1.2rem; color: white;"></i>
                    <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none; font-size: 0.55rem; padding: 0.25em 0.4em;">
                      0
                    </span>
                  </div>
                </a>
                <ul id="notificationList" style="width: 320px; max-height: 400px; overflow-y: auto; right: 0; left: auto; padding: 0;">
                  <li><div style="padding: 12px 15px; font-weight: bold; border-bottom: 1px solid #eee; font-size: 0.9rem; color: #333;">Notifications</div></li>
                  <li id="emptyNotificationMsg" class="text-center text-muted" style="font-size: 0.85rem; padding: 20px;">Aucune nouvelle notification.</li>
                </ul>
              </li>
            {% endif %}

            <li class="dropdown"><a href="#" class="d-flex align-items-center px-2">
              <div class="nav-user-circle" style="background: rgba(255,255,255,0.1); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                {% if app.user.avatar %}
                    <img src="{{ app.user.avatar }}" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;">
                {% else %}
                    <i class="bi bi-person-fill" style="font-size: 1.1rem; color: white;"></i>
                {% endif %}
              </div></a>
              <ul>
                <li><a href="{{ path('app_profile') }}">Mon Profil {{ app.user.prenom ? ('(' ~ app.user.prenom ~ ')') : '' }}</a></li>
                <li><a href="{{ path('app_logout') }}">Déconnexion</a></li>
              </ul>
            </li>
          {% else %}
            <li><a href="{{ path('app_login') }}" class="nav-cta-btn">Se connecter</a></li>
          {% endif %}
        </ul>
        <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
      </nav>

    </div>
  </header>

  <main class="main" style="min-height: 70vh;">


    {% if app.flashes|length > 0 %}
      <div class="container mt-3">
        {% for label, messages in app.flashes %}
          {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show shadow border-start border-4 py-3" role="alert"
                 style="border-left-color: {% if label == 'success' %}#2ecc71{% else %}#e74c3c{% endif %} !important; background: white; z-index: 1000000;">
              <i class="bi bi-{% if label == 'success' %}check-circle-fill text-success{% else %}exclamation-triangle-fill text-danger{% endif %} me-2"></i>
              {{ message|raw }}
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          {% endfor %}
        {% endfor %}
      </div>
    {% endif %}

    {% block body %}{% endblock %}
  </main>

  <footer id="footer" class="footer dark-background">
    <div class="footer-top">
      <div class="container">
        <div class="row gy-4">
          <div class="col-lg-4 col-md-6 footer-about">
            <a href="/" class="logo d-flex align-items-center">
              <span class="sitename">Ardhi</span>
            </a>
            <div class="footer-contact pt-3">
              <p>Votre plateforme d'agriculture intelligente</p>
              <p>Tunisie</p>
              <p class="mt-3"><strong>Email:</strong> <span>contact@ardhi.com</span></p>
            </div>
          </div>

          <div class="col-lg-2 col-md-3 footer-links">
            <h4>Liens utiles</h4>
            <ul>
              <li><a href="{{ is_granted('ROLE_ADMIN') ? path('admin_dashboard') : '/' }}">Accueil</a></li>
              <li><a href="#">À propos</a></li>
              <li><a href="#">Services</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="copyright text-center">
      <div class="container d-flex flex-column flex-lg-row justify-content-center justify-content-lg-between align-items-center">
        <div class="d-flex flex-column align-items-center align-items-lg-start">
          <div>
            © Copyright <strong><span>Ardhi</span></strong>. Tous droits réservés
          </div>
        </div>
      </div>
    </div>
  </footer>

  <!-- Scroll Top -->
  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Vendor JS Files -->
  <script src="{{ asset('assets/vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
  <script src="{{ asset('assets/vendor/aos/aos.js') }}"></script>
  <script src="{{ asset('assets/vendor/swiper/swiper-bundle.min.js') }}"></script>
  <script src="{{ asset('assets/vendor/glightbox/js/glightbox.min.js') }}"></script>

  <!-- Main JS File -->
  <script src="{{ asset('assets/js/main.js') }}"></script>

  {% block javascripts %}{% endblock %}

  <script>
    // Force reload when navigating via back button (bfcache)
    // Applies globally to ensure fresh data across the application
    window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
            window.location.reload();
        }
    });

    {% if app.user and isUserAndDiagRoute %}
    // --- Notification System (UserAndDiag Only) ---
    function fetchNotifications() {
        fetch('{{ path("app_user_and_diag_notifications_unread") }}', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(data => {
            const badge = document.getElementById('notificationBadge');
            const list = document.getElementById('notificationList');
            const emptyMsg = document.getElementById('emptyNotificationMsg');

            if (!badge || !list) return;

            const notifs = data.notifications || [];
            if (notifs.length > 0) {
                // Populate global IDs for hover logic
                window.loadedNotifIds = notifs.map(n => n.id);

                const maxSeen = parseInt(localStorage.getItem('maxSeenNotifId_{{ app.user.id }}') || '0');
                const badgeCount = notifs.filter(n => !n.isRead && n.id > maxSeen).length;

                if (badgeCount > 0) {
                    badge.style.display = 'block';
                    badge.textContent = badgeCount > 99 ? '99+' : badgeCount;
                } else {
                    badge.style.display = 'none';
                }

                emptyMsg.style.display = 'none';

                // Clear existing old items but keep header
                const items = list.querySelectorAll('.notif-item');
                items.forEach(i => i.remove());

                notifs.forEach(n => {
                    const li = document.createElement('li');
                    li.className = 'notif-item';

                    let link = '/user-and-diag/notifications/read-and-redirect/' + n.id;

                    let icon = 'bi-info-circle text-primary';
                    if (n.type === 'LIKED' || n.type === 'LIKE') icon = 'bi-heart-fill text-danger';
                    if (n.type === 'DISLIKE') icon = 'bi-hand-thumbs-down-fill text-secondary';
                    if (n.type === 'COMMENT' || n.type === 'COMMENT_REPLY') icon = 'bi-chat-left-text-fill text-info';
                    if (n.type === 'MENTION') icon = 'bi-at text-success';
                    if (n.type === 'REVIEW') icon = 'bi-clipboard-check text-warning';

                    // Style depending on read status
                    const bgStyle = n.isRead ? 'background-color: transparent; opacity: 0.7;' : 'background-color: rgba(93, 184, 122, 0.05); border-left: 3px solid #5db87a;';
                    const textColor = n.isRead ? '#777' : '#333';
                    const boldWeight = n.isRead ? 'normal' : '600';

                    li.innerHTML = `
                        <a href="${link}" style="display: flex; gap: 12px; padding: 12px 15px; border-bottom: 1px solid #eee; text-decoration: none; align-items: start; transition: 0.3s; ${bgStyle}">
                            <i class="bi ${icon}" style="font-size: 1.1rem; margin-top: 2px;"></i>
                            <div>
                                <span style="font-size: 0.85rem; color: ${textColor}; display: block; line-height: 1.4; font-weight: ${boldWeight};">${n.message}</span>
                                <span style="font-size: 0.7rem; color: #aaa;">${n.date}</span>
                            </div>
                        </a>
                    `;
                    list.appendChild(li);
                });
            } else {
                badge.style.display = 'none';
                emptyMsg.style.display = 'block';
            }
        })
        .catch(err => console.error("Could not fetch notifications", err));
    }

    function onBellHover() {
        const badge = document.getElementById('notificationBadge');
        if (badge && badge.style.display !== 'none') {
            badge.style.display = 'none';
            if (window.loadedNotifIds && window.loadedNotifIds.length > 0) {
                const maxId = Math.max(...window.loadedNotifIds);
                localStorage.setItem('maxSeenNotifId_{{ app.user.id }}', maxId);
            }
        }
    }

    // Call on load and check periodically
    document.addEventListener('DOMContentLoaded', () => {
        fetchNotifications();
        setInterval(fetchNotifications, 60000); // Check every minute
    });
    {% endif %}
  </script>

</body>
</html>