{% extends 'base.html.twig' %}

{% block title %}Ardhi - Diagnostic IA Dashboard{% endblock %}

{% block body_class %}dashboard-page{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/UserAndDiag/dashboard.css') }}" rel="stylesheet">
{% endblock %}



{% block body %}
<!-- Dashboard Container -->
<div class="dashboard-wrapper">
    <div class="dashboard-overlay"></div>
    
    <div class="dashboard-content" 
         data-controller="user-and-diag--dashboard-refresh" 
         data-user-and-diag--dashboard-refresh-url-value="{{ path('app_client_dashboard_stats') }}"
         data-user-and-diag--dashboard-refresh-interval-value="10000"
         data-user-and-diag--dashboard-refresh-last-points-value="{{ gamification.points }}">
        
        <!-- Hero Section -->
        <div class="hero-panel fade-up">
            <div class="avatar-circle">
                <i class="bi bi-person-fill"></i>
            </div>
            <div class="welcome-text">
                <h1>Bonjour, {{ user.prenom|default('Agriculteur') }}</h1>
                <p>Gérez votre exploitation intelligemment avec Ardhi</p>
            </div>
            
            <div class="gamification-stats">
                <div class="level-info">
                    <div class="level-text" data-user-and-diag--dashboard-refresh-target="level">Niveau {{ gamification.level }}</div>
                    <div class="progress">
                        <div class="progress-bar" role="progressbar" 
                             style="width: {{ gamification.progress }}%" 
                             aria-valuenow="{{ gamification.progress }}" 
                             aria-valuemin="0" aria-valuemax="100"
                             data-user-and-diag--dashboard-refresh-target="progress"></div>
                    </div>
                </div>
                <div class="points-info">
                    <div class="points-val" data-user-and-diag--dashboard-refresh-target="points">{{ gamification.points }} pts</div>
                    <div class="points-lbl">points</div>
                </div>
            </div>
            
            <div class="badges-container">
                <div style="font-size: 0.6rem; color: rgba(180,210,190,0.5); font-weight: bold; margin-bottom: 4px; margin-left: 10px;">BADGES RÉCENTS</div>
                <div class="badges-list" data-user-and-diag--dashboard-refresh-target="badges">
                    {% for badge in badges|slice(0, 3) %}
                    <div class="badge-item" title="{{ badge.description }}">
                        <div class="icon">{{ badge.icon }}</div>
                        <div class="name">{{ badge.name }}</div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Intelligence Row -->
        <div class="intelligence-row">
            <!-- Weather Widget -->
            <div class="intell-card weather-card fade-up is-collapsed" style="transition-delay: 100ms;">
                <div class="header" data-action="click->user-and-diag--dashboard-refresh#toggleCollapse">
                    <div class="d-flex align-items-center gap-2">
                        <h3>MÉTÉO DIRECT</h3>
                        <span class="toggle-icon">▼</span>
                    </div>
                    <p class="cond">{{ weather.condition }}</p>
                </div>
                <div class="weather-body" style="display: none;" data-user-and-diag--dashboard-refresh-target="weatherBody">
                    <div class="weather-main">
                        <div class="icon" data-user-and-diag--dashboard-refresh-target="weatherIcon">{{ weather.icon }}</div>
                        <div class="temp" data-user-and-diag--dashboard-refresh-target="weatherTemp">{{ weather.temperature }}°</div>
                        <div class="feels">Ressenti <span data-user-and-diag--dashboard-refresh-target="weatherApparent">{{ weather.apparentTemperature }}</span>°</div>
                    </div>
                    <div class="weather-details">
                        <div class="lbl">💧 Humidité: </div><div class="val" data-user-and-diag--dashboard-refresh-target="weatherHumidity">{{ weather.humidity }}%</div>
                        <div class="lbl">💨 Vent: </div><div class="val" data-user-and-diag--dashboard-refresh-target="weatherWind">{{ weather.windSpeed }} km/h</div>
                        <div class="advice">💡 <span data-user-and-diag--dashboard-refresh-target="weatherAdvice">{{ weather.advice }}</span></div>
                    </div>
                </div>
            </div>

            <!-- Regional Alerts Widget -->
            <div class="intell-card alerts-card fade-up is-collapsed" style="transition-delay: 200ms;">
                <div class="header" data-action="click->user-and-diag--dashboard-refresh#toggleCollapse">
                    <div class="d-flex align-items-center gap-2">
                        <h3>🚨 ALERTES RÉGIONALES</h3>
                        <span class="toggle-icon">▼</span>
                    </div>
                    <div style="font-size: 0.6rem; color: rgba(255,200,190,0.6);">Rayon: 25km</div>
                </div>
                <div class="alerts-body" style="display: none;" data-user-and-diag--dashboard-refresh-target="alertsBody">
                    <div id="epidemic-stats-summary" style="font-size: 0.65rem; color: rgba(255,255,255,0.6); margin-bottom: 5px;">
                        {% if epidemic_stats.reports > 0 %}
                            📊 {{ epidemic_stats.diseases_detected }} maladies | {{ epidemic_stats.reports }} signalements (25km)
                        {% endif %}
                    </div>
                    <div data-user-and-diag--dashboard-refresh-target="alerts">
                        {% for d in regional_diseases %}
                        <div class="disease-row">
                            <div class="d-name"><span>{{ d.icon }}</span> {{ d.diseaseName }}</div>
                            <div class="d-sev {{ d.severityLevel in ['Élevé', 'CRITICAL'] ? 'high' : 'mod' }}">{{ d.severityLevel }}</div>
                        </div>
                        {% else %}
                        <p style="color: rgba(255,255,255,0.5); font-size: 0.75rem; text-align: center; margin: 10px 0;">Aucune alerte en cours dans votre zone.</p>
                        {% endfor %}
                    </div>
                    <div id="regional-alerts-messages">
                        {% for alert in regional_alerts %}
                            <p style="color: #f1c40f; font-size: 0.7rem; margin: 5px 0 0 0; line-height: 1.2;">{{ alert.message }}</p>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Predictive Risks Widget -->
            <div class="intell-card predictive-card fade-up is-collapsed" style="transition-delay: 300ms;">
                <div class="header" data-action="click->user-and-diag--dashboard-refresh#toggleCollapse">
                    <div class="d-flex align-items-center gap-2">
                        <h3>🌡️ PRÉVISIONS & RISQUES</h3>
                        <span class="toggle-icon">▼</span>
                    </div>
                    <div style="font-size: 0.6rem; color: rgba(220,200,255,0.6);">Prochaines 72h</div>
                </div>
                <div class="predict-body" style="display: none;" data-user-and-diag--dashboard-refresh-target="predictiveBody">
                    <div data-user-and-diag--dashboard-refresh-target="predictiveRisks">
                        {% for r in predictive_risks %}
                        <div class="risk-item">
                            <div class="r-head"><span>{{ r.icon }}</span> {{ r.diseaseType }} — {{ r.riskLevel }}</div>
                            <div class="r-desc">{{ r.reason }}</div>
                            <div class="r-adv">💡 {{ r.advice }}</div>
                        </div>
                        {% else %}
                        <p style="color: rgba(255,255,255,0.5); font-size: 0.75rem; text-align: center; margin: 10px 0;">Faible risque détecté pour les 72h à venir.</p>
                        {% endfor %}
                    </div>
                    <div style="font-size: 0.8rem; color: rgba(255,255,255,0.9); margin-top: 5px;" data-user-and-diag--dashboard-refresh-target="treatmentTiming">
                        {{ treatment_timing }}
                    </div>
                </div>
            </div>
        </div>

        <!-- OUTILS & FONCTIONNALITES -->
        <div class="section-label"><h2>OUTILS & FONCTIONNALITÉS</h2></div>
        
        <div class="action-grid">
            <a href="{{ path('app_user_and_diag_subscription') }}" class="action-card card-abonnement">
                <div class="action-icon">💎</div>
                <h3>Abonnement</h3>
                <p>Offres Premium & VIP pour votre exploitation</p>
            </a>
            
            <a href="{{ path('app_user_and_diag_user_diagnostic') }}" class="action-card card-diag">
                <div class="action-icon">🌱</div>
                <h3>Diagnostic IA</h3>
                <p>Analyser vos cultures avec l'intelligence artificielle</p>
            </a>
            
            <a href="{{ path('app_user_and_diag_history') }}" class="action-card card-hist">
                <div class="action-icon">📜</div>
                <h3>Historique</h3>
                <p>Retrouvez vos diagnostics et traitements passés</p>
            </a>
            
            <a href="{{ path('app_user_and_diag_map') }}" class="action-card card-map">
                <div class="action-icon">🌍</div>
                <h3>Carte Maladies</h3>
                <p>Épidémiologie végétale de votre région</p>
            </a>

            <a href="{{ path('app_user_and_diag_community') }}" class="action-card card-comm">
                <div class="action-icon">👥</div>
                <h3>Communauté</h3>
                <p>Réseau d'entraide entre agriculteurs</p>
            </a>

            <a href="{{ path('app_user_and_diag_treatment_plan_list') }}" class="action-card card-treat">
                <div class="action-icon">📋</div>
                <h3>Plans de Traitement</h3>
                <p>Suivez vos plans de traitement générés par l'IA</p>
            </a>
            <a href="{{ path('app_user_and_diag_prevention_plan_list') }}" class="action-card card-prevent">
                <div class="action-icon">🛡️</div>
                <h3>Plans de Prévention</h3>
                <p>Suivez vos plans de prévention pour protéger vos cultures</p>
            </a>
            <a href="{{ path('app_health_scan_new') }}" class="action-card card-scan">
                <div class="action-icon">🛡️</div>
                <h3>Scan de Santé</h3>
                <p>Analyse préventive multi-angles de votre champ</p>
            </a>

            <a href="{{ path('app_health_scan_history') }}" class="action-card card-hiscan">
                <div class="action-icon">📊</div>
                <h3>Historique Scans</h3>
                <p>Consulter les anciens rapports de santé</p>
            </a>

            <a href="{{ path('app_user_and_diag_soil_analysis') }}" class="action-card card-soil">
                <div class="action-icon">🌍</div>
                <h3>Profil de Sol 3D</h3>
                <p>Analyse virtuelle du sol avec données SoilGrids</p>
            </a>
        </div>

        <!-- Leaderboard -->
        <div class="section-label"><h2 style="color: #e8c96a;">CLASSEMENT COMMUNAUTÉ</h2></div>
        <div class="leaderboard-panel">
            <div class="leaderboard-header">
                <div>🏆</div>
                <h3>Top Agriculteurs Ardhi</h3>
            </div>
            <div class="leaderboard-body" data-dashboard-refresh-target="leaderboard">
                {% for player in leaderboard %}
                <div class="lb-row {% if player.isMe %}is-me{% endif %}">
                    <div class="lb-rank">
                        {% if player.rank == 1 %}🥇
                        {% elseif player.rank == 2 %}🥈
                        {% elseif player.rank == 3 %}🥉
                        {% else %}#{{ player.rank }}{% endif %}
                    </div>
                    <div class="lb-name">{{ player.name }}</div>
                    <div class="lb-score">{{ player.points }} pts <span style="color: rgba(255,255,255,0.5); font-size: 0.75rem;">(Niv. {{ player.level }})</span></div>
                </div>
                {% endfor %}
            </div>
        </div>

    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.intell-card .header').forEach(function(header) {
        header.addEventListener('click', function() {
            var card = header.closest('.intell-card');
            var icon = header.querySelector('.toggle-icon');
            var body = card.querySelector('.weather-body, .alerts-body, .predict-body');
            if (body) {
                var isHidden = body.style.display === 'none';
                body.style.display = isHidden ? '' : 'none';
                if (icon) icon.textContent = isHidden ? '▲' : '▼';
                card.classList.toggle('is-collapsed', !isHidden);
            }
        });
    });
});
</script>
{% endblock %}
