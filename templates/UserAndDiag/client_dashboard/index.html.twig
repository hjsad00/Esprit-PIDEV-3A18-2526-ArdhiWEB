{% extends 'base.html.twig' %}

{% block title %}Ardhi - Diagnostic IA Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .dashboard-wrapper {
            position: relative;
            min-height: 100vh;
            padding: 120px 30px 60px 30px;
            background: url("{{ asset('assets/img/hero-bg.jpg') }}") no-repeat center center fixed; /* Using an existing likely image, hero-bg or generic fallback */
            background-size: cover;
            font-family: 'Inter', sans-serif;
        }
        
        /* If original asset DiagComm_bg doesn't exist, we fall back gracefully via the overlay */
        .dashboard-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(135deg, rgba(8, 20, 15, 0.85) 0%, rgba(2, 5, 8, 0.95) 100%);
            z-index: 0;
        }

        .dashboard-content {
            position: relative;
            z-index: 1;
            max-width: 1140px;
            margin: 0 auto;
        }

        /* 1. Hero Section */
        .hero-panel {
            background: rgba(20, 40, 30, 0.4);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 24px 32px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 24px;
            margin-bottom: 30px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .hero-panel:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 45px rgba(0, 0, 0, 0.5);
        }

        .avatar-circle {
            width: 65px; height: 65px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4a7c59, #2d5a3e);
            border: 2px solid rgba(100, 180, 120, 0.4);
            display: flex; align-items: center; justify-content: center;
            font-size: 28px; color: white;
            flex-shrink: 0;
            box-shadow: 0 4px 15px rgba(74, 124, 89, 0.3);
        }

        .welcome-text { flex-grow: 1; }
        .welcome-text h1 {
            font-family: 'Marcellus', Georgia, serif;
            font-size: 1.6rem; font-weight: 700; color: #f0f4f1; margin: 0 0 4px 0;
        }
        .welcome-text p {
            font-size: 0.9rem; color: rgba(180, 210, 190, 0.8); margin: 0;
        }

        .gamification-stats {
            background: rgba(0, 0, 0, 0.25);
            border: 1px solid rgba(100, 180, 120, 0.2);
            border-radius: 16px;
            padding: 12px 20px;
            display: flex; align-items: center; gap: 20px;
        }
        .level-info { text-align: center; }
        .level-info .level-text { color: #7dc995; font-size: 0.75rem; font-weight: bold; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 1px;}
        .progress { height: 6px; width: 110px; background: rgba(255,255,255,0.1); border-radius: 3px; }
        .progress-bar { background-color: #5eb87a; }
        
        .points-info { text-align: center; }
        .points-info .points-val { color: #e8c96a; font-size: 1.1rem; font-weight: bold; margin: 0; }
        .points-info .points-lbl { color: rgba(180,180,180,0.6); font-size: 0.65rem; text-transform: uppercase; }

        .badges-list {
            display: flex; gap: 8px; flex-wrap: wrap; margin-left: 10px;
        }
        .badge-item {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 8px 12px;
            display: flex; flex-direction: column; align-items: center;
            min-width: 65px;
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .badge-item:hover {
            background: rgba(255,255,255,0.15);
            transform: scale(1.05);
        }
        .badge-item .icon { font-size: 1.2rem; line-height: 1; margin-bottom: 4px; }
        .badge-item .name { font-size: 0.55rem; color: #fff; font-weight: bold; text-align: center; }


        /* 2. Intelligence Row */
        .intelligence-row {
            display: flex; gap: 20px; margin-bottom: 35px; flex-wrap: wrap;
        }
        .intell-card {
            flex: 1; min-width: 320px;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.08);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            display: flex; flex-direction: column;
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
            transition: transform 0.3s ease;
        }
        .intell-card:hover { transform: translateY(-3px); }

        /* Weather Card */
        .weather-card {
            background: rgba(20, 50, 80, 0.4);
            border-color: rgba(80, 160, 220, 0.2);
        }
        .weather-card .header {
            background: linear-gradient(135deg, rgba(41,128,185,0.8), rgba(30,90,150,0.9));
            padding: 12px 18px; display: flex; justify-content: space-between; align-items: center;
        }
        .weather-card .header h3 { font-size: 0.65rem; color: rgba(180,220,255,0.9); font-weight: bold; margin: 0; letter-spacing: 1px; }
        .weather-card .header .cond { font-size: 0.75rem; color: rgba(255,255,255,0.8); margin: 0; }
        
        .weather-body { padding: 20px; display: flex; align-items: center; gap: 20px; }
        .weather-main { text-align: center; }
        .weather-main .icon { font-size: 3rem; line-height: 1; margin-bottom: 5px; }
        .weather-main .temp { font-family: 'Marcellus', serif; font-size: 2.2rem; color: white; font-weight: bold; line-height: 1; }
        .weather-main .feels { font-size: 0.7rem; color: rgba(180,220,255,0.8); }
        
        .weather-details { display: grid; grid-template-columns: auto 1fr; gap: 8px 12px; color: rgba(200,230,255,0.9); font-size: 0.8rem; align-items: center;}
        .weather-details .advice { grid-column: 1 / -1; color: #e8d97a; font-size: 0.75rem; font-style: italic; margin-top: 5px; }

        /* Alerts Card */
        .alerts-card {
            background: rgba(60, 15, 15, 0.4);
            border-color: rgba(220, 80, 60, 0.2);
        }
        .alerts-card .header {
            background: linear-gradient(135deg, rgba(180,40,30,0.85), rgba(140,30,25,0.9));
            padding: 12px 18px; display: flex; justify-content: space-between; align-items: center;
        }
        .alerts-card .header h3 { font-size: 0.65rem; color: rgba(255,210,200,0.9); font-weight: bold; margin: 0; display: flex; align-items: center; gap: 8px; letter-spacing: 1px;}
        .alerts-body { padding: 15px; display: flex; flex-direction: column; gap: 8px;}
        .disease-row {
            background: rgba(255,255,255,0.1); border-radius: 10px; padding: 10px 14px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .disease-row .d-name { color: white; font-size: 0.8rem; font-weight: 600; display: flex; align-items: center; gap: 8px; }
        .disease-row .d-sev { font-size: 0.7rem; padding: 3px 8px; border-radius: 6px; font-weight: bold; color: white; }
        .disease-row .d-sev.high { background: rgba(231,76,60,0.8); }
        .disease-row .d-sev.mod { background: rgba(243,156,18,0.8); }

        /* Predictive Card */
        .predictive-card {
            background: rgba(35, 15, 55, 0.4);
            border-color: rgba(150, 80, 200, 0.2);
        }
        .predictive-card .header {
            background: linear-gradient(135deg, rgba(120,50,170,0.85), rgba(90,40,140,0.9));
            padding: 12px 18px; display: flex; justify-content: space-between; align-items: center;
        }
        .predictive-card .header h3 { font-size: 0.65rem; color: rgba(220,200,255,0.9); font-weight: bold; margin: 0; display: flex; align-items: center; gap: 8px; letter-spacing: 1px;}
        
        .predict-body { padding: 15px; display: flex; flex-direction: column; gap: 10px; }
        .risk-item { background: rgba(255,255,255,0.08); border-radius: 10px; padding: 12px;}
        .risk-item .r-head { display: flex; align-items: center; gap: 8px; color: white; font-weight: 600; font-size: 0.8rem; margin-bottom: 4px; }
        .risk-item .r-desc { color: rgba(255,255,255,0.8); font-size: 0.75rem; margin-bottom: 6px; }
        .risk-item .r-adv { color: #f1c40f; font-size: 0.75rem; }


        /* 3. Section Labels */
        .section-label {
            display: flex; align-items: center; gap: 12px; margin-bottom: 20px;
        }
        .section-label::before {
            content: ''; width: 4px; height: 18px; background: #5db87a; border-radius: 2px;
        }
        .section-label::after {
            content: ''; flex-grow: 1; height: 1px; background: rgba(255,255,255,0.1);
        }
        .section-label h2 {
            font-size: 0.7rem; color: #e8f4ec; font-weight: 700; margin: 0; letter-spacing: 1.5px;
        }


        /* 4. Action Grid */
        .action-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }
        .action-card {
            background: rgba(0, 0, 0, 0.35);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 18px;
            padding: 24px 20px;
            display: flex; flex-direction: column; align-items: center; text-align: center;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            text-decoration: none; position: relative; overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        .action-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 100%;
            background: linear-gradient(to bottom, rgba(255,255,255,0.05), transparent);
            opacity: 0; transition: opacity 0.3s ease;
        }
        .action-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.4);
            border-color: rgba(255,255,255,0.25);
        }
        .action-card:hover::before { opacity: 1; }
        
        .action-icon {
            width: 50px; height: 50px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem; margin-bottom: 12px;
            transition: transform 0.3s ease;
        }
        .action-card:hover .action-icon { transform: scale(1.1); }
        
        .action-card h3 { color: #e8f4ec; font-size: 0.95rem; font-weight: 700; margin-bottom: 6px; }
        .action-card p { color: rgba(255,255,255,0.7); font-size: 0.7rem; margin: 0; line-height: 1.4; }

        /* Specific card colors (matched to JavaFX styling) */
        .card-abonnement { border-color: rgba(212,175,55,0.3); }
        .card-abonnement .action-icon { background: rgba(212,175,55,0.15); }
        
        .card-diag { border-color: rgba(93,184,122,0.3); }
        .card-diag .action-icon { background: rgba(93,184,122,0.15); }
        
        .card-hist { border-color: rgba(91,153,163,0.3); }
        .card-hist .action-icon { background: rgba(91,153,163,0.15); }
        
        .card-treat { border-color: rgba(41,128,185,0.3); }
        .card-treat .action-icon { background: rgba(41,128,185,0.15); }
        
        .card-map { border-color: rgba(231,76,60,0.3); }
        .card-map .action-icon { background: rgba(231,76,60,0.15); }
        
        .card-scan { border-color: rgba(46,204,113,0.3); }
        .card-scan .action-icon { background: rgba(46,204,113,0.15); }
        
        .card-hiscan { border-color: rgba(243,156,18,0.3); }
        .card-hiscan .action-icon { background: rgba(243,156,18,0.15); }
        
        .card-comm { border-color: rgba(155,89,182,0.3); }
        .card-comm .action-icon { background: rgba(155,89,182,0.15); }
        
        .card-soil { border-color: rgba(139,90,43,0.3); }
        .card-soil .action-icon { background: rgba(139,90,43,0.15); }


        /* 5. Leaderboard */
        .leaderboard-panel {
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 24px 30px;
            margin-bottom: 50px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        .leaderboard-header { display: flex; align-items: center; gap: 12px; margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid rgba(255,255,255,0.1);}
        .leaderboard-header h3 { font-family: 'Marcellus', serif; color: #e8f4ec; font-size: 1.2rem; font-weight: bold; margin: 0; }
        
        .lb-row {
            display: flex; align-items: center; justify-content: space-between;
            padding: 12px 16px; margin-bottom: 8px;
            background: rgba(255,255,255,0.05); border-radius: 12px;
            transition: all 0.2s;
        }
        .lb-row:hover { background: rgba(255,255,255,0.1); transform: scale(1.01); }
        .lb-rank { font-size: 1.1rem; font-weight: bold; min-width: 30px; color: white; }
        .lb-name { flex-grow: 1; font-weight: bold; color: white; font-size: 0.9rem;}
        .lb-score { color: #5db87a; font-weight: bold; font-size: 0.85rem;}
        .lb-row.is-me { border: 1px solid rgba(93,184,122,0.4); background: rgba(93,184,122,0.1); }

        .intell-card .header {
        cursor: pointer;
        user-select: none;
    }
    .toggle-icon {
        font-size: 0.8rem;
        transition: transform 0.3s ease;
        display: inline-block;
        opacity: 0.7;
    }
    .intell-card.is-collapsed {
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
</style>
{% endblock %}

{% block body_class %}dashboard-page{% endblock %}

{% block body %}
<!-- Dashboard Container -->
<div class="dashboard-wrapper">
    <div class="dashboard-overlay"></div>
    
    <div class="dashboard-content" 
         data-controller="user-and-diag--dashboard-refresh" 
         data-user-and-diag--dashboard-refresh-url-value="{{ path('app_client_dashboard_stats') }}"
         data-user-and-diag--dashboard-refresh-interval-value="10000"
         data-user-and-diag--dashboard-refresh-last-points-value="{{ gamification.points }}">
        
        <!-- Hero Section -->
        <div class="hero-panel fade-up">
            <div class="avatar-circle">
                <i class="bi bi-person-fill"></i>
            </div>
            <div class="welcome-text">
                <h1>Bonjour, {{ user.prenom|default('Agriculteur') }}</h1>
                <p>Gérez votre exploitation intelligemment avec Ardhi</p>
            </div>
            
            <div class="gamification-stats">
                <div class="level-info">
                    <div class="level-text" data-user-and-diag--dashboard-refresh-target="level">Niveau {{ gamification.level }}</div>
                    <div class="progress">
                        <div class="progress-bar" role="progressbar" 
                             style="width: {{ gamification.progress }}%" 
                             aria-valuenow="{{ gamification.progress }}" 
                             aria-valuemin="0" aria-valuemax="100"
                             data-user-and-diag--dashboard-refresh-target="progress"></div>
                    </div>
                </div>
                <div class="points-info">
                    <div class="points-val" data-user-and-diag--dashboard-refresh-target="points">{{ gamification.points }} pts</div>
                    <div class="points-lbl">points</div>
                </div>
            </div>
            
            <div class="badges-container">
                <div style="font-size: 0.6rem; color: rgba(180,210,190,0.5); font-weight: bold; margin-bottom: 4px; margin-left: 10px;">BADGES RÉCENTS</div>
                <div class="badges-list" data-user-and-diag--dashboard-refresh-target="badges">
                    {% for badge in badges|slice(0, 3) %}
                    <div class="badge-item" title="{{ badge.description }}">
                        <div class="icon">{{ badge.icon }}</div>
                        <div class="name">{{ badge.name }}</div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Intelligence Row -->
        <div class="intelligence-row">
            <!-- Weather Widget -->
            <div class="intell-card weather-card fade-up is-collapsed" style="transition-delay: 100ms;">
                <div class="header">
                    <div class="d-flex align-items-center gap-2">
                        <h3>MÉTÉO DIRECT</h3>
                        <span class="toggle-icon">▼</span>
                    </div>
                    <p class="cond">{{ weather.condition }}</p>
                </div>
                <div class="weather-body" style="display: none;" data-user-and-diag--dashboard-refresh-target="weatherBody">
                    <div class="weather-main">
                        <div class="icon" data-user-and-diag--dashboard-refresh-target="weatherIcon">{{ weather.icon }}</div>
                        <div class="temp" data-user-and-diag--dashboard-refresh-target="weatherTemp">{{ weather.temperature }}°</div>
                        <div class="feels">Ressenti <span data-user-and-diag--dashboard-refresh-target="weatherApparent">{{ weather.apparentTemperature }}</span>°</div>
                    </div>
                    <div class="weather-details">
                        <div class="lbl">💧 Humidité: </div><div class="val" data-user-and-diag--dashboard-refresh-target="weatherHumidity">{{ weather.humidity }}%</div>
                        <div class="lbl">💨 Vent: </div><div class="val" data-user-and-diag--dashboard-refresh-target="weatherWind">{{ weather.windSpeed }} km/h</div>
                        <div class="advice">💡 <span data-user-and-diag--dashboard-refresh-target="weatherAdvice">{{ weather.advice }}</span></div>
                    </div>
                </div>
            </div>

            <!-- Regional Alerts Widget -->
            <div class="intell-card alerts-card fade-up is-collapsed" style="transition-delay: 200ms;">
                <div class="header">
                    <div class="d-flex align-items-center gap-2">
                        <h3>🚨 ALERTES RÉGIONALES</h3>
                        <span class="toggle-icon">▼</span>
                    </div>
                    <div style="font-size: 0.6rem; color: rgba(255,200,190,0.6);">Rayon: 25km</div>
                </div>
                <div class="alerts-body" style="display: none;" data-user-and-diag--dashboard-refresh-target="alertsBody">
                    <div id="epidemic-stats-summary" style="font-size: 0.65rem; color: rgba(255,255,255,0.6); margin-bottom: 5px;">
                        {% if epidemic_stats.reports > 0 %}
                            📊 {{ epidemic_stats.diseases_detected }} maladies | {{ epidemic_stats.reports }} signalements (25km)
                        {% endif %}
                    </div>
                    <div data-user-and-diag--dashboard-refresh-target="alerts">
                        {% for d in regional_diseases %}
                        <div class="disease-row">
                            <div class="d-name"><span>{{ d.icon }}</span> {{ d.diseaseName }}</div>
                            <div class="d-sev {{ d.severityLevel in ['Élevé', 'CRITICAL'] ? 'high' : 'mod' }}">{{ d.severityLevel }}</div>
                        </div>
                        {% else %}
                        <p style="color: rgba(255,255,255,0.5); font-size: 0.75rem; text-align: center; margin: 10px 0;">Aucune alerte en cours dans votre zone.</p>
                        {% endfor %}
                    </div>
                    <div id="regional-alerts-messages">
                        {% for alert in regional_alerts %}
                            <p style="color: #f1c40f; font-size: 0.7rem; margin: 5px 0 0 0; line-height: 1.2;">{{ alert.message }}</p>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Predictive Risks Widget -->
            <div class="intell-card predictive-card fade-up is-collapsed" style="transition-delay: 300ms;">
                <div class="header">
                    <div class="d-flex align-items-center gap-2">
                        <h3>🌡️ PRÉVISIONS & RISQUES</h3>
                        <span class="toggle-icon">▼</span>
                    </div>
                    <div style="font-size: 0.6rem; color: rgba(220,200,255,0.6);">Prochaines 72h</div>
                </div>
                <div class="predict-body" style="display: none;" data-user-and-diag--dashboard-refresh-target="predictiveBody">
                    <div data-user-and-diag--dashboard-refresh-target="predictiveRisks">
                        {% for r in predictive_risks %}
                        <div class="risk-item">
                            <div class="r-head"><span>{{ r.icon }}</span> {{ r.diseaseType }} — {{ r.riskLevel }}</div>
                            <div class="r-desc">{{ r.reason }}</div>
                            <div class="r-adv">💡 {{ r.advice }}</div>
                        </div>
                        {% else %}
                        <p style="color: rgba(255,255,255,0.5); font-size: 0.75rem; text-align: center; margin: 10px 0;">Faible risque détecté pour les 72h à venir.</p>
                        {% endfor %}
                    </div>
                    <div style="font-size: 0.8rem; color: rgba(255,255,255,0.9); margin-top: 5px;" data-user-and-diag--dashboard-refresh-target="treatmentTiming">
                        {{ treatment_timing }}
                    </div>
                </div>
            </div>
        </div>

        <!-- OUTILS & FONCTIONNALITES -->
        <div class="section-label"><h2>OUTILS & FONCTIONNALITÉS</h2></div>
        
        <div class="action-grid">
            <a href="{{ path('app_user_and_diag_subscription') }}" class="action-card card-abonnement">
                <div class="action-icon">💎</div>
                <h3>Abonnement</h3>
                <p>Offres Premium & VIP pour votre exploitation</p>
            </a>
            
            <a href="{{ path('app_user_and_diag_user_diagnostic') }}" class="action-card card-diag">
                <div class="action-icon">🌱</div>
                <h3>Diagnostic IA</h3>
                <p>Analyser vos cultures avec l'intelligence artificielle</p>
            </a>
            
            <a href="{{ path('app_user_and_diag_history') }}" class="action-card card-hist">
                <div class="action-icon">📜</div>
                <h3>Historique</h3>
                <p>Retrouvez vos diagnostics et traitements passés</p>
            </a>
            
            <a href="{{ path('app_user_and_diag_treatment_plan_list') }}" class="action-card card-treat">
                <div class="action-icon">📋</div>
                <h3>Plans de Traitement</h3>
                <p>Protocoles de soin actifs et recommandations</p>
            </a>
            
            <a href="{{ path('app_user_and_diag_map') }}" class="action-card card-map">
                <div class="action-icon">🌍</div>
                <h3>Carte Maladies</h3>
                <p>Épidémiologie végétale de votre région</p>
            </a>

            <a href="#" class="action-card card-scan">
                <div class="action-icon">🌿</div>
                <h3>Scan Santé</h3>
                <p>Prévention globale de votre exploitation</p>
            </a>
            
            <a href="#" class="action-card card-hiscan">
                <div class="action-icon">📊</div>
                <h3>Historique Scans</h3>
                <p>Scores et rapports de santé passés</p>
            </a>
            
            <a href="{{ path('app_user_and_diag_community') }}" class="action-card card-comm">
                <div class="action-icon">👥</div>
                <h3>Communauté</h3>
                <p>Réseau d'entraide entre agriculteurs</p>
            </a>
            
            <a href="#" class="action-card card-soil">
                <div class="action-icon">🌐</div>
                <h3>Profil Sol 3D</h3>
                <p>Analyse en profondeur de vos sols</p>
            </a>
        </div>

        <!-- Leaderboard -->
        <div class="section-label"><h2 style="color: #e8c96a;">CLASSEMENT COMMUNAUTÉ</h2></div>
        <div class="leaderboard-panel">
            <div class="leaderboard-header">
                <div>🏆</div>
                <h3>Top Agriculteurs Ardhi</h3>
            </div>
            <div class="leaderboard-body" data-dashboard-refresh-target="leaderboard">
                {% for player in leaderboard %}
                <div class="lb-row {% if player.isMe %}is-me{% endif %}">
                    <div class="lb-rank">
                        {% if player.rank == 1 %}🥇
                        {% elseif player.rank == 2 %}🥈
                        {% elseif player.rank == 3 %}🥉
                        {% else %}#{{ player.rank }}{% endif %}
                    </div>
                    <div class="lb-name">{{ player.name }}</div>
                    <div class="lb-score">{{ player.points }} pts <span style="color: rgba(255,255,255,0.5); font-size: 0.75rem;">(Niv. {{ player.level }})</span></div>
                </div>
                {% endfor %}
            </div>
        </div>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const headers = document.querySelectorAll('.intell-card .header');
    headers.forEach(header => {
        header.addEventListener('click', function(e) {
            const card = this.closest('.intell-card');
            const icon = this.querySelector('.toggle-icon');
            const body = card.querySelector('.weather-body, .alerts-body, .predict-body');
            
            if (body) {
                const isHidden = body.style.display === 'none';
                body.style.display = isHidden ? '' : 'none';
                if (icon) icon.textContent = isHidden ? '▲' : '▼';
                card.classList.toggle('is-collapsed', !isHidden);
            }
        });
    });
});
</script>
{% endblock %}
