{% extends 'base.html.twig' %}

{% block title %}Protocole: {{ diagnostic.resultatIa|split('-')[0] }}{% endblock %}

{% block stylesheets %}
<style>
    /* Premium AgriTech Glassmorphic Base */
    body {
        margin: 0; padding: 0; min-height: 100vh;
        background: url('{{ asset('assets/img/DiagComm_bg.png') }}') no-repeat center center fixed;
        background-size: cover;
    }
    .dashboard-background {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background-color: rgba(0,0,0, 0.55); z-index: -1;
    }
    .glass-panel {
        background: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 20px; padding: 35px; color: white;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
    }
    .header-bar {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 30px; border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 15px;
    }
    
    /* Interactive Image Wrapper & AR Markers */
    .image-wrapper {
        position: relative; border-radius: 15px; overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        border: 2px solid rgba(255,255,255,0.2);
    }
    .image-wrapper img {
        width: 100%; display: block; object-fit: cover;
    }
    .ar-marker {
        position: absolute; width: 20px; height: 20px;
        background: rgba(231, 76, 60, 1);
        border: 3px solid white; border-radius: 50%;
        transform: translate(-50%, -50%);
        display: none; z-index: 10;
        animation: pulse 1.5s infinite;
    }
    .ar-label {
        position: absolute; background: rgba(0,0,0,0.85);
        color: white; padding: 5px 12px; border-radius: 6px;
        font-size: 13px; font-weight: bold; display: none;
        transform: translate(-50%, 20px); z-index: 10;
        white-space: nowrap; border: 1px solid rgba(255,255,255,0.2);
    }
    @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(231, 76, 60, 0.8); }
        70% { box-shadow: 0 0 0 15px rgba(231, 76, 60, 0); }
        100% { box-shadow: 0 0 0 0 rgba(231, 76, 60, 0); }
    }

    /* Tasks Timeline */
    .task-row {
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 12px; padding: 18px 20px;
        margin-bottom: 15px; transition: all 0.3s ease;
        display: flex; align-items: center; gap: 20px;
    }
    .task-row:hover { background: rgba(255, 255, 255, 0.2); }
    .task-row.completed { opacity: 0.5; background: rgba(255, 255, 255, 0.05); }
    .task-row.completed .task-desc { text-decoration: line-through; }
    
    .task-day { font-size: 22px; font-weight: 800; min-width: 65px; color: #f39c12; }
    .task-desc { flex-grow: 1; font-size: 15px; line-height: 1.4; }
    
    /* Tags and Checkboxes */
    .badge-status { padding: 6px 12px; border-radius: 8px; font-size: 11px; font-weight: bold; }
    .status-pending { background: rgba(241, 196, 15, 0.2); color: #f1c40f; border: 1px solid #f1c40f; }
    .status-completed { background: rgba(46, 204, 113, 0.2); color: #2ecc71; border: 1px solid #2ecc71; }
    .btn-pin { background: rgba(231, 76, 60, 0.8); border: none; color: white; border-radius: 50%; width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; transition: 0.2s; }
    .btn-pin:hover { background: rgba(231, 76, 60, 1); transform: scale(1.1); }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-background"></div>

<div class="container py-5">
    <div class="glass-panel">
        
        <div class="header-bar">
            <div>
                <a href="#" class="text-white text-decoration-none fs-4 me-3 opacity-75 hover-opacity-100" onclick="history.back()">← Retour</a>
                <div class="d-inline-block align-middle">
                    <h3 class="m-0 fw-bold">Protocole: {{ diagnostic.resultatIa|split('-')[0] }}</h3>
                    <small class="text-white-50">Diagnostic: {{ diagnostic.resultatIa|split('-')[1]|default('') }} | Débuté le: {{ plan.startDate|date('d/m/Y') }}</small>
                </div>
            </div>
            <div>
                {% if plan.status == 'ACTIVE' %}
                    <span class="badge bg-success fs-6 px-3 py-2">Plan Actif</span>
                {% else %}
                    <span class="badge bg-danger fs-6 px-3 py-2">Abandonné</span>
                {% endif %}
            </div>
        </div>

        <div class="row g-5">
            <div class="col-lg-5">
                <h5 class="mb-3 fw-bold">Ma Plante (Visualisation)</h5>
                
                <div class="image-wrapper mb-3" id="plantImageWrapper">
                    <img src="{{ diagnostic.imageScannee }}" alt="Ma Plante">
                    
                    <div id="arMarker" class="ar-marker"></div>
                    <div id="arLabel" class="ar-label">Zone</div>
                </div>
                
                <div class="p-3 rounded" style="background: rgba(0,0,0,0.3); border: 1px dashed rgba(255,255,255,0.2);">
                    <p class="text-white-75 small mb-0">
                        <i class="bi bi-info-circle me-2"></i> 
                        <i>Cliquez sur l'icône 📍 dans les tâches à droite pour cibler la zone précise d'intervention sur l'image.</i>
                    </p>
                </div>
            </div>

            <div class="col-lg-7">
                <h5 class="mb-4 fw-bold">Calendrier des Interventions</h5>
                
                {% for item in tasksWithMarkers %}
                    {% set task = item.entity %}
                    {% set marker = item.marker %}
                    {% set isCompleted = task.status == 'COMPLETED' %}
                    
                    <div class="task-row {{ isCompleted ? 'completed' : '' }}" id="task-row-{{ task.id }}">
                        
                        <div class="task-day">J-{{ task.dayOffset }}</div>
                        
                        <div class="task-desc">{{ task.taskDescription }}</div>
                        
                        <div class="d-flex align-items-center gap-3 ms-auto">
                            {% if marker %}
                                <button class="btn-pin" 
                                        onclick="triggerMarker({{ marker.x }}, {{ marker.y }}, '{{ marker.label }}')" 
                                        title="Localiser sur la plante">
                                    📍
                                </button>
                            {% endif %}

                            <span class="badge-status {{ isCompleted ? 'status-completed' : 'status-pending' }}" id="badge-{{ task.id }}">
                                {{ isCompleted ? 'ACCOMPLI' : 'EN ATTENTE' }}
                            </span>
                            
                            {% if plan.status == 'ACTIVE' %}
                                <div class="form-check m-0">
                                    <input type="checkbox" class="form-check-input" style="width: 22px; height: 22px; cursor: pointer;" 
                                           id="check-{{ task.id }}" 
                                           {{ isCompleted ? 'checked disabled' : '' }}
                                           onchange="completeTaskAjax({{ task.id }}, this)">
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <div class="alert alert-secondary bg-transparent border-light text-white text-center">
                        Aucune tâche générée pour ce protocole.
                    </div>
                {% endfor %}
            </div>
        </div>
        
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    // AR Visual Marker Logic (Translates your Java Canvas Logic to Web)
    function triggerMarker(xPercent, yPercent, labelText) {
        const marker = document.getElementById('arMarker');
        const label = document.getElementById('arLabel');
        
        // Temporarily hide to restart CSS animation smoothly
        marker.style.display = 'none';
        label.style.display = 'none';
        
        setTimeout(() => {
            marker.style.left = xPercent + '%';
            marker.style.top = yPercent + '%';
            label.style.left = xPercent + '%';
            label.style.top = yPercent + '%';
            label.innerText = labelText;
            
            marker.style.display = 'block';
            label.style.display = 'block';
        }, 50);

        // Hide marker automatically after 4 seconds
        setTimeout(() => {
            marker.style.display = 'none';
            label.style.display = 'none';
        }, 4000);
    }

    // Task Completion AJAX Logic (Translates your Java sequential enforcement)
    function completeTaskAjax(taskId, checkboxElement) {
        if (!checkboxElement.checked) return; // Prevent unchecking

        checkboxElement.disabled = true; // Lock UI during fetch

        fetch(`{{ path('app_user_and_diag_treatment_task_complete', {'id': 'TASK_ID'}) }}`.replace('TASK_ID', taskId), {
            method: 'POST',
            headers: { 
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Update UI visually
                const row = document.getElementById(`task-row-${taskId}`);
                const badge = document.getElementById(`badge-${taskId}`);
                
                row.classList.add('completed');
                badge.className = 'badge-status status-completed';
                badge.innerText = 'ACCOMPLI';
            } else {
                // Handle Sequential Error
                checkboxElement.checked = false;
                checkboxElement.disabled = false;
                alert(data.error || "Une erreur est survenue.");
            }
        })
        .catch(err => {
            checkboxElement.checked = false;
            checkboxElement.disabled = false;
            alert("Erreur réseau de communication avec le serveur.");
        });
    }
</script>
{% endblock %}