{% extends 'base.html.twig' %}

{% block title %}Protocole: {{ diagnostic.resultatIa|split('-')[0] }}{% endblock %}

{% block stylesheets %}
<link href="{{ asset('assets/css/UserAndDiag/treatment-show.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="dashboard-background"></div>

<div class="container py-5">
    <div class="glass-panel">
        
        <div class="header-bar">
            <div>
                <a href="#" class="text-white text-decoration-none fs-4 me-3 opacity-75 hover-opacity-100" onclick="history.back()">← Retour</a>
                <div class="d-inline-block align-middle">
                    <h3 class="m-0 fw-bold">Protocole: {{ diagnostic.resultatIa|split('-')[0] }}</h3>
                    <small class="text-white-50">Diagnostic: {{ diagnostic.resultatIa|split('-')[1]|default('') }} | Débuté le: {{ plan.startDate|date('d/m/Y') }}</small>
                </div>
            </div>
            <div>
                {% if plan.status == 'ACTIVE' %}
                    <span class="badge bg-success fs-6 px-3 py-2">Plan Actif</span>
                {% elseif plan.status == 'COMPLETED' %}
                    <span class="badge bg-success fs-6 px-3 py-2" style="background-color: #2ecc71 !important;">Protocole Terminé</span>
                {% else %}
                    <span class="badge bg-danger fs-6 px-3 py-2">Abandonné</span>
                {% endif %}
            </div>
        </div>

        <div class="row g-5">
            <div class="col-lg-5">
                <h5 class="mb-3 fw-bold">Ma Plante (Visualisation)</h5>
                
                <div class="image-wrapper mb-4" id="plantImageWrapper">
                    <img id="mainPlantImage" src="{{ diagnostic.imageScannee }}" alt="Ma Plante">
                    <div id="arMarker" class="ar-marker"></div>
                    <div id="arLabel" class="ar-label">Zone</div>
                </div>

                {% if plan.status == 'ACTIVE' %}
                    <div class="d-flex flex-column gap-2">
                        
                        <button type="button" class="action-btn btn-ai" onclick="document.getElementById('aiReevalInput').click()">
                            <i class="bi bi-robot"></i> Réévaluer via IA
                        </button>

                        <input type="file" id="aiReevalInput" style="display:none" accept="image/*" onchange="handleAiReevaluation(this)">
                        
                        <form action="{{ path('app_user_and_diag_treatment_plan_abandon', {id: plan.id}) }}" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir abandonner ce protocole ? Cette action est irréversible.');">
                            <button type="submit" class="action-btn" style="background: rgba(231, 76, 60, 0.85); width: 100%;">
                                <i class="bi bi-x-circle"></i> Abandonner le protocole
                            </button>
                        </form>
                        <button class="action-btn" style="background: #25D366; width: 100%;" onclick="triggerWhatsApp({{ plan.id }}, this)">
                            <i class="bi bi-whatsapp"></i> Envoyer un Rappel WhatsApp
                        </button>    
                        
                    </div>
                {% endif %}
            </div>

            <div class="col-lg-7">
                <h5 class="mb-4 fw-bold">Calendrier des Interventions</h5>
                
                {% for item in tasksWithMarkers %}
                    {% set task = item.entity %}
                    {% set marker = item.marker %}
                    {% set isCompleted = task.status == 'COMPLETED' %}
                    
                    <div class="task-row {{ isCompleted ? 'completed' : '' }}" id="task-row-{{ task.id }}">
                        
                        <div class="task-day">J-{{ task.dayOffset }}</div>
                        
                        <div class="task-desc">{{ task.taskDescription }}</div>
                        
                        <div class="d-flex align-items-center gap-3 ms-auto">
                            {% if marker %}
                                <button class="btn-pin" 
                                        onclick="triggerMarker({{ marker.x }}, {{ marker.y }}, '{{ marker.label }}')" 
                                        title="Localiser sur la plante">
                                    📍
                                </button>
                            {% endif %}

                            <span class="badge-status {{ isCompleted ? 'status-completed' : 'status-pending' }}" id="badge-{{ task.id }}">
                                {{ isCompleted ? 'ACCOMPLI' : 'EN ATTENTE' }}
                            </span>
                            
                            {% if plan.status == 'ACTIVE' %}
                                <div class="form-check m-0">
                                    <input type="checkbox" class="form-check-input" style="width: 22px; height: 22px; cursor: pointer;" 
                                           id="check-{{ task.id }}" 
                                           {{ isCompleted ? 'checked disabled' : '' }}
                                           onchange="completeTaskAjax({{ task.id }}, this)">
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <div class="alert alert-secondary bg-transparent border-light text-white text-center">
                        Aucune tâche générée pour ce protocole.
                    </div>
                {% endfor %}
            </div>
        </div>
        
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    // AR Visual Marker Logic (Translates your Java Canvas Logic to Web)
    function triggerMarker(xPercent, yPercent, labelText) {
        const marker = document.getElementById('arMarker');
        const label = document.getElementById('arLabel');
        
        // Temporarily hide to restart CSS animation smoothly
        marker.style.display = 'none';
        label.style.display = 'none';
        
        setTimeout(() => {
            marker.style.left = xPercent + '%';
            marker.style.top = yPercent + '%';
            label.style.left = xPercent + '%';
            label.style.top = yPercent + '%';
            label.innerText = labelText;
            
            marker.style.display = 'block';
            label.style.display = 'block';
        }, 50);

        // Hide marker automatically after 4 seconds
        setTimeout(() => {
            marker.style.display = 'none';
            label.style.display = 'none';
        }, 4000);
    }

    // Task Completion AJAX Logic
    function completeTaskAjax(taskId, checkboxElement) {
        if (!checkboxElement.checked) return; // Prevent unchecking

        checkboxElement.disabled = true; // Lock UI during fetch

        fetch(`{{ path('app_user_and_diag_treatment_task_complete', {'id': 'TASK_ID'}) }}`.replace('TASK_ID', taskId), {
            method: 'POST',
            headers: { 
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Update UI visually for this specific row
                const row = document.getElementById(`task-row-${taskId}`);
                const badge = document.getElementById(`badge-${taskId}`);
                
                row.classList.add('completed');
                badge.className = 'badge-status status-completed';
                badge.innerText = 'ACCOMPLI';

                // NEW LOGIC: Check if the whole plan is done
                if (data.plan_completed) {
                    setTimeout(() => {
                        alert("🎉 Félicitations ! Vous avez accompli toutes les tâches de ce protocole. Votre traitement est terminé !");
                        // Reload the page to update badges and hide the action buttons
                        window.location.reload();
                    }, 300); // Slight delay so the user sees the checkbox turn green first
                }
                
            } else {
                // Handle Sequential Error
                checkboxElement.checked = false;
                checkboxElement.disabled = false;
                alert(data.error || "Une erreur est survenue.");
            }
        })
        .catch(err => {
            checkboxElement.checked = false;
            checkboxElement.disabled = false;
            alert("Erreur réseau de communication avec le serveur.");
        });
    }

    // WhatsApp Reminder Trigger
    function triggerWhatsApp(planId, buttonElement) {
        buttonElement.disabled = true;
        const originalHtml = buttonElement.innerHTML;
        buttonElement.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Envoi...';

        fetch(`{{ path('app_user_and_diag_treatment_plan_whatsapp', {'id': 'PLAN_ID'}) }}`.replace('PLAN_ID', planId), {
            method: 'POST',
            headers: { 
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            buttonElement.disabled = false;
            buttonElement.innerHTML = originalHtml;
            if (data.success) {
                alert("✅ " + data.message);
            } else {
                alert("❌ Erreur : " + data.error);
            }
        })
        .catch(err => {
            buttonElement.disabled = false;
            buttonElement.innerHTML = originalHtml;
            alert("Erreur réseau de communication avec le serveur.");
        });
    }
    function handleAiReevaluation(inputElement) {
        if (!inputElement.files[0]) return;
        
        const formData = new FormData();
        formData.append('image', inputElement.files[0]);

        // Show a visual loading indicator (since this uses Vision models, it takes a few seconds)
        const btn = document.querySelector('.btn-ai');
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Analyse en cours...';
        btn.disabled = true;

        fetch(`{{ path('app_user_and_diag_treatment_plan_reevaluate', {id: plan.id}) }}`, {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(data => {
            btn.innerHTML = originalHtml;
            btn.disabled = false;
            inputElement.value = ""; // Reset file input

            if (data.error) {
                alert("Erreur: " + data.error);
                return;
            }

            if (data.status === 'MISMATCH') {
                alert("⚠️ INCOHÉRENCE DÉTECTÉE\n\nL'IA indique que cette image ne correspond pas au suivi de ce protocole.\nDétail : " + data.message);
            } else if (data.status === 'HEALED') {
                alert("🎉 FÉLICITATIONS !\n\nL'IA a détecté que votre plante est totalement guérie !\nDétail : " + data.message);
                window.location.reload();
            } else if (data.status === 'UNCHANGED' || data.status === 'RECOVERING') {
                const prefix = data.status === 'RECOVERING' ? "📈 AMÉLIORATION" : "➡️ STATIONNAIRE";
                alert(prefix + "\n\nL'IA confirme que le plan actuel est approprié. Continuez vos tâches !\nDétail : " + data.message);
            } else if (data.status === 'PROPOSAL') {
                // The plant is worsening, show the modal with the new proposed tasks!
                alert("⚠️ AGGRAVATION DÉTECTÉE\n\nL'IA a constaté une détérioration (" + data.message + "). Un nouveau protocole a été généré.");
                document.getElementById('aiProposalContent').innerText = data.raw_ai_response;
                new bootstrap.Modal(document.getElementById('aiProposalModal')).show();
            }
        })
        .catch(err => {
            btn.innerHTML = originalHtml;
            btn.disabled = false;
            alert("Erreur réseau lors de la communication avec l'IA.");
        });
    }
</script>
{% endblock %}