{% extends 'base.html.twig' %}

{% block title %}Ardhi - Plans de Traitement{% endblock %}

{% block stylesheets %}
<style>
    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: url('{{ asset('assets/img/hero_3.jpg') }}') no-repeat center center fixed;
        background-size: cover;
    }
    
    .dashboard-background {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background-color: rgba(0,0,0, 0.4);
        z-index: -1;
    }

    .container-list {
        padding: 100px 40px 40px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .header-section {
        margin-bottom: 40px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    /* Grid Layout */
    .plan-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
    }

    /* Card Styling */
    .plan-card {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        cursor: pointer;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    .plan-card:hover {
        transform: translateY(-10px);
        background: rgba(255, 255, 255, 0.2);
        border-color: #6B7F3F;
        box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }

    .diag-image {
        width: 100%;
        height: 160px;
        object-fit: cover;
        border-bottom: 2px solid rgba(107, 127, 63, 0.5);
    }

    .card-content {
        padding: 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .diag-name {
        font-size: 18px;
        font-weight: 700;
        color: white;
        margin-bottom: 8px;
        line-height: 1.2;
    }

    .date-info {
        font-size: 12px;
        color: rgba(255,255,255,0.7);
        margin-bottom: 15px;
    }

    /* Progress UI */
    .progress-container {
        margin-top: auto;
    }

    .progress-labels {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .progress-bg {
        background: rgba(255,255,255,0.1);
        height: 8px;
        border-radius: 4px;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        background: linear-gradient(to right, #6B7F3F, #2ecc71);
        border-radius: 4px;
        transition: width 1s ease-in-out;
    }

    .status-tag {
        position: absolute;
        top: 15px;
        right: 15px;
        background: #2ecc71;
        color: white;
        padding: 4px 12px;
        border-radius: 10px;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
    }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-background"></div>

<div class="container-list">
    <div class="header-section">
        <div>
            <a href="{{ path('app_client_dashboard') }}" class="btn btn-outline-light rounded-pill px-4 mb-3">← Dashboard</a>
            <h1 class="text-white m-0">Protocoles de Soin</h1>
            <p class="text-white-50 m-0">Suivez l'évolution de vos traitements actifs.</p>
        </div>
        <div class="text-end">
            <button class="btn btn-glass px-4 rounded-pill" style="background: rgba(107, 127, 63, 0.8);">
                <i class="bi bi-calendar-event"></i> Calendrier
            </button>
        </div>
    </div>

    <div class="plan-grid">
        {% for item in plans %}
            <div class="plan-card">
                {% if item.plan.status == 'COMPLETED' %}
                    <span class="status-tag">TERMINÉ</span>
                {% endif %}
                
                <img src="{{ item.plan.diagnostic.imageScannee }}" alt="Plant" class="diag-image">
                
                <div class="card-content">
                    <div class="diag-name">{{ item.plan.diagnostic.resultatIa }}</div>
                    <div class="date-info">Démarré le {{ item.plan.startDate|date('d M Y') }}</div>
                    
                    <div class="progress-container">
                        <div class="progress-labels">
                            <span style="color: #2ecc71;">{{ item.progress }}% complété</span>
                            <span class="text-white-50">{{ item.completed }}/{{ item.total }} tâches</span>
                        </div>
                        <div class="progress-bg">
                            <div class="progress-bar" style="width: 0%;" data-width="{{ item.progress }}%"></div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5 text-white bg-white bg-opacity-10 rounded-4">
                <i class="bi bi-journal-check display-1 opacity-25"></i>
                <p class="mt-3">Aucun protocole de soin actif.</p>
                <a href="{{ path('app_user_and_diag_user_diagnostic') }}" class="btn btn-success rounded-pill px-5">Lancer un Diagnostic</a>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    // Animate progress bars on load
    window.addEventListener('load', () => {
        const bars = document.querySelectorAll('.progress-bar');
        bars.forEach(bar => {
            setTimeout(() => {
                bar.style.width = bar.getAttribute('data-width');
            }, 300);
        });
    });
</script>
{% endblock %}
