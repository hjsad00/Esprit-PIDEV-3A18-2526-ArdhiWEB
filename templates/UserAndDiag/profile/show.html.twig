{% extends 'base.html.twig' %}

{% block title %}Profil de {{ user.prenom }} {{ user.nom }} - Ardhi{% endblock %}

{% block body %}
<section class="section py-5">
  <div class="container">
    <div class="row">
      <!-- Sidebar Info -->
      <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0">
          <div class="card-body text-center">
            {% if user.avatar %}
                <img src="{{ user.avatar }}" alt="Avatar" class="rounded-circle mb-3 border shadow-sm" style="width: 120px; height: 120px; object-fit: cover;">
            {% else %}
                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white mx-auto mb-3 shadow-sm" style="width: 120px; height: 120px; font-size: 3rem;">
                    {{ user.prenom|first|upper }}
                </div>
            {% endif %}
            
            <h4 class="mb-1 fw-bold" style="color: var(--heading-color);">{{ user.prenom }} {{ user.nom }}</h4>
            <p class="text-muted mb-2">
                {% if user.role == 'AGRICULTEUR' %} Agriculteur
                {% elseif user.role == 'AGRONOME' %} Agronome
                {% else %} Membre de la communauté
                {% endif %}
                <br>
                <small><i class="bi bi-geo-alt"></i> {{ user.location|default('Localisation non spécifiée') }}</small>
            </p>
            
            {% if user.bio %}
                <p class="small text-muted mt-3 p-3 bg-light rounded shadow-sm text-start" style="font-style: italic;">
                    "{{ user.bio }}"
                </p>
            {% endif %}

            {% if app.user and app.user.id != user.id %}
              <hr class="my-3">
              <form action="{{ path('app_profile_toggle_block', {'id': user.id}) }}" method="POST" class="mt-3">
                  <input type="hidden" name="_token" value="{{ csrf_token('toggle_block_' ~ user.id) }}">
                  {% if app.user.isBlocking(user) %}
                      <button type="submit" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                          <i class="bi bi-unlock me-1"></i> Débloquer
                      </button>
                  {% else %}
                      <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill">
                          <i class="bi bi-slash-circle me-1"></i> Bloquer
                      </button>
                  {% endif %}
              </form>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- Main Content (Posts) -->
      <div class="col-md-8">
        <h4 class="mb-4" style="color: var(--heading-color);">Publications de {{ user.prenom }}</h4>
        
        {% if posts is empty %}
            <div class="alert alert-light text-center border rounded shadow-sm py-5">
                <i class="bi bi-journal-x fs-1 text-muted mb-3 d-block"></i>
                Cet utilisateur n'a pas encore publié dans la communauté.
            </div>
        {% else %}
            {% for post in posts %}
                <div class="card mb-4 shadow-sm border-0" style="border-radius: 12px; overflow: hidden; transition: transform 0.2s;">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title fw-bold m-0">
                                <a href="{{ path('app_user_and_diag_community_detail', {'id': post.id}) }}" class="text-decoration-none" style="color: var(--heading-color);">
                                    {{ post.title }}
                                </a>
                            </h5>
                            {% if post.isResolved %}
                                <span class="badge bg-success rounded-pill"><i class="bi bi-check-circle me-1"></i>Résolu</span>
                            {% endif %}
                        </div>
                        <p class="card-text text-muted small mb-3">
                            <i class="bi bi-clock me-1"></i> Publié le {{ post.createdAt|date('d/m/Y H:i') }}
                        </p>
                        <p class="card-text text-dark">
                            {{ post.description|length > 200 ? post.description|slice(0, 200) ~ '...' : post.description }}
                        </p>
                        
                        <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                            <div class="text-muted small">
                                <span class="me-3"><i class="bi bi-chat-dots me-1"></i> Réponses</span>
                                <span class="me-3"><i class="bi bi-hand-thumbs-up me-1"></i> {{ post.likes }}</span>
                                <span><i class="bi bi-hand-thumbs-down me-1"></i> {{ post.dislikes }}</span>
                            </div>
                            <a href="{{ path('app_user_and_diag_community_detail', {'id': post.id}) }}" class="btn btn-sm btn-primary rounded-pill px-3">Lire la suite</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% endblock %}
