<div class="mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Mes produits en vente</h5>
    <span class="badge bg-light text-dark border">{{ produitsEnVente.getTotalItemCount }}</span>
  </div>

  {% if produitsEnVente is empty %}
    <div class="alert alert-light border mb-0">
      Aucun produit en vente visible pour le moment.
    </div>
  {% else %}
    <div class="row g-3">
      {% for produit in produitsEnVente %}
        <div class="col-md-6">
          <a href="{{ path('app_marketplace_produit_show', {id: produit.id}) }}" class="text-decoration-none text-dark">
            <div class="border rounded-3 p-3 h-100 bg-white">
              <div class="d-flex gap-3 align-items-start">
                <div style="width:64px; height:64px; border-radius:10px; overflow:hidden; background:#f5f5f5; flex-shrink:0;">
                  {% if produit.image %}
                    <img src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="{{ produit.nom }}" style="width:100%; height:100%; object-fit:cover;">
                  {% else %}
                    <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                      <i class="bi bi-box-seam"></i>
                    </div>
                  {% endif %}
                </div>
                <div class="flex-grow-1">
                  <h6 class="mb-1 text-truncate">{{ produit.nom }}</h6>
                  <div class="small text-muted mb-1">{{ produit.categorie ?: 'Sans catégorie' }}</div>
                  <div class="fw-bold text-success">{{ produit.prixFinal|number_format(2, '.', ' ') }} DT</div>
                </div>
              </div>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>

    {% if produitsEnVente.getTotalItemCount > 6 %}
      <div class="mt-3 d-flex justify-content-center">
        {{ knp_pagination_render(produitsEnVente, '@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig') }}
      </div>
    {% endif %}
  {% endif %}
</div>