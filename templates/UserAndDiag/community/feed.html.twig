{% extends 'base.html.twig' %}

{% block title %}Communauté Ardhi{% endblock %}

{% block body_class %}community-page{% endblock %}

{% block stylesheets %}
<link href="{{ asset('assets/css/UserAndDiag/community-feed.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<section class="community-hero">
    <div class="community-header">
        <h1>👥 Communauté</h1>
        <form class="search-box" method="GET" action="{{ path('app_user_and_diag_community') }}">
            <input type="text" name="q" placeholder="Rechercher un sujet..." value="{{ keyword }}">
        </form>
        <a href="{{ path('app_user_and_diag_community_new') }}" class="btn-new-post">+ Poser une question</a>
    </div>

    <div class="feed-container">
        {% for item in feedData %}
            {% set post = item.post %}
            <a href="{{ path('app_user_and_diag_community_detail', {id: post.id}) }}" class="post-card">
                <div class="post-header">
                    {% set colors = ['#E0F2F1','#FCE4EC','#E8EAF6','#F3E5F5','#FFF3E0'] %}
                    {% set textColors = ['#00695C','#AD1457','#283593','#6A1B9A','#E65100'] %}
                    {% set idx = loop.index0 % 5 %}
                    <div class="avatar" style="background:{{ colors[idx] }};color:{{ textColors[idx] }}">
                        {{ post.user.prenom|default('U')|first|upper }}
                    </div>
                    <div class="post-meta">
                        <div class="author">{{ post.user.prenom }} {{ post.user.nom }}</div>
                        <div class="date">{{ post.createdAt|date('d/m/Y à H:i') }}</div>
                    </div>
                    {% if post.resolved %}
                        <span class="badge-resolved">✓ RÉSOLU</span>
                    {% endif %}
                </div>

                <div class="post-title">{{ post.title }}</div>
                <div class="post-desc">{{ post.description|length > 200 ? post.description|slice(0,200) ~ '...' : post.description }}</div>

                {% if post.imageUrl %}
                    <img src="{{ post.imageUrl }}" class="post-image" alt="Image jointe" loading="lazy">
                {% endif %}

                <div class="post-footer">
                    <span>💬 {{ item.commentCount }}</span>
                    <span class="{{ item.userVote == 'LIKE' ? 'active-like' : '' }}">👍 {{ post.likes }}</span>
                    <span class="{{ item.userVote == 'DISLIKE' ? 'active-dislike' : '' }}">👎 {{ post.dislikes }}</span>
                </div>
            </a>
        {% else %}
            <div class="empty-state">
                <p style="font-size: 40px; margin-bottom: 12px;">🌱</p>
                <p>Aucun post pour le moment.<br>Soyez le premier à poser une question !</p>
            </div>
        {% endfor %}
    </div>
</section>
{% endblock %}
