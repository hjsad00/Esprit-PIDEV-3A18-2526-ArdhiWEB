{% extends 'base.html.twig' %}

{% block title %}Communauté Ardhi{% endblock %}

{% block body_class %}community-page{% endblock %}

{% block stylesheets %}
<link href="{{ asset('assets/css/UserAndDiag/community-feed.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<section class="community-hero">
    <div style="max-width: 820px; margin: 0 auto; padding: 0 20px;">
        <nav aria-label="breadcrumb" class="mb-4 text-start">
            <ol class="breadcrumb m-0" style="--bs-breadcrumb-divider: '>';">
                <li class="breadcrumb-item"><a href="{{ path('app_client_dashboard') }}" style="color: rgba(255,255,255,0.7); text-decoration: none;">Dashboard</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Communauté</li>
            </ol>
        </nav>
    </div>
    <div class="community-header">
        <h1 class="mb-3">👥 Communauté</h1>
        <div style="display:flex;align-items:center;gap:12px;">
            <span id="resultCount" style="color:rgba(255,255,255,0.5);font-size:0.85rem;">{{ feedData|length }} post(s)</span>
            <div class="search-box">
                <input type="text" id="searchInput" placeholder="Rechercher un sujet..." oninput="filterPosts()">
            </div>
        </div>
        {% if app.user and app.user.banned %}
            <a href="#" onclick="alert('⛔ Votre compte a été banni de la communauté.'); return false;" class="btn-new-post">+ Poser une question</a>
        {% elseif app.user and app.user.mutedUntil and app.user.mutedUntil > date() %}
            <a href="#" onclick="alert('🔇 Vous êtes muet jusqu\'au {{ app.user.mutedUntil|date('d/m/Y H:i') }}.{% if latestMuteReason %} Raison : {{ latestMuteReason|escape('js') }}{% endif %}'); return false;" class="btn-new-post">+ Poser une question</a>
        {% else %}
            <a href="{{ path('app_user_and_diag_community_new') }}" class="btn-new-post">+ Poser une question</a>
        {% endif %}
        {% if isModerator|default(false) %}
            <a href="{{ path('app_user_and_diag_moderation_dashboard') }}" class="btn-new-post" style="background:linear-gradient(135deg,#e53935,#ff7043);margin-left:8px;">🛡️ Modération</a>
        {% endif %}
    </div>

    <div class="feed-container">
        {% for item in feedData %}
            {% set post = item.post %}
            <div onclick="window.location.href='{{ path('app_user_and_diag_community_detail', {id: post.id}) }}'" class="post-card" style="cursor: pointer;"
               data-track-type="post-feed" data-track-id="{{ post.id }}"
               data-search="{{ post.title|lower }} {{ post.description|lower }} {{ post.user.prenom|lower }} {{ post.user.nom|lower }}">
                <div class="post-header">
                    {% set colors = ['#E0F2F1','#FCE4EC','#E8EAF6','#F3E5F5','#FFF3E0'] %}
                    {% set textColors = ['#00695C','#AD1457','#283593','#6A1B9A','#E65100'] %}
                    {% set idx = loop.index0 % 5 %}
                    {% if post.user.avatar %}
                        <img src="{{ post.user.avatar }}" class="avatar" style="object-fit: cover;" alt="Avatar">
                    {% else %}
                        <div class="avatar" style="background:{{ colors[idx] }};color:{{ textColors[idx] }}">
                            {{ post.user.prenom|default('U')|first|upper }}
                        </div>
                    {% endif %}
                    <div class="post-meta">
                        <div class="author">
                            <a href="{{ path('app_profile_show', {'id': post.user.id}) }}" class="text-decoration-none" style="color: inherit;" onclick="event.stopPropagation();">
                                {{ post.user.prenom }} {{ post.user.nom }}
                            </a>
                            {% if post.user.role == 'AGRONOME' %}
                                <span title="Agronome Vérifié" style="color:#4caf50;font-size:14px;margin-left:4px;">✅</span>
                            {% endif %}
                            {% if post.user.role == 'ADMIN' or post.user.moderator %}
                                <span title="Modérateur" style="color:#ff9800;font-size:11px;margin-left:4px;background:rgba(255,152,0,0.15);padding:1px 6px;border-radius:8px;">🛡️ MOD</span>
                            {% endif %}
                        </div>
                        <div class="date">{{ post.createdAt|date('d/m/Y à H:i') }}</div>
                    </div>
                    {% if post.resolved %}
                        <span class="badge-resolved">✓ RÉSOLU</span>
                    {% endif %}
                </div>

                <div class="post-title">{{ post.title }}</div>
                <div class="post-desc">{{ post.description|length > 200 ? post.description|slice(0,200) ~ '...' : post.description }}</div>

                {% if post.imageUrl %}
                    <img src="{{ post.imageUrl }}" class="post-image" alt="Image jointe" loading="lazy">
                {% endif %}

                <div class="post-footer">
                    <span>💬 {{ item.commentCount }}</span>
                    <span class="{{ item.userVote == 'LIKE' ? 'active-like' : '' }}">👍 {{ post.likes }}</span>
                    <span class="{{ item.userVote == 'DISLIKE' ? 'active-dislike' : '' }}">👎 {{ post.dislikes }}</span>
                    {% if app.user and post.user.id != app.user.id %}
                        {% if app.user.banned %}
                            <span class="report-btn" onclick="event.stopPropagation(); alert('⛔ Votre compte a été banni de la communauté.')" title="Signaler la publication">🚩</span>
                        {% elseif app.user.mutedUntil and app.user.mutedUntil > date() %}
                            <span class="report-btn" onclick="event.stopPropagation(); alert('🔇 Vous êtes muet. Signalement impossible.')" title="Signaler la publication">🚩</span>
                        {% else %}
                            <span class="report-btn" onclick="event.stopPropagation(); reportPost({{ post.id }})" title="Signaler la publication">🚩</span>
                        {% endif %}
                    {% endif %}
                    {% if app.user and post.user.id == app.user.id %}
                        <span style="color:#64b5f6;" title="Vues page">👁️ {{ post.views|default(0) }}</span>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="empty-state">
                <p style="font-size: 40px; margin-bottom: 12px;">🌱</p>
                <p>Aucun post pour le moment.<br>Soyez le premier à poser une question !</p>
            </div>
        {% endfor %}
    </div>
</section>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('assets/js/UserAndDiag/community-analytics.js') }}"></script>
<script>
    function filterPosts() {
        const filterText = document.getElementById('searchInput').value.toLowerCase();
        const cards = document.querySelectorAll('.post-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const searchableData = card.getAttribute('data-search') || '';
            if (searchableData.includes(filterText)) {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        document.getElementById('resultCount').innerText = visibleCount + ' post(s)';
    }

    function reportPost(postId) {
        const reason = prompt('Raison du signalement :');
        if (!reason) return;
        fetch(`/user-and-diag/community/${postId}/report`, {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: `reason=${encodeURIComponent(reason)}`
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) alert('✅ ' + d.message);
            else alert('⚠️ ' + (d.error || 'Erreur'));
        })
        .catch(() => alert('Erreur réseau.'));
    }
</script>
{% endblock %}
