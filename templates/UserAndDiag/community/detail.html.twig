{% extends 'base.html.twig' %}

{% block title %}{{ post.title }} - Communauté Ardhi{% endblock %}

{% block body_class %}community-detail-page premium-header-active{% endblock %}

{% block stylesheets %}
<link href="{{ asset('assets/css/UserAndDiag/community-detail.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<section class="detail-hero">
    <div class="detail-container">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb m-0" style="--bs-breadcrumb-divider: '>';">
                <li class="breadcrumb-item"><a href="{{ path('app_user_and_diag_community') }}" style="color: rgba(255,255,255,0.7); text-decoration: none;">Communauté</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Post Detail</li>
            </ol>
        </nav>

        {# ─── Post Card ─── #}
        <div class="glass-card">
            <div class="post-header">
                {% set colors = ['#E0F2F1','#FCE4EC','#E8EAF6','#F3E5F5','#FFF3E0'] %}
                {% set textColors = ['#00695C','#AD1457','#283593','#6A1B9A','#E65100'] %}
                {% set idx = post.user.id % 5 %}
                {% if post.user.avatar %}
                    <img src="{{ post.user.avatar }}" class="avatar" style="object-fit: cover;" alt="Avatar">
                {% else %}
                    <div class="avatar" style="background:{{ colors[idx] }};color:{{ textColors[idx] }}">
                        {{ post.user.prenom|default('U')|first|upper }}
                    </div>
                {% endif %}
                <div class="post-meta">
                    <div class="author">
                        <a href="{{ path('app_profile_show', {'id': post.user.id}) }}" class="text-decoration-none" style="color: inherit;">
                            {{ post.user.prenom }} {{ post.user.nom }}
                        </a>
                        {% if post.user.role == 'AGRONOME' %}
                            <span title="Agronome Vérifié" style="color:#4caf50;font-size:14px;margin-left:4px;">✅</span>
                        {% endif %}
                        {% if post.user.role == 'ADMIN' or post.user.moderator %}
                            <span title="Modérateur" style="color:#ff9800;font-size:11px;margin-left:4px;background:rgba(255,152,0,0.15);padding:1px 6px;border-radius:8px;">🛡️ MOD</span>
                        {% endif %}
                    </div>
                    <div class="date">{{ post.createdAt|date('d/m/Y à H:i') }}</div>
                </div>
                {% if post.resolved %}
                    <span class="badge-resolved">✓ RÉSOLU</span>
                {% endif %}
            </div>

            <div class="post-title">{{ post.title }}</div>
            <div class="post-body">{{ post.description|emojify|social_embed }}</div>

            {% if post.imageUrl %}
                <img src="{{ post.imageUrl }}" class="post-image" alt="Image du post" loading="lazy">
            {% endif %}

            {% if app.user and post.user.id == app.user.id %}
                <div class="post-owner-actions mt-3 mb-3">
                    {% if app.user.banned %}
                        <a href="#" onclick="alert('⛔ Votre compte a été banni de la communauté.'); return false;" class="btn btn-sm" style="border-radius: 20px; padding: 4px 12px; margin-right: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; border: 1px solid rgba(255,255,255,0.2); color: white;">✏️ Modifier</a>
                        <button onclick="alert('⛔ Votre compte a été banni de la communauté.');" class="btn btn-sm" style="border-radius: 20px; padding: 4px 12px; border: 1px solid rgba(255,0,0,0.4); color: #ff5252; background: transparent; display: inline-flex; align-items: center; gap: 4px;">🗑️ Supprimer</button>
                    {% elseif app.user.mutedUntil and app.user.mutedUntil > date() %}
                        <a href="#" onclick="alert('🔇 Vous êtes muet jusqu\'au {{ app.user.mutedUntil|date('d/m/Y H:i') }}. Modification impossible.'); return false;" class="btn btn-sm" style="border-radius: 20px; padding: 4px 12px; margin-right: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; border: 1px solid rgba(255,255,255,0.2); color: white;">✏️ Modifier</a>
                        <button onclick="alert('🔇 Vous êtes muet jusqu\'au {{ app.user.mutedUntil|date('d/m/Y H:i') }}. Suppression impossible.');" class="btn btn-sm" style="border-radius: 20px; padding: 4px 12px; border: 1px solid rgba(255,0,0,0.4); color: #ff5252; background: transparent; display: inline-flex; align-items: center; gap: 4px;">🗑️ Supprimer</button>
                    {% else %}
                        <a href="{{ path('app_user_and_diag_community_edit', {id: post.id}) }}" class="btn btn-sm btn-outline-primary" style="border-radius: 20px; padding: 4px 12px; margin-right: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; border: 1px solid rgba(255,255,255,0.2); color: white;">✏️ Modifier</a>
                        <form action="{{ path('app_user_and_diag_community_delete', {id: post.id}) }}" method="POST" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette question ?');">
                            <button type="submit" class="btn btn-sm" style="border-radius: 20px; padding: 4px 12px; border: 1px solid rgba(255,0,0,0.4); color: #ff5252; background: transparent; display: inline-flex; align-items: center; gap: 4px;">🗑️ Supprimer</button>
                        </form>
                    {% endif %}
                </div>
            {% endif %}

            <div class="action-bar">
                <button class="vote-btn {{ postVote == 'LIKE' ? 'active-like' : '' }}" id="btnLikePost" onclick="votePost('LIKE')">
                    👍 <span id="postLikes">{{ post.likes }}</span>
                </button>
                <button class="vote-btn {{ postVote == 'DISLIKE' ? 'active-dislike' : '' }}" id="btnDislikePost" onclick="votePost('DISLIKE')">
                    👎 <span id="postDislikes">{{ post.dislikes }}</span>
                </button>
                {% if app.user and post.user.id != app.user.id %}
                    {% if app.user.banned %}
                        <button class="vote-btn" onclick="alert('⛔ Votre compte a été banni de la communauté.')" style="font-size:12px;">🚩 Signaler</button>
                    {% elseif app.user.mutedUntil and app.user.mutedUntil > date() %}
                        <button class="vote-btn" onclick="alert('🔇 Vous êtes muet. Signalement impossible.')" style="font-size:12px;">🚩 Signaler</button>
                    {% else %}
                        <button class="vote-btn" onclick="reportPost({{ post.id }})" style="font-size:12px;">🚩 Signaler</button>
                    {% endif %}
                {% endif %}
            </div>
        </div>

        {# ─── Comments ─── #}
        <div class="comments-header">Réponses ({{ commentCount }})</div>

        <div id="commentsContainer">
            {% macro render_comment(comment, childrenMap, commentVotes, post, currentUserId, depth) %}
                {% set isOp = comment.user.id == post.user.id %}
                {% set vote = commentVotes[comment.id] ?? null %}
                {% set ml = depth * 35 %}
                {% if ml > 200 %}{% set ml = 200 %}{% endif %}

                <div class="comment-card {{ comment.solution ? 'solution' : '' }}" style="margin-left: {{ ml }}px" data-id="{{ comment.id }}">
                    <div class="comment-header">
                        {% set colors = ['#E0F2F1','#FCE4EC','#E8EAF6','#F3E5F5','#FFF3E0'] %}
                        {% set textColors = ['#00695C','#AD1457','#283593','#6A1B9A','#E65100'] %}
                        {% set idx = comment.user.id % 5 %}
                        {% if comment.user.avatar %}
                            <img src="{{ comment.user.avatar }}" class="avatar-sm" style="object-fit: cover; border-radius: 50%;" alt="Avatar">
                        {% else %}
                            <div class="avatar-sm" style="background:{{ colors[idx] }};color:{{ textColors[idx] }}">
                                {{ comment.user.prenom|default('U')|first|upper }}
                            </div>
                        {% endif %}
                        <span class="comment-author">
                            <a href="{{ path('app_profile_show', {'id': comment.user.id}) }}" class="text-decoration-none" style="color: inherit;">
                                {{ comment.user.prenom }} {{ comment.user.nom }}
                            </a>
                        </span>
                        {% if isOp %}<span class="badge-op">OP</span>{% endif %}
                        {% if comment.solution %}<span class="badge-solution">✓ SOLUTION</span>{% endif %}
                    </div>
                    <div class="comment-body">{{ comment.content|emojify }}</div>
                    <div class="comment-actions">
                        <button class="{{ vote == 'LIKE' ? 'active-like' : '' }}" onclick="voteComment({{ comment.id }}, 'LIKE', this)">👍 <span>{{ comment.likes }}</span></button>
                        <button class="{{ vote == 'DISLIKE' ? 'active-dislike' : '' }}" onclick="voteComment({{ comment.id }}, 'DISLIKE', this)">👎 <span>{{ comment.dislikes }}</span></button>
                        <button onclick="replyTo({{ comment.id }}, '{{ comment.user.prenom }}')">Répondre</button>
                        {% if post.user.id == currentUserId and not post.resolved and not comment.solution %}
                            <button class="btn-solve" onclick="markSolution({{ post.id }}, {{ comment.id }})">✓ Marquer comme solution</button>
                        {% endif %}
                        {% if app.user and comment.user.id != app.user.id %}
                            {% if app.user.banned %}
                                <button style="color:#fbc02d;font-size:11px;" onclick="alert('⛔ Votre compte a été banni de la communauté.')">🚩 Signaler</button>
                            {% elseif app.user.mutedUntil and app.user.mutedUntil > date() %}
                                <button style="color:#fbc02d;font-size:11px;" onclick="alert('🔇 Vous êtes muet. Signalement impossible.')">🚩 Signaler</button>
                            {% else %}
                                <button style="color:#fbc02d;font-size:11px;" onclick="reportComment({{ comment.id }})">🚩 Signaler</button>
                            {% endif %}
                        {% endif %}
                        {% if is_granted('ROLE_MODERATOR') %}
                            <button style="color:#e53935;font-size:11px;" onclick="modDeleteComment({{ comment.id }})">🗑️ Mod Supprimer</button>
                        {% endif %}
                        {% if app.user and comment.user.id == app.user.id %}
                            {% if app.user.banned %}
                                <button style="color:#64b5f6;font-size:11px;" onclick="alert('⛔ Votre compte a été banni de la communauté.')">✏️ Éditer</button>
                                <button style="color:#e53935;font-size:11px;" onclick="alert('⛔ Votre compte a été banni de la communauté.')">🗑️ Supprimer</button>
                            {% elseif app.user.mutedUntil and app.user.mutedUntil > date() %}
                                <button style="color:#64b5f6;font-size:11px;" onclick="alert('🔇 Vous êtes muet jusqu\'au {{ app.user.mutedUntil|date('d/m/Y H:i') }}.')">✏️ Éditer</button>
                                <button style="color:#e53935;font-size:11px;" onclick="alert('🔇 Vous êtes muet jusqu\'au {{ app.user.mutedUntil|date('d/m/Y H:i') }}.')">🗑️ Supprimer</button>
                            {% else %}
                                <button style="color:#64b5f6;font-size:11px;" onclick="editComment({{ comment.id }})">✏️ Éditer</button>
                                <button style="color:#e53935;font-size:11px;" onclick="deleteComment({{ comment.id }})">🗑️ Supprimer</button>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>

                {% if childrenMap[comment.id] is defined %}
                    {% for child in childrenMap[comment.id] %}
                        {{ _self.render_comment(child, childrenMap, commentVotes, post, currentUserId, depth + 1) }}
                    {% endfor %}
                {% endif %}
            {% endmacro %}

            {% for comment in rootComments %}
                {{ _self.render_comment(comment, childrenMap, commentVotes, post, app.user.id, 0) }}
            {% endfor %}
        </div>
    </div>
</section>

{# ─── Sticky Comment Input ─── #}
<div class="comment-input-area">
    <div class="reply-indicator" id="replyIndicator">
        Réponse à <strong id="replyName"></strong>
        <button class="cancel-reply" onclick="cancelReply()">✕</button>
    </div>
    <div class="comment-input-inner">
        <div style="display:flex;align-items:center;gap:6px;width:100%;">
            <button type="button" class="emoji-toggle" onclick="toggleEmojiPicker()" title="Emojis" style="background:none;border:none;font-size:20px;cursor:pointer;">😊</button>
            <textarea id="txtComment" placeholder="Écrire un commentaire... (utilisez :plant: :tomato: :fire: etc.)" rows="1" style="flex:1;"></textarea>
        </div>
        <button class="btn-send" onclick="sendComment()">Envoyer</button>
    </div>
    <div id="emojiPicker" style="display:none;background:rgba(30,30,30,0.95);border-radius:12px;padding:10px;margin-top:8px;flex-wrap:wrap;gap:6px;max-width:400px;">
        <span class="ep" onclick="insertEmote(':plant:')" title=":plant:">🌱</span>
        <span class="ep" onclick="insertEmote(':sun:')" title=":sun:">☀️</span>
        <span class="ep" onclick="insertEmote(':rain:')" title=":rain:">🌧️</span>
        <span class="ep" onclick="insertEmote(':bug:')" title=":bug:">🐛</span>
        <span class="ep" onclick="insertEmote(':leaf:')" title=":leaf:">🍃</span>
        <span class="ep" onclick="insertEmote(':tomato:')" title=":tomato:">🍅</span>
        <span class="ep" onclick="insertEmote(':corn:')" title=":corn:">🌽</span>
        <span class="ep" onclick="insertEmote(':tractor:')" title=":tractor:">🚜</span>
        <span class="ep" onclick="insertEmote(':check:')" title=":check:">✅</span>
        <span class="ep" onclick="insertEmote(':warning:')" title=":warning:">⚠️</span>
        <span class="ep" onclick="insertEmote(':fire:')" title=":fire:">🔥</span>
        <span class="ep" onclick="insertEmote(':heart:')" title=":heart:">❤️</span>
        <span class="ep" onclick="insertEmote(':thumbsup:')" title=":thumbsup:">👍</span>
        <span class="ep" onclick="insertEmote(':star:')" title=":star:">⭐</span>
        <span class="ep" onclick="insertEmote(':idea:')" title=":idea:">💡</span>
        <span class="ep" onclick="insertEmote(':trophy:')" title=":trophy:">🏆</span>
        <span class="ep" onclick="insertEmote(':wave:')" title=":wave:">👋</span>
        <span class="ep" onclick="insertEmote(':clap:')" title=":clap:">👏</span>
        <span class="ep" onclick="insertEmote(':eyes:')" title=":eyes:">👀</span>
        <span class="ep" onclick="insertEmote(':pray:')" title=":pray:">🙏</span>
        <span class="ep" onclick="insertEmote(':muscle:')" title=":muscle:">💪</span>
        <span class="ep" onclick="insertEmote(':wheat:')" title=":wheat:">🌾</span>
        <span class="ep" onclick="insertEmote(':olive:')" title=":olive:">🫒</span>
        <span class="ep" onclick="insertEmote(':droplet:')" title=":droplet:">💧</span>
        <span class="ep" onclick="insertEmote(':bee:')" title=":bee:">🐝</span>
        <span class="ep" onclick="insertEmote(':ant:')" title=":ant:">🐜</span>
        <span class="ep" onclick="insertEmote(':mushroom:')" title=":mushroom:">🍄</span>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    let replyingToId = null;
    const postId = {{ post.id }};

    // ── Post Voting ──
    function votePost(type) {
        fetch(`/user-and-diag/community/${postId}/vote`, {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: `vote=${type}`
        })
        .then(async r => {
            const data = await r.json();
            if (data.error) throw new Error(data.error);
            return data;
        })
        .then(d => {
            document.getElementById('postLikes').textContent = d.likes;
            document.getElementById('postDislikes').textContent = d.dislikes;
            const btnL = document.getElementById('btnLikePost');
            const btnD = document.getElementById('btnDislikePost');
            btnL.className = 'vote-btn' + (d.userVote === 'LIKE' ? ' active-like' : '');
            btnD.className = 'vote-btn' + (d.userVote === 'DISLIKE' ? ' active-dislike' : '');
        })
        .catch(err => alert(err.message));
    }

    // ── Comment Voting ──
    function voteComment(commentId, type, btn) {
        fetch(`/user-and-diag/community/comment/${commentId}/vote`, {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: `vote=${type}`
        })
        .then(async r => {
            const data = await r.json();
            if (data.error) throw new Error(data.error);
            return data;
        })
        .then(d => {
            const card = btn.closest('.comment-card');
            const btns = card.querySelectorAll('.comment-actions button');
            btns[0].className = d.userVote === 'LIKE' ? 'active-like' : '';
            btns[0].querySelector('span').textContent = d.likes;
            btns[1].className = d.userVote === 'DISLIKE' ? 'active-dislike' : '';
            btns[1].querySelector('span').textContent = d.dislikes;
        })
        .catch(err => alert(err.message));
    }

    // ── Reply ──
    function replyTo(commentId, name) {
        replyingToId = commentId;
        document.getElementById('replyIndicator').style.display = 'block';
        document.getElementById('replyName').textContent = name;
        document.getElementById('txtComment').focus();
        document.getElementById('txtComment').placeholder = `Réponse à ${name}...`;
    }

    function cancelReply() {
        replyingToId = null;
        document.getElementById('replyIndicator').style.display = 'none';
        document.getElementById('txtComment').placeholder = 'Écrire un commentaire...';
    }

    // ── Send Comment ──
    function sendComment() {
        const txt = document.getElementById('txtComment');
        const content = txt.value.trim();
        if (!content) return;

        const body = `content=${encodeURIComponent(content)}` + (replyingToId ? `&parent_id=${replyingToId}` : '');

        fetch(`/user-and-diag/community/${postId}/comment`, {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body
        })
        .then(async r => {
            const data = await r.json();
            if (data.error) throw new Error(data.error);
            return data;
        })
        .then((data) => {
            // Emulate the rendered comment insertion to avoid reload
            const initialId = data.userName.charAt(0).toUpperCase();
            
            // Build the card HTML
            const margin = replyingToId ? 35 : 0; // Simple approximation for UI
            
            const html = `
                <div class="comment-card" style="margin-left: ${margin}px" data-id="${data.id}">
                    <div class="comment-header">
                        <div class="avatar-sm" style="background:#E0F2F1;color:#00695C">${initialId}</div>
                        <span class="comment-author">
                            <a href="#" class="text-decoration-none" style="color: inherit;">
                                ${data.userName}
                            </a>
                        </span>
                    </div>
                    <div class="comment-body">${data.content}</div>
                    <div class="comment-actions">
                        <button onclick="voteComment(${data.id}, 'LIKE', this)">👍 <span>0</span></button>
                        <button onclick="voteComment(${data.id}, 'DISLIKE', this)">👎 <span>0</span></button>
                        <button onclick="replyTo(${data.id}, '${data.userName}')">Répondre</button>
                        <button style="color:#64b5f6;font-size:11px;" onclick="editComment(${data.id})">✏️ Éditer</button>
                        <button style="color:#e53935;font-size:11px;" onclick="deleteComment(${data.id})">🗑️ Supprimer</button>
                    </div>
                </div>
            `;
            
            if (replyingToId) {
                const parentCard = document.querySelector(`.comment-card[data-id="${replyingToId}"]`);
                if (parentCard) {
                    parentCard.insertAdjacentHTML('afterend', html);
                } else {
                    document.getElementById('commentsContainer').insertAdjacentHTML('beforeend', html);
                }
            } else {
                document.getElementById('commentsContainer').insertAdjacentHTML('beforeend', html);
            }

            txt.value = '';
            cancelReply();
        })
        .catch(err => alert(err.message));
    }

    // ── Mark Solution ──
    function markSolution(postId, commentId) {
        if (!confirm('Marquer ce commentaire comme solution ? Cela marquera votre question comme résolue.')) return;

        fetch(`/user-and-diag/community/${postId}/solve/${commentId}`, {
            method: 'POST',
        })
        .then(r => r.json())
        .then(() => location.reload());
    }

    // Auto-expand textarea
    document.getElementById('txtComment').addEventListener('input', function() {
        this.style.height = '44px';
        this.style.height = Math.min(this.scrollHeight, 120) + 'px';
    });

    // ── Emoji Picker ──
    function toggleEmojiPicker() {
        const picker = document.getElementById('emojiPicker');
        picker.style.display = picker.style.display === 'none' ? 'flex' : 'none';
    }
    function insertEmote(code) {
        const ta = document.getElementById('txtComment');
        ta.value += ' ' + code + ' ';
        ta.focus();
    }

    // ── Report Post ──
    function reportPost(postId) {
        const reason = prompt('Raison du signalement :');
        if (!reason) return;
        fetch(`/user-and-diag/community/${postId}/report`, {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: `reason=${encodeURIComponent(reason)}`
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) alert('✅ ' + d.message);
            else alert('⚠️ ' + (d.error || 'Erreur'));
        })
        .catch(() => alert('Erreur réseau.'));
    }

    // ── Mod: Delete Comment ──
    function modDeleteComment(commentId) {
        const reason = prompt('Raison de la suppression :');
        if (!reason) return;
        fetch(`/user-and-diag/moderation/comment/${commentId}/delete`, {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: `reason=${encodeURIComponent(reason)}`
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) location.reload();
            else alert(d.error || 'Erreur');
        });
    }

    // ── Edit Comment ──
    function editComment(commentId) {
        const card = document.querySelector(`.comment-card[data-id="${commentId}"]`);
        const bodyEl = card.querySelector('.comment-body');
        // A simple prompt for editing, strips out emojis which might be rendered as img tags if emojify filter does that, 
        // but here we just grab innerText which should mostly be safe for simple edits.
        const currentContent = bodyEl.innerText;
        const newContent = prompt('Modifiez votre commentaire :', currentContent);

        if (newContent !== null && newContent.trim() !== '' && newContent !== currentContent) {
            fetch(`/user-and-diag/community/comment/${commentId}/edit`, {
                method: 'POST',
                headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                body: `content=${encodeURIComponent(newContent)}`
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) {
                    bodyEl.innerText = d.content;
                } else {
                    alert(d.error || 'Erreur');
                }
            });
        }
    }

    // ── Delete Comment ──
    function deleteComment(commentId) {
        if (!confirm('Voulez-vous vraiment supprimer ce commentaire ?')) return;

        fetch(`/user-and-diag/community/comment/${commentId}/delete`, {
            method: 'POST'
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                const card = document.querySelector(`.comment-card[data-id="${commentId}"]`);
                if (card) card.remove();
            } else {
                alert(d.error || 'Erreur');
            }
        });
    }

    // ── Report Comment ──
    function reportComment(commentId) {
        const reason = prompt('Raison du signalement :');
        if (!reason) return;
        fetch(`/user-and-diag/community/comment/${commentId}/report`, {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: `reason=${encodeURIComponent(reason)}`
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) alert('✅ ' + d.message);
            else alert('⚠️ ' + (d.error || 'Erreur'));
        })
        .catch(() => alert('Erreur réseau.'));
    }
</script>
{% endblock %}