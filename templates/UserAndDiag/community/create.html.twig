{% extends 'base.html.twig' %}

{% block title %}Poser une question - Communauté Ardhi{% endblock %}

{% block body_class %}community-create-page{% endblock %}

{% block stylesheets %}
<style>
    .create-hero {
        padding: 120px 0 40px;
        background: url('{{ asset('assets/img/DiagComm_bg.png') }}') no-repeat center center fixed; background-size: cover;
        min-height: 100vh; display: flex; align-items: flex-start; justify-content: center;
        position: relative;
    }
    .create-hero::before {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background-color: rgba(0,0,0,0.45);
        z-index: 0;
    }
    .create-hero > * { position: relative; z-index: 1; }
    .create-card {
        background: rgba(0,0,0,0.45); backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.15); border-radius: 24px;
        padding: 40px; width: 100%; max-width: 700px; margin: 0 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    }
    .create-card h2 { color: #fff; font-weight: 800; margin-bottom: 8px; }
    .create-card .subtitle { color: rgba(255,255,255,0.6); font-size: 14px; margin-bottom: 30px; }

    .form-group { margin-bottom: 24px; }
    .form-group label { color: #fff; font-weight: 700; font-size: 14px; display: block; margin-bottom: 8px; }
    .form-group input[type="text"],
    .form-group textarea {
        width: 100%; background: rgba(255,255,255,0.9); border: none; border-radius: 12px;
        padding: 14px 18px; font-size: 15px; font-family: 'Inter', sans-serif;
        outline: none; transition: 0.3s; box-sizing: border-box;
    }
    .form-group input:focus, .form-group textarea:focus { box-shadow: 0 0 0 3px rgba(107,127,63,0.4); }
    .form-group textarea { min-height: 160px; resize: vertical; }

    .file-zone {
        background: rgba(0,0,0,0.25); border: 2px dashed rgba(255,255,255,0.35);
        border-radius: 16px; padding: 24px; text-align: center; color: rgba(255,255,255,0.5);
        cursor: pointer; transition: 0.3s; position: relative;
    }
    .file-zone:hover { border-color: rgba(255,255,255,0.5); background: rgba(0,0,0,0.35); }
    .file-zone input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
    .file-zone .preview { max-height: 120px; border-radius: 10px; margin-top: 10px; }

    .btn-publish {
        width: 100%; background: linear-gradient(135deg, #6B7F3F, #4A5A2B); color: #fff;
        border: none; padding: 16px; border-radius: 30px; font-size: 17px; font-weight: 800;
        cursor: pointer; transition: 0.3s; margin-top: 10px;
    }
    .btn-publish:hover { transform: translateY(-2px); opacity: 0.9; }
    .btn-back {
        display: inline-flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.7);
        text-decoration: none; font-size: 14px; font-weight: 600; margin-bottom: 24px; transition: 0.3s;
    }
    .btn-back:hover { color: #fff; }
</style>
{% endblock %}

{% block body %}
<section class="create-hero">
    <div class="create-card">
        <a href="{{ path('app_user_and_diag_community') }}" class="btn-back">← Retour à la communauté</a>
        <h2>Poser une question</h2>
        <p class="subtitle">Partagez votre problème avec la communauté Ardhi.</p>

        <form method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label>Titre</label>
                <input type="text" name="title" placeholder="Ex: Feuilles jaunes sur mes tomates..." required>
            </div>
            <div class="form-group">
                <label>Description détaillée</label>
                <textarea name="description" placeholder="Décrivez les symptômes, le contexte, les traitements déjà essayés..." required></textarea>
            </div>
            <div class="form-group">
                <label>Image jointe (optionnel)</label>
                <div class="file-zone" id="fileZone">
                    <input type="file" name="image" accept="image/*" id="fileInput">
                    <p>📷 Cliquez ou glissez une image ici</p>
                    <img id="imgPreview" class="preview" style="display:none" alt="Preview">
                </div>
            </div>
            <button type="submit" class="btn-publish">Publier la question</button>
        </form>
    </div>
</section>
{% endblock %}

{% block javascripts %}
<script>
    const fileInput = document.getElementById('fileInput');
    const preview = document.getElementById('imgPreview');
    fileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
            preview.src = URL.createObjectURL(file);
            preview.style.display = 'block';
        }
    });
</script>
{% endblock %}
