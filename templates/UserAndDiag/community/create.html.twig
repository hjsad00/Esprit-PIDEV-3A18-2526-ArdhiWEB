{% extends 'base.html.twig' %}

{% block title %}Poser une question - Communauté Ardhi{% endblock %}

{% block body_class %}community-create-page{% endblock %}

{% block stylesheets %}
<link href="{{ asset('assets/css/UserAndDiag/community-create.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<section class="create-hero">
    <div class="create-card">
        <nav aria-label="breadcrumb" class="mb-4 text-start">
            <ol class="breadcrumb m-0" style="--bs-breadcrumb-divider: '>';">
                <li class="breadcrumb-item"><a href="{{ path('app_user_and_diag_community') }}" style="color: rgba(255,255,255,0.7); text-decoration: none;">Communauté</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Poser une question</li>
            </ol>
        </nav>
        <h2>Poser une question</h2>
        <p class="subtitle">Partagez votre problème avec la communauté Ardhi.</p>

        <form method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label>Titre</label>
                <input type="text" name="title" placeholder="Ex: Feuilles jaunes sur mes tomates..." required>
            </div>
            <div class="form-group">
                <label>Description détaillée</label>
                <textarea name="description" id="postDescription" placeholder="Décrivez les symptômes, le contexte, les traitements déjà essayés..." required></textarea>
            </div>
            <div class="form-group">
                <label>Image jointe (optionnel)</label>
                <div class="file-zone" id="fileZone">
                    <input type="file" name="image" accept="image/*" id="fileInput">
                    <p>📷 Cliquez ou glissez une image ici</p>
                    <img id="imgPreview" class="preview" style="display:none" alt="Preview">
                </div>
            </div>
            <button type="submit" class="btn-publish">Publier la question</button>
        </form>
    </div>
</section>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('assets/js/UserAndDiag/community-mentions.js') }}"></script>
<script>
    const fileInput = document.getElementById('fileInput');
    const preview = document.getElementById('imgPreview');
    fileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
            preview.src = URL.createObjectURL(file);
            preview.style.display = 'block';
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        setupMentions('postDescription');
    });
</script>
{% endblock %}
