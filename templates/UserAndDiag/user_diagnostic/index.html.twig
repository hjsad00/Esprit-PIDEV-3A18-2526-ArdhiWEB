{% extends 'base.html.twig' %}

{% block title %}Ardhi - Diagnostic IA{% endblock %}

{% block stylesheets %}
<style>
    /* Premium Glassmorphic Core Setup */
    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: url('{{ asset('assets/img/hero_3.jpg') }}') no-repeat center center fixed;
        background-size: cover;
    }
    
    /* Global Overlay */
    .dashboard-background {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background-color: rgba(0,0,0, 0.4);
        z-index: -1;
    }

    .diagnostic-container {
        padding: 100px 30px 40px;
        min-height: 100vh;
    }

    .panel-glass {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
        padding: 30px;
        color: white;
    }

    .header-bar {
        display: flex;
        align-items: center;
        background: rgba(0,0,0,0.3);
        padding: 15px 25px;
        border-radius: 15px;
        margin-bottom: 30px;
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }

    .btn-back {
        background: transparent;
        color: white;
        border: none;
        font-size: 24px;
        cursor: pointer;
        padding: 0 15px 0 0;
        transition: transform 0.2s ease;
    }
    .btn-back:hover {
        transform: translateX(-5px);
    }
    
    .header-title {
        font-size: 22px;
        font-weight: 700;
        margin: 0;
        text-shadow: 1px 1px 4px rgba(0,0,0,0.5);
    }
    
    .badge-premium {
        background: rgba(107, 127, 63, 0.85); /* Ardhi Green */
        color: white;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: bold;
        margin-left: auto;
    }

    /* Uploader Area */
    .image-preview-zone {
        background: rgba(255, 255, 255, 0.85);
        border: 2px dashed rgba(0, 0, 0, 0.2);
        border-radius: 12px;
        height: 260px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        overflow: hidden;
        position: relative;
    }
    .image-preview-zone img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        display: none;
    }
    .image-preview-placeholder {
        color: #555;
        font-size: 15px;
        text-align: center;
    }
    
    /* Custom Buttons */
    .btn-glass {
        border-radius: 10px;
        font-weight: bold;
        color: white;
        border: none;
        padding: 12px 20px;
        transition: all 0.3s ease;
        text-shadow: 0 1px 2px rgba(0,0,0,0.5);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
    }
    
    .btn-blue { background: rgba(91, 153, 163, 0.65); border: 1px solid rgba(255,255,255,0.2); }
    .btn-blue:hover { background: rgba(91, 153, 163, 0.85); transform: translateY(-2px); color: white;}
    
    .btn-orange { background: rgba(230, 126, 34, 0.85); border: 1px solid rgba(255,255,255,0.2); }
    .btn-orange:hover { background: rgba(230, 126, 34, 1); transform: translateY(-2px); color: white;}
    
    .btn-purple { background: rgba(142, 68, 173, 0.75); border: 1px solid rgba(255,255,255,0.2); }
    .btn-purple:hover { background: rgba(142, 68, 173, 0.95); transform: translateY(-2px); color:white;}
    
    .btn-scan {
        background: rgba(107, 127, 63, 0.9);
        border: 1px solid rgba(255,255,255,0.4);
        width: 100%;
        padding: 16px;
        font-size: 16px;
        margin-top: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }
    .btn-scan:hover:not(:disabled) {
        background: rgba(107, 127, 63, 1);
        transform: translateY(-2px);
        color:white;
    }
    .btn-scan:disabled {
        background: rgba(107, 127, 63, 0.5);
        cursor: not-allowed;
    }
    
    /* Result Area */
    #result-panel {
        display: none; /* hidden until scan completes */
    }

    .result-title {
        font-size: 26px;
        font-weight: 800;
        margin-top: 15px;
        margin-bottom: 20px;
        text-shadow: 1px 1px 4px rgba(0,0,0,0.6);
    }

    .confidence-wrapper {
        background: rgba(255, 255, 255, 0.9);
        border-radius: 10px;
        padding: 12px 15px;
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        color: #333;
    }
    .progress-bar-custom {
        flex-grow: 1;
        height: 10px;
        background: rgba(0,0,0,0.1);
        border-radius: 5px;
        overflow: hidden;
    }
    .progress-bar-fill {
        height: 100%;
        background: #6B7F3F;
        width: 0%;
        transition: width 1s ease-in-out;
    }
    .confidence-text {
        font-weight: bold;
        color: #d35400; /* dark orange */
        font-size: 16px;
    }
    
    .treatment-box {
        margin-top: 20px;
        line-height: 1.6;
        font-size: 15px;
        text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
    }

    /* Loading Overlay */
    .loading-overlay {
        position: absolute;
        top:0; left:0; width:100%; height:100%;
        background: rgba(0,0,0,0.7);
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 10;
        display: none;
    }
    
    .spinner {
        width: 50px;
        height: 50px;
        border: 5px solid rgba(255,255,255,0.3);
        border-top-color: #6B7F3F;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 15px;
    }
    
    @keyframes spin { 100% { transform: rotate(360deg); } }

    .action-stack {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 25px;
    }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-background"></div>

<div class="container diagnostic-container">
    <div class="header-bar">
        <a href="{{ path('app_client_dashboard') }}" class="btn-back"><i class="bi bi-arrow-left"></i></a>
        <h1 class="header-title">Diagnostic IA</h1>
        <div class="badge-premium" id="badgePremium">
            {% if limit == -1 %}
                ✅ Illimité ({{ planName }})
            {% elseif used >= limit %}
                ❌ Limite atteinte ({{ planName }})
            {% else %}
                ✅ {{ used }}/{{ limit }} diagnostics effectués ({{ planName }})
            {% endif %}
        </div>
    </div>

    <!-- Main Content -->
    <div class="row g-4 position-relative">
        
        <!-- Loading Overlay (Absolutely positioned over the entire grid) -->
        <div class="loading-overlay" id="loadingOverlay">
            <div class="spinner"></div>
            <h4 class="text-white text-shadow">Analyse de la végétation en cours...</h4>
            <p class="text-white-50">Appel modèle LlaMa-4-Vision</p>
        </div>

        <!-- Left Column: Upload -->
        <div class="col-lg-5">
            <div class="panel-glass position-relative">
                <h4 class="mb-4">📷 Importer une image</h4>
                
                <div class="image-preview-zone" id="dropZone">
                    <div class="image-preview-placeholder" id="placeholder">
                        <i class="bi bi-cloud-arrow-up display-4"></i><br>
                        Aucune image sélectionnée<br>
                        <small>Cliquez sur Importer ou glissez une photo ici</small>
                    </div>
                    <img id="imgPreview" src="" alt="Aperçu">
                </div>

                <div class="d-flex justify-content-between mb-3 gap-2">
                    <button id="btnImport" class="btn-glass btn-blue flex-grow-1" {% if limit != -1 and used >= limit %}disabled title="Limite horaire atteinte"{% endif %} onclick="document.getElementById('fileInput').click()">
                        <i class="bi bi-folder2-open"></i> Importer
                    </button>
                    <!-- Hidden input to handle the actual file selection -->
                    <input type="file" id="fileInput" accept="image/*" style="display:none" onchange="previewImage(event)" {% if limit != -1 and used >= limit %}disabled{% endif %}>

                    <button id="btnCamera" class="btn-glass btn-orange flex-grow-1" {% if limit != -1 and used >= limit %}disabled{% endif %} onclick="alert('Module Caméra intégré dans l\'application iOS/Android.')">
                        <i class="bi bi-camera"></i> Caméra
                    </button>
                </div>
                
                <hr style="opacity: 0.2;">

                <button class="btn-glass btn-scan" id="btnScan" disabled onclick="lancerScan()">
                    <i class="bi bi-cpu"></i> LANCER LE DIAGNOSTIC
                </button>
            </div>
        </div>

        <!-- Right Column: Results -->
        <div class="col-lg-7">
            <div class="panel-glass h-100" id="result-panel">
                <div class="d-flex align-items-center gap-2">
                    <span style="font-size: 22px;">📊</span>
                    <h5 class="m-0 font-weight-bold" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.5);">RÉSULTAT DE L'ANALYSE</h5>
                </div>

                <div class="result-title" id="lblMaladieTitre">
                    Diagnostic en cours...
                </div>

                <div class="confidence-wrapper">
                    <span>Fiabilité :</span>
                    <div class="progress-bar-custom">
                        <div class="progress-bar-fill" id="barConfiance"></div>
                    </div>
                    <span class="confidence-text" id="lblConfiance">0%</span>
                </div>

                <hr style="opacity: 0.2;">

                <div class="treatment-box" id="lblTraitement">
                    <!-- Dynamic Treatment Description Injection -->
                </div>
                
                <div class="action-stack">
                    <a href="#" id="btnChatIa" class="btn-glass btn-blue w-100"><i class="bi bi-chat-dots"></i> Discuter avec l'IA</a>
                    <a href="#" class="btn-glass btn-purple w-100"><i class="bi bi-people"></i> Demander à la Communauté</a>
                    <a href="#" class="btn-glass" style="background: rgba(39, 174, 96, 0.85); w-100"><i class="bi bi-person-check"></i> Demander l'avis d'un Expert</a>
                    <a href="#" class="btn-glass w-100" style="background: #e67e22;"><i class="bi bi-journal-medical"></i> Commencer le Protocole de Soin</a>
                </div>
            </div>
        </div>
        
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    let selectedFile = null;
    let currentUsed = {{ used }};
    const maxLimit = {{ limit }};
    const planName = '{{ planName|escape('js') }}';

    // 1. Image Preview Logic
    function previewImage(event) {
        if(event.target.files && event.target.files[0]){
            // Extra safety block
            if(maxLimit !== -1 && currentUsed >= maxLimit) { return; }

            selectedFile = event.target.files[0];
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('imgPreview').src = e.target.result;
                document.getElementById('imgPreview').style.display = 'block';
                document.getElementById('placeholder').style.display = 'none';
                
                // Enable scan button
                document.getElementById('btnScan').disabled = false;
                
                // Hide result panel if it was open from a previous scan
                document.getElementById('result-panel').style.display = 'none';
            }
            reader.readAsDataURL(selectedFile);
        }
    }

    // Drag and Drop Logic
    const dropZone = document.getElementById('dropZone');
    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = 'rgba(107, 127, 63, 1)';
    });
    dropZone.addEventListener('dragleave', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = 'rgba(0,0,0,0.2)';
    });
    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = 'rgba(0,0,0,0.2)';
        if(e.dataTransfer.files && e.dataTransfer.files[0]) {
            document.getElementById('fileInput').files = e.dataTransfer.files;
            previewImage({target: document.getElementById('fileInput')});
        }
    });

    // 2. AJAX Scan Logic
    function lancerScan() {
        if(!selectedFile) return;

        // Show loading state
        const loadingOverlay = document.getElementById('loadingOverlay');
        loadingOverlay.style.display = 'flex';
        document.getElementById('btnScan').disabled = true;

        const formData = new FormData();
        formData.append('image', selectedFile);

        executeAjaxScan(formData, loadingOverlay);
    }

    function executeAjaxScan(formData, loadingOverlay) {
        fetch("{{ path('app_user_and_diag_user_diagnostic_scan') }}", {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            loadingOverlay.style.display = 'none';
            document.getElementById('btnScan').disabled = false;

            if(data.error) {
                alert("Erreur: " + data.error);
                return;
            }

            // Populate Results
            document.getElementById('result-panel').style.display = 'block';
            document.getElementById('lblMaladieTitre').innerText = data.plante + ' : ' + data.maladie;
            
            // Animation for Confidence Bar
            setTimeout(() => {
                document.getElementById('barConfiance').style.width = data.confiance + '%';
            }, 100);
            document.getElementById('lblConfiance').innerText = data.confiance + '%';
            
            // Adjust confidence text color based on severity/confidence
            let color = '#d35400';
            if(data.severity === 'CRITICAL') color = '#e74c3c'; // Red
            if(data.confiance > 80 && data.severity !== 'CRITICAL') color = '#27ae60'; // Green

            document.getElementById('lblConfiance').style.color = color;

            document.getElementById('lblTraitement').innerHTML = `
                <strong>Traitement recommandé : </strong> ${data.traitement.nom}<br>
                <div class="mt-2 text-warning d-inline-block px-2 py-1 bg-dark bg-opacity-25 rounded"><small>Catégorie : ${data.traitement.type}</small></div>
                <hr style="opacity:0.2;">
                <p class="mb-0">${data.traitement.description}</p>
            `;

            // Update Chat Button Link
            const chatLink = "{{ path('app_user_and_diag_chatbot', {id: 'PLACEHOLDER'}) }}".replace('PLACEHOLDER', data.diagnostic_id);
            document.getElementById('btnChatIa').setAttribute('href', chatLink);

            // Update real-time limits
            if(data.usage) {
                currentUsed = data.usage.used;
                const limit = data.usage.limit;
                
                const badge = document.getElementById('badgePremium');
                if (limit !== -1 && currentUsed >= limit) {
                    badge.innerHTML = `❌ Limite atteinte (${planName})`;
                    // Disable inputs since the limit for the hour is hit
                    document.getElementById('fileInput').disabled = true;
                    document.getElementById('btnImport').disabled = true;
                    document.getElementById('btnCamera').disabled = true;
                    document.getElementById('btnScan').disabled = true;
                } else {
                    if (limit === -1) {
                        badge.innerHTML = `✅ Illimité (${planName})`;
                    } else {
                        badge.innerHTML = `✅ ${currentUsed}/${limit} diagnostics effectués (${planName})`;
                    }
                }
            }
        })
        .catch(error => {
            loadingOverlay.style.display = 'none';
            document.getElementById('btnScan').disabled = false;
            console.error('Error:', error);
            alert("Erreur de connexion lors du scan.");
        });
    }
</script>
{% endblock %}
