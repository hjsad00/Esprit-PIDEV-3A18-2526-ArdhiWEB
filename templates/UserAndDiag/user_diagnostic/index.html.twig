{% extends 'base.html.twig' %}

{% block title %}Ardhi - Diagnostic IA{% endblock %}

{% block body_class %}diagnostic-page{% endblock %}

{% block stylesheets %}
<link href="{{ asset('assets/css/UserAndDiag/diagnostic.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="dashboard-background"></div>

<div class="container diagnostic-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb m-0" style="--bs-breadcrumb-divider: '>';">
                <li class="breadcrumb-item"><a href="{{ path('app_client_dashboard') }}" class="text-white-50 text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Diagnostic IA</li>
            </ol>
        </nav>
        
        <div class="badge-premium m-0" id="badgePremium">
            {% if limit == -1 %}
                ✅ Illimité ({{ planName }})
            {% elseif used >= limit %}
                ❌ Limite atteinte ({{ planName }})
            {% else %}
                ✅ {{ used }}/{{ limit }} diagnostics effectués ({{ planName }})
            {% endif %}
        </div>
    </div>

    <!-- Main Content -->
    <div class="row g-4 position-relative">
        
        <!-- Loading Overlay (Absolutely positioned over the entire grid) -->
        <div class="loading-overlay" id="loadingOverlay">
            <div class="spinner"></div>
            <h4 class="text-white text-shadow">Analyse de la végétation en cours...</h4>
            <p class="text-white-50">Appel modèle LlaMa-4-Vision</p>
        </div>

        <!-- Left Column: Upload -->
        <div class="col-lg-5">
            <div class="panel-glass position-relative">
                <h4 class="mb-4">📷 Importer une image</h4>
                
                <div class="image-preview-zone" id="dropZone">
                    <div class="image-preview-placeholder" id="placeholder">
                        <i class="bi bi-cloud-arrow-up display-4"></i><br>
                        Aucune image sélectionnée<br>
                        <small>Cliquez sur Importer ou glissez une photo ici</small>
                    </div>
                    <img id="imgPreview" src="" alt="Aperçu">
                </div>

                <div class="d-flex justify-content-between mb-3 gap-2">
                    <button id="btnImport" class="btn-glass btn-blue flex-grow-1" {% if limit != -1 and used >= limit %}disabled title="Limite horaire atteinte"{% endif %} onclick="document.getElementById('fileInput').click()">
                        <i class="bi bi-folder2-open"></i> Importer
                    </button>
                    <!-- Hidden input to handle the actual file selection -->
                    <input type="file" id="fileInput" accept="image/*" style="display:none" onchange="previewImage(event)" {% if limit != -1 and used >= limit %}disabled{% endif %}>
                </div>
                
                <hr style="opacity: 0.2;">

                <button class="btn-glass btn-scan" id="btnScan" disabled onclick="lancerScan()">
                    <i class="bi bi-cpu"></i> LANCER LE DIAGNOSTIC
                </button>
            </div>
        </div>

        <!-- Right Column: Results -->
        <div class="col-lg-7">
            <div class="panel-glass h-100" id="result-panel">
                <div class="d-flex align-items-center gap-2">
                    <span style="font-size: 22px;">📊</span>
                    <h5 class="m-0 font-weight-bold" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.5);">RÉSULTAT DE L'ANALYSE</h5>
                </div>

                <div class="result-title" id="lblMaladieTitre">
                    Diagnostic en cours...
                </div>

                <div class="confidence-wrapper">
                    <span>Fiabilité :</span>
                    <div class="progress-bar-custom">
                        <div class="progress-bar-fill" id="barConfiance"></div>
                    </div>
                    <span class="confidence-text" id="lblConfiance">0%</span>
                </div>

                <hr style="opacity: 0.2;">

                <div class="treatment-box" id="lblTraitement">
                    <!-- Dynamic Treatment Description Injection -->
                </div>
                
                <div class="action-stack">
                    <a href="#" id="btnChatIa" class="btn-glass btn-blue w-100"><i class="bi bi-chat-dots"></i> Discuter avec l'IA</a>
                    <a href="#" id="btnCommunity" class="btn-glass btn-purple w-100" onclick="return false;" style="opacity:0.5; pointer-events:none;"><i class="bi bi-people"></i> Demander à la Communauté</a>
                    
                    <button id="btnSecondOpinion" class="btn-glass w-100" style="background: rgba(41, 128, 185, 0.85); border: 1px solid rgba(41, 128, 185, 0.4);" onclick="demanderSecondAvis()">
                        <i class="bi bi-person-badge"></i> Demander un 2ème avis (Agronome)
                    </button>
                    <div id="secondOpinionNotification" class="inline-notification"></div>

                    <button id="btnCreatePlan" class="btn-glass btn-orange w-100" onclick="genererPlanTraitement()">
                        <i class="bi bi-calendar2-check"></i> Générer un Plan de Traitement
                    </button>
                    
                    <div id="planNotification" class="inline-notification"></div>
                </div>
            </div>
        </div>
        
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    let selectedFile = null;
    let currentUsed = {{ used }};
    const maxLimit = {{ limit }};
    const planName = '{{ planName|escape('js') }}';
    // NEW: Variable to store the ID of the newly created diagnostic
    let currentDiagnosticId = null; 

    // 1. Image Preview Logic
    function previewImage(event) {
        if(event.target.files && event.target.files[0]){
            // Extra safety block
            if(maxLimit !== -1 && currentUsed >= maxLimit) { return; }

            selectedFile = event.target.files[0];
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('imgPreview').src = e.target.result;
                document.getElementById('imgPreview').style.display = 'block';
                document.getElementById('placeholder').style.display = 'none';
                
                // Enable scan button
                document.getElementById('btnScan').disabled = false;
                
                // Hide result panel if it was open from a previous scan
                document.getElementById('result-panel').style.display = 'none';
            }
            reader.readAsDataURL(selectedFile);
        }
    }

    // Drag and Drop Logic
    const dropZone = document.getElementById('dropZone');
    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = 'rgba(107, 127, 63, 1)';
    });
    
    dropZone.addEventListener('dragleave', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = 'rgba(0,0,0,0.2)';
    });
    
    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = 'rgba(0,0,0,0.2)';
        if(e.dataTransfer.files && e.dataTransfer.files[0]) {
            document.getElementById('fileInput').files = e.dataTransfer.files;
            previewImage({target: document.getElementById('fileInput')});
        }
    });

    // 2. AJAX Scan Logic
    function lancerScan() {
        if(!selectedFile) return;
        
        // Show loading state
        const loadingOverlay = document.getElementById('loadingOverlay');
        loadingOverlay.style.display = 'flex';
        document.getElementById('btnScan').disabled = true;

        const formData = new FormData();
        formData.append('image', selectedFile);

        executeAjaxScan(formData, loadingOverlay);
    }

    function executeAjaxScan(formData, loadingOverlay) {
        fetch("{{ path('app_user_and_diag_user_diagnostic_scan') }}", {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            loadingOverlay.style.display = 'none';
            document.getElementById('btnScan').disabled = false;

            if(data.error) {
                alert("Erreur: " + data.error);
                return;
            }

            // --- NEW CODE: Save ID and Reset UI for Treatment Plan ---
            currentDiagnosticId = data.diagnostic_id;
            
            const btnPlan = document.getElementById('btnCreatePlan');
            const notifPlan = document.getElementById('planNotification');
            
            if (btnPlan && notifPlan) {
                notifPlan.style.display = 'none';
                btnPlan.disabled = false;
                btnPlan.innerHTML = '<i class="bi bi-calendar2-check"></i> Générer un Plan de Traitement';
                // Remove custom click if it was added previously
                btnPlan.onclick = genererPlanTraitement;
            }
            // ---------------------------------------------------------

            // Populate Results
            document.getElementById('result-panel').style.display = 'block';
            document.getElementById('lblMaladieTitre').innerText = data.plante + ' : ' + data.maladie;
            
            // Animation for Confidence Bar
            setTimeout(() => {
                document.getElementById('barConfiance').style.width = data.confiance + '%';
            }, 100);
            document.getElementById('lblConfiance').innerText = data.confiance + '%';
            
            // Adjust confidence text color based on severity/confidence
            let color = '#d35400';
            if(data.severity === 'CRITICAL') color = '#e74c3c'; // Red
            if(data.confiance > 80 && data.severity !== 'CRITICAL') color = '#27ae60'; // Green

            document.getElementById('lblConfiance').style.color = color;
            
            document.getElementById('lblTraitement').innerHTML = `
                <strong>Traitement recommandé : </strong> ${data.traitement.nom}<br>
                <div class="mt-2 text-warning d-inline-block px-2 py-1 bg-dark bg-opacity-25 rounded"><small>Catégorie : ${data.traitement.type}</small></div>
                <hr style="opacity:0.2;">
                <p class="mb-0">${data.traitement.description}</p>
            `;
            
            // Update Chat Button Link
            const chatLink = "{{ path('app_user_and_diag_chatbot', {id: 'PLACEHOLDER'}) }}".replace('PLACEHOLDER', data.diagnostic_id);
            document.getElementById('btnChatIa').setAttribute('href', chatLink);

            // Update Community Button — pre-fill with diagnostic results
            const communityBtn = document.getElementById('btnCommunity');
            if (communityBtn) {
                const title = encodeURIComponent(`[Diagnostic] ${data.plante} — ${data.maladie} (${data.confiance}% fiabilité)`);
                const desc = encodeURIComponent(
                    `🌱 Plante : ${data.plante}\n` +
                    `🔬 Maladie détectée : ${data.maladie}\n` +
                    `📊 Fiabilité : ${data.confiance}%\n` +
                    `💊 Traitement suggéré : ${data.traitement.nom} (${data.traitement.type})\n` +
                    `📝 Description : ${data.traitement.description}\n\n` +
                    `---\n` +
                    `Bonjour la communauté, j'ai effectué un diagnostic IA et j'aimerais avoir vos avis ou retours d'expérience sur ce résultat. Merci !`
                );
                const communityUrl = `{{ path('app_user_and_diag_community_new') }}?title=${title}&description=${desc}`;
                communityBtn.setAttribute('href', communityUrl);
                communityBtn.style.opacity = '1';
                communityBtn.style.pointerEvents = 'auto';
                communityBtn.setAttribute('onclick', '');
            }

            // Update real-time limits
            if(data.usage) {
                currentUsed = data.usage.used;
                const limit = data.usage.limit;
                
                const badge = document.getElementById('badgePremium');
                if (limit !== -1 && currentUsed >= limit) {
                    badge.innerHTML = `❌ Limite atteinte (${planName})`;
                    
                    // Disable inputs since the limit for the hour is hit
                    document.getElementById('fileInput').disabled = true;
                    document.getElementById('btnImport').disabled = true;
                    document.getElementById('btnScan').disabled = true;
                } else {
                    if (limit === -1) {
                        badge.innerHTML = `✅ Illimité (${planName})`;
                    } else {
                        badge.innerHTML = `✅ ${currentUsed}/${limit} diagnostics effectués (${planName})`;
                    }
                }
            }
        })
        .catch(error => {
            loadingOverlay.style.display = 'none';
            document.getElementById('btnScan').disabled = false;
            console.error('Error:', error);
            alert("Erreur de connexion lors du scan.");
        });
    }

    // --- NEW FUNCTION: Generate Treatment Plan ---
    function genererPlanTraitement() {
        if (!currentDiagnosticId) return;

        const btn = document.getElementById('btnCreatePlan');
        const notif = document.getElementById('planNotification');
        
        // UI Loading State
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Vérification...';
        notif.style.display = 'none';

        // Build the URL dynamically using Twig's path function
        const url = "{{ path('app_user_and_diag_create_treatment_plan', {id: 'ID_PLACEHOLDER'}) }}".replace('ID_PLACEHOLDER', currentDiagnosticId);

        fetch(url, {
            method: 'POST',
            headers: { 
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            notif.style.display = 'block';
            
            if (data.success) {
                // Success UI
                notif.className = 'inline-notification notif-success';
                notif.innerHTML = `<i class="bi bi-check-circle-fill"></i> ${data.message}`;
                btn.innerHTML = '<i class="bi bi-eye"></i> Voir le Plan';
                
                // Change button behavior to redirect to the new plan index
                // Adjust this URL to match your actual route for viewing plans!
                btn.onclick = () => window.location.href = `/user-and-diag/treatment-plan/`; 
                btn.disabled = false;
            } else {
                // Error / Access Denied UI
                notif.className = 'inline-notification notif-error';
                
                if (data.upgrade_required) {
                    notif.innerHTML = `<i class="bi bi-lock-fill"></i> ${data.error} <br><a href="/user-and-diag/subscription" class="text-white text-decoration-underline mt-1 d-inline-block">Mettre à niveau</a>`;
                } else {
                    notif.innerHTML = `<i class="bi bi-exclamation-triangle-fill"></i> ${data.error}`;
                }
                
                btn.innerHTML = '<i class="bi bi-calendar2-check"></i> Générer un Plan de Traitement';
                btn.disabled = false;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            notif.style.display = 'block';
            notif.className = 'inline-notification notif-error';
            notif.innerHTML = '<i class="bi bi-x-circle-fill"></i> Une erreur réseau est survenue.';
            btn.innerHTML = '<i class="bi bi-calendar2-check"></i> Générer un Plan de Traitement';
            btn.disabled = false;
        });
    }

    // --- "Demander un 2ème avis" function ---
    function demanderSecondAvis() {
        if (!currentDiagnosticId) return;

        const btn = document.getElementById('btnSecondOpinion');
        const notif = document.getElementById('secondOpinionNotification');

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Envoi...';
        notif.style.display = 'none';

        const url = "{{ path('app_user_and_diag_ask_second_opinion', {id: 'ID_PLACEHOLDER'}) }}".replace('ID_PLACEHOLDER', currentDiagnosticId);

        fetch(url, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            notif.style.display = 'block';

            if (data.success) {
                notif.className = 'inline-notification notif-success';
                notif.innerHTML = `<i class="bi bi-check-circle-fill"></i> ${data.message}`;
                btn.innerHTML = '<i class="bi bi-check-lg"></i> Demande envoyée';
                // Leave disabled to prevent spam
            } else {
                notif.className = 'inline-notification notif-error';
                notif.innerHTML = `<i class="bi bi-exclamation-triangle-fill"></i> ${data.error}`;
                btn.innerHTML = '<i class="bi bi-person-badge"></i> Demander un 2ème avis (Agronome)';
                btn.disabled = false;
            }
        })
        .catch(err => {
            notif.style.display = 'block';
            notif.className = 'inline-notification notif-error';
            notif.innerHTML = '<i class="bi bi-x-circle-fill"></i> Erreur réseau.';
            btn.innerHTML = '<i class="bi bi-person-badge"></i> Demander un 2ème avis (Agronome)';
            btn.disabled = false;
        });
    }
</script>
{% endblock %}
