{% extends 'base.html.twig' %}

{% block title %}Ardhi - Assistant IA{% endblock %}

{% block stylesheets %}
<link href="{{ asset('assets/css/UserAndDiag/chat.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="dashboard-background"></div>

<div class="chat-container">
    <div class="mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb m-0" style="--bs-breadcrumb-divider: '>';">
                <li class="breadcrumb-item"><a href="{{ path('app_user_and_diag_user_diagnostic') }}" style="color: rgba(255,255,255,0.7); text-decoration: none;">Diagnostic IA</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Assistant IA</li>
            </ol>
        </nav>
    </div>
    <div class="header-bar mb-3">
        <div class="mt-2">
            <h1 class="header-title text-white m-0" style="font-size: 20px; font-weight: 700;">Ardhi Assistant IA</h1>
            <small class="text-white-50">Sujet : {{ diagnostic.resultatIa }}</small>
        </div>
    </div>

    <div class="chat-window">
        <div class="message-area" id="messageArea">
            <!-- Initial AI Message -->
            <div class="message message-ai">
                Bonjour ! Je suis Ardhi-IA. Je suis prêt à répondre à vos questions sur ce diagnostic de <strong>{{ diagnostic.resultatIa }}</strong>. Comment puis-je vous aider ?
            </div>

            {% for msg in history %}
                <div class="message {{ msg.role == 'user' ? 'message-user' : 'message-ai' }}">
                    {{ msg.content|nl2br }}
                </div>
            {% endfor %}
        </div>

        <div id="typingIndicator" class="px-4 typing">Ardhi-IA réfléchit...</div>

        <div class="input-bar">

            <input type="text" id="chatInput" class="chat-input" placeholder="Posez une question sur le traitement..." autocomplete="off">
            <button class="btn-action btn-send" id="btnSend">
                ENVOYER
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    const messageArea = document.getElementById('messageArea');
    const chatInput = document.getElementById('chatInput');
    const btnSend = document.getElementById('btnSend');
    const typingIndicator = document.getElementById('typingIndicator');

    // Scroll to bottom
    const scrollToBottom = () => {
        messageArea.scrollTop = messageArea.scrollHeight;
    };
    scrollToBottom();

    function addMessage(text, role) {
        const div = document.createElement('div');
        div.className = `message message-${role}`;
        div.innerHTML = text.replace(/\n/g, '<br>');
        messageArea.appendChild(div);
        scrollToBottom();
    }

    async function sendMessage() {
        const msg = chatInput.value.trim();
        if (!msg) return;

        // Add user message to UI
        addMessage(msg, 'user');
        chatInput.value = '';
        chatInput.disabled = true;
        btnSend.disabled = true;
        typingIndicator.style.display = 'block';

        const formData = new FormData();
        formData.append('message', msg);

        try {
            const response = await fetch("{{ path('app_user_and_diag_chatbot_send', {id: diagnostic.id}) }}", {
                method: 'POST',
                body: formData
            });
            const data = await response.json();

            typingIndicator.style.display = 'none';
            chatInput.disabled = false;
            btnSend.disabled = false;
            chatInput.focus();

            if (data.response) {
                addMessage(data.response, 'ai');
            } else {
                addMessage("Désolé, j'ai rencontré un problème.", 'ai');
            }
        } catch (error) {
            typingIndicator.style.display = 'none';
            chatInput.disabled = false;
            btnSend.disabled = false;
            console.error('Chat Error:', error);
            addMessage("Erreur de connexion au serveur.", 'ai');
        }
    }

    btnSend.addEventListener('click', sendMessage);
    chatInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendMessage();
    });

</script>
{% endblock %}
