{% extends 'base.html.twig' %}

{% block title %}Ardhi - Assistant IA{% endblock %}

{% block stylesheets %}
<style>
    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: url('{{ asset('assets/img/DiagComm_bg.png') }}') no-repeat center center fixed;
        background-size: cover;
    }
    
    .dashboard-background {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background-color: rgba(0,0,0, 0.5);
        z-index: -1;
    }

    .chat-container {
        padding: 100px 20px 40px;
        max-width: 900px;
        margin: 0 auto;
        height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .header-bar {
        display: flex;
        align-items: center;
        background: rgba(0,0,0,0.15);
        padding: 15px 25px;
        border-radius: 15px;
        margin-bottom: 20px;
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .btn-back {
        color: white;
        font-size: 24px;
        margin-right: 20px;
        transition: transform 0.2s;
    }
    .btn-back:hover { transform: translateX(-5px); color: #6B7F3F; }

    .chat-window {
        flex-grow: 1;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.4);
    }

    .message-area {
        flex-grow: 1;
        padding: 25px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* Message Bubbles */
    .message {
        max-width: 80%;
        padding: 14px 18px;
        border-radius: 18px;
        font-size: 15px;
        line-height: 1.5;
        position: relative;
        animation: fadeIn 0.3s ease-out;
    }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .message-user {
        align-self: flex-end;
        background: rgba(107, 127, 63, 0.9);
        color: white;
        border-bottom-right-radius: 4px;
        box-shadow: 0 4px 15px rgba(107, 127, 63, 0.3);
    }

    .message-ai {
        align-self: flex-start;
        background: rgba(255, 255, 255, 0.9);
        color: #333;
        border-bottom-left-radius: 4px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    /* Input Area */
    .input-bar {
        background: rgba(255, 255, 255, 0.95);
        padding: 20px 25px;
        display: flex;
        align-items: center;
        gap: 15px;
        border-top: 1px solid rgba(0,0,0,0.05);
    }

    .chat-input {
        flex-grow: 1;
        border: 1px solid #ddd;
        border-radius: 30px;
        padding: 12px 25px;
        font-size: 15px;
        outline: none;
        transition: border-color 0.3s;
    }
    .chat-input:focus { border-color: #6B7F3F; box-shadow: 0 0 0 3px rgba(107, 127, 63, 0.1); }

    .btn-action {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 20px;
    }

    .btn-mic { background: #e67e22; color: white; }
    .btn-mic.active { background: #e74c3c; animation: pulse 1.5s infinite; }
    .btn-send { background: #6B7F3F; color: white; width: auto; padding: 0 25px; border-radius: 30px; font-weight: bold; font-size: 14px;}
    
    .btn-action:hover { transform: scale(1.05); opacity: 0.9; }
    .btn-action:disabled { opacity: 0.5; cursor: not-allowed; }

    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(231, 76, 60, 0.4); } 70% { box-shadow: 0 0 0 15px rgba(231, 76, 60, 0); } 100% { box-shadow: 0 0 0 0 rgba(231, 76, 60, 0); } }

    /* Typing Indicator */
    .typing { font-style: italic; color: rgba(255,255,255,0.7); font-size: 13px; margin-bottom: 10px; display: none; }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-background"></div>

<div class="chat-container">
    <div class="header-bar">
        <a href="{{ path('app_user_and_diag_user_diagnostic') }}" class="btn-back"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h1 class="header-title text-white m-0" style="font-size: 20px; font-weight: 700;">Ardhi Assistant IA</h1>
            <small class="text-white-50">Sujet : {{ diagnostic.resultatIa }}</small>
        </div>
    </div>

    <div class="chat-window">
        <div class="message-area" id="messageArea">
            <!-- Initial AI Message -->
            <div class="message message-ai">
                Bonjour ! Je suis Ardhi-IA. Je suis prêt à répondre à vos questions sur ce diagnostic de <strong>{{ diagnostic.resultatIa }}</strong>. Comment puis-je vous aider ?
            </div>

            {% for msg in history %}
                <div class="message {{ msg.role == 'user' ? 'message-user' : 'message-ai' }}">
                    {{ msg.content|nl2br }}
                </div>
            {% endfor %}
        </div>

        <div id="typingIndicator" class="px-4 typing">Ardhi-IA réfléchit...</div>

        <div class="input-bar">

            <input type="text" id="chatInput" class="chat-input" placeholder="Posez une question sur le traitement..." autocomplete="off">
            <button class="btn-action btn-send" id="btnSend">
                ENVOYER
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    const messageArea = document.getElementById('messageArea');
    const chatInput = document.getElementById('chatInput');
    const btnSend = document.getElementById('btnSend');
    const btnMic = document.getElementById('btnMic');
    const typingIndicator = document.getElementById('typingIndicator');

    // Scroll to bottom
    const scrollToBottom = () => {
        messageArea.scrollTop = messageArea.scrollHeight;
    };
    scrollToBottom();

    function addMessage(text, role) {
        const div = document.createElement('div');
        div.className = `message message-${role}`;
        div.innerHTML = text.replace(/\n/g, '<br>');
        messageArea.appendChild(div);
        scrollToBottom();
    }

    async function sendMessage() {
        const msg = chatInput.value.trim();
        if (!msg) return;

        // Add user message to UI
        addMessage(msg, 'user');
        chatInput.value = '';
        chatInput.disabled = true;
        btnSend.disabled = true;
        typingIndicator.style.display = 'block';

        const formData = new FormData();
        formData.append('message', msg);

        try {
            const response = await fetch("{{ path('app_user_and_diag_chatbot_send', {id: diagnostic.id}) }}", {
                method: 'POST',
                body: formData
            });
            const data = await response.json();

            typingIndicator.style.display = 'none';
            chatInput.disabled = false;
            btnSend.disabled = false;
            chatInput.focus();

            if (data.response) {
                addMessage(data.response, 'ai');
            } else {
                addMessage("Désolé, j'ai rencontré un problème.", 'ai');
            }
        } catch (error) {
            typingIndicator.style.display = 'none';
            chatInput.disabled = false;
            btnSend.disabled = false;
            console.error('Chat Error:', error);
            addMessage("Erreur de connexion au serveur.", 'ai');
        }
    }

    btnSend.addEventListener('click', sendMessage);
    chatInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendMessage();
    });

    // Speech to Text Integration
    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        const recognition = new SpeechRecognition();
        recognition.lang = 'fr-FR';
        recognition.interimResults = false;

        let isRecording = false;

        btnMic.addEventListener('click', () => {
            if (!isRecording) {
                recognition.start();
                btnMic.classList.add('active');
                btnMic.innerHTML = '<i class="bi bi-stop-fill"></i>';
                isRecording = true;
            } else {
                recognition.stop();
            }
        });

        recognition.onresult = (event) => {
            const transcript = event.results[0][0].transcript;
            chatInput.value = transcript;
            btnMic.classList.remove('active');
            btnMic.innerHTML = '<i class="bi bi-mic"></i>';
            isRecording = false;
            sendMessage(); // Auto-send
        };

        recognition.onend = () => {
            btnMic.classList.remove('active');
            btnMic.innerHTML = '<i class="bi bi-mic"></i>';
            isRecording = false;
        };

        recognition.onerror = (event) => {
            console.error('STT Error:', event.error);
            btnMic.classList.remove('active');
            btnMic.innerHTML = '<i class="bi bi-mic"></i>';
            isRecording = false;
        };
    } else {
        btnMic.style.display = 'none';
    }
</script>
{% endblock %}
