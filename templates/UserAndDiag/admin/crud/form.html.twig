{% extends 'UserAndDiag/admin/admin_base.html.twig' %}

{% block title %}{{ page_title }} - Ardhi Admin{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block body %}
<div class="admin-form-card">
  {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

    {% for field in form %}
      {% if field.vars.name != '_token' %}
        {% if 'checkbox' in field.vars.block_prefixes %}
          <div class="mb-3 form-check">
            {{ form_widget(field, {'attr': {'class': 'form-check-input'}}) }}
            {{ form_label(field, null, {'label_attr': {'class': 'form-check-label'}}) }}
            {{ form_errors(field) }}
          </div>
        {% else %}
          <div class="mb-3">
            {{ form_label(field, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(field, {'attr': {'class': 'choice' in field.vars.block_prefixes and field.vars.expanded == false ? 'form-select' : 'form-control'}}) }}
            {{ form_errors(field) }}
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}

    <div class="d-flex gap-2 mt-4">
      <button type="submit" class="btn btn-admin">
        <i class="bi bi-check-lg me-1"></i>{{ submit_label|default('Enregistrer') }}
      </button>
      <a href="{{ path(cancel_route) }}" class="btn btn-admin-outline">Annuler</a>
    </div>

  {{ form_end(form) }}
</div>
{% endblock %}
