{% extends 'UserAndDiag/admin/admin_base.html.twig' %}

{% block title %}{{ page_title }} - Ardhi Admin{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% form_theme form 'bootstrap_5_layout.html.twig' _self %}

{% block form_errors %}
    {% if errors|length > 0 %}
        {% for error in errors %}
            <div class="premium-invalid-feedback d-block mt-2">{{ error.message }}</div>
        {% endfor %}
    {% endif %}
{% endblock form_errors %}

{% block body %}
<div class="admin-form-card">
  {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {{ form_widget(form) }}
    <div class="d-flex gap-2 mt-4">
      <button type="submit" class="btn btn-admin">
        <i class="bi bi-check-lg me-1"></i>Enregistrer
      </button>
      <a href="{{ path(cancel_route) }}" class="btn btn-admin-outline">Annuler</a>
    </div>
  {{ form_end(form) }}
</div>
{% endblock %}
