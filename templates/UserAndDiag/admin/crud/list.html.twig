{% extends 'UserAndDiag/admin/admin_base.html.twig' %}

{% block title %}{{ page_title }} - Ardhi Admin{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}

{% block body %}
<div class="admin-table-card">
  <div class="admin-table-header">
    <h2><i class="bi {{ icon ?? 'bi-table' }} me-2"></i>{{ page_title }}</h2>
    {% if new_route is defined and new_route %}
    <a href="{{ path(new_route) }}" class="btn btn-admin">
      <i class="bi bi-plus-lg me-1"></i>Ajouter
    </a>
    {% endif %}
  </div>

  <div class="admin-filters mb-4">
    <form method="get" class="d-flex gap-2 align-items-center">
      <div class="input-group" style="max-width: 400px;">
        <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input type="text" name="q" class="form-control border-start-0 ps-0" placeholder="Rechercher..." value="{{ app.request.get('q') }}">
      </div>
      
      {% if app.request.get('sort') %}
        <input type="hidden" name="sort" value="{{ app.request.get('sort') }}">
        <input type="hidden" name="direction" value="{{ app.request.get('direction') }}">
      {% endif %}

      <button type="submit" class="btn btn-primary px-4">Filtrer</button>
      
      {% if app.request.get('q') or app.request.get('sort') %}
        <a href="{{ path(app.request.attributes.get('_route')) }}" class="btn btn-outline-secondary">
          <i class="bi bi-x-lg me-1"></i>Réinitialiser
        </a>
      {% endif %}
    </form>
  </div>

  {% if items|length > 0 %}
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          {% for col in columns %}
            <th>
              {% set current_sort = app.request.get('sort') %}
              {% set current_dir = app.request.get('direction', 'asc') %}
              {% set next_dir = (current_sort == col.field and current_dir == 'asc') ? 'desc' : 'asc' %}
              
              <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'sort': col.field, 'direction': next_dir})) }}" class="text-decoration-none text-dark d-flex align-items-center gap-1">
                {{ col.label }}
                {% if current_sort == col.field %}
                  <i class="bi bi-sort-alpha-{{ current_dir == 'asc' ? 'down' : 'up' }} text-primary"></i>
                {% else %}
                  <i class="bi bi-arrow-down-up text-muted small" style="opacity: 0.3"></i>
                {% endif %}
              </a>
            </th>
          {% endfor %}
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for item in items %}
        <tr>
          {% for col in columns %}
            <td>
              {% set value = attribute(item, col.field) %}
              {% if col.type|default('text') == 'date' %}
                {{ value ? value|date('d/m/Y H:i') : '-' }}
              {% elseif col.type|default('text') == 'bool' %}
                {% if value %}
                  <span class="badge bg-success badge-admin">Oui</span>
                {% else %}
                  <span class="badge bg-secondary badge-admin">Non</span>
                {% endif %}
              {% elseif col.type|default('text') == 'relation' %}
                {{ value ? value.id ~ (col.display is defined and col.display ? ' - ' ~ attribute(value, col.display) : '') : '-' }}
              {% elseif col.type|default('text') == 'badge' %}
                <span class="badge badge-admin" style="background: {{ col.color|default('#6c757d') }}22; color: {{ col.color|default('#6c757d') }};">{{ value ?? '-' }}</span>
              {% elseif col.type|default('text') == 'image' %}
                {% if value %}
                  {% if value|slice(0, 4) == 'http' or '.' in value or '/' in value %}
                    <div class="admin-img-wrapper" style="width:60px !important; height:45px !important; overflow:hidden !important; border-radius:4px !important; cursor:pointer;" onclick="window.open('{{ value }}')">
                      {% if value|slice(0, 4) == 'http' %}
                          <img src="{{ value }}" alt="Image" class="admin-crud-thumb" style="width:100% !important; height:100% !important; object-fit:cover !important;">
                      {% else %}
                          <img src="{{ asset(value) }}" alt="Image" class="admin-crud-thumb" style="width:100% !important; height:100% !important; object-fit:cover !important;">
                      {% endif %}
                    </div>
                  {% else %}
                    <div class="admin-icon-preview" style="font-size: 1.5rem;">
                      {% if value|slice(0, 3) == 'bi-' or value|slice(0, 3) == 'fa-' %}
                        <i class="{{ value }}"></i>
                      {% else %}
                        {{ value }}
                      {% endif %}
                    </div>
                  {% endif %}
                {% else %}
                  <span class="text-muted small">Aucune</span>
                {% endif %}
              {% else %}
                {{ value ?? '-' }}
              {% endif %}
            </td>
          {% endfor %}
          <td>
            <div class="action-btns">
              {% if edit_route is defined and edit_route %}
              <a href="{{ path(edit_route, {id: id_getter is defined ? attribute(item, id_getter) : item.id}) }}" class="btn btn-outline-primary btn-sm" title="Modifier">
                <i class="bi bi-pencil"></i>
              </a>
              {% endif %}
              {% if delete_route is defined and delete_route %}
              <form method="post" action="{{ path(delete_route, {id: id_getter is defined ? attribute(item, id_getter) : item.id}) }}" class="delete-form" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ (id_getter is defined ? attribute(item, id_getter) : item.id)) }}">
                <button type="submit" class="btn btn-outline-danger btn-sm" title="Supprimer">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
              {% endif %}
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div class="empty-state">
    <i class="bi {{ icon ?? 'bi-inbox' }}"></i>
    <p>Aucun élément trouvé.</p>
  </div>
  {% endif %}
</div>
{% endblock %}
