<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>{% block title %}Administration - Ardhi{% endblock %}</title>

  <link href="{{ asset('assets/img/ardhi_logo.png') }}" rel="icon">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/css/admin.css') }}" rel="stylesheet">
  {% block stylesheets %}{% endblock %}
</head>
<body>

  <!-- Sidebar -->
  <aside class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-header">
      <a href="{{ path('admin_dashboard') }}" class="sidebar-brand">
        <img src="{{ asset('assets/img/ardhi_logo.png') }}" alt="Ardhi" class="sidebar-logo">
        <span>Ardhi Admin</span>
      </a>
      <button class="sidebar-close d-lg-none" id="sidebarClose"><i class="bi bi-x-lg"></i></button>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section-title">Navigation</div>
      <ul class="nav flex-column">
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active' : '' }}" href="{{ path('admin_dashboard') }}">
            <i class="bi bi-speedometer2"></i><span>Tableau de bord</span>
          </a>
        </li>
      </ul>

      <div class="nav-section-title">Gestion des Entités</div>
      <ul class="nav flex-column">
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_user' ? 'active' : '' }}" href="{{ path('admin_user_index') }}">
            <i class="bi bi-people-fill"></i><span>Utilisateurs</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_diagnostic' ? 'active' : '' }}" href="{{ path('admin_diagnostic_index') }}">
            <i class="bi bi-search"></i><span>Diagnostics</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_abonnement' ? 'active' : '' }}" href="{{ path('admin_abonnement_index') }}">
            <i class="bi bi-credit-card-fill"></i><span>Abonnements</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_avis' ? 'active' : '' }}" href="{{ path('admin_avis_index') }}">
            <i class="bi bi-star-fill"></i><span>Avis</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_badge' ? 'active' : '' }}" href="{{ path('admin_badge_index') }}">
            <i class="bi bi-award-fill"></i><span>Badges</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_community_post' ? 'active' : '' }}" href="{{ path('admin_community_post_index') }}">
            <i class="bi bi-chat-square-text-fill"></i><span>Posts</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_community_comment' ? 'active' : '' }}" href="{{ path('admin_community_comment_index') }}">
            <i class="bi bi-chat-dots-fill"></i><span>Commentaires</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_community_like' ? 'active' : '' }}" href="{{ path('admin_community_like_index') }}">
            <i class="bi bi-heart-fill"></i><span>Likes</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_offre' ? 'active' : '' }}" href="{{ path('admin_offre_index') }}">
            <i class="bi bi-tag-fill"></i><span>Offres</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_review' ? 'active' : '' }}" href="{{ path('admin_review_index') }}">
            <i class="bi bi-clipboard-check-fill"></i><span>Reviews</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_traitement' ? 'active' : '' }}" href="{{ path('admin_traitement_index') }}">
            <i class="bi bi-capsule"></i><span>Traitements</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_farm_health_scan' ? 'active' : '' }}" href="{{ path('admin_farm_health_scan_index') }}">
            <i class="bi bi-activity"></i><span>Scans Santé</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_farm_health_report' ? 'active' : '' }}" href="{{ path('admin_farm_health_report_index') }}">
            <i class="bi bi-file-earmark-medical-fill"></i><span>Rapports Santé</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_prevention_plan' ? 'active' : '' }}" href="{{ path('admin_prevention_plan_index') }}">
            <i class="bi bi-shield-fill-check"></i><span>Plans Prévention</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_prevention_task' ? 'active' : '' }}" href="{{ path('admin_prevention_task_index') }}">
            <i class="bi bi-list-check"></i><span>Tâches Prévention</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_treatment_plan' ? 'active' : '' }}" href="{{ path('admin_treatment_plan_index') }}">
            <i class="bi bi-journal-medical"></i><span>Plans Traitement</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_treatment_task' ? 'active' : '' }}" href="{{ path('admin_treatment_task_index') }}">
            <i class="bi bi-check2-square"></i><span>Tâches Traitement</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_user_badge' ? 'active' : '' }}" href="{{ path('admin_user_badge_index') }}">
            <i class="bi bi-patch-check-fill"></i><span>User Badges</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_vulnerability' ? 'active' : '' }}" href="{{ path('admin_vulnerability_index') }}">
            <i class="bi bi-bug-fill"></i><span>Vulnérabilités</span>
          </a>
        </li>
      </ul>

      <div class="nav-section-title">Compte</div>
      <ul class="nav flex-column">
        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_home') }}">
            <i class="bi bi-house-fill"></i><span>Retour au site</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_logout') }}">
            <i class="bi bi-box-arrow-left"></i><span>Déconnexion</span>
          </a>
        </li>
      </ul>
    </nav>
  </aside>

  <!-- Main Content -->
  <div class="admin-main">
    <!-- Top Navbar -->
    <header class="admin-topbar">
      <button class="sidebar-toggle d-lg-none" id="sidebarToggle"><i class="bi bi-list"></i></button>
      <h1 class="topbar-title">{% block page_title %}Administration{% endblock %}</h1>
      <div class="topbar-right">
        <span class="topbar-user">
          <i class="bi bi-person-circle"></i>
          {{ app.user.prenom ?? '' }} {{ app.user.nom ?? '' }}
        </span>
      </div>
    </header>

    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show mx-4 mt-3" role="alert">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      {% endfor %}
    {% endfor %}

    <!-- Page Content -->
    <main class="admin-content">
      {% block body %}{% endblock %}
    </main>
  </div>

  <div class="sidebar-overlay d-lg-none" id="sidebarOverlay"></div>

  <script src="{{ asset('assets/vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
  <script>
    // Sidebar toggle for mobile
    const toggle = document.getElementById('sidebarToggle');
    const close = document.getElementById('sidebarClose');
    const sidebar = document.getElementById('adminSidebar');
    const overlay = document.getElementById('sidebarOverlay');

    function openSidebar() { sidebar.classList.add('open'); overlay.classList.add('active'); }
    function closeSidebar() { sidebar.classList.remove('open'); overlay.classList.remove('active'); }

    if (toggle) toggle.addEventListener('click', openSidebar);
    if (close) close.addEventListener('click', closeSidebar);
    if (overlay) overlay.addEventListener('click', closeSidebar);
  </script>
  {% block javascripts %}{% endblock %}
</body>
</html>
