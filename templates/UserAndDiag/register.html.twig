{% extends 'base.html.twig' %}

{% block title %}Inscription - Ardhi{% endblock %}

{% block body %}
<section class="section d-flex align-items-center justify-content-center" style="min-height: 60vh;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-6 col-md-8 shadow p-5 bg-white rounded">
        <form method="post" id="registerForm" novalidate>
            <div class="text-center mb-4">
              <h1 class="h3 font-weight-normal" style="color: var(--heading-color);">Créer un compte</h1>
              <p class="text-muted">Rejoignez la communauté Ardhi</p>
            </div>

            {% if errors is not empty %}
              <div class="alert alert-danger mb-4 shadow-sm border-0" style="background: rgba(220, 53, 69, 0.1); border-left: 5px solid #dc3545 !important;">
                <div class="d-flex align-items-center mb-2">
                  <i class="bi bi-exclamation-triangle-fill fs-4 text-danger me-3"></i>
                  <h5 class="mb-0 text-danger fw-bold">Erreur d'inscription</h5>
                </div>
                <ul class="mb-0 ps-4">
                  {% for field, message in errors %}
                    <li class="text-danger small fw-600">{{ message }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="inputNom" class="form-label">Nom <span class="text-danger">*</span></label>
                <input type="text" name="nom" id="inputNom" class="form-control {{ errors.nom is defined ? 'is-invalid' : '' }}" value="{{ last_nom }}" autofocus>
                {% if errors.nom is defined %}
                  <div class="premium-invalid-feedback">{{ errors.nom }}</div>
                {% endif %}
              </div>
              <div class="col-md-6 mb-3">
                <label for="inputPrenom" class="form-label">Prénom <span class="text-danger">*</span></label>
                <input type="text" name="prenom" id="inputPrenom" class="form-control {{ errors.prenom is defined ? 'is-invalid' : '' }}" value="{{ last_prenom }}">
                {% if errors.prenom is defined %}
                  <div class="premium-invalid-feedback">{{ errors.prenom }}</div>
                {% endif %}
              </div>
            </div>

            <div class="mb-3">
              <label for="inputEmail" class="form-label">Email <span class="text-danger">*</span></label>
              <input type="email" name="email" id="inputEmail" class="form-control {{ errors.email is defined ? 'is-invalid' : '' }}" value="{{ last_email }}" autocomplete="email">
              {% if errors.email is defined %}
                <div class="premium-invalid-feedback">{{ errors.email }}</div>
              {% endif %}
            </div>

            <div class="mb-3">
              <label for="inputRole" class="form-label">Rôle <span class="text-danger">*</span></label>
              <select name="role" id="inputRole" class="form-select {{ errors.role is defined ? 'is-invalid' : '' }}">
                <option value="AGRICULTEUR" {{ last_role == 'AGRICULTEUR' ? 'selected' : '' }}>Agriculteur</option>
                <option value="CLIENT" {{ last_role == 'CLIENT' ? 'selected' : '' }}>Client</option>
                <option value="AGRONOME" {{ last_role == 'AGRONOME' ? 'selected' : '' }}>Agronome</option>
              </select>
              {% if errors.role is defined %}
                <div class="premium-invalid-feedback">{{ errors.role }}</div>
              {% endif %}
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="inputPhone" class="form-label">Téléphone</label>
                <input type="tel" name="phone" id="inputPhone" class="form-control {{ errors.phone is defined ? 'is-invalid' : '' }}" value="{{ last_phone }}" placeholder="+216 XX XXX XXX">
                {% if errors.phone is defined %}
                  <div class="premium-invalid-feedback">{{ errors.phone }}</div>
                {% endif %}
              </div>
              <div class="col-md-6 mb-3">
                <label for="inputLocation" class="form-label">Localisation</label>
                <input type="text" name="location" id="inputLocation" class="form-control {{ errors.location is defined ? 'is-invalid' : '' }}" value="{{ last_location }}" placeholder="Ville, Gouvernorat">
                {% if errors.location is defined %}
                  <div class="premium-invalid-feedback">{{ errors.location }}</div>
                {% endif %}
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="inputPassword" class="form-label">Mot de passe <span class="text-danger">*</span></label>
                <input type="password" name="password" id="inputPassword" class="form-control {{ errors.password is defined ? 'is-invalid' : '' }}" autocomplete="new-password">
                <div class="progress mt-2" style="height: 6px; display: none; border-radius: 4px;" id="pwStrengthBarWrapper">
                  <div class="progress-bar" id="pwStrengthBar" role="progressbar" style="width: 0%; transition: width 0.3s ease, background-color 0.3s ease;"></div>
                </div>
                <small id="pwFeedback" class="form-text d-block mt-1 mb-2"></small>
                {% if errors.password is defined %}
                  <div class="premium-invalid-feedback">{{ errors.password }}</div>
                {% endif %}
              </div>
              <div class="col-md-6 mb-3">
                <label for="inputPasswordConfirm" class="form-label">Confirmer <span class="text-danger">*</span></label>
                <input type="password" name="password_confirm" id="inputPasswordConfirm" class="form-control {{ errors.password_confirm is defined ? 'is-invalid' : '' }}" autocomplete="new-password">
                {% if errors.password_confirm is defined %}
                  <div class="premium-invalid-feedback">{{ errors.password_confirm }}</div>
                {% endif %}
              </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">
            <input type="hidden" name="g-recaptcha-response" id="g-recaptcha-response" value="">

            <div class="d-grid mb-3">
              <button class="btn btn-primary btn-lg" type="submit">
                  <i class="bi bi-person-plus me-2"></i>S'inscrire
              </button>
            </div>

            <div class="text-center">
              <p class="text-muted mb-0">
                  Vous avez déjà un compte ?
                  <a href="{{ path('app_login') }}" style="color: var(--accent-color);">Se connecter</a>
              </p>
            </div>
        </form>
      </div>
    </div>
  </div>
</section>
{% endblock %}

{% block javascripts %}
<script src="https://www.google.com/recaptcha/api.js?render=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/zxcvbn/4.4.2/zxcvbn.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const registerForm = document.getElementById('registerForm');
        if (registerForm) {
            registerForm.addEventListener('submit', function(e) {
                if (!document.getElementById('g-recaptcha-response').value) {
                    e.preventDefault();
                    grecaptcha.ready(function() {
                        grecaptcha.execute('6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI', {action: 'register'}).then(function(token) {
                            document.getElementById('g-recaptcha-response').value = token;
                            registerForm.submit();
                        });
                    });
                }
            });
        }

        const pwInput = document.getElementById('inputPassword');
        const pwBarWrapper = document.getElementById('pwStrengthBarWrapper');
        const pwBar = document.getElementById('pwStrengthBar');
        const pwFeedback = document.getElementById('pwFeedback');
        
        if (pwInput) {
            pwInput.addEventListener('input', function() {
                const val = pwInput.value;
                if (val.length === 0) {
                    pwBarWrapper.style.display = 'none';
                    pwFeedback.innerHTML = '';
                    return;
                }
                
                pwBarWrapper.style.display = 'flex';
                const result = zxcvbn(val);
                const score = result.score; // 0 to 4
                
                let width = (score + 1) * 20;
                let color = '#dc3545'; // danger/red
                let text = 'Très faible';
                
                if (score === 1) { width = 40; color = '#ffc107'; text = 'Faible'; }
                if (score === 2) { width = 60; color = '#fd7e14'; text = 'Moyen'; }
                if (score === 3) { width = 80; color = '#20c997'; text = 'Fort'; }
                if (score === 4) { width = 100; color = '#198754'; text = 'Très fort'; }
                
                pwBar.style.width = width + '%';
                pwBar.style.backgroundColor = color;
                
                let feedbackHtml = `<span style="color: ${color}; font-weight: 500;">Sécurité : ${text}</span>`;
                if (result.feedback.warning) {
                    feedbackHtml += ` <span style="font-size: 0.9em; opacity: 0.8; margin-left: 5px;">- ${result.feedback.warning}</span>`;
                }
                pwFeedback.innerHTML = feedbackHtml;
            });
        }
    });
</script>
{% endblock %}
