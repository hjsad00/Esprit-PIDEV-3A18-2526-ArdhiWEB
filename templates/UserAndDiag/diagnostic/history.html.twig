{% extends 'base.html.twig' %}

{% block title %}Ardhi - Historique ds Diagnostics{% endblock %}

{% block stylesheets %}
<link href="{{ asset('assets/css/UserAndDiag/history.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="dashboard-background"></div>

<div class="container-history">
    <div class="glass-panel">
        <div class="header-actions">
            <div>
                <a href="{{ path('app_client_dashboard') }}" class="btn btn-outline-light rounded-pill px-4 mb-2">← Retour</a>
                <h1 class="text-white m-0">Historique des Diagnostics</h1>
                <p class="text-white-50 m-0">Retrouvez vos analyses passées et traitements recommandés.</p>
            </div>
            
            <form action="{{ path('app_user_and_diag_history') }}" method="GET" class="search-box">
                <i class="bi bi-search text-white-50"></i>
                <input type="text" name="q" id="searchInput" class="search-input" placeholder="Rechercher une plante ou maladie..." value="{{ keyword }}">
            </form>
        </div>

        <div class="history-list">
            {% for diagnostic in diagnostics %}
                <div class="history-card" onclick="showTreatment({{ diagnostic.id }}, '{{ diagnostic.resultatIa }}')">
                    <img src="{{ diagnostic.imageScannee }}" alt="Thumb" class="diag-thumb">
                    <div class="diag-info">
                        <div class="diag-title">{{ diagnostic.resultatIa }}</div>
                        <div class="diag-meta">
                            <span><i class="bi bi-calendar3"></i> {{ diagnostic.dateScan|date('d/m/Y H:i') }}</span>
                            <span><i class="bi bi-geo-alt"></i> {{ diagnostic.locationLabel }}</span>
                        </div>
                    </div>
                    <div class="confidence-badge" style="background: {{ diagnostic.confiance >= 80 ? '#d4edda' : '#fff3cd' }}; color: {{ diagnostic.confiance >= 80 ? '#155724' : '#856404' }};">
                        {{ diagnostic.confiance|round }}% Fiabilité
                    </div>
                </div>
            {% else %}
                <div class="text-center py-5 text-white">
                    <i class="bi bi-clipboard-x display-1 opacity-25"></i>
                    <p class="mt-3">Aucun diagnostic trouvé.</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<!-- Treatment Modal -->
<div class="modal fade" id="treatmentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Traitement Recommandé</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody">
                <div class="text-center p-4">
                    <div class="spinner-border text-success" role="status"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success rounded-pill px-4" data-bs-dismiss="modal">Compris</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    const modal = new bootstrap.Modal(document.getElementById('treatmentModal'));
    const modalBody = document.getElementById('modalBody');
    const modalTitle = document.getElementById('modalTitle');

    function showTreatment(id, resultName) {
        modalTitle.innerText = "Traitement : " + resultName;
        modalBody.innerHTML = '<div class="text-center p-4"><div class="spinner-border text-success"></div></div>';
        modal.show();

        fetch("{{ path('app_user_and_diag_history_treatment', {id: 0}) }}".replace('/0/', '/' + id + '/'))
            .then(res => res.json())
            .then(data => {
                if (data.error) {
                    modalBody.innerHTML = `<div class="alert alert-warning">${data.error}</div>`;
                } else {
                    modalBody.innerHTML = `
                        <h6 class="fw-bold text-success"><i class="bi bi-capsule"></i> ${data.solutionNom}</h6>
                        <span class="badge bg-secondary mb-3">${data.typeTraitement}</span>
                        <p>${data.descriptionDetaillee.replace(/\n/g, '<br>')}</p>
                    `;
                }
            })
            .catch(err => {
                modalBody.innerHTML = `<div class="alert alert-danger">Erreur de connexion.</div>`;
            });
    }

    // Voice Search
    const btnMic = document.getElementById('btnMic');
    const searchInput = document.getElementById('searchInput');

    if ('webkitSpeechRecognition' in window) {
        const recognition = new webkitSpeechRecognition();
        recognition.lang = 'fr-FR';
        
        btnMic.addEventListener('click', (e) => {
            e.preventDefault();
            recognition.start();
            btnMic.classList.add('active');
        });

        recognition.onresult = (event) => {
            searchInput.value = event.results[0][0].transcript;
            btnMic.classList.remove('active');
            searchInput.form.submit();
        };

        recognition.onerror = () => btnMic.classList.remove('active');
        recognition.onend = () => btnMic.classList.remove('active');
    } else {
        btnMic.style.display = 'none';
    }
</script>
{% endblock %}
