{% extends 'base.html.twig' %}

{% block title %}Ardhi - Historique ds Diagnostics{% endblock %}

{% block stylesheets %}
<link href="{{ asset('assets/css/UserAndDiag/history.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="dashboard-background"></div>

<div class="container-history">
    <div class="glass-panel">
        <div class="header-actions">
            <div>
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb m-0" style="--bs-breadcrumb-divider: '>';">
                        <li class="breadcrumb-item"><a href="{{ path('app_client_dashboard') }}" class="text-white-50 text-decoration-none">Dashboard</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Historique des Diagnostics</li>
                    </ol>
                </nav>
                <h1 class="text-white m-0">Historique des Diagnostics</h1>
                <p class="text-white-50 m-0">Retrouvez vos analyses passées et traitements recommandés.</p>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <span id="resultCount" class="text-white-50 small">{{ diagnostics|length }} diagnostic(s)</span>
                
                <select id="sortSelect" class="form-select bg-transparent text-white border-light" style="width: auto;" onchange="sortCards()">
                    <option value="date-desc" class="text-dark">Plus récent</option>
                    <option value="date-asc" class="text-dark">Plus ancien</option>
                    <option value="score-desc" class="text-dark">Fiabilité (Haute > Basse)</option>
                </select>

                <div class="search-box" style="display:flex;align-items:center;">
                    <i class="bi bi-search text-white-50"></i>
                    <input type="text" id="searchInput" class="search-input" placeholder="Rechercher une plante ou maladie..." oninput="filterCards()">
                </div>
            </div>
        </div>

        <div class="history-list">
            {% for diagnostic in diagnostics %}
                <div class="history-card" 
                     data-search="{{ diagnostic.resultatIa|lower }} {{ diagnostic.locationLabel|lower }}"
                     data-date="{{ diagnostic.dateScan ? diagnostic.dateScan|date('U') : 0 }}"
                     data-score="{{ diagnostic.confiance|default(0) }}"
                     onclick="showTreatment({{ diagnostic.id }}, '{{ diagnostic.resultatIa }}')">
                    <img src="{{ diagnostic.imageScannee }}" alt="Thumb" class="diag-thumb">
                    <div class="diag-info">
                        <div class="diag-title">{{ diagnostic.resultatIa }}</div>
                        <div class="diag-meta">
                            <span><i class="bi bi-calendar3"></i> {{ diagnostic.dateScan|date('d/m/Y H:i') }}</span>
                            <span><i class="bi bi-geo-alt"></i> {{ diagnostic.locationLabel }}</span>
                        </div>
                    </div>
                    <div class="confidence-badge" style="background: {{ diagnostic.confiance >= 80 ? '#d4edda' : '#fff3cd' }}; color: {{ diagnostic.confiance >= 80 ? '#155724' : '#856404' }};">
                        {{ diagnostic.confiance|round }}% Fiabilité
                    </div>
                </div>
            {% else %}
                <div class="text-center py-5 text-white empty-state-msg">
                    <i class="bi bi-clipboard-x display-1 opacity-25"></i>
                    <p class="mt-3">Aucun diagnostic trouvé.</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<!-- Treatment Modal -->
<div class="modal fade" id="treatmentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Traitement Recommandé</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody">
                <div class="text-center p-4">
                    <div class="spinner-border text-success" role="status"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success rounded-pill px-4" data-bs-dismiss="modal">Compris</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    const modal = new bootstrap.Modal(document.getElementById('treatmentModal'));
    const modalBody = document.getElementById('modalBody');
    const modalTitle = document.getElementById('modalTitle');

    function showTreatment(id, resultName) {
        modalTitle.innerText = "Traitement : " + resultName;
        modalBody.innerHTML = '<div class="text-center p-4"><div class="spinner-border text-success"></div></div>';
        modal.show();

        fetch("{{ path('app_user_and_diag_history_treatment', {id: 0}) }}".replace('/0/', '/' + id + '/'))
            .then(res => res.json())
            .then(data => {
                if (data.error) {
                    modalBody.innerHTML = `<div class="alert alert-warning">${data.error}</div>`;
                } else {
                    modalBody.innerHTML = `
                        <h6 class="fw-bold text-success"><i class="bi bi-capsule"></i> ${data.solutionNom}</h6>
                        <span class="badge bg-secondary mb-3">${data.typeTraitement}</span>
                        <p>${data.descriptionDetaillee.replace(/\n/g, '<br>')}</p>
                    `;
                }
            })
            .catch(err => {
                modalBody.innerHTML = `<div class="alert alert-danger">Erreur de connexion.</div>`;
            });
    }

    // Instant Search Filtering
    function filterCards() {
        const filterText = document.getElementById('searchInput').value.toLowerCase();
        const cards = document.querySelectorAll('.history-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const searchableData = card.getAttribute('data-search') || '';
            if (searchableData.includes(filterText)) {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        document.getElementById('resultCount').innerText = visibleCount + ' diagnostic(s)';
    }

    // Instant Sorting
    function sortCards() {
        const sortValue = document.getElementById('sortSelect').value;
        const container = document.querySelector('.history-list');
        const cards = Array.from(container.querySelectorAll('.history-card'));
        
        cards.sort((a, b) => {
            if (sortValue === 'date-desc') {
                return b.dataset.date - a.dataset.date;
            } else if (sortValue === 'date-asc') {
                return a.dataset.date - b.dataset.date;
            } else if (sortValue === 'score-desc') {
                return b.dataset.score - a.dataset.score;
            }
        });

        // Re-append to container in sorted order
        cards.forEach(card => container.appendChild(card));
    }

</script>
{% endblock %}
