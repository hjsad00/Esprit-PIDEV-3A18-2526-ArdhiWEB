{% extends 'base.html.twig' %}

{% block title %}Ardhi - Cartographie des Maladies{% endblock %}

{% block stylesheets %}
    {{ parent() }}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link href="{{ asset('assets/css/UserAndDiag/map.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div id="map"></div>

<div class="map-overlay">
    <div class="map-controls">
        <div class="glass-panel">
            <h4 class="text-white mb-3">🛰️ Intelligence Géo</h4>
            <button id="btnNDVI" class="btn-map-action w-100 mb-3">
                <i class="bi bi-satellite"></i> NDVI Satellite
            </button>
            <p class="text-white-50 small">Visualisez l'indice de végétation pour détecter les zones de stress avant les symptômes visibles.</p>
        </div>

        <div class="glass-panel text-white">
            <h5 class="mb-3">📡 SporeCast Radar</h5>
            <p class="small text-white-50">Cliquez sur un marqueur critique pour analyser la propagation probable par le vent.</p>
            <div id="sporeLog" class="small text-warning" style="display: none;">
                ⚠️ Radar actif : Risque de contagion détecté.
            </div>
        </div>
    </div>

    <div class="map-sidebar">
        <div class="glass-panel overflow-auto" style="max-height: 500px;">
            <h5 class="text-white mb-3">🌍 État Régional</h5>
            {% for d in regionalDiseases %}
                <div class="regional-card">
                    <span>{{ d.icon }}</span>
                    <div class="flex-grow-1">
                        <div class="fw-bold small">{{ d.name }}</div>
                        <div class="text-muted small" style="font-size: 10px;">{{ d.distance|round(1) }} km - {{ d.count }} cas</div>
                    </div>
                </div>
            {% else %}
                <p class="text-white-50 small">Aucune menace signalée.</p>
            {% endfor %}
        </div>
    </div>
</div>

<div id="ndviLegend" class="ndvi-legend">
    <h6>🛰️ INDICE DE VÉGÉTATION (NDVI)</h6>
    <div class="ndvi-gradient">
        <span style="background:#8B4513" title="Sol nu"></span>
        <span style="background:#D2691E" title="Très clairsemé"></span>
        <span style="background:#FFA500" title="Clairsemé"></span>
        <span style="background:#FFD700" title="Léger"></span>
        <span style="background:#ADFF2F" title="Modéré"></span>
        <span style="background:#7CFC00" title="Bon"></span>
        <span style="background:#32CD32" title="Sain"></span>
        <span style="background:#228B22" title="Très sain"></span>
        <span style="background:#006400" title="Dense"></span>
    </div>
    <div class="ndvi-labels">
        <span>Sol nu</span>
        <span>Clairsemé</span>
        <span>Modéré</span>
        <span>Sain</span>
        <span>Dense</span>
    </div>
</div>

<div id="statusBadge" class="status-badge">Chargement...</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    const map = L.map('map', {
        zoomControl: false,
        attributionControl: false
    }).setView([{{ centerLat|number_format(6, '.', '') }}, {{ centerLon|number_format(6, '.', '') }}], 10);

    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        maxZoom: 19
    }).addTo(map);

    L.control.zoom({ position: 'bottomright' }).addTo(map);

    const markers = L.layerGroup().addTo(map);
    const ndviLayer = L.layerGroup().addTo(map);
    let ndviActive = false;

    // Load GeoJSON Markers
    fetch("{{ path('app_user_and_diag_map_data') }}")
        .then(res => res.json())
        .then(data => {
            L.geoJSON(data, {
                pointToLayer: (feature, latlng) => {
                    const color = feature.properties.severity === 'CRITICAL' ? '#e74c3c' : (feature.properties.severity === 'MEDIUM' ? '#f39c12' : '#2ecc71');
                    return L.circleMarker(latlng, {
                        radius: 8,
                        fillColor: color,
                        color: "#fff",
                        weight: 2,
                        opacity: 1,
                        fillOpacity: 0.8
                    });
                },
                onEachFeature: (feature, layer) => {
                    const p = feature.properties;
                    layer.bindPopup(`
                        <div class="leaflet-popup-custom">
                            <img src="${p.image}" class="popup-img">
                            <div class="popup-content">
                                <h6 class="mb-1">${p.title}</h6>
                                <p class="text-muted small mb-1">${p.date} • ${p.location}</p>
                                <div class="badge bg-${p.severity === 'CRITICAL' ? 'danger' : (p.severity === 'MEDIUM' ? 'warning' : 'success')} mb-2">
                                    Fiabilité: ${p.confiance}%
                                </div>
                                <button class="btn btn-sm btn-outline-success w-100" onclick="runSporeCast(${p.id}, ${feature.geometry.coordinates[1]}, ${feature.geometry.coordinates[0]}, '${p.resultat}')">
                                    Radar SporeCast
                                </button>
                            </div>
                        </div>
                    `);
                }
            }).addTo(markers);
            
            if (data.features.length > 0) {
                const group = L.featureGroup(markers.getLayers());
                map.fitBounds(group.getBounds().pad(0.1));
            }
        });

    // NDVI Logic
    const btnNDVI = document.getElementById('btnNDVI');
    btnNDVI.addEventListener('click', () => {
        if (ndviActive) {
            ndviLayer.clearLayers();
            btnNDVI.innerHTML = '<i class="bi bi-satellite"></i> NDVI Satellite';
            btnNDVI.classList.remove('active');
            ndviActive = false;
            document.getElementById('ndviLegend').style.display = 'none';
            return;
        }

        showStatus("Fétchage des données satellite...");
        fetch("{{ path('app_user_and_diag_map_ndvi') }}?lat={{ centerLat|number_format(6, '.', '') }}&lon={{ centerLon|number_format(6, '.', '') }}")
            .then(res => res.json())
            .then(cells => {
                cells.forEach(cell => {
                    const bounds = [
                        [cell.lat - cell.size/2, cell.lon - cell.size/2],
                        [cell.lat + cell.size/2, cell.lon + cell.size/2]
                    ];
                    L.rectangle(bounds, {
                        color: cell.color,
                        weight: 0,
                        fillOpacity: 0.5,
                        interactive: true
                    }).bindTooltip(cell.label).addTo(ndviLayer);
                });
                btnNDVI.innerHTML = '<i class="bi bi-x-circle"></i> Masquer NDVI';
                btnNDVI.classList.add('active');
                ndviActive = true;
                document.getElementById('ndviLegend').style.display = 'block';
                hideStatus();
            });
    });

    // SporeCast Radar Logic
    const sporeLog = document.getElementById('sporeLog');
    let sporeGraphic = null;

    function runSporeCast(id, lat, lon, disease) {
        if (sporeGraphic) map.removeLayer(sporeGraphic);
        
        showStatus("Analyse SporeCast en cours...");
        fetch(`{{ path('app_user_and_diag_map_sporecast') }}?lat=${lat}&lon=${lon}&disease=${encodeURIComponent(disease)}`)
            .then(res => res.json())
            .then(data => {
                if (data.isContagious) {
                    drawSporeCone(lat, lon, data.travelAngle, data.blastRadiusKm, data.windDirectionLabel);
                    sporeLog.innerHTML = `⚠️ Radar : Propagation vers le ${data.windDirectionLabel}`;
                    sporeLog.style.display = 'block';
                    showStatus(`Alerte : Propagation suspectée (${data.windDirectionLabel})`, 3000);
                } else {
                    showStatus("Maladie non-contagieuse par l'air.", 3000);
                    sporeLog.style.display = 'none';
                }
            });
    }

    function drawSporeCone(lat, lon, angle, radiusKm, windDirectionLabel) {
        const points = [];
        points.push([lat, lon]); // Origin
        
        const radiusMeters = radiusKm * 1000;
        const earthRadius = 6378137;
        const spreadAngle = 60; // 60 degree cone spread
        const startAngle = angle - (spreadAngle / 2);
        
        // Calculate arc nodes
        for (let i = 0; i <= 20; i++) {
            const currentAngle = startAngle + (i * (spreadAngle / 20));
            const bearing = currentAngle * Math.PI / 180;
            const latRad = lat * Math.PI / 180;
            const lonRad = lon * Math.PI / 180;
            const distRatio = radiusMeters / earthRadius;
            
            const destLatRad = Math.asin(Math.sin(latRad) * Math.cos(distRatio) + Math.cos(latRad) * Math.sin(distRatio) * Math.cos(bearing));
            const destLonRad = lonRad + Math.atan2(Math.sin(bearing) * Math.sin(distRatio) * Math.cos(latRad), Math.cos(distRatio) - Math.sin(latRad) * Math.sin(destLatRad));
            points.push([destLatRad * 180 / Math.PI, destLonRad * 180 / Math.PI]);
        }
        
        const sectorPolygon = L.polygon(points, {
            color: '#c0392b',
            weight: 2,
            dashArray: '5, 5',
            fillColor: '#e74c3c',
            fillOpacity: 0.2
        });

        const popupHTML = `
            <div style="font-family: 'Inter', sans-serif; font-size: 0.9rem;">
                <strong style="color: #c0392b; font-size: 1.1rem;"><i class="bi bi-broadcast"></i> Zone de Risque Épidémique</strong><br>
                <span>Rayon: ${radiusKm}km</span><br>
                <span>Propagation par les vents vers le ${windDirectionLabel}</span>
            </div>
        `;
        sectorPolygon.bindPopup(popupHTML);

        sporeGraphic = L.layerGroup([
            sectorPolygon,
            L.circleMarker([lat, lon], { radius: 12, color: '#e67e22', fillColor: '#e67e22', fillOpacity: 0.5, weight: 3, color: 'white' }) // Highlight origin
        ]).addTo(map);

        sectorPolygon.openPopup([lat, lon]);
    }

    function showStatus(text, duration = 0) {
        const badge = document.getElementById('statusBadge');
        badge.innerText = text;
        badge.style.display = 'block';
        if (duration > 0) setTimeout(hideStatus, duration);
    }

    function hideStatus() {
        document.getElementById('statusBadge').style.display = 'none';
    }
</script>
{% endblock %}
