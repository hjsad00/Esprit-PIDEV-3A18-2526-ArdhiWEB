{% extends 'base.html.twig' %}

{% block title %}Vérifiez vos emails{% endblock %}

{% block body %}
<section class="section d-flex align-items-center justify-content-center" style="min-height: 60vh;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-5 col-md-8 shadow p-5 bg-white rounded text-center">
        
        <div class="mb-4">
            <h1 class="h3 font-weight-normal" style="color: var(--heading-color);">Email envoyé</h1>
        </div>

        {% if debugUrl1 is defined %}
        <div class="alert alert-info">
            <p><strong>URL WITH TOKEN:</strong> {{ debugUrl1 }}</p>
            <p><strong>URL WITHOUT TOKEN:</strong> {{ debugUrl2 }}</p>
        </div>
        {% endif %}

        <p class="text-muted mb-4">
            Un email contenant un lien pour réinitialiser votre mot de passe a été envoyé. 
            Ce lien expirera dans <strong>15 minutes</strong>.
        </p>

        <p class="text-muted mb-4">
            Si vous n'avez pas reçu d'email, veuillez vérifier votre dossier spam ou
            <a href="{{ path('app_forgot_password_request') }}" style="color: var(--accent-color);">essayer à nouveau</a>.
        </p>
        
        <div class="mt-4">
            <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-lg w-100">Retour à la connexion</a>
        </div>

      </div>
    </div>
  </div>
</section>
{% endblock %}
