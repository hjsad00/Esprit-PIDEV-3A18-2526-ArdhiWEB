{% extends 'base.html.twig' %}

{% block title %}Créer un nouveau mot de passe{% endblock %}

{% block body %}
<section class="section d-flex align-items-center justify-content-center" style="min-height: 60vh;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-6 col-md-8 shadow p-5 bg-white rounded" style="border: 1px solid #e0e0e0; border-radius: 12px !important;">
        
        <div class="text-center mb-4">
            <h1 class="h3 font-weight-bold" style="color: #647a46;">Vérification</h1>
            <p class="text-muted mt-3" style="font-size: 0.95rem;">Un code à 4 chiffres a été envoyé à votre email.<br>Veuillez le saisir pour réinitialiser votre mot de passe.</p>
        </div>

        {{ form_start(resetForm, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="mb-4">
                <label style="font-weight: 600; font-size: 0.9rem; color: #444; margin-bottom: 5px;">Code de vérification</label>
                {{ form_widget(resetForm.code, {'attr': {'class': 'form-control form-control-lg' ~ (resetForm.code.vars.valid ? '' : ' is-invalid'), 'style': 'text-align: center; letter-spacing: 2px; font-weight: bold; background-color: #f8fcfb; border-color: #a3c2b8;'}}) }}
                <div class="invalid-feedback" style="display: block; font-weight: 500;">
                    {{ form_errors(resetForm.code) }}
                </div>
            </div>
            <div class="mb-4 mt-4">
                <label style="font-weight: 600; font-size: 0.9rem; color: #444; margin-bottom: 5px;">Nouveau mot de passe</label>
                {{ form_widget(resetForm.plainPassword, {'attr': {'class': 'form-control form-control-lg' ~ (resetForm.plainPassword.vars.valid ? '' : ' is-invalid'), 'style': 'background-color: #fcfcfc;'}}) }}
                <div class="invalid-feedback" style="display: block; font-weight: 500;">
                    {{ form_errors(resetForm.plainPassword) }}
                </div>
            </div>

            <div class="d-grid mb-2 mt-5">
                <button class="btn btn-lg" style="background-color: #556b2f; color: white; font-weight: 600; border-radius: 8px;">Confirmer le changement</button>
            </div>
        {{ form_end(resetForm) }}
      </div>
    </div>
  </div>
</section>
{% endblock %}
