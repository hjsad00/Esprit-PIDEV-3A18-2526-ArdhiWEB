{% extends 'base.html.twig' %}

{% block title %}Créer un nouveau mot de passe{% endblock %}

{% block body %}
<section class="section d-flex align-items-center justify-content-center" style="min-height: 60vh;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-5 col-md-8 shadow p-5 bg-white rounded">
        
        <div class="text-center mb-4">
            <h1 class="h3 font-weight-normal" style="color: var(--heading-color);">Nouveau Mot de Passe</h1>
            <p class="text-muted">Créez votre nouveau mot de passe sécurisé</p>
        </div>

        {{ form_start(resetForm, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="mb-3">
                {{ form_row(resetForm.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder': 'Nouveau mot de passe'}, 'row_attr': {'class': 'mb-3'}}) }}
            </div>
            <div class="mb-3">
                {{ form_row(resetForm.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': 'Confirmez le mot de passe'}, 'row_attr': {'class': 'mb-3'}}) }}
            </div>

            <div class="d-grid mb-3 mt-4">
                <button class="btn btn-primary btn-lg">Définir le mot de passe</button>
            </div>
        {{ form_end(resetForm) }}
      </div>
    </div>
  </div>
</section>
{% endblock %}
