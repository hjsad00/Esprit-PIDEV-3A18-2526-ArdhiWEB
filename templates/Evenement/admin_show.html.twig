{% extends 'evenement/admin_layout.html.twig' %}
{% block title %}{{ evenement.titre }} - Admin Ardhi{% endblock %}
{% block page_title %}{{ evenement.titre|slice(0,60) }}{% endblock %}

{% block stylesheets %}
<style>
.ev-info-card{background:#fff;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.07);padding:22px;margin-bottom:18px;}
.ev-info-card h5{font-size:.9rem;font-weight:700;color:#667A3F;border-bottom:2px solid #f0f4e8;padding-bottom:8px;margin-bottom:16px;display:flex;align-items:center;gap:8px;}
.info-row{display:flex;align-items:flex-start;gap:10px;margin-bottom:12px;}
.info-icon{width:34px;height:34px;background:#f0f4e8;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#667A3F;font-size:.95rem;flex-shrink:0;}
.info-label{font-size:.72rem;color:#9ca3af;margin-bottom:1px;}
.info-value{font-weight:600;color:#374151;font-size:.9rem;}
.places-bar{height:8px;border-radius:8px;background:#f1f5f9;overflow:hidden;}
.places-fill{height:100%;border-radius:8px;transition:width .4s;}
.avis-card{border-radius:10px;border:1.5px solid #f0f4e8;padding:14px 16px;margin-bottom:10px;}
.star-filled{color:#F39C12;} .star-empty{color:#d1d5db;}
</style>
{% endblock %}

{% block body %}
{# Breadcrumb / actions bar #}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <a href="{{ path('app_evenement_admin_liste') }}" class="btn btn-sm btn-outline-secondary me-1">
      <i class="bi bi-table me-1"></i>Liste
    </a>
    <a href="{{ path('app_evenement_admin_dashboard') }}" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-speedometer2 me-1"></i>Dashboard
    </a>
  </div>
  <div class="d-flex gap-2">
    <a href="{{ path('app_evenement_edit', {id: evenement.id}) }}" class="btn btn-sm btn-success">
      <i class="bi bi-pencil-fill me-1"></i>Modifier
    </a>
    <form method="post" action="{{ path('app_evenement_delete', {id: evenement.id}) }}" class="d-inline"
          onsubmit="return confirm('Supprimer cet événement ?')">
      <input type="hidden" name="_token" value="{{ csrf_token('delete'~evenement.id) }}">
      <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash3-fill me-1"></i>Supprimer</button>
    </form>
  </div>
</div>

<div class="row g-4">
  {# LEFT — event details #}
  <div class="col-lg-8">

    {# Info card #}
    <div class="ev-info-card">
      <h5><i class="bi bi-info-circle-fill"></i>Informations</h5>
      <div class="row">
        <div class="col-md-6">
          <div class="info-row">
            <div class="info-icon"><i class="bi bi-geo-alt-fill"></i></div>
            <div><div class="info-label">Lieu</div><div class="info-value">{{ evenement.lieu }}</div></div>
          </div>
          <div class="info-row">
            <div class="info-icon"><i class="bi bi-calendar3"></i></div>
            <div><div class="info-label">Date début</div><div class="info-value">{{ evenement.dateDebut|date('d/m/Y') }}</div></div>
          </div>
          <div class="info-row">
            <div class="info-icon"><i class="bi bi-calendar-check"></i></div>
            <div><div class="info-label">Date fin</div><div class="info-value">{{ evenement.dateFin|date('d/m/Y') }}</div></div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="info-row">
            <div class="info-icon"><i class="bi bi-person-badge-fill"></i></div>
            <div><div class="info-label">Organisateur</div><div class="info-value">{{ evenement.organisateur ?? '-' }}</div></div>
          </div>
          <div class="info-row">
            <div class="info-icon"><i class="bi bi-people-fill"></i></div>
            <div><div class="info-label">Inscriptions</div><div class="info-value">{{ evenement.nombreParticipants }} / {{ evenement.nombrePlacesMax }}</div></div>
          </div>
          <div class="info-row">
            <div class="info-icon"><i class="bi bi-calendar-plus"></i></div>
            <div><div class="info-label">Créé le</div><div class="info-value">{{ evenement.dateCreation|date('d/m/Y') }}</div></div>
          </div>
        </div>
      </div>
      {% set pct = evenement.nombrePlacesMax > 0 ? ((evenement.nombreParticipants / evenement.nombrePlacesMax)*100)|round : 0 %}
      <div class="d-flex justify-content-between mb-1 mt-2" style="font-size:.82rem;color:#6b7280;">
        <span><strong>{{ evenement.nombreParticipants }}</strong> inscrits</span>
        <span><strong>{{ evenement.placesRestantes }}</strong> place(s) restante(s)</span>
      </div>
      <div class="places-bar"><div class="places-fill" style="width:{{ pct > 100 ? 100 : pct }}%;background:{{ pct>=90?'#E74C3C':(pct>=60?'#F39C12':'#8BC34A') }}"></div></div>
    </div>

    {# Description #}
    {% if evenement.description %}
    <div class="ev-info-card">
      <h5><i class="bi bi-file-text-fill"></i>Description</h5>
      <p style="color:#4b5563;line-height:1.75;font-size:.95rem;">{{ evenement.description|nl2br }}</p>
    </div>
    {% endif %}

    {# Avis #}
    <div class="ev-info-card">
      <h5><i class="bi bi-star-fill"></i>Avis &amp; évaluations
        {% if avis|length > 0 %}<span style="font-size:.78rem;font-weight:500;color:#9ca3af;">({{ avis|length }})</span>{% endif %}
      </h5>
      {% if avis|length == 0 %}
        <p class="text-muted" style="font-size:.88rem;">Aucun avis pour l'instant.</p>
      {% else %}
        {% for p in avis %}
        <div class="avis-card">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="fw-bold" style="font-size:.88rem;">{{ p.utilisateur.prenom }} {{ p.utilisateur.nom }}</div>
            <div>
              {% for i in 1..5 %}<i class="bi bi-star-fill {{ i <= p.note ? 'star-filled' : 'star-empty' }}" style="font-size:.85rem;"></i>{% endfor %}
              <span style="font-size:.8rem;font-weight:700;color:#F39C12;margin-left:4px;">{{ p.note }}/5</span>
            </div>
          </div>
          {% if p.avis %}<p style="margin:0;font-size:.88rem;color:#4b5563;">{{ p.avis }}</p>{% endif %}
        </div>
        {% endfor %}
      {% endif %}
    </div>

    {# Participants table (admin can manage statuses) #}
    <div class="ev-info-card">
      <h5><i class="bi bi-people-fill"></i>Participants inscrits</h5>
      {% if evenement.participations is empty %}
        <p class="text-muted">Aucun participant pour l'instant.</p>
      {% else %}
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
              <tr><th>Nom</th><th>Statut</th><th>Inscrit le</th><th class="text-end">Action</th></tr>
            </thead>
            <tbody>
              {% for p in evenement.participations %}{% if p.statut != 'ANNULE' %}
              <tr>
                <td style="font-size:.88rem;">{{ p.utilisateur.prenom }} {{ p.utilisateur.nom }}</td>
                <td>
                  <span class="badge bg-{{ p.statut=='CONFIRME'?'success':p.statut=='PRESENT'?'info':p.statut=='EN_ATTENTE'?'warning text-dark':'secondary' }}">
                    {{ p.statut|replace({'EN_ATTENTE':'EN ATTENTE'}) }}
                  </span>
                </td>
                <td style="font-size:.82rem;color:#6b7280;">{{ p.dateInscription|date('d/m/Y') }}</td>
                <td class="text-end">
                  <form method="post" action="{{ path('app_evenement_participation_update', {id: p.id}) }}" class="d-flex gap-2 justify-content-end">
                    <select name="statut" class="form-select form-select-sm" style="width:130px;font-size:.75rem;">
                      {% for code, label in {'CONFIRME':'Confirmer','EN_ATTENTE':'En attente','PRESENT':'Présent','REFUSE':'Refuser','ANNULE':'Annuler'} %}
                        <option value="{{ code }}" {% if p.statut == code %}selected{% endif %}>{{ label }}</option>
                      {% endfor %}
                    </select>
                    <button type="submit" class="btn btn-sm btn-success px-2" style="font-size:.75rem;font-weight:700;">OK</button>
                  </form>
                </td>
              </tr>
              {% endif %}{% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>

  </div>

  {# RIGHT — admin quick actions #}
  <div class="col-lg-4">
    <div class="ev-info-card">
      <h5><i class="bi bi-lightning-fill"></i>Actions rapides</h5>

      {# Status badge #}
      <div class="text-center mb-3 p-3" style="background:#f8fafc;border-radius:10px;">
        <span class="badge bg-{{ evenement.statut=='A_VENIR'?'success':evenement.statut=='EN_COURS'?'info text-dark':evenement.statut=='TERMINE'?'secondary':'danger' }}" style="font-size:.85rem;padding:8px 18px;">
          {{ evenement.statut|replace({'A_VENIR':'À venir','EN_COURS':'En cours','TERMINE':'Terminé','ANNULE':'Annulé'}) }}
        </span>
        <div class="mt-2" style="font-size:.78rem;color:#9ca3af;">{{ evenement.type }}</div>
      </div>

      <a href="{{ path('app_evenement_edit', {id: evenement.id}) }}" class="btn btn-success w-100 mb-2">
        <i class="bi bi-pencil-fill me-2"></i>Modifier l'événement
      </a>
      <a href="{{ path('app_evenement_participations') }}" class="btn btn-outline-success w-100 mb-2">
        <i class="bi bi-people-fill me-2"></i>Gérer participations
      </a>
      <form method="post" action="{{ path('app_evenement_delete', {id: evenement.id}) }}"
            onsubmit="return confirm('Supprimer cet événement ? Action irréversible.')">
        <input type="hidden" name="_token" value="{{ csrf_token('delete'~evenement.id) }}">
        <button type="submit" class="btn btn-outline-danger w-100">
          <i class="bi bi-trash3-fill me-2"></i>Supprimer
        </button>
      </form>

      <hr class="my-3">
      <div style="font-size:.82rem;color:#9ca3af;text-align:center;">
        <i class="bi bi-calendar-plus me-1"></i>Créé le {{ evenement.dateCreation|date('d/m/Y') }}
      </div>
    </div>
  </div>
</div>
{% endblock %}
