{% extends 'evenement/admin_layout.html.twig' %}
{% block title %}Créer un Événement - Ardhi Admin{% endblock %}
{% block page_title %}Créer un Événement{% endblock %}

{% block stylesheets %}
<style>
.form-control,.form-select{border-radius:10px;border:1.5px solid #e2e8f0;padding:10px 14px;font-size:.95rem;transition:all .2s;}
.form-control:focus,.form-select:focus{border-color:#667A3F;box-shadow:0 0 0 3px rgba(102,122,63,.12);outline:none;}
.form-label{font-size:.88rem;color:#475569;font-weight:600;margin-bottom:6px;}
input[type="file"]::file-selector-button{background:#667A3F;color:white;border:none;border-radius:6px;padding:5px 10px;margin-right:10px;cursor:pointer;font-weight:600;}
</style>
{% endblock %}

{% block body %}
<div class="card shadow-sm">
  <div class="card-header bg-white py-3">
    <h5 class="fw-bold mb-0" style="font-size:.95rem;color:#1a2e05;">
      <i class="bi bi-plus-circle-fill me-2 text-warning"></i>Nouvel événement
    </h5>
  </div>
  <div class="card-body">
    {{ include('evenement/_form.html.twig', {'button_label': 'Publier l\'événement'}) }}
  </div>
</div>
{% endblock %}
