{% extends 'base.html.twig' %}
{% block title %}{{ evenement.titre }} - Ardhi{% endblock %}
{% block stylesheets %}
<link href="{{ asset('assets/css/homepage.css') }}" rel="stylesheet">
<style>
/* Layout */
.detail-card {
  background:#fff; border-radius:16px;
  box-shadow:0 4px 24px rgba(0,0,0,.07);
  padding:28px 32px; margin-bottom:24px;
}
.detail-card h4 {
  font-size:1rem; font-weight:700; color:#667A3F;
  border-bottom:2px solid #f0f4e8; padding-bottom:10px; margin-bottom:18px;
  display:flex; align-items:center; gap:8px;
}
.info-row { display:flex; align-items:flex-start; gap:12px; margin-bottom:14px; }
.info-icon {
  width:38px; height:38px; background:#f0f4e8; border-radius:9px;
  display:flex; align-items:center; justify-content:center;
  color:#667A3F; font-size:1rem; flex-shrink:0;
}
.info-label { font-size:.76rem; color:#9ca3af; margin-bottom:1px; }
.info-value { font-weight:600; color:#374151; font-size:.95rem; }
/* Places bar */
.places-bar { height:10px; border-radius:10px; background:#f1f5f9; overflow:hidden; }
.places-fill { height:100%; border-radius:10px; transition:width .4s; }
/* Action card */
.action-card {
  background:#fff; border-radius:16px;
  box-shadow:0 4px 24px rgba(0,0,0,.08);
  padding:26px; position:sticky; top:90px;
}
.btn-inscrire {
  width:100%; border:none; border-radius:10px; padding:12px;
  background:linear-gradient(135deg,#8BC34A,#667A3F);
  color:#fff; font-weight:700; font-size:.95rem; cursor:pointer;
  display:flex; align-items:center; justify-content:center; gap:8px;
  transition:opacity .2s;
}
.btn-inscrire:hover { opacity:.88; }
.btn-desinscrire {
  width:100%; border:2px solid #E74C3C; border-radius:10px; padding:11px;
  background:#fff; color:#E74C3C; font-weight:700; font-size:.93rem; cursor:pointer;
  display:flex; align-items:center; justify-content:center; gap:8px; transition:all .2s;
}
.btn-desinscrire:hover { background:#E74C3C; color:#fff; }
.btn-edit-ev {
  width:100%; border:2px solid #667A3F; border-radius:10px; padding:11px;
  background:#f0f4e8; color:#667A3F; font-weight:700; font-size:.93rem;
  text-decoration:none; display:flex; align-items:center; justify-content:center; gap:8px; transition:all .2s;
}
.btn-edit-ev:hover { background:#667A3F; color:#fff; }
.btn-del-ev {
  width:100%; border:2px solid #E74C3C; border-radius:10px; padding:11px;
  background:#fff5f5; color:#E74C3C; font-weight:700; font-size:.93rem; cursor:pointer;
  display:flex; align-items:center; justify-content:center; gap:8px; transition:all .2s;
}
.btn-del-ev:hover { background:#E74C3C; color:#fff; }
.btn-fav-lg {
  width:100%; border:2px solid #e2e8f0; border-radius:10px; padding:11px;
  background:#fff; font-weight:600; font-size:.9rem; cursor:pointer;
  display:flex; align-items:center; justify-content:center; gap:8px; transition:all .2s;
}
.btn-fav-lg.on { border-color:#E74C3C; color:#E74C3C; }
.btn-fav-lg:hover { border-color:#E74C3C; color:#E74C3C; }
/* Badges */
.b-type,.b-stat { font-size:.75rem; font-weight:700; padding:5px 14px; border-radius:50px; text-transform:uppercase; }
.b-FOIRE{background:#3498DB;color:#fff;} .b-FORMATION{background:#9B59B6;color:#fff;}
.b-CONFERENCE{background:#F39C12;color:#fff;} .b-ATELIER{background:#2ECC71;color:#fff;}
.b-A_VENIR{background:#8BC34A;color:#fff;} .b-EN_COURS{background:#3498DB;color:#fff;}
.b-TERMINE{background:#95a5a6;color:#fff;} .b-ANNULE{background:#E74C3C;color:#fff;}
/* Avis */
.avis-card {
  border-radius:12px; border:1.5px solid #f0f4e8; padding:18px 20px; margin-bottom:14px;
}
.star-filled { color:#F39C12; }
.star-empty  { color:#d1d5db; }
.avis-form-wrap {
  background:#f0f4e8; border-radius:14px; padding:24px;
  border:2px dashed #8BC34A;
}
</style>
{% endblock %}
{% block body %}

<!-- HERO BANNER -->
<div style="margin-top:0;position:relative;min-height:340px;display:flex;align-items:flex-end;overflow:hidden;
            background:linear-gradient(135deg,#667A3F,#3498DB);">

  {# ── Image with path normalization (fixes desktop-uploaded images) ── #}
  {% if evenement.imageUrl %}
    {% set imgPath = evenement.imageUrl %}
    {% if imgPath starts with 'uploads/' %}
      {% set imgPath = '/' ~ imgPath %}
    {% endif %}
    <img src="{{ imgPath starts with 'http' ? imgPath : asset(imgPath) }}"
         alt="{{ evenement.titre }}"
         style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.32;"
         onerror="this.style.display='none'">
  {% endif %}

  <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.72),rgba(0,0,0,.08));"></div>
  <div class="container" style="position:relative;z-index:2;padding:130px 0 36px 0;">
    <nav style="font-size:.84rem;color:rgba(255,255,255,.65);margin-bottom:12px;">
      <a href="{{ path('app_evenement_index') }}" style="color:rgba(255,255,255,.8);text-decoration:none;">Événements</a>
      <span style="margin:0 8px;color:rgba(255,255,255,.35)">›</span>
      <span>{{ evenement.titre|slice(0,50) }}</span>
    </nav>
    <div class="d-flex flex-wrap gap-2 mb-3">
      <span class="b-type b-{{ evenement.type }}">{{ evenement.type }}</span>
      <span class="b-stat b-{{ evenement.statut }}">
        {% if evenement.statut=='A_VENIR' %}À venir{% elseif evenement.statut=='EN_COURS' %}En cours{% elseif evenement.statut=='TERMINE' %}Terminé{% else %}Annulé{% endif %}
      </span>
    </div>
    <h1 style="font-size:2.2rem;font-weight:800;color:#fff;line-height:1.2;text-shadow:0 2px 8px rgba(0,0,0,.5);">{{ evenement.titre }}</h1>
    <div class="hero-actions-row mt-3">
      {% include 'Evenement/_retour_button.html.twig' with { back_path: path('app_evenement_index'), back_label: 'Retour aux événements' } %}
    </div>
  </div>
</div>

<section class="services section" style="padding-top:40px;">
  <div class="container">
    {# ── Global flash messages ── #}
    <div class="mb-3">
      {% for type, messages in app.flashes %}
        {% for message in messages %}
          <div class="alert alert-{{ type == 'success' ? 'success' : type == 'info' ? 'info' : type == 'warning' ? 'warning' : 'danger' }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
    <div class="row g-4">

      <!-- LEFT -->
      <div class="col-lg-8">

        <!-- Infos -->
        <div class="detail-card">
          <h4><i class="bi bi-info-circle-fill"></i>Informations</h4>
          <div class="row">
            <div class="col-md-6">
              <div class="info-row">
                <div class="info-icon"><i class="bi bi-geo-alt-fill"></i></div>
                <div><div class="info-label">Lieu</div><div class="info-value">{{ evenement.lieu }}</div></div>
              </div>
              <div class="info-row">
                <div class="info-icon"><i class="bi bi-calendar3"></i></div>
                <div><div class="info-label">Date début</div><div class="info-value">{{ evenement.dateDebut|date('d/m/Y') }}</div></div>
              </div>
              <div class="info-row">
                <div class="info-icon"><i class="bi bi-calendar-check"></i></div>
                <div><div class="info-label">Date fin</div><div class="info-value">{{ evenement.dateFin|date('d/m/Y') }}</div></div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="info-row">
                <div class="info-icon"><i class="bi bi-person-badge-fill"></i></div>
                <div><div class="info-label">Organisateur</div><div class="info-value">{{ evenement.organisateur }}</div></div>
              </div>
              <div class="info-row">
                <div class="info-icon"><i class="bi bi-people-fill"></i></div>
                <div><div class="info-label">Inscriptions</div><div class="info-value">{{ evenement.nombreParticipants }} / {{ evenement.nombrePlacesMax }}</div></div>
              </div>
              <div class="info-row">
                <div class="info-icon"><i class="bi bi-calendar-plus"></i></div>
                <div><div class="info-label">Créé le</div><div class="info-value">{{ evenement.dateCreation|date('d/m/Y') }}</div></div>
              </div>
            </div>
          </div>
          {% set pct = evenement.nombrePlacesMax > 0 ? ((evenement.nombreParticipants / evenement.nombrePlacesMax)*100)|round : 0 %}
          <div class="d-flex justify-content-between mb-1" style="font-size:.83rem;color:#6b7280;">
            <span><strong>{{ evenement.nombreParticipants }}</strong> inscrits</span>
            <span><strong>{{ evenement.placesRestantes }}</strong> place(s) restante(s)</span>
          </div>
          <div class="places-bar">
            <div class="places-fill" style="width:{{ pct > 100 ? 100 : pct }}%;background:{{ pct>=90 ? '#E74C3C' : (pct>=60 ? '#F39C12' : '#8BC34A') }}"></div>
          </div>
        </div>

        <!-- Description -->
        {% if evenement.description %}
        <div class="detail-card">
          <h4><i class="bi bi-file-text-fill"></i>Description</h4>
          <p style="color:#4b5563;line-height:1.75;font-size:.97rem;">{{ evenement.description|nl2br }}</p>
        </div>
        {% endif %}

        {# Visualisation de la localisation #}
        {% include 'Evenement/_location_map.html.twig' with { evenement: evenement } %}

        <!-- ── AVIS SECTION ── -->
        <div class="detail-card">
          <h4><i class="bi bi-star-fill"></i>Avis et évaluations
            {% if avis|length > 0 %}
              <span style="font-size:.8rem;font-weight:500;color:#9ca3af;">({{ avis|length }} avis)</span>
            {% endif %}
          </h4>

          {% for label, messages in app.flashes %}
            {% for message in messages %}
              <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'info' ? 'info' : 'danger') }} alert-dismissible fade show mb-3" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
            {% endfor %}
          {% endfor %}

          {% if avisForm %}
          <div class="avis-form-wrap mb-4" id="avis-form-section">
            <h6 class="fw-bold mb-3" style="color:#667A3F;"><i class="bi bi-pencil-square me-1"></i>Laisser un avis</h6>
            <div id="avis-form-feedback" style="display:none;" class="alert mb-3"></div>
            <div class="mb-3">
              {{ form_label(avisForm.note) }}
              {{ form_widget(avisForm.note, {attr: {id: 'avis_note'}}) }}
            </div>
            <div class="mb-3">
              {{ form_label(avisForm.avis) }}
              {{ form_widget(avisForm.avis, {attr: {id: 'avis_avis'}}) }}
            </div>
            <button type="button" id="avis-submit-btn" class="btn btn-success"
                    onclick="submitAvisForm({{ evenement.id }})">
              <i class="bi bi-send-fill me-1"></i>Publier mon avis
            </button>
          </div>
          {% elseif app.user and userParticipation and userParticipation.statut == 'PRESENT' and (userParticipation.note is not null and userParticipation.note > 0) %}
          <div class="alert alert-success py-2 mb-3">
            <i class="bi bi-check-circle-fill me-1"></i>Vous avez déjà laissé un avis pour cet événement.
          </div>
          {% endif %}

          {% if avis|length == 0 %}
            <p class="text-muted" style="font-size:.9rem;">Aucun avis pour l'instant. Soyez le premier à partager votre expérience !</p>
          {% else %}
            {% for p in avis %}
            <div class="avis-card" id="avis-{{ p.id }}">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center gap-2">
                  <div style="width:36px;height:36px;border-radius:50%;background:#667A3F22;display:flex;align-items:center;justify-content:center;">
                    <i class="bi bi-person-fill" style="color:#667A3F;font-size:.9rem;"></i>
                  </div>
                  <div>
                    <div style="font-weight:700;font-size:.9rem;color:#1a2e05;">
                      {{ p.utilisateur.prenom }} {{ p.utilisateur.nom }}
                    </div>
                    <div style="font-size:.75rem;color:#9ca3af;">{{ p.dateInscription|date('d/m/Y') }}</div>
                  </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <div>
                    {% for i in 1..5 %}
                      <i class="bi bi-star-fill {{ i <= p.note ? 'star-filled' : 'star-empty' }}" style="font-size:.9rem;"></i>
                    {% endfor %}
                    <span style="font-size:.82rem;font-weight:700;color:#F39C12;margin-left:4px;">{{ p.note }}/5</span>
                  </div>
                  {% if app.user and p.utilisateur == app.user %}
                    <button type="button" class="btn btn-sm p-0 text-danger"
                            style="font-size:1rem;margin-left:5px;"
                            onclick="deleteAvis({{ evenement.id }}, {{ p.id }})"
                            title="Supprimer mon avis">
                      <i class="bi bi-trash3-fill"></i>
                    </button>
                  {% endif %}
                </div>
              </div>
              {% if p.avis %}
                <p style="margin:0;font-size:.9rem;color:#4b5563;line-height:1.6;">{{ p.avis }}</p>
              {% endif %}

              <div class="avis-comments mt-3" style="border-top:1px solid #e5e7eb;padding-top:12px;">
                <div id="comments-{{ p.id }}" class="comments-list mb-2"></div>
                {% if app.user %}
                <button type="button" class="btn btn-link btn-sm p-0 mb-2"
                        style="color:#667A3F;text-decoration:none;font-size:.82rem;display:inline-flex;align-items:center;gap:3px;"
                        onclick="toggleMainReviewReply({{ p.id }})">
                  <i class="bi bi-reply"></i> Répondre
                </button>
                <div id="comment-input-{{ p.id }}" style="display:none;gap:8px;margin-top:10px;align-items:center;">
                  <input type="text" class="comment-input form-control form-control-sm"
                         placeholder="Ajouter un commentaire..."
                         style="flex:1;font-size:.84rem;"
                         onkeydown="if(event.key==='Enter'){submitComment({{ p.id }},this);}">
                  <button type="button" class="btn btn-sm btn-success"
                          onclick="submitComment({{ p.id }}, document.querySelector('#comment-input-{{ p.id }} .comment-input'))"
                          style="font-size:.84rem;padding:5px 10px;">
                    <i class="bi bi-send-fill"></i>
                  </button>
                </div>
                {% endif %}
              </div>
            </div>
            {% endfor %}
          {% endif %}
        </div>

        <!-- Participants list (creator/admin) -->
        {% if app.user and (app.user == evenement.createur or is_granted('ROLE_ADMIN')) %}
        <div class="detail-card">
          <h4><i class="bi bi-people-fill"></i>Participants inscrits</h4>
          {% if evenement.participations is empty %}
            <p class="text-muted">Aucun participant pour l'instant.</p>
          {% else %}
            <div class="table-responsive">
              <table class="table table-sm align-middle">
                <thead class="table-light">
                  <tr><th>Nom</th><th>Statut</th><th>Inscrit le</th><th class="text-end">Action</th></tr>
                </thead>
                <tbody>
                  {% for p in evenement.participations %}
                  {% if p.statut != 'ANNULE' %}
                  <tr>
                    <td>{{ p.utilisateur.prenom }} {{ p.utilisateur.nom }}</td>
                    <td>
                      <span class="badge bg-{{ p.statut=='CONFIRME' ? 'success' : p.statut=='PRESENT' ? 'info' : 'warning text-dark' }}">
                        {{ p.statut|replace({'EN_ATTENTE':'EN ATTENTE'}) }}
                      </span>
                    </td>
                    <td style="font-size:.85rem;color:#6b7280;">{{ p.dateInscription|date('d/m/Y') }}</td>
                    <td class="text-end">
                      <form method="post" action="{{ path('app_evenement_participation_update', {id: p.id}) }}" class="d-flex gap-2 justify-content-end">
                        <select name="statut" class="form-select form-select-sm" style="width:130px;font-size:0.75rem;">
                          {% for code, label in {'CONFIRME':'Confirmer','EN_ATTENTE':'En attente','PRESENT':'Present','REFUSE':'Refuser','ANNULE':'Annuler'} %}
                            <option value="{{ code }}" {% if p.statut == code %}selected{% endif %}>{{ label }}</option>
                          {% endfor %}
                        </select>
                        <button type="submit" class="btn btn-sm btn-success px-2 py-0" style="font-size:0.75rem;font-weight:700;">OK</button>
                      </form>
                    </td>
                  </tr>
                  {% endif %}
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% endif %}
        </div>
        {% endif %}

      </div>

      <!-- RIGHT: Actions -->
      <div class="col-lg-4">
        <div class="action-card">

          {% if not app.user %}
            <a href="{{ path('app_login') }}" class="btn-inscrire mb-3">
              <i class="bi bi-box-arrow-in-right"></i>Connectez-vous pour s'inscrire
            </a>

          {% elseif app.user == evenement.createur or is_granted('ROLE_ADMIN') %}
            <div class="mb-3 p-3 text-center" style="background:#f0f4e8;border-radius:10px;">
              <i class="bi bi-person-badge-fill text-success" style="font-size:1.5rem;"></i>
              <div class="fw-bold mt-1" style="color:#667A3F;">Vous êtes organisateur</div>
            </div>
            <a href="{{ path('app_evenement_edit', {id: evenement.id}) }}" class="btn-edit-ev mb-3">
              <i class="bi bi-pencil-fill"></i>Modifier l'événement
            </a>
            <form method="post" action="{{ path('app_evenement_delete', {id: evenement.id}) }}"
                  onsubmit="return confirm('Supprimer cet événement ? Cette action est irréversible.')">
              <input type="hidden" name="_token" value="{{ csrf_token('delete'~evenement.id) }}">
              <button type="submit" class="btn-del-ev mb-3">
                <i class="bi bi-trash3-fill"></i>Supprimer
              </button>
            </form>

          {% elseif userParticipation and userParticipation.statut != 'ANNULE' %}
            <div class="mb-3 p-3 text-center" style="background:#f0f9e8;border-radius:10px;border:2px solid #8BC34A;">
              <i class="bi bi-check-circle-fill text-success" style="font-size:1.6rem;"></i>
              <div class="fw-bold text-success mt-1">Vous êtes inscrit !</div>
              <div style="font-size:.8rem;color:#6b7280;">Statut : {{ userParticipation.statut }}</div>
            </div>
            {% if evenement.statut not in ['TERMINE','ANNULE'] %}
            <form method="post" action="{{ path('app_evenement_desinscrire', {id: evenement.id}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token('desinscrire'~evenement.id) }}">
              <button type="submit" class="btn-desinscrire mb-3"
                      onclick="return confirm('Annuler votre inscription ?')">
                <i class="bi bi-x-circle-fill"></i>Se désinscrire
              </button>
            </form>
            {% endif %}

          {% elseif evenement.statut in ['TERMINE','ANNULE'] %}
            <button class="btn-inscrire mb-3" disabled style="opacity:.6;">
              <i class="bi bi-lock-fill"></i>Inscriptions fermées
            </button>

          {% elseif evenement.placesRestantes <= 0 %}
            <button class="btn-inscrire mb-3" disabled style="opacity:.6;background:#E74C3C;">
              <i class="bi bi-exclamation-circle-fill"></i>Événement complet
            </button>

          {% else %}
            <form method="post" action="{{ path('app_evenement_inscrire', {id: evenement.id}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token('inscrire'~evenement.id) }}">
              <button type="submit" class="btn-inscrire mb-3">
                <i class="bi bi-person-plus-fill"></i>S'inscrire à l'événement
              </button>
            </form>
          {% endif %}

          {% if app.user and app.user.role != 'ADMIN' %}
          <form method="post" action="{{ path('app_evenement_toggle_favori', {id: evenement.id}) }}" class="mb-3">
            <input type="hidden" name="_token" value="{{ csrf_token('favori'~evenement.id) }}">
            <button type="submit" class="btn-fav-lg {{ isFavori ? 'on' : '' }}">
              <i class="bi bi-heart{{ isFavori ? '-fill' : '' }}"></i>
              {{ isFavori ? 'Retirer des favoris' : 'Ajouter aux favoris' }}
            </button>
          </form>
          {% endif %}

          <div class="d-flex gap-2 mb-4 flex-wrap">
            <form method="POST" action="{{ path('app_calendar_add', {id: evenement.id}) }}" class="flex-grow-1">
                <button type="submit" class="btn btn-outline-primary btn-sm w-100 py-2 fw-semibold" style="border-radius:10px;">
                    📅 Google Calendar
                </button>
            </form>
            <a href="{{ path('app_calendar_ics', {id: evenement.id}) }}"
               class="btn btn-outline-secondary btn-sm py-2 fw-semibold" style="border-radius:10px; width:45px;" title="Télécharger .ics">
                ⬇️
            </a>
          </div>

          <div class="pt-3 border-top" style="font-size:.82rem;color:#9ca3af;text-align:center;">
            <i class="bi bi-shield-check me-1 text-success"></i>Inscription sécurisée via Ardhi
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const eventId = {{ evenement.id }};

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.avis-card').forEach(function(el) {
      loadComments(el.id.replace('avis-', ''));
    });
  });

  function deleteAvis(evenementId, participationId) {
    if (!confirm('Supprimer votre avis ? Cette action est irréversible.')) return;
    fetch('/evenement/' + evenementId + '/avis/supprimer', {
      method: 'POST',
      headers: { 'Accept': 'application/json' }
    })
    .then(function(r) {
      return r.json().then(function(p) {
        if (!r.ok) throw new Error(p.error || 'Erreur serveur (' + r.status + ')');
        return p;
      });
    })
    .then(function() { location.reload(); })
    .catch(function(e) { alert(e.message); });
  }

  function submitAvisForm(evenementId) {
    var noteEl   = document.getElementById('avis_note');
    var avisEl   = document.getElementById('avis_avis');
    var feedback = document.getElementById('avis-form-feedback');
    var btn      = document.getElementById('avis-submit-btn');
    var formSect = document.getElementById('avis-form-section');

    feedback.style.display = 'none';
    feedback.innerHTML = '';

    if (!noteEl || !noteEl.value) {
      showFormFeedback(feedback, 'danger', 'Veuillez sélectionner une note.', null);
      return;
    }

    var avisText = avisEl ? avisEl.value.trim() : '';
    btn.disabled  = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Envoi...';

    var params = new URLSearchParams();
    params.append('note', noteEl.value);
    if (avisText) { params.append('avis[avis]', avisText); }

    fetch('/evenement/' + evenementId + '/soumettre-avis', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
      body: params.toString()
    })
    .then(function(r) {
      return r.json().then(function(payload) {
        if (!r.ok) throw { message: payload.error || 'Erreur serveur (' + r.status + ')', badWords: payload.badWords };
        return payload;
      });
    })
    .then(function(data) {
      formSect.innerHTML =
        '<div class="alert alert-success d-flex align-items-center gap-2">' +
        '<i class="bi bi-check-circle-fill"></i>' +
        '<span>' + escapeHtml(data.message) + '</span></div>';
      setTimeout(function() { location.reload(); }, 1200);
    })
    .catch(function(err) {
      btn.disabled  = false;
      btn.innerHTML = '<i class="bi bi-send-fill me-1"></i>Publier mon avis';
      var msg = (err && err.message) ? err.message : 'Une erreur est survenue.';
      var isBadWord = (err && err.badWords === true);
      showFormFeedback(feedback, 'danger', msg, isBadWord ? avisEl : null);
    });
  }

  function showFormFeedback(el, type, msg, fieldToReset) {
    el.style.display = 'flex';
    el.className = 'alert alert-' + type + ' mb-3 d-flex align-items-center justify-content-between gap-2';
    var text = document.createElement('span');
    text.textContent = msg;
    el.innerHTML = '';
    el.appendChild(text);
    if (fieldToReset) {
      var fixBtn = document.createElement('button');
      fixBtn.type = 'button';
      fixBtn.textContent = 'Corriger';
      fixBtn.style.cssText = 'border:1px solid #E74C3C;background:#fff;color:#E74C3C;border-radius:4px;padding:3px 10px;font-size:.82rem;cursor:pointer;white-space:nowrap;flex-shrink:0;';
      fixBtn.onclick = function() { el.style.display = 'none'; fieldToReset.value = ''; fieldToReset.focus(); };
      el.appendChild(fixBtn);
    } else {
      var closeBtn = document.createElement('button');
      closeBtn.type = 'button';
      closeBtn.className = 'btn-close';
      closeBtn.onclick = function() { el.style.display = 'none'; };
      el.appendChild(closeBtn);
    }
  }

  function loadComments(participationId) {
    fetch('/evenement/' + eventId + '/avis/' + participationId + '/commentaires')
      .then(function(r) { return r.json(); })
      .then(function(comments) {
        var list = document.getElementById('comments-' + participationId);
        if (!list) return;
        list.innerHTML = '';
        comments.forEach(function(comment) {
          var wrapper = document.createElement('div');
          wrapper.id  = 'comment-wrapper-' + comment.id;
          wrapper.style.marginBottom = '8px';
          wrapper.appendChild(buildCommentEl(comment, participationId, false));
          if (comment.replies && comment.replies.length > 0) {
            var rBlock = document.createElement('div');
            rBlock.style.cssText = 'margin-left:18px;padding-left:10px;border-left:2px solid #e5e7eb;margin-top:4px;';
            comment.replies.forEach(function(reply) { rBlock.appendChild(buildCommentEl(reply, participationId, true)); });
            wrapper.appendChild(rBlock);
          }
          var slot = document.createElement('div');
          slot.id   = 'reply-slot-' + comment.id;
          slot.style.marginLeft = '18px';
          wrapper.appendChild(slot);
          list.appendChild(wrapper);
        });
      })
      .catch(function(e) { console.error('loadComments error:', e); });
  }

  function buildCommentEl(comment, participationId, isReply) {
    var div = document.createElement('div');
    div.id  = 'comment-el-' + comment.id;
    div.style.cssText =
      'background:#f9fafb;padding:7px 10px;margin-bottom:4px;font-size:.84rem;' +
      'border-left:3px solid ' + (isReply ? '#bfdbfe' : '#8BC34A') + ';border-radius:0 6px 6px 0;';
    var hdr = document.createElement('div');
    hdr.style.cssText = 'display:flex;justify-content:space-between;align-items:center;margin-bottom:2px;';
    var meta = document.createElement('div');
    meta.innerHTML = '<strong style="color:#1a2e05;font-size:.84rem;">' + escapeHtml(comment.userName) + '</strong>' +
      ' <small style="color:#9ca3af;">' + escapeHtml(comment.date) + '</small>';
    var actions = document.createElement('div');
    actions.style.cssText = 'display:flex;gap:4px;align-items:center;';
    if (comment.isOwner) {
      var delBtn = document.createElement('button');
      delBtn.type  = 'button'; delBtn.title = 'Supprimer';
      delBtn.style.cssText = 'background:none;border:none;padding:2px 5px;cursor:pointer;color:#E74C3C;font-size:.78rem;border-radius:4px;';
      delBtn.innerHTML = '<i class="bi bi-trash3-fill"></i>';
      delBtn.onmouseover = function() { this.style.background = '#fff0f0'; };
      delBtn.onmouseout  = function() { this.style.background = 'none'; };
      delBtn.onclick = function() { deleteComment(comment.id, participationId); };
      actions.appendChild(delBtn);
    }
    hdr.appendChild(meta); hdr.appendChild(actions); div.appendChild(hdr);
    var body = document.createElement('p');
    body.style.cssText = 'margin:0 0 4px;color:#374151;line-height:1.5;';
    body.textContent   = comment.content;
    div.appendChild(body);
    if (!isReply) {
      var replyBtn = document.createElement('button');
      replyBtn.type = 'button';
      replyBtn.style.cssText = 'background:none;border:none;padding:0;font-size:.78rem;color:#667A3F;cursor:pointer;display:inline-flex;align-items:center;gap:3px;';
      replyBtn.innerHTML = '<i class="bi bi-reply" style="font-size:.78rem;"></i> Répondre';
      replyBtn.onclick   = function() { toggleReplyForm(participationId, comment.id, comment.userName); };
      div.appendChild(replyBtn);
    }
    return div;
  }

  function toggleMainReviewReply(participationId) {
    var div = document.getElementById('comment-input-' + participationId);
    if (!div) return;
    if (div.style.display === 'none') {
      div.style.display = 'flex';
      var input = div.querySelector('input');
      if (input) input.focus();
    } else { div.style.display = 'none'; clearInlineError(div); }
  }

  function submitComment(participationId, inputEl) {
    if (!inputEl) return;
    var content   = inputEl.value.trim();
    var inputArea = document.getElementById('comment-input-' + participationId);
    var sendBtn   = inputArea ? inputArea.querySelector('button') : null;
    clearInlineError(inputArea);
    if (!content) { if (inputEl) inputEl.focus(); return; }
    if (sendBtn) setLoading(sendBtn, true);
    postComment(participationId, content, null)
      .then(function() { inputEl.value = ''; if (inputArea) inputArea.style.display = 'none'; loadComments(participationId); })
      .catch(function(e) { if (inputArea) showDismissibleError(inputArea, e.message, inputEl); })
      .finally(function() { if (sendBtn) setLoading(sendBtn, false); });
  }

  function toggleReplyForm(participationId, commentId, userName) {
    var slot = document.getElementById('reply-slot-' + commentId);
    if (!slot) return;
    if (slot.hasChildNodes()) { slot.innerHTML = ''; return; }
    var inner = document.createElement('div');
    inner.style.cssText = 'display:flex;flex-direction:column;gap:4px;margin-top:6px;';
    var inputRow = document.createElement('div');
    inputRow.style.cssText = 'display:flex;gap:6px;align-items:center;';
    var input = document.createElement('input');
    input.type = 'text'; input.className = 'form-control form-control-sm reply-input';
    input.placeholder = 'Répondre à ' + escapeHtml(userName) + '...';
    input.style.cssText = 'flex:1;font-size:.83rem;';
    var sendBtn = document.createElement('button');
    sendBtn.type = 'button'; sendBtn.className = 'btn btn-sm btn-success';
    sendBtn.style.fontSize = '.83rem'; sendBtn.innerHTML = '<i class="bi bi-send-fill"></i>';
    var cancelBtn = document.createElement('button');
    cancelBtn.type = 'button'; cancelBtn.className = 'btn btn-sm btn-light';
    cancelBtn.style.fontSize = '.83rem'; cancelBtn.textContent = '✕';
    cancelBtn.onclick = function() { slot.innerHTML = ''; };
    input.onkeydown = function(e) { if (e.key === 'Enter') doSend(); };
    sendBtn.onclick = doSend;
    inputRow.appendChild(input); inputRow.appendChild(sendBtn); inputRow.appendChild(cancelBtn);
    inner.appendChild(inputRow); slot.appendChild(inner); input.focus();
    function doSend() {
      var content = input.value.trim();
      if (!content) return;
      clearInlineError(inner); setLoading(sendBtn, true);
      postComment(participationId, content, commentId)
        .then(function() { slot.innerHTML = ''; loadComments(participationId); })
        .catch(function(e) { showDismissibleError(inner, e.message, input); })
        .finally(function() { setLoading(sendBtn, false); });
    }
  }

  function deleteComment(commentId, participationId) {
    if (!confirm('Supprimer ce commentaire ?')) return;
    fetch('/evenement/commentaire/' + commentId + '/supprimer', {
      method: 'POST', headers: { 'Accept': 'application/json' }
    })
    .then(function(r) {
      return r.json().then(function(p) {
        if (!r.ok) throw new Error(p.error || 'Erreur serveur (' + r.status + ')'); return p;
      });
    })
    .then(function() {
      var wrapper = document.getElementById('comment-wrapper-' + commentId);
      if (wrapper) { wrapper.style.transition = 'opacity .2s'; wrapper.style.opacity = '0'; setTimeout(function() { wrapper.remove(); }, 200); }
    })
    .catch(function(e) { alert(e.message); });
  }

  function postComment(participationId, content, parentId) {
    var body = 'content=' + encodeURIComponent(content);
    if (parentId) body += '&parent_id=' + parentId;
    return fetch('/evenement/' + eventId + '/avis/' + participationId + '/commentaire', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
      body: body
    }).then(function(r) {
      return r.json().then(function(payload) {
        if (!r.ok) throw new Error(payload.error || 'Erreur serveur (' + r.status + ')'); return payload;
      });
    });
  }

  function showDismissibleError(container, msg, inputToReset) {
    clearInlineError(container);
    var banner = document.createElement('div');
    banner.className = 'inline-err';
    banner.style.cssText = 'display:flex;align-items:center;justify-content:space-between;gap:8px;background:#fff5f5;border:1px solid #fca5a5;border-radius:6px;padding:6px 10px;margin-top:6px;font-size:.82rem;color:#991b1b;';
    var text = document.createElement('span'); text.textContent = msg;
    var fixBtn = document.createElement('button');
    fixBtn.type = 'button'; fixBtn.textContent = 'Corriger';
    fixBtn.style.cssText = 'border:1px solid #E74C3C;background:#fff;color:#E74C3C;border-radius:4px;padding:2px 8px;font-size:.78rem;cursor:pointer;white-space:nowrap;flex-shrink:0;';
    fixBtn.onclick = function() { banner.remove(); if (inputToReset) { inputToReset.value = ''; inputToReset.focus(); } };
    banner.appendChild(text); banner.appendChild(fixBtn); container.appendChild(banner);
  }

  function setLoading(btn, on) {
    btn.disabled  = on;
    btn.innerHTML = on ? '<span class="spinner-border spinner-border-sm"></span>' : '<i class="bi bi-send-fill"></i>';
  }

  function clearInlineError(container) {
    if (!container) return;
    var e = container.querySelector('.inline-err');
    if (e) e.remove();
  }

  function escapeHtml(t) {
    return String(t).replace(/[&<>"']/g, function(c) {
      return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;' }[c];
    });
  }
</script>
{% endblock %}
