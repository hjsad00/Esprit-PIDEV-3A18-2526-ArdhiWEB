{% extends 'base.html.twig' %}
{% block title %}Mes Favoris - Ardhi{% endblock %}
{% block stylesheets %}
    <link href="{{ asset('assets/css/homepage.css') }}" rel="stylesheet">
{% endblock %}
{% block body %}
<section class="hero section dark-background" style="background-image: linear-gradient(180deg, rgba(10, 15, 8, 0.6), rgba(10, 15, 8, 0.12)), url('{{ asset('assets/img/hero_5.jpg') }}'); background-size: cover; background-position: center; min-height: 320px; margin-top: 70px;">
  <div class="hero-content-wrapper" style="align-items: center; justify-content: center;">
    <div class="hero-left" style="max-width: 760px; padding: 100px 40px;">
      <span class="hero-label">MES FAVORIS</span>
      <h1 class="hero-headline">Vos événements favoris</h1>
      <p class="hero-description">Retrouvez en un clic vos événements sélectionnés et reprenez leur inscription ou consultation.</p>
      <div class="hero-cta-group">
        <a href="{{ path('app_evenement_index') }}" class="hero-btn-secondary">Retour aux événements</a>
        <a href="{{ path('app_evenement_inscriptions') }}" class="hero-btn-primary">Mes inscriptions</a>
      </div>
    </div>
  </div>
</section>
<section class="services section">
  <div class="container section-title" data-aos="fade-up">
    <h2>Favoris enregistrés</h2>
    <p>Les événements que vous avez ajoutés à vos favoris.</p>
  </div>
  <div class="container">
    {% if favoris is empty %}
      <div class="alert alert-info">Vous n'avez encore aucun événement dans vos favoris.</div>
      <a href="{{ path('app_evenement_index') }}" class="btn btn-success">Voir les événements</a>
    {% else %}
      <div class="row g-4">
        {% for fav in favoris %}
          {% set e = fav.evenement %}
          <div class="col-lg-4 col-md-6">
            <div class="card shadow-sm h-100">
              <div class="card-body">
                <span class="badge bg-success">{{ e.type }}</span>
                <h5 class="mt-3">{{ e.titre }}</h5>
                <p class="text-muted mb-1"><i class="bi bi-geo-alt-fill me-2"></i>{{ e.lieu }}</p>
                <p class="text-muted mb-1"><i class="bi bi-calendar3 me-2"></i>{{ e.dateDebut|date('d/m/Y') }}</p>
                <p class="text-muted mb-0"><i class="bi bi-person-fill me-2"></i>{{ e.organisateur }}</p>
              </div>
              <div class="card-footer d-flex justify-content-between align-items-center">
                <a href="{{ path('app_evenement_show', {id: e.id}) }}" class="btn btn-sm btn-success">Voir</a>
                <form method="post" action="{{ path('app_evenement_toggle_favori', {id: e.id}) }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('favori' ~ e.id) }}">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Retirer</button>
                </form>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
{% endblock %}
