{% extends 'base.html.twig' %}

{% block title %}Créer un événement - Ardhi{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('assets/css/homepage.css') }}" rel="stylesheet">
    <style>
        .form-card { 
            background: rgba(255, 255, 255, 0.95); 
            backdrop-filter: blur(10px);
            border-radius: 20px; 
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08); 
            padding: 40px; 
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        .form-control, .form-select { 
            border-radius: 12px; 
            border: 1.5px solid #e2e8f0; 
            padding: 12px 16px; 
            font-size: 0.98rem; 
            transition: all 0.2s;
        }
        .form-control:focus, .form-select:focus { 
            border-color: #667A3F; 
            box-shadow: 0 0 0 4px rgba(102, 122, 63, 0.12); 
            outline: none; 
        }
        .form-label { 
            font-size: 0.9rem; 
            color: #475569; 
            font-weight: 600; 
            margin-bottom: 8px;
        }
        .btn-save { 
            background: linear-gradient(135deg, #8BC34A, #667A3F); 
            color: #fff; 
            border: none; 
            border-radius: 14px; 
            padding: 14px 32px; 
            font-weight: 700; 
            font-size: 1rem; 
            cursor: pointer; 
            transition: transform 0.2s, box-shadow 0.2s; 
            display: inline-flex;
            align-items: center;
        }
        .btn-save:hover { 
            transform: translateY(-2px);
            box-shadow: 0 8px 15px rgba(102, 122, 63, 0.2);
            color: #fff;
        }
        .btn-cancel { 
            background: #f1f5f9; 
            color: #64748b; 
            border: none; 
            border-radius: 14px; 
            padding: 14px 28px; 
            font-weight: 600; 
            font-size: 1rem; 
            text-decoration: none; 
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
        }
        .btn-cancel:hover { 
            background: #e2e8f0; 
            color: #334155; 
        }
        .invalid-feedback { 
            color: #e11d48; 
            font-size: 0.85rem; 
            margin-top: 6px; 
            display: block;
        }
        /* Custom file input styling */
        input[type="file"]::file-selector-button {
            background: #667A3F;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 6px 12px;
            margin-right: 12px;
            cursor: pointer;
            font-weight: 600;
        }
    </style>
{% endblock %}

{% block body %}
    {# Header Hero Section with Glassmorphism #}
    <section class="hero section dark-background" 
             style="background-image: linear-gradient(180deg, rgba(10, 15, 8, 0.6), rgba(10, 15, 8, 0.2)), url('{{ asset('assets/img/hero_4.jpg') }}'); 
                    background-size: cover; background-position: center; padding: 140px 0 80px;">
        <div class="container">
            <div class="row">
                <div class="col-lg-8" data-aos="fade-up">
                    <span class="hero-label" style="background: rgba(139, 195, 74, 0.2); backdrop-filter: blur(4px); padding: 8px 16px; border-radius: 100px; color: #fff; border: 1px solid rgba(139, 195, 74, 0.3); font-size: 0.85rem; font-weight: 700; letter-spacing: 1px;">
                        NOUVEL ÉVÉNEMENT
                    </span>
                    <h1 class="hero-headline mt-3" style="font-size: 3.5rem; font-weight: 800; color: #fff; text-shadow: 0 4px 10px rgba(0,0,0,0.3);">
                        Publiez un événement agricole
                    </h1>
                    <p class="hero-description mt-3" style="font-size: 1.25rem; color: rgba(255,255,255,0.9); max-width: 600px;">
                        Ajoutez un événement, invitez des participants et développez votre réseau au sein de la communauté Ardhi.
                    </p>
                    <div class="mt-4">
                        {% include 'Evenement/_retour_button.html.twig' with { back_path: path('app_evenement_index'), back_label: 'Retour aux événements' } %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="services section" style="padding-top: 60px; background: #fafafa;">
        <div class="container section-title text-center mb-5" data-aos="fade-up">
            <h2 style="font-weight: 800; color: #1a202c;">Créer un événement</h2>
            <div style="height: 4px; width: 60px; background: #8BC34A; margin: 15px auto; border-radius: 2px;"></div>
            <p style="color: #64748b;">Remplissez les informations ci-dessous pour publier votre événement.</p>
        </div>

        <div class="container mb-5">
            <div class="row justify-content-center">
                <div class="col-xl-11">
                    <div class="form-card" data-aos="fade-up" data-aos-delay="100">
                        {{ include('evenement/_form.html.twig', {
                            'button_label': 'Publier l\'événement'
                        }) }}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
