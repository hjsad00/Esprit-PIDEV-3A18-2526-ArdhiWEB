{% extends 'base.html.twig' %}
{% block title %}Nouvel événement - Ardhi{% endblock %}
{% block stylesheets %}
    <link href="{{ asset('assets/css/homepage.css') }}" rel="stylesheet">
{% endblock %}
{% block body %}
<section class="hero section dark-background" style="background-image: linear-gradient(180deg, rgba(10, 15, 8, 0.56), rgba(10, 15, 8, 0.16)), url('{{ asset('assets/img/hero_4.jpg') }}'); background-size: cover; background-position: center; min-height: 320px; margin-top: 70px;">
  <div class="hero-content-wrapper" style="align-items: center; justify-content: center;">
    <div class="hero-left" style="max-width: 760px; padding: 90px 40px;">
      <span class="hero-label">NOUVEL ÉVÉNEMENT</span>
      <h1 class="hero-headline">Publiez un événement agricole</h1>
      <p class="hero-description">Ajoutez un événement, invitez les participants et développez votre réseau agricole.</p>
    </div>
  </div>
</section>
<section class="services section">
  <div class="container section-title" data-aos="fade-up">
    <h2>Créer un événement</h2>
    <p>Complétez les informations et publiez votre événement.</p>
  </div>
  <div class="container py-4">
    <div class="card shadow-sm p-4">
      {% include 'evenement/_form.html.twig' with {submitLabel: 'Publier'} %}
    </div>
  </div>
</section>
{% endblock %}
