{% extends 'base.html.twig' %}
{% block title %}Mes Événements - Ardhi{% endblock %}
{% block stylesheets %}<link href="{{ asset('assets/css/homepage.css') }}" rel="stylesheet">
<style>
.ev-card{background:#fff;border-radius:14px;box-shadow:0 4px 18px rgba(0,0,0,.07);overflow:hidden;transition:transform .2s,box-shadow .2s;}
.ev-card:hover{transform:translateY(-4px);box-shadow:0 10px 28px rgba(0,0,0,.1);}
.ev-card-img{height:190px;object-fit:cover;width:100%;display:block;}
.ev-card-placeholder{height:190px;display:flex;align-items:center;justify-content:center;font-size:3.5rem;background:linear-gradient(135deg,#667A3F22,#8BC34A11);}
.ev-card-body{padding:20px;}
.ev-card-title{font-weight:700;font-size:1rem;color:#1a2e05;margin-bottom:10px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.ev-meta{font-size:.84rem;color:#6b7280;display:flex;align-items:center;gap:6px;margin-bottom:8px;}
.ev-meta i{color:#667A3F;}
.ev-card-foot{padding:14px 20px 20px;background:#f9fafb;border-top:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;}
.b-type,.b-stat{font-size:.71rem;font-weight:700;padding:4px 10px;border-radius:20px;text-transform:uppercase;}
.b-FOIRE{background:#3498DB22;color:#2980b9;} .b-FORMATION{background:#9B59B622;color:#8e44ad;}
.b-CONFERENCE{background:#F39C1222;color:#e67e22;} .b-ATELIER{background:#2ECC7122;color:#27ae60;}
.b-A_VENIR{background:#8BC34A;color:#fff;} .b-EN_COURS{background:#3498DB;color:#fff;}
.b-TERMINE{background:#95a5a6;color:#fff;} .b-ANNULE{background:#E74C3C;color:#fff;}
.btn-voir{background:#667A3F;color:#fff;border:none;border-radius:8px;padding:8px 16px;font-size:.87rem;font-weight:600;text-decoration:none;transition:background .2s;}
.btn-voir:hover{background:#4a5c2a;color:#fff;}
.filter-wrap{background:#fff;border-radius:14px;box-shadow:0 4px 20px rgba(0,0,0,.08);padding:20px 24px;margin-top:-28px;position:relative;z-index:10;}
.filter-wrap .form-control,.filter-wrap .form-select{border-radius:8px;border:1.5px solid #e2e8f0;font-size:.93rem;}
.filter-wrap .form-control:focus,.filter-wrap .form-select:focus{border-color:#667A3F;box-shadow:0 0 0 3px rgba(102,122,63,.15);}
.btn-filtrer{background:#667A3F;color:#fff;border:none;border-radius:8px;padding:9px 22px;font-weight:700;}
.btn-filtrer:hover{background:#4a5c2a;color:#fff;}
.btn-reset{border:1.5px solid #667A3F;color:#667A3F;background:transparent;border-radius:8px;padding:9px 14px;font-weight:600;transition:all .2s;}
.btn-reset:hover{background:#667A3F;color:#fff;}
.hero-insc{min-height:520px !important;overflow:visible;}
.hero-insc .hero-left{padding:90px 40px 70px 40px !important;}
.hero-cta-group{display:flex;flex-wrap:wrap;gap:14px;align-items:center;margin-top:24px;}
.hero-btn-secondary,.hero-btn-primary{white-space:nowrap;}
</style>{% endblock %}
{% block body %}
<section class="hero section dark-background hero-insc"
  style="background-image:linear-gradient(180deg,rgba(10,15,8,.54),rgba(10,15,8,.14)),url('{{ asset('assets/img/hero_4.jpg') }}');
         background-size:cover;background-position:center;padding-top:120px;">
  <div class="hero-content-wrapper" style="align-items:center;justify-content:center;">
    <div class="hero-left" style="max-width:760px;">
      <div class="hero-label">MES ÉVÉNEMENTS</div>
      <h1 class="hero-headline">Mes événements créés</h1>
      <p class="hero-description">{{ evenements|length }} événement(s) créé(s) — gérez vos propres événements.</p>
      <div class="hero-cta-group">
        <a href="{{ path('app_evenement_index') }}" class="hero-btn-secondary">Voir tous les événements</a>
        <a href="{{ path('app_evenement_new') }}" class="hero-btn-primary">Créer un événement</a>
      </div>
    </div>
  </div>
</section>
<section class="services section" style="padding-top:36px;">
  <div class="container">
    {% if evenements is empty %}
      <div class="text-center py-5" style="color:#9ca3af;">
        <i class="bi bi-calendar-x" style="font-size:4rem;color:#d1d5db;display:block;margin-bottom:16px;"></i>
        <h5 class="fw-bold">Aucun événement créé pour l'instant</h5>
        <p>Créez un événement pour le voir ici.</p>
        <a href="{{ path('app_evenement_new') }}" class="btn btn-success mt-2">Créer un événement</a>
      </div>
    {% else %}
    <div class="filter-wrap mt-0 mb-4" style="margin-top:0!important">
      <form id="mes-event-filter-form">
        <div class="row g-3 align-items-end">
          <div class="col-md-4">
            <label class="form-label fw-semibold small text-muted mb-1">Rechercher</label>
            <input id="mes-event-search" type="text" name="search" class="form-control" value="{{ search ?? '' }}" placeholder="Titre, lieu, organisateur...">
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold small text-muted mb-1">Type</label>
            <select id="mes-event-type" name="type" class="form-select">
              <option value="">-- Tous les types --</option>
              <option value="FOIRE" {% if type=='FOIRE' %}selected{% endif %}>Foire</option>
              <option value="FORMATION" {% if type=='FORMATION' %}selected{% endif %}>Formation</option>
              <option value="CONFERENCE" {% if type=='CONFERENCE' %}selected{% endif %}>Conférence</option>
              <option value="ATELIER" {% if type=='ATELIER' %}selected{% endif %}>Atelier</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold small text-muted mb-1">Statut</label>
            <select id="mes-event-statut" name="statut" class="form-select">
              <option value="">-- Tous les statuts --</option>
              <option value="A_VENIR" {% if statut=='A_VENIR' %}selected{% endif %}>À venir</option>
              <option value="EN_COURS" {% if statut=='EN_COURS' %}selected{% endif %}>En cours</option>
              <option value="TERMINE" {% if statut=='TERMINE' %}selected{% endif %}>Terminé</option>
              <option value="ANNULE" {% if statut=='ANNULE' %}selected{% endif %}>Annulé</option>
            </select>
          </div>
          <div class="col-md-2 d-flex gap-2">
            <button id="mes-event-apply" type="button" class="btn-filtrer flex-fill"><i class="bi bi-search me-1"></i>Filtrer</button>
            <button id="mes-event-reset" type="button" class="btn-reset"><i class="bi bi-x-lg"></i></button>
          </div>
        </div>
      </form>
    </div>
    <div class="row g-4 pb-5" id="mes-events-list">
      {% for e in evenements %}
      <div class="col-lg-6" data-event-item data-title="{{ e.titre|lower|e('html_attr') }}" data-lieu="{{ e.lieu|lower|e('html_attr') }}" data-statut="{{ e.statut|lower|e('html_attr') }}" data-type="{{ e.type|lower|e('html_attr') }}">
        <div class="ev-card">
          {% if e.imageUrl %}
            <img src="{{ asset(e.imageUrl) }}" class="ev-card-img" alt="{{ e.titre }}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
            <div class="ev-card-placeholder" style="display:none;">
              {% if e.type=='FOIRE' %}🌾{% elseif e.type=='FORMATION' %}📚{% elseif e.type=='CONFERENCE' %}🎤{% else %}🔧{% endif %}
            </div>
          {% else %}
            <div class="ev-card-placeholder">
              {% if e.type=='FOIRE' %}🌾{% elseif e.type=='FORMATION' %}📚{% elseif e.type=='CONFERENCE' %}🎤{% else %}🔧{% endif %}
            </div>
          {% endif %}
          <div class="ev-card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <span class="b-type b-{{ e.type }}">{{ e.type }}</span>
              <span class="b-stat b-{{ e.statut }}">
                {% if e.statut=='A_VENIR' %}À venir{% elseif e.statut=='EN_COURS' %}En cours{% elseif e.statut=='TERMINE' %}Terminé{% else %}Annulé{% endif %}
              </span>
            </div>
            <h5 class="ev-card-title">{{ e.titre }}</h5>
            <div class="ev-meta"><i class="bi bi-geo-alt-fill"></i>{{ e.lieu }}</div>
            <div class="ev-meta"><i class="bi bi-calendar3"></i>{{ e.dateDebut|date('d/m/Y') }}{% if e.dateFin != e.dateDebut %} → {{ e.dateFin|date('d/m/Y') }}{% endif %}</div>
            <div class="ev-meta"><i class="bi bi-person-fill"></i>{{ e.organisateur }}</div>
          </div>
          <div class="ev-card-foot">
            <a href="{{ path('app_evenement_show', {id: e.id}) }}" class="btn-voir">Voir les détails</a>
            <span class="b-stat b-{{ e.statut }}">Créé le {{ e.dateCreation|date('d/m/Y') }}</span>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    <p id="mes-event-empty-filter" class="text-center text-muted py-3 d-none">Aucun résultat pour ce filtre.</p>
    {% endif %}
  </div>
</section>
{% endblock %}
{% block javascripts %}
{{ parent() }}
<script>
  (() => {
    const searchInput = document.getElementById('mes-event-search');
    const typeSelect = document.getElementById('mes-event-type');
    const statutSelect = document.getElementById('mes-event-statut');
    const list = document.getElementById('mes-events-list');
    if (!searchInput || !typeSelect || !statutSelect || !list) return;

    const emptyMsg = document.getElementById('mes-event-empty-filter');
    const items = Array.from(list.querySelectorAll('[data-event-item]'));

    const apply = () => {
      const q = (searchInput.value || '').trim().toLowerCase();
      const type = (typeSelect.value || '').toLowerCase();
      const statut = (statutSelect.value || '').toLowerCase();

      const filtered = items.filter((el) => {
        const haystack = [el.dataset.title, el.dataset.lieu, el.dataset.statut, el.dataset.type].join(' ');
        const textOk = !q || haystack.includes(q);
        const typeOk = !type || (el.dataset.type || '') === type;
        const statutOk = !statut || (el.dataset.statut || '') === statut;
        const ok = textOk && typeOk && statutOk;
        el.style.display = ok ? '' : 'none';
        return ok;
      });

      if (emptyMsg) emptyMsg.classList.toggle('d-none', filtered.length > 0);
    };

    const applyBtn = document.getElementById('mes-event-apply');
    const resetBtn = document.getElementById('mes-event-reset');
    let timeoutId;

    searchInput.addEventListener('input', () => {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(apply, 450);
    });
    typeSelect.addEventListener('change', apply);
    statutSelect.addEventListener('change', apply);
    if (applyBtn) applyBtn.addEventListener('click', apply);
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        searchInput.value = '';
        typeSelect.value = '';
        statutSelect.value = '';
        apply();
      });
    }
  })();
</script>
{% endblock %}
