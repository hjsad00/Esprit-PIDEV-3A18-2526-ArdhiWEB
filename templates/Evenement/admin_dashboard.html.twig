{% extends 'base.html.twig' %}
{% block title %}Dashboard Admin - Événements{% endblock %}
{% block stylesheets %}<link href="{{ asset('assets/css/homepage.css') }}" rel="stylesheet">
<style>
.kpi-card{background:#fff;border-radius:14px;box-shadow:0 4px 18px rgba(0,0,0,.07);padding:24px;text-align:center;border-top:4px solid transparent;}
.kpi-val{font-size:2.4rem;font-weight:800;} .kpi-lbl{font-size:.8rem;color:#9ca3af;font-weight:600;text-transform:uppercase;margin-top:4px;}
.k-green{border-color:#8BC34A;} .k-green .kpi-val{color:#667A3F;}
.k-blue{border-color:#3498DB;}  .k-blue .kpi-val{color:#2980b9;}
.k-orange{border-color:#F39C12;} .k-orange .kpi-val{color:#e67e22;}
.admin-hero-top { display:flex; align-items:flex-start; justify-content:space-between; gap:40px; flex-wrap:wrap; }
.admin-hero-intro { flex:1 1 620px; min-width:320px; max-width:860px; }
.admin-hero-actions { display:flex; gap:14px; flex-wrap:wrap; align-items:center; justify-content:flex-start; margin:22px 0 18px 0; }
.admin-hero-actions .hero-btn-primary,
.admin-hero-actions .hero-btn-secondary {
  min-width:auto;
  padding:14px 24px;
  font-size:15px;
  white-space:nowrap;
}
.admin-hero { min-height:920px !important; overflow:visible !important; }
.admin-hero .hero-content-wrapper { min-height:920px; padding-top:118px; padding-bottom:140px; align-items:flex-start; gap:34px; overflow:visible; }
.admin-hero .hero-left { flex:1 1 58%; max-width:none; padding-bottom:48px; }
.admin-hero .hero-headline { max-width:12ch; }
.admin-hero .hero-description { max-width:760px; font-size:1.2rem; line-height:1.8; }
.admin-hero .hero-services-sidebar { flex:0 0 380px; max-width:380px; }
.admin-hero .services-glass-panel {
  padding:26px 22px;
  min-height:680px;
  background:linear-gradient(180deg,rgba(45,109,63,.44),rgba(63,145,74,.24)) !important;
  border:1px solid rgba(179,235,173,.34);
}
.admin-hero .services-panel-title { color:#f3fff0; }
.admin-hero .service-sidebar-item {
  padding:22px 18px;
  min-height:96px;
  background:rgba(255,255,255,.06);
}
.admin-hero .service-sidebar-item.active {
  background:rgba(113,196,86,.28);
  border-color:rgba(182,255,171,.5);
}
.admin-hero .service-sidebar-icon {
  width:58px;
  height:58px;
  background:linear-gradient(135deg,rgba(86,175,59,.95),rgba(124,200,78,.88)) !important;
  color:#ffffff !important;
}
.admin-hero .service-sidebar-text h4 { font-size:1.1rem; margin-bottom:4px; }
.admin-hero .service-sidebar-text span { font-size:.98rem; color:rgba(255,255,255,.86); }
@media (max-width: 1200px) {
  .admin-hero .hero-content-wrapper { gap:24px; }
  .admin-hero .hero-services-sidebar { flex:1 1 100%; max-width:100%; }
}
@media (max-width: 992px) {
  .admin-hero-top { flex-direction:column; }
  .admin-hero-intro { min-width:0; max-width:none; }
  .admin-hero-actions { justify-content:flex-start; }
  .admin-hero .hero-headline { max-width:none; }
}
</style>{% endblock %}
{% block body %}
<section class="hero section dark-background admin-hero"
  style="background-image:linear-gradient(135deg,rgba(24,80,35,.88),rgba(92,161,74,.72)),url('{{ asset('assets/img/hero_3.jpg') }}');
         background-size:cover;background-position:center;min-height:360px;margin-top:70px;">
  <div class="hero-content-wrapper">
    <div class="hero-left">
      <div class="admin-hero-top">
        <div class="admin-hero-intro">
          <div class="hero-label">DASHBOARD ADMIN</div>
          <h1 class="hero-headline">Gestion des événements</h1>
          <div class="admin-hero-actions">
            <a href="{{ path('app_evenement_new') }}" class="hero-btn-primary">Créer un événement</a>
            <a href="{{ path('app_evenement_statistics') }}" class="hero-btn-secondary">Statistiques</a>
            <a href="{{ path('app_evenement_participations') }}" class="hero-btn-secondary">Participations</a>
          </div>
          <p class="hero-description">Créez, gérez et analysez tous les événements de la plateforme.</p>
        </div>
      </div>
    </div>
    <div class="hero-services-sidebar">
      <div class="services-glass-panel">
        <div class="services-panel-title">Admin</div>
        <a href="{{ path('app_evenement_admin_dashboard') }}" class="service-sidebar-item active">
          <div class="service-sidebar-icon"><i class="bi bi-speedometer2"></i></div>
          <div class="service-sidebar-text"><h4>Dashboard</h4><span>Vue globale</span></div>
        </a>
        <a href="{{ path('app_evenement_statistics') }}" class="service-sidebar-item">
          <div class="service-sidebar-icon"><i class="bi bi-graph-up"></i></div>
          <div class="service-sidebar-text"><h4>Statistiques</h4><span>Analyses détaillées</span></div>
        </a>
        <a href="{{ path('app_evenement_participations') }}" class="service-sidebar-item">
          <div class="service-sidebar-icon"><i class="bi bi-people-fill"></i></div>
          <div class="service-sidebar-text"><h4>Participations</h4><span>Gérer inscriptions</span></div>
        </a>
        <a href="{{ path('app_evenement_calendrier') }}" class="service-sidebar-item">
          <div class="service-sidebar-icon"><i class="bi bi-calendar3"></i></div>
          <div class="service-sidebar-text"><h4>Calendrier</h4><span>Vue mensuelle</span></div>
        </a>
        <a href="{{ path('app_evenement_new') }}" class="service-sidebar-item">
          <div class="service-sidebar-icon"><i class="bi bi-plus-circle-fill"></i></div>
          <div class="service-sidebar-text"><h4>Créer</h4><span>Nouvel événement</span></div>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="services section" style="padding-top:36px;">
  <div class="container">
    {% set gs = globalStats %}

    <!-- KPIs -->
    <div class="row g-4 mb-4">
      <div class="col-md-4"><div class="kpi-card k-green"><div class="kpi-val">{{ gs.totalEvents }}</div><div class="kpi-lbl">📅 Total événements</div></div></div>
      <div class="col-md-4"><div class="kpi-card k-blue"><div class="kpi-val">{{ gs.totalParticipations }}</div><div class="kpi-lbl">👥 Participations</div></div></div>
      <div class="col-md-4"><div class="kpi-card k-orange"><div class="kpi-val">{{ gs.avgRating }} ⭐</div><div class="kpi-lbl">Note moyenne</div></div></div>
    </div>

    <div class="row g-4 mb-4">
      <div class="col-md-6">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h5 class="fw-bold mb-3" style="color:#667A3F;"><i class="bi bi-circle-fill me-2"></i>Par statut</h5>
            <ul class="list-group list-group-flush">
              {% set slabels={'A_VENIR':'À VENIR','EN_COURS':'EN COURS','TERMINE':'TERMINÉ','ANNULE':'ANNULÉ'} %}
              {% set scolors={'A_VENIR':'success','EN_COURS':'info text-dark','TERMINE':'secondary','ANNULE':'danger'} %}
              {% for row in gs.eventsByStatus %}
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span>{{ slabels[row.statut] ?? row.statut }}</span>
                <span class="badge bg-{{ scolors[row.statut] ?? 'primary' }} rounded-pill">{{ row.count }}</span>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h5 class="fw-bold mb-3" style="color:#667A3F;"><i class="bi bi-tag-fill me-2"></i>Par type</h5>
            <ul class="list-group list-group-flush">
              {% for row in gs.eventsByType %}
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span>{{ row.type }}</span>
                <span class="badge bg-success rounded-pill">{{ row.count }}</span>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Events table -->
    <div class="card shadow-sm mb-5">
      <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0" style="color:#667A3F;"><i class="bi bi-table me-2"></i>Tous les événements</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr><th>Titre</th><th>Type</th><th>Statut</th><th>Date</th><th>Places</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
              {% for e in evenements %}
              <tr>
                <td class="fw-semibold">{{ e.titre|slice(0,40) }}</td>
                <td>
                  <span class="badge {{ e.type=='FOIRE' ? 'bg-primary' : e.type=='FORMATION' ? 'bg-dark' : e.type=='CONFERENCE' ? 'bg-warning text-dark' : 'bg-success' }}">
                    {{ e.type }}
                  </span>
                </td>
                <td><span class="badge bg-{{ e.statut=='A_VENIR' ? 'success' : e.statut=='EN_COURS' ? 'info text-dark' : e.statut=='TERMINE' ? 'secondary' : 'danger' }}">{{ e.statut }}</span></td>
                <td style="white-space:nowrap;font-size:.84rem;">{{ e.dateDebut|date('d/m/Y') }}</td>
                <td style="font-size:.84rem;">{{ e.nombreParticipants }}/{{ e.nombrePlacesMax }}</td>
                <td class="text-end">
                  <a href="{{ path('app_evenement_show', {id: e.id}) }}" class="btn btn-sm btn-outline-success me-1">Voir</a>
                  <a href="{{ path('app_evenement_edit', {id: e.id}) }}" class="btn btn-sm btn-success me-1">Modifier</a>
                  <form method="post" action="{{ path('app_evenement_delete', {id: e.id}) }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete'~e.id) }}">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Supprimer ?')">Supp.</button>
                  </form>
                </td>
              </tr>
              {% else %}
              <tr><td colspan="6" class="text-center text-muted py-3">Aucun événement.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
