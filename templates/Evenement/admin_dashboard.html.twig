{% extends 'evenement/admin_layout.html.twig' %}
{% block title %}Gestion des Événements - Ardhi Admin{% endblock %}
{% block page_title %}Gestion des Événements{% endblock %}

{% block body %}
{# ── Stat cards — same markup/CSS as the diags dashboard ── #}
<div class="row g-4 mb-4">
  {% for stat in stats %}
  <div class="col-xl-3 col-lg-4 col-md-6">
    <a href="{{ path(stat.route) }}" class="stat-card" style="--card-accent: {{ stat.color }};">
      <div class="stat-icon" style="background: {{ stat.color }}1a; color: {{ stat.color }};">
        <i class="bi {{ stat.icon }}"></i>
      </div>
      <div class="stat-info">
        <span class="stat-count">{{ stat.count }}</span>
        <span class="stat-label">{{ stat.label }}</span>
      </div>
    </a>
  </div>
  {% endfor %}
</div>

{# ── Events table ── #}
<div class="card shadow-sm">
  <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
    <h5 class="fw-bold mb-0" style="font-size:.95rem;color:#1a2e05;">
      <i class="bi bi-table me-2 text-success"></i>Tous les événements
    </h5>
    <div class="d-flex gap-2">
      <a href="{{ path('app_inactifs_dashboard') }}" class="btn btn-sm btn-outline-danger">
        <i class="bi bi-person-x-fill me-1"></i>Participants inactifs
      </a>
      <a href="{{ path('app_evenement_new') }}" class="btn btn-sm btn-success">
        <i class="bi bi-plus-lg me-1"></i>Créer
      </a>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Titre</th>
            <th>Type</th>
            <th>Statut</th>
            <th>Date début</th>
            <th>Places</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for e in evenements %}
          <tr>
            <td class="fw-semibold" style="font-size:.9rem;">{{ e.titre|slice(0,42) }}</td>
            <td>
              <span class="badge {{ e.type=='FOIRE' ? 'bg-primary' : e.type=='FORMATION' ? 'bg-dark' : e.type=='CONFERENCE' ? 'bg-warning text-dark' : 'bg-success' }}">
                {{ e.type }}
              </span>
            </td>
            <td>
              <span class="badge bg-{{ e.statut=='A_VENIR' ? 'success' : e.statut=='EN_COURS' ? 'info text-dark' : e.statut=='TERMINE' ? 'secondary' : 'danger' }}">
                {{ e.statut|replace({'A_VENIR':'À VENIR','EN_COURS':'EN COURS','TERMINE':'TERMINÉ','ANNULE':'ANNULÉ'}) }}
              </span>
            </td>
            <td style="white-space:nowrap;font-size:.84rem;">{{ e.dateDebut|date('d/m/Y') }}</td>
            <td style="font-size:.84rem;">{{ e.nombreParticipants }}/{{ e.nombrePlacesMax }}</td>
            <td class="text-end">
              <a href="{{ path('app_evenement_show', {id: e.id}) }}" class="btn btn-sm btn-outline-success me-1">Voir</a>
              <a href="{{ path('app_evenement_edit', {id: e.id}) }}" class="btn btn-sm btn-success me-1">Modifier</a>
              <form method="post" action="{{ path('app_evenement_delete', {id: e.id}) }}" class="d-inline"
                    onsubmit="return confirm('Supprimer cet événement ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete'~e.id) }}">
                <button type="submit" class="btn btn-sm btn-danger">Supp.</button>
              </form>
            </td>
          </tr>
          {% else %}
          <tr><td colspan="6" class="text-center text-muted py-4">Aucun événement trouvé.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
