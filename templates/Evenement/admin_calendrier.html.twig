{% extends 'evenement/admin_layout.html.twig' %}
{% block title %}Calendrier des Événements - Ardhi Admin{% endblock %}
{% block page_title %}Calendrier des Événements{% endblock %}

{% block stylesheets %}
<style>
.cal-layout-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.07); }
.cal-head { border-bottom: 1px solid #f0f3f7; padding: 18px 20px; }
.cal-month { font-size: 1.4rem; font-weight: 800; color: #1a2e05; margin: 0; }
.cal-grid-wrap { padding: 16px; }
.cal-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
.cal-dow { text-align: center; font-weight: 700; font-size: .78rem; color: #5f6b74; padding: 6px 0; background: #f8f9fb; border-radius: 8px; }
.cal-cell { min-height: 80px; border: 1px solid #e5e9ef; border-radius: 10px; padding: 7px; background: #fff; cursor: pointer; transition: .15s ease; }
.cal-cell:hover { transform: translateY(-2px); box-shadow: 0 6px 14px rgba(17,24,39,.08); }
.cal-cell.out { background: #fafbfc; opacity: .65; }
.cal-cell.today { border-color: #4ea33d; }
.cal-cell.active { border-color: #5f8f2f; box-shadow: 0 0 0 2px rgba(95,143,47,.18); background: #f7fbef; }
.cal-day { font-weight: 700; font-size: .88rem; color: #2d3748; margin-bottom: 4px; }
.cal-bars { display: grid; gap: 3px; }
.cal-bar { height: 4px; border-radius: 999px; }
.cal-more { font-size: .68rem; color: #64748b; font-weight: 700; }
.cal-legend { display: flex; gap: 14px; flex-wrap: wrap; padding: 4px 2px 0; }
.cal-legend-item { display: flex; gap: 5px; align-items: center; font-size: .78rem; color: #5f6b74; }
.cal-dot { width: 9px; height: 9px; border-radius: 3px; }
.cal-side { padding: 18px; }
.cal-side h5 { color: #667A3F; font-weight: 800; margin-bottom: 2px; font-size: .95rem; }
.cal-side small { color: #7c8791; }
.cal-events { margin-top: 14px; max-height: 460px; overflow: auto; display: grid; gap: 8px; }
.cal-event { border: 1px solid #e7ebf0; border-left: 4px solid #3498DB; border-radius: 8px; padding: 9px 11px; background: #fff; }
.cal-event-title { font-weight: 700; color: #22313f; margin-bottom: 4px; font-size: .88rem; }
.cal-event-meta { font-size: .78rem; color: #617080; }
.cal-chip { display: inline-block; margin-top: 5px; font-size: .68rem; font-weight: 700; border-radius: 999px; padding: 2px 8px; text-transform: uppercase; }
.c-A_VENIR{background:#50C87822;color:#198754;} .c-EN_COURS{background:#F39C1222;color:#d97706;}
.c-TERMINE{background:#95A5A622;color:#64748b;} .c-ANNULE{background:#E74C3C22;color:#dc2626;} .c-DEF{background:#8BC34A22;color:#4f7f20;}
</style>
{% endblock %}

{% block body %}
<div class="row g-4">
  <div class="col-lg-8">
    <div class="cal-layout-card">
      <div class="cal-head d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h2 id="calMonth" class="cal-month">-</h2>
        <div class="d-flex gap-2">
          <button id="calPrev" class="btn btn-sm btn-outline-success">◀ Précédent</button>
          <button id="calToday" class="btn btn-sm btn-success">Aujourd'hui</button>
          <button id="calNext" class="btn btn-sm btn-outline-success">Suivant ▶</button>
        </div>
      </div>
      <div class="cal-grid-wrap">
        <div id="calGrid" class="cal-grid"></div>
        <div class="cal-legend mt-3">
          <div class="cal-legend-item"><span class="cal-dot" style="background:#50C878;"></span>À venir</div>
          <div class="cal-legend-item"><span class="cal-dot" style="background:#F39C12;"></span>En cours</div>
          <div class="cal-legend-item"><span class="cal-dot" style="background:#95A5A6;"></span>Terminé</div>
          <div class="cal-legend-item"><span class="cal-dot" style="background:#E74C3C;"></span>Annulé</div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="cal-layout-card cal-side">
      <h5>Événements du jour</h5>
      <small id="calSelectedDate">-</small>
      <div id="calEventsList" class="cal-events"></div>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
  (() => {
    const rawEvents = {{ calendarEvents|json_encode|raw }};
    const monthLabel = document.getElementById('calMonth');
    const grid = document.getElementById('calGrid');
    const list = document.getElementById('calEventsList');
    const selectedDateLabel = document.getElementById('calSelectedDate');
    if (!monthLabel || !grid || !list || !selectedDateLabel) return;
    const statusColor = (s) => ({A_VENIR:'#50C878',EN_COURS:'#F39C12',TERMINE:'#95A5A6',ANNULE:'#E74C3C'}[s]||'#3498DB');
    const statusLabel = (s) => ({A_VENIR:'À venir',EN_COURS:'En cours',TERMINE:'Terminé',ANNULE:'Annulé'}[s]||s);
    const typeLabel   = (t) => ({FOIRE:'Foire',FORMATION:'Formation',CONFERENCE:'Conférence',ATELIER:'Atelier'}[t]||t);
    const eventsByDay = {};
    rawEvents.forEach((ev) => {
      if (!ev.dateDebut||!ev.dateFin) return;
      const start = new Date(ev.dateDebut+'T00:00:00');
      const end   = new Date(ev.dateFin  +'T00:00:00');
      for (let d = new Date(start); d <= end; d.setDate(d.getDate()+1)) {
        const key = d.toISOString().slice(0,10);
        if (!eventsByDay[key]) eventsByDay[key]=[];
        eventsByDay[key].push(ev);
      }
    });
    const weekdays = ['L','M','M','J','V','S','D'];
    let current = new Date(), selected = new Date();
    const fmtMonth = (d) => d.toLocaleDateString('fr-FR',{month:'long',year:'numeric'});
    const fmtDay   = (d) => { const t=d.toLocaleDateString('fr-FR',{weekday:'long',day:'2-digit',month:'long',year:'numeric'}); return t.charAt(0).toUpperCase()+t.slice(1); };
    const dayKey   = (d) => new Date(d.getTime()-(d.getTimezoneOffset()*60000)).toISOString().slice(0,10);
    const renderEvents = (date) => {
      const key = dayKey(date), dayEvents = eventsByDay[key]||[];
      selectedDateLabel.textContent = fmtDay(date); list.innerHTML='';
      if (!dayEvents.length) { list.innerHTML='<div class="text-center text-muted py-4"><i class="bi bi-calendar-x fs-1 d-block mb-2"></i>Aucun événement ce jour.</div>'; return; }
      dayEvents.forEach((ev) => {
        const card = document.createElement('div'); card.className='cal-event'; card.style.borderLeftColor=statusColor(ev.statut);
        card.innerHTML=`<div class="cal-event-title">${ev.titre}</div><div class="cal-event-meta"><i class="bi bi-geo-alt-fill me-1"></i>${ev.lieu||'-'}</div><div class="cal-event-meta"><i class="bi bi-calendar3 me-1"></i>${ev.dateDebut} → ${ev.dateFin}</div><span class="cal-chip c-${ev.statut||'DEF'}">${statusLabel(ev.statut)} · ${typeLabel(ev.type)}</span>`;
        list.appendChild(card);
      });
    };
    const sameDate = (a,b) => a.getFullYear()===b.getFullYear()&&a.getMonth()===b.getMonth()&&a.getDate()===b.getDate();
    const draw = () => {
      monthLabel.textContent = fmtMonth(current).toUpperCase(); grid.innerHTML='';
      weekdays.forEach((d) => { const h=document.createElement('div'); h.className='cal-dow'; h.textContent=d; grid.appendChild(h); });
      const first=new Date(current.getFullYear(),current.getMonth(),1);
      const offset=(first.getDay()+6)%7; const start=new Date(first); start.setDate(first.getDate()-offset);
      for (let i=0;i<42;i++) {
        const d=new Date(start); d.setDate(start.getDate()+i);
        const key=dayKey(d), dayEvents=eventsByDay[key]||[], cell=document.createElement('div'); cell.className='cal-cell';
        if (d.getMonth()!==current.getMonth()) cell.classList.add('out');
        if (sameDate(d,new Date())) cell.classList.add('today');
        if (sameDate(d,selected)) cell.classList.add('active');
        const bars=dayEvents.slice(0,3).map((ev)=>`<div class="cal-bar" style="background:${statusColor(ev.statut)}"></div>`).join('');
        const more=dayEvents.length>3?`<div class="cal-more">+${dayEvents.length-3}</div>`:'';
        cell.innerHTML=`<div class="cal-day">${d.getDate()}</div><div class="cal-bars">${bars}${more}</div>`;
        cell.addEventListener('click',()=>{ selected=d; draw(); renderEvents(d); });
        grid.appendChild(cell);
      }
    };
    document.getElementById('calPrev')?.addEventListener('click',()=>{ current=new Date(current.getFullYear(),current.getMonth()-1,1); draw(); });
    document.getElementById('calNext')?.addEventListener('click',()=>{ current=new Date(current.getFullYear(),current.getMonth()+1,1); draw(); });
    document.getElementById('calToday')?.addEventListener('click',()=>{ current=new Date(); selected=new Date(); draw(); renderEvents(selected); });
    draw(); renderEvents(selected);
  })();
</script>
{% endblock %}
