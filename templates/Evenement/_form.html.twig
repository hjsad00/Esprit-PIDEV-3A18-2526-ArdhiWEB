{{ form_start(form) }}

{% if not form.vars.valid %}
    <div class="alert alert-danger shadow-sm border-start border-4 border-danger py-3 mb-4" role="alert" style="background: #fff; border-radius: 12px;">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
            <div>
                <h6 class="fw-bold mb-1 text-danger">Une erreur est survenue</h6>
                <div class="text-muted small">Veuillez vérifier les informations saisies dans le formulaire ci-dessous.</div>
            </div>
        </div>
        {{ form_errors(form) }}
    </div>
{% endif %}

<div class="row g-4">
    <div class="col-lg-8">
        {# Section: Main Info #}
        <div class="mb-4">
            {{ form_label(form.titre, form.titre.vars.label ~ ' *', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.titre) }}
            {{ form_errors(form.titre) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.description, form.description.vars.label, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>

        {# Replace the entire lieu field block #}
        <div class="mb-4">
            {{ form_label(form.lieu, form.lieu.vars.label ~ ' *', {'label_attr': {'class': 'form-label'}}) }}
            
            <div class="input-group mb-2">
                {{ form_widget(form.lieu, {'attr': {'class': 'form-control', 'id': 'evenement_lieu', 'placeholder': 'Cliquez sur la carte ou tapez une adresse...', 'autocomplete': 'off'}}) }}
                <button type="button" id="btn-search-map"
                        class="btn fw-semibold"
                        style="background:#667A3F;color:#fff;border-radius:0 12px 12px 0;padding:0 16px;border:1.5px solid #667A3F;">
                    <i class="bi bi-search"></i>
                </button>
            </div>
            {{ form_errors(form.lieu) }}

            {# Leaflet Map #}
            <div id="leaflet-map" style="height:320px;border-radius:14px;border:1.5px solid #e2e8f0;z-index:0;"></div>
            <div class="form-text text-muted mt-2" style="font-size:0.8rem;">
                <i class="bi bi-cursor-fill me-1 text-success"></i>
                Cliquez n'importe où sur la carte pour définir le lieu, ou tapez une adresse et appuyez sur Entrée.
            </div>
        </div>

        {# Leaflet CSS + JS — free, no API key #}
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

        <script>
        document.addEventListener('DOMContentLoaded', () => {

            // ── Leaflet map init (centered on Tunis) ──────────────────────────────
            const map = L.map('leaflet-map').setView([36.8065, 10.1815], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors',
                maxZoom: 19,
            }).addTo(map);

            let marker = null;

            function placeMarker(lat, lng, label) {
                if (marker) marker.remove();
                marker = L.marker([lat, lng]).addTo(map);
                if (label) marker.bindPopup(label).openPopup();
                map.setView([lat, lng], 15);
                document.getElementById('evenement_lieu').value = label || `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
            }

            // ── Click on map → reverse geocode → fill lieu field ──────────────────
            map.on('click', async (e) => {
                const { lat, lng } = e.latlng;

                // Show a temporary marker immediately
                placeMarker(lat, lng, '...');

                try {
                    const res  = await fetch(
                        `https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json&accept-language=fr`,
                        { headers: { 'Accept-Language': 'fr' } }
                    );
                    const data = await res.json();
                    const address = data.display_name ?? `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
                    placeMarker(lat, lng, address);
                } catch {
                    placeMarker(lat, lng, `${lat.toFixed(5)}, ${lng.toFixed(5)}`);
                }
            });

            // ── Search by typing address → geocode → move map ─────────────────────
            async function searchAddress() {
                const query = document.getElementById('evenement_lieu').value.trim();
                if (!query) return;

                try {
                    const res  = await fetch(
                        `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&format=json&limit=1&accept-language=fr`
                    );
                    const data = await res.json();

                    if (data.length > 0) {
                        const { lat, lon, display_name } = data[0];
                        placeMarker(parseFloat(lat), parseFloat(lon), display_name);
                    } else {
                        alert('Adresse introuvable. Essayez avec plus de détails.');
                    }
                } catch {
                    alert('Erreur de recherche. Vérifiez votre connexion.');
                }
            }

            const btnSearch = document.getElementById('btn-search-map');
            if (btnSearch) btnSearch.addEventListener('click', searchAddress);
            
            const lInput = document.getElementById('evenement_lieu');
            if (lInput) {
                lInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') { e.preventDefault(); searchAddress(); }
                });
            }

            // ── If lieu field already has a value (edit mode), show it on map ──────
            const existingLieu = document.getElementById('evenement_lieu').value.trim();
            if (existingLieu) {
                fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(existingLieu)}&format=json&limit=1`)
                    .then(r => r.json())
                    .then(data => {
                        if (data.length > 0) {
                            placeMarker(parseFloat(data[0].lat), parseFloat(data[0].lon), existingLieu);
                        }
                    }).catch(() => {});
            }
        });
        </script>

        <div class="row g-3">
            <div class="col-md-6 mb-4">
                {{ form_label(form.dateDebut, form.dateDebut.vars.label ~ ' *', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.dateDebut) }}
                {{ form_errors(form.dateDebut) }}
            </div>
            <div class="col-md-6 mb-4">
                {{ form_label(form.dateFin, form.dateFin.vars.label ~ ' *', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.dateFin) }}
                {{ form_errors(form.dateFin) }}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        {# Section: Sidebar Info #}
        <div class="mb-4">
            {{ form_label(form.type, form.type.vars.label ~ ' *', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.type) }}
            {{ form_errors(form.type) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.nombrePlacesMax, form.nombrePlacesMax.vars.label ~ ' *', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.nombrePlacesMax) }}
            {{ form_errors(form.nombrePlacesMax) }}
        </div>

        <div class="mb-4 p-3" style="background: #f8fafc; border-radius: 12px; border: 1px dashed #cbd5e1;">
            {{ form_label(form.imageFile, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.imageFile) }}
            <div class="form-text mt-2 text-muted" style="font-size: 0.8rem;">
                <i class="bi bi-info-circle me-1"></i> {{ form.imageFile.vars.help|default('Formats acceptés : JPG, PNG, WEBP, GIF — max 5 Mo.') }}
            </div>
            {{ form_errors(form.imageFile) }}
            
            {% if evenement.imageUrl %}
                <div class="mt-3">
                    <span class="d-block mb-2 text-muted" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Image actuelle :</span>
                    <img id="image-preview" src="{{ evenement.imageUrl }}" alt="Preview" class="img-fluid rounded shadow-sm" style="max-height: 150px; width: 100%; object-fit: cover;">
                </div>
            {% else %}
                <div class="mt-3">
                    <img id="image-preview" src="" alt="Preview" class="img-fluid rounded shadow-sm d-none" style="max-height: 150px; width: 100%; object-fit: cover;">
                </div>
            {% endif %}
            <div id="image-file-label" class="mt-1 small"></div>
        </div>
    </div>
</div>

{# ── AI Action buttons ────────────────────────────────────────────────────── #}
<div class="row mb-4">
    <div class="col-12 d-flex gap-2 flex-wrap">
        <button type="button" id="btn-generate-ai" class="btn btn-success shadow-sm">
            <i class="bi bi-robot me-1"></i> Générer avec IA
        </button>
        <button type="button" id="btn-predict" class="btn btn-info text-white shadow-sm">
            <i class="bi bi-graph-up-arrow me-1"></i> Prédire Participation
        </button>
    </div>
</div>

{# ── Prediction result panel (hidden by default) ──────────────────────────── #}
<div id="prediction-panel" class="card mb-4 border-info d-none shadow-sm" style="border-radius:12px;">
    <div class="card-header bg-info text-white fw-bold py-2" style="border-radius:12px 12px 0 0;">📊 Prédiction de participation</div>
    <div class="card-body" id="prediction-body">
        <p class="placeholder-glow"><span class="placeholder col-8"></span></p>
    </div>
</div>

{# ── Hidden field to carry the AI-chosen image path through form submit ────── #}
<input type="hidden" id="ai-image-path" name="ai_image_path" value="">

<div class="d-flex gap-3 mt-4 pt-3 border-top">
    <button type="submit" class="btn-save">
        <i class="bi bi-check-circle-fill me-2"></i>
        {{ button_label|default('Enregistrer') }}
    </button>
    <a href="{{ path('app_evenement_index') }}" class="btn-cancel">
        <i class="bi bi-x-circle me-1"></i>
        Annuler
    </a>
</div>

{{ form_widget(form.organisateur) }}
{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', () => {

    // ── helpers ───────────────────────────────────────────────────────────────
    const field  = id => document.getElementById(id);
    const getVal = id => (field(id)?.value ?? '').trim();

    function collectBaseData() {
        return {
            titre:            getVal('{{ form.titre.vars.id }}'),
            type:             getVal('{{ form.type.vars.id }}'),
            lieu:             getVal('{{ form.lieu.vars.id }}'),
            description:      getVal('{{ form.description.vars.id }}'),
            nombrePlacesMax:  parseInt(getVal('{{ form.nombrePlacesMax.vars.id }}') || '100'),
            dateDebut:        getVal('{{ form.dateDebut.vars.id }}'),
        };
    }

    // ── 🤖 Generate description + image ──────────────────────────────────────
    const btnGen = field('btn-generate-ai');
    if (btnGen) {
        btnGen.addEventListener('click', async () => {
            const d = collectBaseData();

            if (!d.titre || !d.type || !d.lieu) {
                alert('Veuillez renseigner le titre, le type et le lieu avant de générer.');
                return;
            }

            btnGen.disabled = true;
            btnGen.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Génération en cours…';

            try {
                const res  = await fetch('{{ path("app_evenement_ai_generate") }}', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify({ titre: d.titre, type: d.type, lieu: d.lieu }),
                });

                if (!res.ok) throw new Error('Erreur serveur ' + res.status);

                const data = await res.json();

                // Fill description
                if (data.description) {
                    const descField = field('{{ form.description.vars.id }}');
                    if (descField) descField.value = data.description;
                }

                // Show image preview
                if (data.imagePath) {
                    const hiddenPath = field('ai-image-path');
                    if (hiddenPath) hiddenPath.value = data.imagePath;

                    const preview = document.getElementById('image-preview');
                    if (preview) {
                        preview.src       = data.imagePath;
                        preview.classList.remove('d-none');
                    }

                    const label = document.getElementById('image-file-label');
                    if (label) {
                        label.textContent = '✓ Image IA générée';
                        label.className = 'mt-1 small text-success fw-bold';
                    }
                }

            } catch (e) {
                alert('Erreur : ' + e.message);
            } finally {
                btnGen.disabled    = false;
                btnGen.innerHTML = '<i class="bi bi-robot me-1"></i> Générer avec IA';
            }
        });
    }

    // ── 🧠 Predict attendance ─────────────────────────────────────────────────
    const btnPred = field('btn-predict');
    if (btnPred) {
        btnPred.addEventListener('click', async () => {
            const d = collectBaseData();

            if (!d.titre || !d.lieu || !d.dateDebut) {
                alert('Veuillez renseigner le titre, le lieu et la date de début avant de prédire.');
                return;
            }

            const panel = field('prediction-panel');
            const body  = field('prediction-body');

            btnPred.disabled    = true;
            btnPred.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Analyse…';
            panel.classList.remove('d-none');
            body.innerHTML  = '<p class="text-muted"><span class="spinner-grow spinner-grow-sm me-2"></span>Calcul en cours…</p>';

            try {
                const res = await fetch('{{ path("app_evenement_ai_predict") }}', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify(d),
                });

                if (!res.ok) throw new Error('Erreur serveur ' + res.status);

                const p = await res.json();

                body.innerHTML = `
                  <p class="fs-5 fw-bold text-success mb-2">
                    <i class="bi bi-people-fill me-2"></i>${p.participantsPredits} participants prévus
                  </p>
                  <p class="text-muted small mb-3">Indice de confiance : <strong>${p.confianceTexte}</strong> (${Math.round(p.confiance * 100)}%)</p>
                  
                  <h6 class="fw-bold mb-2" style="font-size:0.9rem;">🎯 Facteurs d'analyse</h6>
                  <div class="row g-2 mb-3">
                    <div class="col-6 small">Statut Type : ${Math.round(p.facteurs.type)}/100</div>
                    <div class="col-6 small">Saison : ${Math.round(p.facteurs.saison)}/100</div>
                    <div class="col-6 small">Localisation : ${Math.round(p.facteurs.lieu)}/100</div>
                    <div class="col-6 small">Historique : ${Math.round(p.facteurs.historique)}/100</div>
                  </div>

                  <h6 class="fw-bold mb-2" style="font-size:0.9rem;">💡 Recommandations pratiques</h6>
                  <ul class="list-unstyled small">
                    ${Object.entries(p.recommandations).map(([k, v]) =>
                      `<li class="mb-1"><i class="bi bi-dot me-1"></i><strong>${k.charAt(0).toUpperCase() + k.slice(1)}</strong> : ${v}</li>`
                    ).join('')}
                  </ul>
                `;

            } catch (e) {
                body.innerHTML = `<p class="text-danger">Erreur : ${e.message}</p>`;
            } finally {
                btnPred.disabled    = false;
                btnPred.innerHTML = '<i class="bi bi-graph-up-arrow me-1"></i> Prédire Participation';
            }
        });
    }
});
</script>
