{% extends 'evenement/admin_layout.html.twig' %}
{% block title %}Statistiques Événements - Ardhi Admin{% endblock %}
{% block page_title %}Statistiques Événements{% endblock %}

{% block stylesheets %}
<style>
.stat-card-ev{background:#fff;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.07);padding:22px;text-align:center;border-left:4px solid transparent;display:flex;align-items:center;gap:16px;}
.stat-icon-ev{width:46px;height:46px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0;}
.stat-val-ev{font-size:1.8rem;font-weight:800;line-height:1;} .stat-lbl-ev{font-size:.75rem;color:#9ca3af;font-weight:600;text-transform:uppercase;margin-top:3px;}
.section-card{background:#fff;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.07);padding:22px;margin-bottom:20px;}
.section-card h5{font-weight:700;font-size:.9rem;color:#667A3F;border-bottom:2px solid #f0f4e8;padding-bottom:10px;margin-bottom:14px;display:flex;align-items:center;gap:8px;}
.stat-progress-row{margin-bottom:14px;}
.stat-progress-label{display:flex;justify-content:space-between;font-size:.82rem;margin-bottom:3px;font-weight:600;}
.stat-bar{height:8px;border-radius:8px;background:#f1f5f9;overflow:hidden;}
.stat-bar-fill{height:100%;border-radius:8px;transition:width .5s;}
.top-ev-row{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #f1f5f9;}
.top-ev-row:last-child{border-bottom:none;}
.top-rank{width:32px;height:32px;border-radius:50%;background:#667A3F;color:#fff;font-weight:800;display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0;}
.top-rank.r1{background:linear-gradient(135deg,#F39C12,#e67e22);} .top-rank.r2{background:linear-gradient(135deg,#95a5a6,#7f8c8d);} .top-rank.r3{background:linear-gradient(135deg,#cd7f32,#a0522d);}
.chart-card{background:#fff;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.07);padding:18px;height:100%;}
.chart-title{font-weight:700;font-size:.9rem;color:#667A3F;margin-bottom:10px;}
.chart-wrap{position:relative;height:260px;}
</style>
{% endblock %}

{% block body %}
{% set gs = globalStats %}

{# KPI Cards #}
<div class="row g-3 mb-4">
  <div class="col-lg col-md-4">
    <div class="stat-card-ev" style="border-color:#667A3F;">
      <div class="stat-icon-ev" style="background:#f0f4e8;color:#667A3F;"><i class="bi bi-calendar-event-fill"></i></div>
      <div><div class="stat-val-ev" style="color:#667A3F;">{{ gs.totalEvents }}</div><div class="stat-lbl-ev">Événements</div></div>
    </div>
  </div>
  <div class="col-lg col-md-4">
    <div class="stat-card-ev" style="border-color:#3498DB;">
      <div class="stat-icon-ev" style="background:#ebf5fb;color:#2980b9;"><i class="bi bi-people-fill"></i></div>
      <div><div class="stat-val-ev" style="color:#2980b9;">{{ gs.totalParticipations }}</div><div class="stat-lbl-ev">Participations</div></div>
    </div>
  </div>
  <div class="col-lg col-md-4">
    <div class="stat-card-ev" style="border-color:#1abc9c;">
      <div class="stat-icon-ev" style="background:#e8f8f5;color:#16a085;"><i class="bi bi-person-check-fill"></i></div>
      <div><div class="stat-val-ev" style="color:#16a085;">{{ gs.tauxPresence }}%</div><div class="stat-lbl-ev">Taux présence</div></div>
    </div>
  </div>
  <div class="col-lg col-md-4">
    <div class="stat-card-ev" style="border-color:#F39C12;">
      <div class="stat-icon-ev" style="background:#fef9e7;color:#e67e22;"><i class="bi bi-star-fill"></i></div>
      <div><div class="stat-val-ev" style="color:#e67e22;">{{ gs.avgRating }}</div><div class="stat-lbl-ev">Note moyenne</div></div>
    </div>
  </div>
  <div class="col-lg col-md-4">
    <div class="stat-card-ev" style="border-color:#E74C3C;">
      <div class="stat-icon-ev" style="background:#fdedec;color:#c0392b;"><i class="bi bi-x-circle-fill"></i></div>
      <div><div class="stat-val-ev" style="color:#c0392b;">{{ gs.tauxAnnulation }}%</div><div class="stat-lbl-ev">Taux annulation</div></div>
    </div>
  </div>
</div>

{# Charts row #}
<div class="row g-3 mb-4">
  <div class="col-lg-4">
    <div class="chart-card"><div class="chart-title"><i class="bi bi-pie-chart-fill me-2"></i>Répartition par type</div><div class="chart-wrap"><canvas id="adminTypeChart"></canvas></div></div>
  </div>
  <div class="col-lg-4">
    <div class="chart-card"><div class="chart-title"><i class="bi bi-bar-chart-fill me-2"></i>Participations par statut</div><div class="chart-wrap"><canvas id="adminParticipationChart"></canvas></div></div>
  </div>
  <div class="col-lg-4">
    <div class="chart-card"><div class="chart-title"><i class="bi bi-graph-up-arrow me-2"></i>Top événements</div><div class="chart-wrap"><canvas id="adminTopEventsChart"></canvas></div></div>
  </div>
</div>

{# Progress bars #}
<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="section-card h-100">
      <h5><i class="bi bi-circle-fill text-success"></i>Par Statut</h5>
      {% set totalEv = gs.totalEvents > 0 ? gs.totalEvents : 1 %}
      {% set statusColors={'A_VENIR':'#8BC34A','EN_COURS':'#66BB6A','TERMINE':'#95a5a6','ANNULE':'#E74C3C'} %}
      {% set statusLabels={'A_VENIR':'À venir','EN_COURS':'En cours','TERMINE':'Terminé','ANNULE':'Annulé'} %}
      {% for row in gs.eventsByStatus %}
      <div class="stat-progress-row">
        <div class="stat-progress-label"><span>{{ statusLabels[row.statut]??row.statut }}</span><span>{{ row.count }}</span></div>
        <div class="stat-bar"><div class="stat-bar-fill" style="width:{{ ((row.count/totalEv)*100)|round }}%;background:{{ statusColors[row.statut]??'#667A3F' }}"></div></div>
      </div>
      {% endfor %}
    </div>
  </div>
  <div class="col-md-4">
    <div class="section-card h-100">
      <h5><i class="bi bi-tag-fill text-success"></i>Par Type</h5>
      {% set typeColors={'FOIRE':'#8BC34A','FORMATION':'#7CB342','CONFERENCE':'#A5D6A7','ATELIER':'#66BB6A'} %}
      {% for row in gs.eventsByType %}
      <div class="stat-progress-row">
        <div class="stat-progress-label"><span>{{ row.type }}</span><span>{{ row.count }}</span></div>
        <div class="stat-bar"><div class="stat-bar-fill" style="width:{{ ((row.count/totalEv)*100)|round }}%;background:{{ typeColors[row.type]??'#667A3F' }}"></div></div>
      </div>
      {% endfor %}
    </div>
  </div>
  <div class="col-md-4">
    <div class="section-card h-100">
      <h5><i class="bi bi-people-fill text-success"></i>Participations par statut</h5>
      {% set totalP = gs.totalParticipations > 0 ? gs.totalParticipations : 1 %}
      {% set pstatColors={'CONFIRME':'#8BC34A','EN_ATTENTE':'#A5D6A7','PRESENT':'#66BB6A','REFUSE':'#E74C3C','ANNULE':'#95a5a6'} %}
      {% set pstatLabels={'CONFIRME':'Confirmés','EN_ATTENTE':'En attente','PRESENT':'Présents','REFUSE':'Refusés','ANNULE':'Annulés'} %}
      {% for row in gs.participationsByStatus %}
      <div class="stat-progress-row">
        <div class="stat-progress-label"><span>{{ pstatLabels[row.statut]??row.statut }}</span><span>{{ row.count }} ({{ ((row.count/totalP)*100)|round }}%)</span></div>
        <div class="stat-bar"><div class="stat-bar-fill" style="width:{{ ((row.count/totalP)*100)|round }}%;background:{{ pstatColors[row.statut]??'#667A3F' }}"></div></div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{# Top events #}
<div class="row g-3">
  <div class="col-md-6">
    <div class="section-card">
      <h5><i class="bi bi-trophy-fill" style="color:#F39C12;"></i>Top 5 par participants</h5>
      {% for ev in gs.topEvents %}
      <div class="top-ev-row">
        <div class="top-rank {{ loop.index==1?'r1':(loop.index==2?'r2':(loop.index==3?'r3':'')) }}">{{ loop.index }}</div>
        <div style="flex:1;min-width:0;"><div style="font-weight:700;font-size:.87rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ ev.titre }}</div></div>
        <div style="text-align:right;"><div style="font-weight:800;font-size:1.2rem;color:#5f8f2f;">{{ ev.participantCount }}</div><div style="font-size:.7rem;color:#9ca3af;">participants</div></div>
      </div>
      {% else %}<p class="text-muted">Aucune donnée.</p>{% endfor %}
    </div>
  </div>
  <div class="col-md-6">
    <div class="section-card">
      <h5><i class="bi bi-star-fill" style="color:#F39C12;"></i>Mieux notés</h5>
      {% for ev in gs.topRatedEvents %}
      <div class="top-ev-row">
        <div class="top-rank {{ loop.index==1?'r1':(loop.index==2?'r2':(loop.index==3?'r3':'')) }}">{{ loop.index }}</div>
        <div style="flex:1;min-width:0;"><div style="font-weight:700;font-size:.87rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ ev.titre }}</div></div>
        <div style="text-align:right;"><div style="font-weight:800;font-size:1.2rem;color:#F39C12;">{{ ev.avgRating }} ⭐</div><div style="font-size:.7rem;color:#9ca3af;">{{ ev.count }} avis</div></div>
      </div>
      {% else %}<p class="text-muted">Aucun avis encore.</p>{% endfor %}
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
  (() => {
    if (typeof Chart === 'undefined') return;
    const baseOpts = { responsive:true, maintainAspectRatio:false, animation:{duration:800}, plugins:{legend:{position:'bottom'}} };
    const typeLabels = [{% for row in globalStats.eventsByType %}'{{ row.type|e('js') }}'{% if not loop.last %},{% endif %}{% endfor %}];
    const typeValues = [{% for row in globalStats.eventsByType %}{{ row.count }}{% if not loop.last %},{% endif %}{% endfor %}];
    new Chart(document.getElementById('adminTypeChart'),{type:'doughnut',data:{labels:typeLabels,datasets:[{data:typeValues,backgroundColor:['#8BC34A','#7CB342','#A5D6A7','#66BB6A','#95a5a6']}]},options:baseOpts});
    const partLabels=[{% for row in globalStats.participationsByStatus %}'{{ row.statut|e('js') }}'{% if not loop.last %},{% endif %}{% endfor %}];
    const partValues=[{% for row in globalStats.participationsByStatus %}{{ row.count }}{% if not loop.last %},{% endif %}{% endfor %}];
    new Chart(document.getElementById('adminParticipationChart'),{type:'bar',data:{labels:partLabels,datasets:[{label:'Participations',data:partValues,backgroundColor:'#667A3F'}]},options:{...baseOpts,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true}}}});
    const topLabels=[{% for ev in globalStats.topEvents %}'{{ ev.titre|slice(0,20)|e('js') }}'{% if not loop.last %},{% endif %}{% endfor %}];
    const topValues=[{% for ev in globalStats.topEvents %}{{ ev.participantCount }}{% if not loop.last %},{% endif %}{% endfor %}];
    new Chart(document.getElementById('adminTopEventsChart'),{type:'bar',data:{labels:topLabels,datasets:[{label:'Participants',data:topValues,backgroundColor:'#5f8f2f'}]},options:{...baseOpts,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true}}}});
  })();
</script>
{% endblock %}
