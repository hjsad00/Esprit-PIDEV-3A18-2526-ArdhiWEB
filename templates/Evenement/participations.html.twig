{% extends 'base.html.twig' %}
{% block title %}Gestion des participations - Ardhi{% endblock %}
{% block stylesheets %}<link href="{{ asset('assets/css/homepage.css') }}" rel="stylesheet">{% endblock %}
{% block body %}
<section class="hero section dark-background"
  style="background-image:linear-gradient(180deg,rgba(10,15,8,.62),rgba(10,15,8,.2)),url('{{ asset('assets/img/hero_3.jpg') }}');
         background-size:cover;background-position:center;min-height:340px;margin-top:70px;">
  <div class="hero-content-wrapper" style="align-items:center;justify-content:center;">
    <div class="hero-left" style="max-width:720px;padding:90px 40px;">
      <div class="hero-label">TABLEAU DE BORD</div>
      <h1 class="hero-headline">Gestion des participations</h1>
      <div class="hero-actions-row">
        <a href="{{ path('app_evenement_index') }}" class="hero-btn-secondary">Retour aux evenements</a>
        {% if not isAdmin %}
        <a href="{{ path('app_evenement_inscriptions') }}" class="hero-btn-primary">Mes inscriptions</a>
        {% endif %}
      </div>
      <p class="hero-description">
        {% if isAdmin %}Toutes les participations de la plateforme.{% else %}Gerez les inscriptions a vos evenements.{% endif %}
      </p>
    </div>
  </div>
</section>
<section class="services section" style="padding-top:36px;">
  <div class="container section-title" data-aos="fade-up">
    <h2>Participations</h2><p>Gerez les statuts d'inscription.</p>
  </div>
  <div class="container pb-5">
    {% if participations is empty %}
      <div class="alert alert-info">Aucune participation a gerer.</div>
    {% else %}
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr><th>Evenement</th><th>Participant</th><th>Date</th><th>Places</th><th>Statut</th><th class="text-end">Action</th></tr>
            </thead>
            <tbody>
              {% for p in participations %}
              <tr>
                <td><a href="{{ path('app_evenement_show', {id: p.evenement.id}) }}" class="text-decoration-none fw-semibold">{{ p.evenement.titre|slice(0,35) }}</a></td>
                <td>{{ p.utilisateur.prenom }} {{ p.utilisateur.nom }}</td>
                <td style="white-space:nowrap;font-size:.84rem;">{{ p.dateInscription ? p.dateInscription|date('d/m/Y H:i') : '-' }}</td>
                <td>{{ p.nombrePersonnes }}</td>
                <td>
                  <span class="badge bg-{{ p.statut=='CONFIRME' ? 'success' : p.statut=='PRESENT' ? 'info text-dark' : p.statut=='EN_ATTENTE' ? 'warning text-dark' : p.statut=='REFUSE' ? 'danger' : 'secondary' }}">
                    {{ p.statut|replace({'EN_ATTENTE':'EN ATTENTE'}) }}
                  </span>
                </td>
                <td class="text-end">
                  <form method="post" action="{{ path('app_evenement_participation_update', {id: p.id}) }}" class="d-flex gap-2 justify-content-end">
                    <select name="statut" class="form-select form-select-sm" style="width:160px;">
                      {% for code, label in {'CONFIRME':'Confirmer','EN_ATTENTE':'En attente','PRESENT':'Present','REFUSE':'Refuser','ANNULE':'Annuler'} %}
                        <option value="{{ code }}" {% if p.statut == code %}selected{% endif %}>{{ label }}</option>
                      {% endfor %}
                    </select>
                    <button type="submit" class="btn btn-sm btn-success">OK</button>
                  </form>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</section>
{% endblock %}
